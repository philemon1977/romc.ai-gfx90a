# ============================================================================
# Git LFS 规则 —— 只针对"不可再生"的二进制产出
#
# 轻量克隆（推荐）：GIT_LFS_SKIP_SMUDGE=1 git clone --depth 1 <url>
# 只看报告文本时不必下载 800 MB 的 trace。
# ============================================================================

# aiter gfx90a INT8 GEMM 模块（orig/fixed 一对，是 M<=64 边界修复的实测证据）
*.so filter=lfs diff=lfs merge=lfs -text

# PyTorch profiler trace（gzip JSON）：decode 归因的唯一原始测量数据
*.pt.trace.json.gz filter=lfs diff=lfs merge=lfs -text
*.trace.json.gz filter=lfs diff=lfs merge=lfs -text

# 预防性规则：若日后提交模型权重 / 归档 / 图像
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.gguf filter=lfs diff=lfs merge=lfs -text
*.pt filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text

# --- 文本规范化 -------------------------------------------------------------
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.csv text eol=lf
*.log text eol=lf
*.patch text eol=lf -diff
*.diff text eol=lf -diff
Dockerfile text eol=lf

# 二进制兜底：未列出的二进制一律不按文本处理
*.bin binary
*.o binary
*.a binary
