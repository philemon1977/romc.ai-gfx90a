{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ad7070e90a199d32","type":"tool_result","content":"=== ornith1.5_35b_a3b_vllm-moet_gate1_1m_8107_5090.sh ===\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (5090 单卡) — vllm-moet gate=1, 专家池全量驻留系统RAM (DMA)\n# Description: Ornith-1.5-35B-A3B (qwen3_5_moe 底座, 67GB BF16, 256专家/8激活,\n#   40层: 30层 linear_attn + 10层 full_attn) 在 RTX 5090 (32GB, GPU index 2)\n#   单卡 vllm027-moet (0.27.1 + Moet 补丁) 上 DMA 方式部署 = 专家池全量装载\n#   系统 RAM (host-side pinned base), GPU 只留 hot-expert cache:\n#   - BASE_CACHE_GB=20: 2-bit 专家 base 全量 pinned 主机 RAM (~20GB, 主机\n#     184GB 可承受), GPU 侧仅 20GiB hot-expert cache\n#   - GATE=1: cache miss → gate 批量 pinned-H2D 抓取 + graph replay\n#     (bit-identical, strict 模式 fail-closed, 绝不静默零贡献)\n#   - PREFETCH=1: draft-affinity 预取 (token→expert 亲和表), 压低 miss 率\n#     (README 实测: ~19% 覆盖服务 ~96% 路由; A3B 每 token 仅 8 专家, 路由更集中)\n#   - STORE_DIR 盘上 pack: 量化结果持久化, 二次启动跳过 67GB 反量化重建\n#   - 上下文 1M: 原生 max_position_embeddings=262144 (256K), 靠\n#     VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 (vllm_moet.conf 已设) 允许\n#     --max-model-len 1048576 覆盖 (full_attn 仅 10/40 层, KV 压力有限)\n# KPI: 启动日志关注 \"[base] KPI: replay X% of last N steps\" (KPI_EVERY=20):\n#   replay 高 → 增大 BASE_CACHE_GB 或显 BASE_MISS_TOL (默认 0 = strict)\nset -euo pipefail\n\n# ── GPU & CUDA (单卡 5090 = index 2) ────────────────────────────────────\nsource ${AI_SERVER_HOME:-/mnt/nvme4t/ai}/config/gpu_5090.conf\n\n# ── 引擎共性 (vllm027-moet python + MOE_W2 共性) ────────────────────────\nsource ${AI_SERVER_HOME:-/mnt/nvme4t/ai}/config/vllm_moet.conf\n\n# ── 功率限制 (加载 67GB 权重时防 5090 满载掉电/显示引擎 hang, 默认 450W) ──\nGPU_POWER_LIMIT=\"${GPU_POWER_LIMIT:-450}\"\n_gpu=${GPU_DEVICE}\n_min=$(nvidia-smi -i \"${_gpu}\" --query-gpu=power.min_limit --format=csv,noheader,nounits 2>/dev/null | tr -d ' ' | cut -d. -f1)\n_target=$(( GPU_POWER_LIMIT > _min ? GPU_POWER_LIMIT : _min ))\nif sudo -n nvidia-smi -i \"${_gpu}\" -pl \"${_target}\" >/dev/null 2>&1; then\n  echo \"GPU ${_gpu}: 功率上限 ${_target}W\"\nelse\n  echo \"警告: GPU ${_gpu} 功率限制失败 (需 root 免密 sudo)\"\nfi\n\n# ── 端口 ────────────────────────────────────────────────────────────────\nPORT=\"${PORT:-8107}\"   # 一底座一端口: ornith-1.5 (8101=qwen3.8 / 8102=qwen3.6 / 8103=dsv4 / 8104=gemma4 / 8105=web-watcher / 8106=muse-glimmer)\n\n# 防重复启动\nexec 9>/tmp/vllm-ornith-1.5-${PORT}.lock\nflock -n 9 || { echo \"错误: 已有实例在运行 (flock 拒绝)\"; exit 1; }\n\nMODEL_PATH=${AI_SERVER_HOME:-/mnt/nvme4t/ai}/models/ornith-ai/Ornith-1.5-35B-A3B\nSTORE_DIR=${AI_SERVER_HOME:-/mnt/nvme4t/ai}/cache/moet-pack-ornith-1.5\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\n\nif ss -tlnp 2>/dev/null | grep -q \":${PORT} \"; then\n  echo \"错误: 端口 ${PORT} 已被占用\"; exit 1\nfi\n\n# 防僵尸残留: 清掉同端口残留 vllm 进程\npkill -f \"vllm.entrypoints.openai.api_server.*--port ${PORT}\" 2>/dev/null && {\n  echo \"已清理同端口残留进程\"\n  sleep 3\n} || true\n\n> \"${LOG_FILE}\"\nmkdir -p \"${STORE_DIR}\"\n\necho \"Starting Ornith-1.5-35B-A3B (vllm-moet gate=1, 专家池全量RAM) on GPU ${GPU_DEVICE} port=${PORT} ...\"\necho \"  Config: TP1 | 专家池pinned RAM全量 + GPU 20GiB hot cache | GATE=1 strict | PREFETCH=1 | 1M ctx | max-seqs 8\"\n\n# ── DMA 方式: 专家池全量装载系统 RAM (host pinned base) + GPU hot-expert cache ──\nexport VLLM_MOE_W2_BASE_CACHE_GB=20      # GPU 侧 hot-expert cache 20GiB (专家池在主机 RAM)\nexport VLLM_MOE_W2_GATE=1                 # miss → 批量 pinned-H2D + graph replay (bit-identical)\nexport VLLM_MOE_W2_REPLAY_MODE=strict     # fail-closed: 不返回静默零贡献的 logits\nexport VLLM_MOE_W2_PREFETCH=1             # draft-affinity 预取, 压低 miss 率\nexport VLLM_MOE_W2_DELTA=0                # 关闭 FP4 delta tier (本模式专家池纯 host base)\nexport VLLM_MOE_W2_STORE_DIR=\"${STORE_DIR}/pack\"   # 盘上 pack: 量化持久化, 免二次重建\nexport VLLM_MOE_W2_BASE_RAM_GB=20         # pinned MRU arena over pack (arena 覆盖 = 全量专家池)\nexport VLLM_MOE_W2_BASE_MISS_TOL=0        # 默认 strict: 任何 miss 都 replay\n\n# ── 本脚本专属 (引擎共性已在 vllm_moet.conf) ────────────────────────────\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8,max_split_size_mb:512\"\nmkdir -p \"${HOME}/.cache/flashinfer\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" --served-model-name ornith-1.5 --trust-remote-code \\\n  --tensor-parallel-size 1 --disable-custom-all-reduce \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --kv-cache-dtype fp8 --block-size 256 \\\n  --max-model-len 1048576 --gpu-memory-utilization 0.97 \\\n  --max-num-batched-tokens 8192 --max-num-seqs 8 \\\n  --enable-prefix-caching \\\n  --enable-chunked-prefill \\\n  --limit-mm-per-prompt '{\"image\":0,\"video\":0}' \\\n  --compilation-config '{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"custom_ops\":[\"all\"]}' \\\n  > \"${LOG_FILE}\" 2>&1 &\n\n# 页缓存清理: 67GB checkpoint 读完即废, 滞留会让常驻阶段可用内存枯竭\nDROP_CKPT=/tmp/vllm-ornith-1.5-${PORT}-drop-ckpt\nrm -f \"${DROP_CKPT}\"\n( exec 9>&-; for i in $(seq 1 960); do\n    if [ ! -f \"${DROP_CKPT}\" ] && grep -qE \"checkpoint shards: 100%|Loading model weights took\" \"${LOG_FILE}\" 2>/dev/null; then\n      echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null 2>&1\n      echo \"[drop_caches] checkpoint $(date +%H:%M:%S)\" >> \"${LOG_FILE}\"\n      touch \"${DROP_CKPT}\"\n    fi\n    sleep 5\n  done ) &\n\nsleep 3\necho \"✅ http://localhost:${PORT}/v1 | Log: tail -f ${LOG_FILE}\"\necho \"   优化: TP1 | 专家池全量RAM+GPU20G hot cache | GATE=1 strict replay | PREFETCH=1 | KV fp8 | 1M ctx\"\n=== ornith_1.5_35b_a3b_vllm_rocm72_mi250x_tp4_256k.sh ===\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (MI250X GPU0-3, vLLM rocm7.2 wheel, TP4, 256k, AITER)\n# Desc: 由原系统版启动命令(存于 ~/ornith_serve_cmd.txt)迁移到 vllm_0.28.0_rocm72 环境。\n#   原参数逐字保留(--served-model-name ornith --language-model-only --max-model-len 8192\n#   --gpu-memory-utilization 0.85 --trust-remote-code --port 8000)，差异: TP 8→4；\n#   2026-09-03 更新: 启用 ROCm AITER 全家桶(主开关 VLLM_ROCM_USE_AITER=1，含 AITER MoE/\n#   RMSNorm/CUSTOM_AR)，并移除 --disable-custom-all-reduce 以放行定制 allreduce。\n#   2026-09-07 更新: ctx 8k→**256k**(MAX_MODEL_LEN=262144)。依据：config.json\n#   max_position_embeddings=262,144 ⇒ 原生上限内，无需 YaRN/外挂（CLAUDE.md §9 同族\n#   Flash-Next 已定稿 262,144；1M 判定被用户取消，见 docs/research-notes/{1M-上下文可行性,256k-上下文}-2026-09-07.md）。\n#   ⚠️ 改名后 beta 封装 serve_ornith_splitkv_ab.sh 的 LAUNCHER 路径与 LOGPAT 需同步（已同步）。\nset -euo pipefail\n\nAI_HOME=\"${AI_HOME:-/home/qiba/ai}\"\nVLLM_PYTHON=\"${VLLM_PYTHON:-${AI_HOME}/envs/vllm_0.28.0_rocm72/bin/python}\"\n\nROCM724=\"${ROCM724:-/opt/rocm-7.2.4}\"\nexport LD_LIBRARY_PATH=\"${ROCM724}/lib:${LD_LIBRARY_PATH:-}\"\nexport ROCM_PATH=\"${ROCM724}\"\nexport PATH=\"${ROCM724}/bin:${PATH}\"\n\n# --- ROCm AITER 加速路径 ---\nexport VLLM_ROCM_USE_AITER=\"${VLLM_ROCM_USE_AITER:-0}\"    # CDNA2(gfx90a) 被 vllm 硬门槛禁用(>2 才放行)\n\nPORT=\"${PORT:-8000}\"\nMODEL_PATH=\"${MODEL_PATH:-${AI_HOME}/models/ornith-ai/Ornith-1.5-35B-A3B}\"\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\nGPU_MEM_UTIL=\"${GPU_MEM_UTIL:-0.85}\"\nMAX_MODEL_LEN=\"${MAX_MODEL_LEN:-262144}\"   # 2026-09-07: 8192→262144（原生上限，见头部注释）\nTP=\"${TP:-4}\"\n\nexport HIP_VISIBLE_DEVICES=\"${HIP_VISIBLE_DEVICES:-0,1,2,3}\"\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8\"\nexport RAY_memory_monitor_refresh_ms=\"0\"\n\n# --- MI250X(gfx90a) P1+C2+C3（原生 env 已打补丁，2026-09-03 实测）---------------\n# P1 门控 GEMV：与 F.linear 逐位相同；Ornith TP4 单流 71.2 -> 85.3 t/s (+19.8%)。\n# C2/C3 QuickReduce：默认下限表 (bf16,4)=8MB 会把 decode 的 4-10KB 全 reduce 挡在门外，\n#   必须同时给 MIN_SIZE_BYTES_MB=0 才真上场；缺这行 = 设了 FP 也没用（我踩过）。\n#   实测增益 Ornith TP4 单流 +12.5% / 并发4 +24.9%；稠密 TP2 单流 +4.7% / 并发 +2.0%。\n#   数值：world=2 与 NCCL 逐位一致；world>=4 是求和顺序不同（平均误差与 NCCL 相等\n#   0.231 ULP、优劣对称 19/62/19），temp=0 的逐 token 输出会与旧基线不同 -> 基线需重跑。\nexport MI250_GATE_GEMV=\"${MI250_GATE_GEMV:-1}\"\nexport VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"${VLLM_ROCM_QUICK_REDUCE_QUANTIZATION:-FP}\"\nexport VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB=\"${VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB:-0}\"\nexport VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=\"${VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16:-0}\"\n\n# --- MI250X split-KV paged-decode（2026-09-07 转正，进生产默认开）---\n# 病根：现役 Triton 参考内核 grid 只有 (num_seqs, num_kv_heads) ⇒ 单流时 **1 个 program / 104 CU**，\n#       带宽恒定 7-12 GB/s（纯读峰 1171）。split-KV 把 KV 维切成 partition 作为 grid 第三维。\n# 实测收益（die0-3、同二进制两臂、只差这一个 env）：单流 @30720 ctx 13.1 -> 94.5 t/s（×7.22）；\n#       并发 8/32/64 的 Phase2 tok/s +1.39% / +1.83% / +0.20%，SE-Bench Phase1 逐项无回退。\n# 范围（**超出即走原路径，是设计不是遗漏**）：纯 decode(max_query_len==1) ∧ bf16 ∧ hd=256 ∧\n#       非2幂 block(528) ∧ kv_cache_dtype=auto ∧ 无 sliding_window/sinks/alibi ∧ num_seqs*kv_heads<=64。\n# ⚠️ 代价：分段 + log-sum-exp 归并改了求和顺序 ⇒ **破 temp=0 逐字可比性**（与上面 QuickReduce w>=4\n#       同类）。本模型历史基线全部作废：SE-Bench Phase2 新基线 = OFF 481.61 / ON 488.30 tok/s。\n# 证据：docs/research-notes/splitkv-{落地端到端,拐点与税收,转正许可证}-2026-09-0{7,8}.md\n# 正确性裁判：bench/pa256_golden.py（float32 独立手算）81 格全过，含 b=24/32/64 与 partition 边界±1。\n# ⚠️ **故意不设 VLLM_ROCM_SPLITKV_PA_MAX_SEQS**：门限唯一真值在内核 DEFAULT_MAX_SEQS=64；\n#    在这里再写一遍会制造\"两个真值来源\"（beta 封装里曾因此把 64 按回 16）。要改请改内核。\n# 关它（回退对照/排障）：VLLM_ROCM_SPLITKV_PA=0 bash <本脚本>\nexport VLLM_ROCM_SPLITKV_PA=\"${VLLM_ROCM_SPLITKV_PA:-1}\"\n# scratch 单 key 预算（内核 :676，默认 32 MiB/key）。本臂 256k 实测：seqs=16..64 七档全部被\n# `scratch 34078720..136314880 超预算` 打回 Triton——最小那次 **只超阈值 524,288 B（1.6%）**，\n# 最大 136,314,880 B=130 MiB。⇒ 与 27B 两臂统一抬到 192 MiB/key（130 + ~48% 余量；64/96 救不了\n# 本臂的 seqs≥32）。总基座仍受内核 MAX_TOTAL_MIB=192 MiB 约束（capture 从大到小 ⇒ hist≈0），\n# scratch 在 KV 池 sizing 后独立分配 ⇒ 不吃 KV 池（实测见 256k-上下文-2026-09-07.md §6）。\n# 一行回退：VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB=32 bash <本脚本>\nexport VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB=\"${VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB:-192}\"\n\nif nc -z 127.0.0.1 \"${PORT}\" 2>/dev/null; then\n  echo \"错误：端口 $PORT 已被占用\"; exit 1\nfi\n\n> \"${LOG_FILE}\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" \\\n  --served-model-name ornith \\\n  --language-model-only \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --tensor-parallel-size \"${TP}\" \\\n  --gpu-memory-utilization \"${GPU_MEM_UTIL}\" \\\n  --max-model-len \"${MAX_MODEL_LEN}\" \\\n  --enable-auto-tool-choice \\\n  --tool-call-parser qwen3_coder \\\n  --trust-remote-code \\\n  --no-use-tqdm-on-load \\\n  > \"${LOG_FILE}\" 2>&1 &\n\nsleep 1\necho \"✅ ornith-1.5-35b-a3b (MI250X GPU ${HIP_VISIBLE_DEVICES}, TP=${TP}, vLLM+AITER) http://localhost:${PORT}/v1\"\necho \"   AITER=1(moe/rmsnorm/mla/custom_ar) | ctx=${MAX_MODEL_LEN} | util=${GPU_MEM_UTIL} | 限功率400W/模组\"\necho \"   查看日志: tail -f ${LOG_FILE}\"\n\n=== ornith_1.5_35b_a3b_vllm_rocm72_mi250x_tp4_8k.sh ===\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (MI250X GPU0-3, vLLM rocm7.2 wheel, TP4, 8k, AITER)\n# Desc: 由原系统版启动命令(存于 ~/ornith_serve_cmd.txt)迁移到 vllm_0.28.0_rocm72 环境。\n#   原参数逐字保留(--served-model-name ornith --language-model-only --max-model-len 8192\n#   --gpu-memory-utilization 0.85 --trust-remote-code --port 8000)，差异: TP 8→4；\n#   2026-09-03 更新: 启用 ROCm AITER 全家桶(主开关 VLLM_ROCM_USE_AITER=1，含 AITER MoE/\n#   RMSNorm/CUSTOM_AR)，并移除 --disable-custom-all-reduce 以放行定制 allreduce。\nset -euo pipefail\n\nAI_HOME=\"${AI_HOME:-/mnt/nvme2t-samsung/ai}\"\nVLLM_PYTHON=\"${VLLM_PYTHON:-${AI_HOME}/envs/vllm_0.28.0_rocm72/bin/python}\"\n\nROCM724=\"${ROCM724:-/opt/rocm-7.2.4}\"\nexport LD_LIBRARY_PATH=\"${ROCM724}/lib:${LD_LIBRARY_PATH:-}\"\nexport ROCM_PATH=\"${ROCM724}\"\nexport PATH=\"${ROCM724}/bin:${PATH}\"\n\n# --- ROCm AITER 加速路径 ---\nexport VLLM_ROCM_USE_AITER=\"${VLLM_ROCM_USE_AITER:-0}\"    # CDNA2(gfx90a) 被 vllm 硬门槛禁用(>2 才放行)\n\nPORT=\"${PORT:-8000}\"\nMODEL_PATH=\"${MODEL_PATH:-${AI_HOME}/models/ornith-ai/Ornith-1.5-35B-A3B}\"\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\nGPU_MEM_UTIL=\"${GPU_MEM_UTIL:-0.85}\"\nMAX_MODEL_LEN=\"${MAX_MODEL_LEN:-8192}\"\nTP=\"${TP:-4}\"\n\nexport HIP_VISIBLE_DEVICES=\"${HIP_VISIBLE_DEVICES:-0,1,2,3}\"\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8\"\nexport RAY_memory_monitor_refresh_ms=\"0\"\n\n# --- MI250X(gfx90a) P1+C2+C3（原生 env 已打补丁，2026-09-03 实测）---------------\n# P1 门控 GEMV：与 F.linear 逐位相同；Ornith TP4 单流 71.2 -> 85.3 t/s (+19.8%)。\n# C2/C3 QuickReduce：默认下限表 (bf16,4)=8MB 会把 decode 的 4-10KB 全 reduce 挡在门外，\n#   必须同时给 MIN_SIZE_BYTES_MB=0 才真上场；缺这行 = 设了 FP 也没用（我踩过）。\n#   实测增益 Ornith TP4 单流 +12.5% / 并发4 +24.9%；稠密 TP2 单流 +4.7% / 并发 +2.0%。\n#   数值：world=2 与 NCCL 逐位一致；world>=4 是求和顺序不同（平均误差与 NCCL 相等\n#   0.231 ULP、优劣对称 19/62/19），temp=0 的逐 token 输出会与旧基线不同 -> 基线需重跑。\nexport MI250_GATE_GEMV=\"${MI250_GATE_GEMV:-1}\"\nexport VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"${VLLM_ROCM_QUICK_REDUCE_QUANTIZATION:-FP}\"\nexport VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB=\"${VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB:-0}\"\nexport VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=\"${VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16:-0}\"\n\nif nc -z 127.0.0.1 \"${PORT}\" 2>/dev/null; then\n  echo \"错误：端口 $PORT 已被占用\"; exit 1\nfi\n\n> \"${LOG_FILE}\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" \\\n  --served-model-name ornith \\\n  --language-model-only \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --tensor-parallel-size \"${TP}\" \\\n  --gpu-memory-utilization \"${GPU_MEM_UTIL}\" \\\n  --max-model-len \"${MAX_MODEL_LEN}\" \\\n  --enable-auto-tool-choice \\\n  --tool-call-parser qwen3_coder \\\n  --trust-remote-code \\\n  --no-use-tqdm-on-load \\\n  > \"${LOG_FILE}\" 2>&1 &\n\nsleep 1\necho \"✅ ornith-1.5-35b-a3b (MI250X GPU ${HIP_VISIBLE_DEVICES}, TP=${TP}, vLLM+AITER) http://localhost:${PORT}/v1\"\necho \"   AITER=1(moe/rmsnorm/mla/custom_ar) | ctx=${MAX_MODEL_LEN} | util=${GPU_MEM_UTIL} | 限功率400W/模组\"\necho \"   查看日志: tail -f ${LOG_FILE}\"\nShell cwd was reset to /home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-35B-A3B/20260914T094955Z-aa171c76/runs/specialist/d00cdedfc173451eaf5b312d08e00da9","is_error":false}]},"parent_tool_use_id":null,"session_id":"8f181082-ed15-418f-a6d5-f6b9b40a6948","uuid":"1b1a2e32-2c46-4d5e-aca2-b74da2482191","timestamp":"2026-09-14T10:56:58.264Z","tool_use_result":{"stdout":"=== ornith1.5_35b_a3b_vllm-moet_gate1_1m_8107_5090.sh ===\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (5090 单卡) — vllm-moet gate=1, 专家池全量驻留系统RAM (DMA)\n# Description: Ornith-1.5-35B-A3B (qwen3_5_moe 底座, 67GB BF16, 256专家/8激活,\n#   40层: 30层 linear_attn + 10层 full_attn) 在 RTX 5090 (32GB, GPU index 2)\n#   单卡 vllm027-moet (0.27.1 + Moet 补丁) 上 DMA 方式部署 = 专家池全量装载\n#   系统 RAM (host-side pinned base), GPU 只留 hot-expert cache:\n#   - BASE_CACHE_GB=20: 2-bit 专家 base 全量 pinned 主机 RAM (~20GB, 主机\n#     184GB 可承受), GPU 侧仅 20GiB hot-expert cache\n#   - GATE=1: cache miss → gate 批量 pinned-H2D 抓取 + graph replay\n#     (bit-identical, strict 模式 fail-closed, 绝不静默零贡献)\n#   - PREFETCH=1: draft-affinity 预取 (token→expert 亲和表), 压低 miss 率\n#     (README 实测: ~19% 覆盖服务 ~96% 路由; A3B 每 token 仅 8 专家, 路由更集中)\n#   - STORE_DIR 盘上 pack: 量化结果持久化, 二次启动跳过 67GB 反量化重建\n#   - 上下文 1M: 原生 max_position_embeddings=262144 (256K), 靠\n#     VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 (vllm_moet.conf 已设) 允许\n#     --max-model-len 1048576 覆盖 (full_attn 仅 10/40 层, KV 压力有限)\n# KPI: 启动日志关注 \"[base] KPI: replay X% of last N steps\" (KPI_EVERY=20):\n#   replay 高 → 增大 BASE_CACHE_GB 或显 BASE_MISS_TOL (默认 0 = strict)\nset -euo pipefail\n\n# ── GPU & CUDA (单卡 5090 = index 2) ────────────────────────────────────\nsource ${AI_SERVER_HOME:-/mnt/nvme4t/ai}/config/gpu_5090.conf\n\n# ── 引擎共性 (vllm027-moet python + MOE_W2 共性) ────────────────────────\nsource ${AI_SERVER_HOME:-/mnt/nvme4t/ai}/config/vllm_moet.conf\n\n# ── 功率限制 (加载 67GB 权重时防 5090 满载掉电/显示引擎 hang, 默认 450W) ──\nGPU_POWER_LIMIT=\"${GPU_POWER_LIMIT:-450}\"\n_gpu=${GPU_DEVICE}\n_min=$(nvidia-smi -i \"${_gpu}\" --query-gpu=power.min_limit --format=csv,noheader,nounits 2>/dev/null | tr -d ' ' | cut -d. -f1)\n_target=$(( GPU_POWER_LIMIT > _min ? GPU_POWER_LIMIT : _min ))\nif sudo -n nvidia-smi -i \"${_gpu}\" -pl \"${_target}\" >/dev/null 2>&1; then\n  echo \"GPU ${_gpu}: 功率上限 ${_target}W\"\nelse\n  echo \"警告: GPU ${_gpu} 功率限制失败 (需 root 免密 sudo)\"\nfi\n\n# ── 端口 ────────────────────────────────────────────────────────────────\nPORT=\"${PORT:-8107}\"   # 一底座一端口: ornith-1.5 (8101=qwen3.8 / 8102=qwen3.6 / 8103=dsv4 / 8104=gemma4 / 8105=web-watcher / 8106=muse-glimmer)\n\n# 防重复启动\nexec 9>/tmp/vllm-ornith-1.5-${PORT}.lock\nflock -n 9 || { echo \"错误: 已有实例在运行 (flock 拒绝)\"; exit 1; }\n\nMODEL_PATH=${AI_SERVER_HOME:-/mnt/nvme4t/ai}/models/ornith-ai/Ornith-1.5-35B-A3B\nSTORE_DIR=${AI_SERVER_HOME:-/mnt/nvme4t/ai}/cache/moet-pack-ornith-1.5\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\n\nif ss -tlnp 2>/dev/null | grep -q \":${PORT} \"; then\n  echo \"错误: 端口 ${PORT} 已被占用\"; exit 1\nfi\n\n# 防僵尸残留: 清掉同端口残留 vllm 进程\npkill -f \"vllm.entrypoints.openai.api_server.*--port ${PORT}\" 2>/dev/null && {\n  echo \"已清理同端口残留进程\"\n  sleep 3\n} || true\n\n> \"${LOG_FILE}\"\nmkdir -p \"${STORE_DIR}\"\n\necho \"Starting Ornith-1.5-35B-A3B (vllm-moet gate=1, 专家池全量RAM) on GPU ${GPU_DEVICE} port=${PORT} ...\"\necho \"  Config: TP1 | 专家池pinned RAM全量 + GPU 20GiB hot cache | GATE=1 strict | PREFETCH=1 | 1M ctx | max-seqs 8\"\n\n# ── DMA 方式: 专家池全量装载系统 RAM (host pinned base) + GPU hot-expert cache ──\nexport VLLM_MOE_W2_BASE_CACHE_GB=20      # GPU 侧 hot-expert cache 20GiB (专家池在主机 RAM)\nexport VLLM_MOE_W2_GATE=1                 # miss → 批量 pinned-H2D + graph replay (bit-identical)\nexport VLLM_MOE_W2_REPLAY_MODE=strict     # fail-closed: 不返回静默零贡献的 logits\nexport VLLM_MOE_W2_PREFETCH=1             # draft-affinity 预取, 压低 miss 率\nexport VLLM_MOE_W2_DELTA=0                # 关闭 FP4 delta tier (本模式专家池纯 host base)\nexport VLLM_MOE_W2_STORE_DIR=\"${STORE_DIR}/pack\"   # 盘上 pack: 量化持久化, 免二次重建\nexport VLLM_MOE_W2_BASE_RAM_GB=20         # pinned MRU arena over pack (arena 覆盖 = 全量专家池)\nexport VLLM_MOE_W2_BASE_MISS_TOL=0        # 默认 strict: 任何 miss 都 replay\n\n# ── 本脚本专属 (引擎共性已在 vllm_moet.conf) ────────────────────────────\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8,max_split_size_mb:512\"\nmkdir -p \"${HOME}/.cache/flashinfer\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" --served-model-name ornith-1.5 --trust-remote-code \\\n  --tensor-parallel-size 1 --disable-custom-all-reduce \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --kv-cache-dtype fp8 --block-size 256 \\\n  --max-model-len 1048576 --gpu-memory-utilization 0.97 \\\n  --max-num-batched-tokens 8192 --max-num-seqs 8 \\\n  --enable-prefix-caching \\\n  --enable-chunked-prefill \\\n  --limit-mm-per-prompt '{\"image\":0,\"video\":0}' \\\n  --compilation-config '{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"custom_ops\":[\"all\"]}' \\\n  > \"${LOG_FILE}\" 2>&1 &\n\n# 页缓存清理: 67GB checkpoint 读完即废, 滞留会让常驻阶段可用内存枯竭\nDROP_CKPT=/tmp/vllm-ornith-1.5-${PORT}-drop-ckpt\nrm -f \"${DROP_CKPT}\"\n( exec 9>&-; for i in $(seq 1 960); do\n    if [ ! -f \"${DROP_CKPT}\" ] && grep -qE \"checkpoint shards: 100%|Loading model weights took\" \"${LOG_FILE}\" 2>/dev/null; then\n      echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null 2>&1\n      echo \"[drop_caches] checkpoint $(date +%H:%M:%S)\" >> \"${LOG_FILE}\"\n      touch \"${DROP_CKPT}\"\n    fi\n    sleep 5\n  done ) &\n\nsleep 3\necho \"✅ http://localhost:${PORT}/v1 | Log: tail -f ${LOG_FILE}\"\necho \"   优化: TP1 | 专家池全量RAM+GPU20G hot cache | GATE=1 strict replay | PREFETCH=1 | KV fp8 | 1M ctx\"\n=== ornith_1.5_35b_a3b_vllm_rocm72_mi250x_tp4_256k.sh ===\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (MI250X GPU0-3, vLLM rocm7.2 wheel, TP4, 256k, AITER)\n# Desc: 由原系统版启动命令(存于 ~/ornith_serve_cmd.txt)迁移到 vllm_0.28.0_rocm72 环境。\n#   原参数逐字保留(--served-model-name ornith --language-model-only --max-model-len 8192\n#   --gpu-memory-utilization 0.85 --trust-remote-code --port 8000)，差异: TP 8→4；\n#   2026-09-03 更新: 启用 ROCm AITER 全家桶(主开关 VLLM_ROCM_USE_AITER=1，含 AITER MoE/\n#   RMSNorm/CUSTOM_AR)，并移除 --disable-custom-all-reduce 以放行定制 allreduce。\n#   2026-09-07 更新: ctx 8k→**256k**(MAX_MODEL_LEN=262144)。依据：config.json\n#   max_position_embeddings=262,144 ⇒ 原生上限内，无需 YaRN/外挂（CLAUDE.md §9 同族\n#   Flash-Next 已定稿 262,144；1M 判定被用户取消，见 docs/research-notes/{1M-上下文可行性,256k-上下文}-2026-09-07.md）。\n#   ⚠️ 改名后 beta 封装 serve_ornith_splitkv_ab.sh 的 LAUNCHER 路径与 LOGPAT 需同步（已同步）。\nset -euo pipefail\n\nAI_HOME=\"${AI_HOME:-/home/qiba/ai}\"\nVLLM_PYTHON=\"${VLLM_PYTHON:-${AI_HOME}/envs/vllm_0.28.0_rocm72/bin/python}\"\n\nROCM724=\"${ROCM724:-/opt/rocm-7.2.4}\"\nexport LD_LIBRARY_PATH=\"${ROCM724}/lib:${LD_LIBRARY_PATH:-}\"\nexport ROCM_PATH=\"${ROCM724}\"\nexport PATH=\"${ROCM724}/bin:${PATH}\"\n\n# --- ROCm AITER 加速路径 ---\nexport VLLM_ROCM_USE_AITER=\"${VLLM_ROCM_USE_AITER:-0}\"    # CDNA2(gfx90a) 被 vllm 硬门槛禁用(>2 才放行)\n\nPORT=\"${PORT:-8000}\"\nMODEL_PATH=\"${MODEL_PATH:-${AI_HOME}/models/ornith-ai/Ornith-1.5-35B-A3B}\"\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\nGPU_MEM_UTIL=\"${GPU_MEM_UTIL:-0.85}\"\nMAX_MODEL_LEN=\"${MAX_MODEL_LEN:-262144}\"   # 2026-09-07: 8192→262144（原生上限，见头部注释）\nTP=\"${TP:-4}\"\n\nexport HIP_VISIBLE_DEVICES=\"${HIP_VISIBLE_DEVICES:-0,1,2,3}\"\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8\"\nexport RAY_memory_monitor_refresh_ms=\"0\"\n\n# --- MI250X(gfx90a) P1+C2+C3（原生 env 已打补丁，2026-09-03 实测）---------------\n# P1 门控 GEMV：与 F.linear 逐位相同；Ornith TP4 单流 71.2 -> 85.3 t/s (+19.8%)。\n# C2/C3 QuickReduce：默认下限表 (bf16,4)=8MB 会把 decode 的 4-10KB 全 reduce 挡在门外，\n#   必须同时给 MIN_SIZE_BYTES_MB=0 才真上场；缺这行 = 设了 FP 也没用（我踩过）。\n#   实测增益 Ornith TP4 单流 +12.5% / 并发4 +24.9%；稠密 TP2 单流 +4.7% / 并发 +2.0%。\n#   数值：world=2 与 NCCL 逐位一致；world>=4 是求和顺序不同（平均误差与 NCCL 相等\n#   0.231 ULP、优劣对称 19/62/19），temp=0 的逐 token 输出会与旧基线不同 -> 基线需重跑。\nexport MI250_GATE_GEMV=\"${MI250_GATE_GEMV:-1}\"\nexport VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"${VLLM_ROCM_QUICK_REDUCE_QUANTIZATION:-FP}\"\nexport VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB=\"${VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB:-0}\"\nexport VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=\"${VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16:-0}\"\n\n# --- MI250X split-KV paged-decode（2026-09-07 转正，进生产默认开）---\n# 病根：现役 Triton 参考内核 grid 只有 (num_seqs, num_kv_heads) ⇒ 单流时 **1 个 program / 104 CU**，\n#       带宽恒定 7-12 GB/s（纯读峰 1171）。split-KV 把 KV 维切成 partition 作为 grid 第三维。\n# 实测收益（die0-3、同二进制两臂、只差这一个 env）：单流 @30720 ctx 13.1 -> 94.5 t/s（×7.22）；\n#       并发 8/32/64 的 Phase2 tok/s +1.39% / +1.83% / +0.20%，SE-Bench Phase1 逐项无回退。\n# 范围（**超出即走原路径，是设计不是遗漏**）：纯 decode(max_query_len==1) ∧ bf16 ∧ hd=256 ∧\n#       非2幂 block(528) ∧ kv_cache_dtype=auto ∧ 无 sliding_window/sinks/alibi ∧ num_seqs*kv_heads<=64。\n# ⚠️ 代价：分段 + log-sum-exp 归并改了求和顺序 ⇒ **破 temp=0 逐字可比性**（与上面 QuickReduce w>=4\n#       同类）。本模型历史基线全部作废：SE-Bench Phase2 新基线 = OFF 481.61 / ON 488.30 tok/s。\n# 证据：docs/research-notes/splitkv-{落地端到端,拐点与税收,转正许可证}-2026-09-0{7,8}.md\n# 正确性裁判：bench/pa256_golden.py（float32 独立手算）81 格全过，含 b=24/32/64 与 partition 边界±1。\n# ⚠️ **故意不设 VLLM_ROCM_SPLITKV_PA_MAX_SEQS**：门限唯一真值在内核 DEFAULT_MAX_SEQS=64；\n#    在这里再写一遍会制造\"两个真值来源\"（beta 封装里曾因此把 64 按回 16）。要改请改内核。\n# 关它（回退对照/排障）：VLLM_ROCM_SPLITKV_PA=0 bash <本脚本>\nexport VLLM_ROCM_SPLITKV_PA=\"${VLLM_ROCM_SPLITKV_PA:-1}\"\n# scratch 单 key 预算（内核 :676，默认 32 MiB/key）。本臂 256k 实测：seqs=16..64 七档全部被\n# `scratch 34078720..136314880 超预算` 打回 Triton——最小那次 **只超阈值 524,288 B（1.6%）**，\n# 最大 136,314,880 B=130 MiB。⇒ 与 27B 两臂统一抬到 192 MiB/key（130 + ~48% 余量；64/96 救不了\n# 本臂的 seqs≥32）。总基座仍受内核 MAX_TOTAL_MIB=192 MiB 约束（capture 从大到小 ⇒ hist≈0），\n# scratch 在 KV 池 sizing 后独立分配 ⇒ 不吃 KV 池（实测见 256k-上下文-2026-09-07.md §6）。\n# 一行回退：VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB=32 bash <本脚本>\nexport VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB=\"${VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB:-192}\"\n\nif nc -z 127.0.0.1 \"${PORT}\" 2>/dev/null; then\n  echo \"错误：端口 $PORT 已被占用\"; exit 1\nfi\n\n> \"${LOG_FILE}\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" \\\n  --served-model-name ornith \\\n  --language-model-only \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --tensor-parallel-size \"${TP}\" \\\n  --gpu-memory-utilization \"${GPU_MEM_UTIL}\" \\\n  --max-model-len \"${MAX_MODEL_LEN}\" \\\n  --enable-auto-tool-choice \\\n  --tool-call-parser qwen3_coder \\\n  --trust-remote-code \\\n  --no-use-tqdm-on-load \\\n  > \"${LOG_FILE}\" 2>&1 &\n\nsleep 1\necho \"✅ ornith-1.5-35b-a3b (MI250X GPU ${HIP_VISIBLE_DEVICES}, TP=${TP}, vLLM+AITER) http://localhost:${PORT}/v1\"\necho \"   AITER=1(moe/rmsnorm/mla/custom_ar) | ctx=${MAX_MODEL_LEN} | util=${GPU_MEM_UTIL} | 限功率400W/模组\"\necho \"   查看日志: tail -f ${LOG_FILE}\"\n\n=== ornith_1.5_35b_a3b_vllm_rocm72_mi250x_tp4_8k.sh ===\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (MI250X GPU0-3, vLLM rocm7.2 wheel, TP4, 8k, AITER)\n# Desc: 由原系统版启动命令(存于 ~/ornith_serve_cmd.txt)迁移到 vllm_0.28.0_rocm72 环境。\n#   原参数逐字保留(--served-model-name ornith --language-model-only --max-model-len 8192\n#   --gpu-memory-utilization 0.85 --trust-remote-code --port 8000)，差异: TP 8→4；\n#   2026-09-03 更新: 启用 ROCm AITER 全家桶(主开关 VLLM_ROCM_USE_AITER=1，含 AITER MoE/\n#   RMSNorm/CUSTOM_AR)，并移除 --disable-custom-all-reduce 以放行定制 allreduce。\nset -euo pipefail\n\nAI_HOME=\"${AI_HOME:-/mnt/nvme2t-samsung/ai}\"\nVLLM_PYTHON=\"${VLLM_PYTHON:-${AI_HOME}/envs/vllm_0.28.0_rocm72/bin/python}\"\n\nROCM724=\"${ROCM724:-/opt/rocm-7.2.4}\"\nexport LD_LIBRARY_PATH=\"${ROCM724}/lib:${LD_LIBRARY_PATH:-}\"\nexport ROCM_PATH=\"${ROCM724}\"\nexport PATH=\"${ROCM724}/bin:${PATH}\"\n\n# --- ROCm AITER 加速路径 ---\nexport VLLM_ROCM_USE_AITER=\"${VLLM_ROCM_USE_AITER:-0}\"    # CDNA2(gfx90a) 被 vllm 硬门槛禁用(>2 才放行)\n\nPORT=\"${PORT:-8000}\"\nMODEL_PATH=\"${MODEL_PATH:-${AI_HOME}/models/ornith-ai/Ornith-1.5-35B-A3B}\"\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\nGPU_MEM_UTIL=\"${GPU_MEM_UTIL:-0.85}\"\nMAX_MODEL_LEN=\"${MAX_MODEL_LEN:-8192}\"\nTP=\"${TP:-4}\"\n\nexport HIP_VISIBLE_DEVICES=\"${HIP_VISIBLE_DEVICES:-0,1,2,3}\"\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8\"\nexport RAY_memory_monitor_refresh_ms=\"0\"\n\n# --- MI250X(gfx90a) P1+C2+C3（原生 env 已打补丁，2026-09-03 实测）---------------\n# P1 门控 GEMV：与 F.linear 逐位相同；Ornith TP4 单流 71.2 -> 85.3 t/s (+19.8%)。\n# C2/C3 QuickReduce：默认下限表 (bf16,4)=8MB 会把 decode 的 4-10KB 全 reduce 挡在门外，\n#   必须同时给 MIN_SIZE_BYTES_MB=0 才真上场；缺这行 = 设了 FP 也没用（我踩过）。\n#   实测增益 Ornith TP4 单流 +12.5% / 并发4 +24.9%；稠密 TP2 单流 +4.7% / 并发 +2.0%。\n#   数值：world=2 与 NCCL 逐位一致；world>=4 是求和顺序不同（平均误差与 NCCL 相等\n#   0.231 ULP、优劣对称 19/62/19），temp=0 的逐 token 输出会与旧基线不同 -> 基线需重跑。\nexport MI250_GATE_GEMV=\"${MI250_GATE_GEMV:-1}\"\nexport VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"${VLLM_ROCM_QUICK_REDUCE_QUANTIZATION:-FP}\"\nexport VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB=\"${VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB:-0}\"\nexport VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=\"${VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16:-0}\"\n\nif nc -z 127.0.0.1 \"${PORT}\" 2>/dev/null; then\n  echo \"错误：端口 $PORT 已被占用\"; exit 1\nfi\n\n> \"${LOG_FILE}\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" \\\n  --served-model-name ornith \\\n  --language-model-only \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --tensor-parallel-size \"${TP}\" \\\n  --gpu-memory-utilization \"${GPU_MEM_UTIL}\" \\\n  --max-model-len \"${MAX_MODEL_LEN}\" \\\n  --enable-auto-tool-choice \\\n  --tool-call-parser qwen3_coder \\\n  --trust-remote-code \\\n  --no-use-tqdm-on-load \\\n  > \"${LOG_FILE}\" 2>&1 &\n\nsleep 1\necho \"✅ ornith-1.5-35b-a3b (MI250X GPU ${HIP_VISIBLE_DEVICES}, TP=${TP}, vLLM+AITER) http://localhost:${PORT}/v1\"\necho \"   AITER=1(moe/rmsnorm/mla/custom_ar) | ctx=${MAX_MODEL_LEN} | util=${GPU_MEM_UTIL} | 限功率400W/模组\"\necho \"   查看日志: tail -f ${LOG_FILE}\"","stderr":"\nShell cwd was reset to /home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-35B-A3B/20260914T094955Z-aa171c76/runs/specialist/d00cdedfc173451eaf5b312d08e00da9","interrupted":false,"isImage":false,"noOutputExpected":false}}
