{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_829ccdd48c30402f","type":"tool_result","content":"atom_mi300x.sh\natom_mi355x.sh\nmagpie_bench_remote_compat.sh\nserver_cleanup.sh\nsglang_mi300x.sh\nsglang_mi355x.sh\nvllm_mi300x.sh\nvllm_mi300x.sh.orig\nvllm_mi300x_mm.sh\nvllm_mi355x.sh\nvllm_mi355x_mm.sh\nxdit_bench_common.sh\nxdit_mi300x.sh\nxdit_mi355x.sh\n=== vllm_mi300x.sh ===\n     1\t#!/usr/bin/env bash\n     2\t###############################################################################\n     3\t# Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.\n     4\t#\n     5\t# See LICENSE for license information.\n     6\t###############################################################################\n     7\t\n     8\t# Magpie Generic vLLM Benchmark Script for MI300X\n     9\t#\n    10\t# Phases (via MAGPIE_RUN_PHASE): all | server | client (default all).\n    11\t# Server-only writes PID to MAGPIE_SERVER_PID_FILE then disowns and exits.\n    12\t#\n    13\t# Remote server (BENCHMARK_BASE_URL): when set, the client phase points\n    14\t# benchmark_serving at an external vLLM-compatible HTTP endpoint\n    15\t# instead of localhost:$PORT, and forces PHASE=client (no local server\n    16\t# launch, no server-side cleanup, no SERVER_PID monitoring). Use this\n    17\t# whenever the server is hosted off-pod (different node, different\n    18\t# cluster, externally managed). Leave the env unset to keep the\n    19\t# default behaviour of launching a local server.\n    20\t\n    21\tsource \"$(dirname \"$0\")/benchmark_lib.sh\"\n    22\tsource \"$(dirname \"$0\")/server_cleanup.sh\"\n    23\t# shellcheck source=magpie_bench_remote_compat.sh\n    24\t[[ -f \"$(dirname \"$0\")/magpie_bench_remote_compat.sh\" ]] && source \"$(dirname \"$0\")/magpie_bench_remote_compat.sh\"\n    25\t\n    26\tPHASE=\"${MAGPIE_RUN_PHASE:-all}\"\n    27\tcase \"$PHASE\" in\n    28\t  all|server|client) ;;\n    29\t  *) echo \"ERROR: Invalid MAGPIE_RUN_PHASE='$PHASE'. Must be all|server|client.\" >&2; exit 2 ;;\n    30\tesac\n    31\t\n    32\tif [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n    33\t  if [[ \"$PHASE\" != \"client\" ]]; then\n    34\t    echo \"[vllm_mi300x] BENCHMARK_BASE_URL set; forcing PHASE=client (was $PHASE)\"\n    35\t    PHASE=client\n    36\t  fi\n    37\tfi\n    38\t\n    39\tif [[ \"$PHASE\" == \"server\" || \"$PHASE\" == \"all\" ]]; then\n    40\t  check_env_vars MODEL TP\n    41\tfi\n    42\tif [[ \"$PHASE\" == \"client\" || \"$PHASE\" == \"all\" ]]; then\n    43\t  check_env_vars MODEL CONC ISL OSL RANDOM_RANGE_RATIO RESULT_FILENAME\n    44\tfi\n    45\t\n    46\tMAX_MODEL_LEN=${MAX_MODEL_LEN:-4096}\n    47\tGPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-0.95}\n    48\t\n    49\tif [[ -n \"$SLURM_JOB_ID\" ]]; then\n    50\t  echo \"JOB $SLURM_JOB_ID running on $SLURMD_NODENAME\"\n    51\tfi\n    52\t\n    53\tif [[ \"$PHASE\" != \"client\" ]]; then\n    54\t  hf download \"$MODEL\" 2>/dev/null || true\n    55\tfi\n    56\t\n    57\t# MI300X specific: Check MEC firmware version for RCCL memory reclaim\n    58\tversion=$(rocm-smi --showfw 2>/dev/null | grep MEC | head -n 1 | awk '{print $NF}')\n    59\tif [[ \"$version\" == \"\" || $version -lt 177 ]]; then\n    60\t  export HSA_NO_SCRATCH_RECLAIM=1\n    61\tfi\n    62\t\n    63\t# ROCR_VISIBLE_DEVICES already re-indexes visible GPUs to 0..N-1, so HIP\n    64\t# must use the logical range, not the original physical ids.\n    65\tif [ -n \"$ROCR_VISIBLE_DEVICES\" ] && [ -z \"$HIP_VISIBLE_DEVICES\" ]; then\n    66\t    n=$(echo \"$ROCR_VISIBLE_DEVICES\" | awk -F, '{print NF}')\n    67\t    export HIP_VISIBLE_DEVICES=$(seq -s, 0 $((n-1)))\n    68\tfi\n    69\t\n    70\t# vLLM optimizations for MI300X\n    71\t_aiter_default=1\n    72\tif /opt/rocm/bin/rocminfo 2>/dev/null | grep -q \"gfx90a\"; then _aiter_default=0; fi\n    73\texport VLLM_ROCM_USE_AITER=${VLLM_ROCM_USE_AITER:-$_aiter_default}\n    74\t\n    75\tWORKSPACE_DIR=${RESULT_DIR:-/workspace}\n    76\tSERVER_LOG=${SERVER_LOG:-$WORKSPACE_DIR/server.log}\n    77\tPORT=${PORT:-8888}\n    78\t\n    79\t# Build profiler args for vLLM >= 0.15 (env var VLLM_TORCH_PROFILER_DIR is deprecated)\n    80\tPROFILER_ARGS=()\n    81\tif [[ \"${PROFILE:-}\" == \"1\" ]]; then\n    82\t  TRACE_DIR=\"${VLLM_TORCH_PROFILER_DIR:-$WORKSPACE_DIR/torch_trace}\"\n    83\t  mkdir -p \"$TRACE_DIR\"\n    84\t  PROFILER_ARGS+=(--profiler-config.profiler torch)\n    85\t  PROFILER_ARGS+=(--profiler-config.torch_profiler_dir \"$TRACE_DIR\")\n    86\t  PROFILER_ARGS+=(--profiler-config.torch_profiler_record_shapes True)\n    87\t  PROFILER_ARGS+=(--profiler-config.torch_profiler_with_memory True)\n    88\t  PROFILER_ARGS+=(--profiler-config.torch_profiler_with_flops True)\n    89\t  PROFILER_ARGS+=(--profiler-config.torch_profiler_use_gzip True)\n    90\tfi\n    91\t\n    92\tset -x\n    93\tif [[ \"$PHASE\" == \"server\" || \"$PHASE\" == \"all\" ]]; then\n    94\t  setsid vllm serve $MODEL --port $PORT \\\n    95\t    --tensor-parallel-size=$TP \\\n    96\t    --gpu-memory-utilization 0.95 \\\n    97\t    --max-model-len $MAX_MODEL_LEN \\\n    98\t    --trust-remote-code \\\n    99\t    \"${PROFILER_ARGS[@]}\" \\\n   100\t    $EXTRA_VLLM_ARGS > $SERVER_LOG 2>&1 &\n   101\t\n   102\t  SERVER_PID=$!\n   103\t  if [[ \"$PHASE\" == \"all\" ]]; then\n   104\t    trap 'magpie_stop_benchmark_server_stack \"$SERVER_PID\"' EXIT INT TERM\n   105\t  fi\n   106\t\n   107\t  wait_for_server_ready --port \"$PORT\" --server-log \"$SERVER_LOG\" --server-pid \"$SERVER_PID\"\n   108\t\n   109\t  if [[ \"$PHASE\" == \"server\" ]]; then\n   110\t    if [[ -z \"${MAGPIE_SERVER_PID_FILE:-}\" ]]; then\n   111\t      echo \"ERROR: MAGPIE_SERVER_PID_FILE must be set for MAGPIE_RUN_PHASE=server\" >&2\n   112\t      kill -TERM \"-$SERVER_PID\" 2>/dev/null || true\n   113\t      exit 3\n   114\t    fi\n   115\t    printf '%s\\n' \"$SERVER_PID\" > \"$MAGPIE_SERVER_PID_FILE\"\n   116\t    disown \"$SERVER_PID\" 2>/dev/null || true\n   117\t    exit 0\n   118\t  fi\n   119\tfi\n   120\t\n   121\tSERVER_MONITOR_ARGS=()\n   122\tif [[ -n \"${SERVER_PID:-}\" ]]; then\n   123\t  SERVER_MONITOR_ARGS+=(--server-pid \"$SERVER_PID\")\n   124\tfi\n   125\t\n   126\tif [[ \"$PHASE\" == \"client\" || \"$PHASE\" == \"all\" ]]; then\n   127\t  if [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n   128\t    SERVER_MONITOR_ARGS=()\n   129\t    magpie_run_benchmark_serving_remote_direct trust || exit $?\n   130\t  else\n   131\t    run_benchmark_serving \\\n   132\t        --model \"$MODEL\" \\\n   133\t        --port \"$PORT\" \\\n   134\t        --backend vllm \\\n   135\t        --input-len \"$ISL\" \\\n   136\t        --output-len \"$OSL\" \\\n   137\t        --random-range-ratio \"$RANDOM_RANGE_RATIO\" \\\n   138\t        --num-prompts ${NUM_PROMPTS:-$(( $CONC * 10 ))} \\\n   139\t        --max-concurrency \"$CONC\" \\\n   140\t        --result-filename \"$RESULT_FILENAME\" \\\n   141\t        --result-dir \"$WORKSPACE_DIR/\" \\\n   142\t        \"${SERVER_MONITOR_ARGS[@]}\" \\\n   143\t        --trust-remote-code || exit $?\n   144\t  fi\n   145\tfi\n   146\t\n   147\t# After throughput, run evaluation only if RUN_EVAL is true\n   148\tif [[ \"$PHASE\" != \"server\" && \"${RUN_EVAL}\" = \"true\" ]]; then\n   149\t    if [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n   150\t        if declare -F magpie_run_eval_remote_direct &>/dev/null; then\n   151\t            magpie_run_eval_remote_direct || exit $?\n   152\t        else\n   153\t            echo \"[vllm_mi300x] RUN_EVAL=true with BENCHMARK_BASE_URL but magpie_run_eval_remote_direct shim not available; skipping eval (results gate will see accuracy=None).\"\n   154\t        fi\n   155\t    else\n   156\t        run_eval --framework lm-eval --port \"$PORT\" || exit $?\n   157\t        append_lm_eval_summary\n   158\t    fi\n   159\tfi\n   160\tset +x\n   161","is_error":false}]},"parent_tool_use_id":null,"session_id":"8f18108