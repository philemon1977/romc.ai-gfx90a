\nMAGPIE_BUILTIN_SCRIPTS = frozenset(\n    {\n        \"vllm_mi300x.sh\",\n        \"vllm_mi355x.sh\",\n        \"sglang_mi300x.sh\",\n        \"sglang_mi355x.sh\",\n        \"atom_mi300x.sh\",\n        \"atom_mi355x.sh\",\n    }\n)\n\n\nclass BenchmarkMode:","numLines":60,"startLine":1,"totalLines":1993}}}
{"type":"assistant","message":{"id":"msg_f7f6d143-3c08-404b-8dd0-fca35590b178","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call_99ae16e24db54b1a","name":"Edit","input":{"replace_all":false,"file_path":"/home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-35B-A3B/20260914T094955Z-aa171c76/runs/specialist/d00cdedfc173451eaf5b312d08e00da9/scratch/wt/Magpie/modes/benchmark/benchmarker.py","old_string":"# Scripts shipping with Magpie that honor MAGPIE_RUN_PHASE (server/client split).\nMAGPIE_BUILTIN_SCRIPTS = frozenset(\n    {\n        \"vllm_mi300x.sh\",\n        \"vllm_mi355x.sh\",\n        \"sglang_mi300x.sh\",\n        \"sglang_mi355x.sh\",\n        \"atom_mi300x.sh\",\n        \"atom_mi355x.sh\",\n    }\n)","new_string":"# Scripts shipping with Magpie that honor MAGPIE_RUN_PHASE (server/client split).\nMAGPIE_BUILTIN_SCRIPTS = frozenset(\n    {\n        \"vllm_mi300x.sh\",\n        \"vllm_mi355x.sh\",\n        \"sglang_mi300x.sh\",\n        \"sglang_mi355x.sh\",\n        \"atom_mi300x.sh\",\n        \"atom_mi355x.sh\",\n    }\n)\n\n# Device-selection env vars understood by the ROCm/CUDA stacks.\n_VISIBLE_DEVICE_VARS = (\"HIP_VISIBLE_DEVICES\", \"CUDA_VISIBLE_DEVICES\")\n\n\ndef align_rocm_visible_devices(env: Dict[str, str]) -> Dict[str, str]:\n    \"\"\"Make ``HIP``/``CUDA_VISIBLE_DEVICES`` logical indices of the ROCR set.\n\n    ``ROCR_VISIBLE_DEVICES`` filters at the HSA layer and *renumbers* the\n    agents that survive, so the devices that appear as HIP ids ``0..N-1`` are\n    the same physical GPUs that appear as ROCR ids ``0..N-1``. Any\n    ``HIP``/``CUDA`` id taken from a *host-physical* enumeration is therefore\n    meaningless once ``ROCR_VISIBLE_DEVICES`` is set: HIP filters the already\n    remapped ROCR list and, when no id survives, the process ends up with zero\n    usable devices (``torch.cuda.device_count()`` stays non-zero via ROCR's\n    count but every allocation fails with \"No CUDA GPUs are available\").\n\n    A launcher (e.g. a container entrypoint pinning a pod's cards) commonly\n    exports host-physical ``HIP_VISIBLE_DEVICES`` while Magpie's\n    ``gpu_selection`` pins ``ROCR_VISIBLE_DEVICES`` for the benchmark. Merge\n    the two here, at the single choke point every local benchmark/server phase\n    passes through, so the child sees a self-consistent set:\n\n    * ``ROCR_VISIBLE_DEVICES`` selects ``N >= 1`` devices -> the request is\n      satisfiable, so re-pin ``HIP``/``CUDA`` to the logical range ``0..N-1``.\n    * otherwise, or when the HIP set is already a subset of the ROCR logical\n      range -> leave the environment untouched.\n\n    An explicit ``benchmark.envs.HIP_VISIBLE_DEVICES``/\n    ``CUDA_VISIBLE_DEVICES`` in the config counts as a request that the caller\n    resolved themselves and is only rewritten when it cannot be satisfied.\n\n    Args:\n        env: Environment mapping to mutate in place.\n\n    Returns:\n        The same ``env`` mapping (so callers can use either style).\n    \"\"\"\n    rocr_raw = (env.get(\"ROCR_VISIBLE_DEVICES\") or \"\").strip()\n    if not rocr_raw:\n        return env\n    rocr_ids = [t.strip() for t in rocr_raw.split(\",\") if t.strip()]\n    if not rocr_ids:\n        return env\n    rocr_count = len(rocr_ids)\n    logical = {str(i) for i in range(rocr_count)}\n    derived = \",\".join(str(i) for i in range(rocr_count))\n\n    for var in _VISIBLE_DEVICE_VARS:\n        current = (env.get(var) or \"\").strip()\n        if not current:\n            continue\n        parts = [t.strip() for t in current.split(\",\") if t.strip()]\n        if parts and all(p in logical for p in parts):\n            # Already consistent with the ROCR renumbering — respect it as-is.\n            continue\n        logger.info(\n            \"%s=%r is not a logical index set of ROCR_VISIBLE_DEVICES=%r \"\n            \"(HSA renumbers the visible agents); re-pinning to %r so the \"\n            \"benchmark child actually sees the selected GPU(s).\",\n            var,\n            current,\n            rocr_raw,\n            derived,\n        )\n        env[var] = derived\n\n    return env"}}],"model":"qwen3.8-flash-next","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"8f181082-ed15-418f-a6d5-f6b9b40a6948","uuid":"38411086-5792-43c3-b66c-c138d2feb084"}
