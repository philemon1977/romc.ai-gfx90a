{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_896052a169d5dc25","type":"tool_result","content":"diff --git a/Magpie/modes/benchmark/image_selector.py b/Magpie/modes/benchmark/image_selector.py\nindex 8e0fceb..ac57538 100644\n--- a/Magpie/modes/benchmark/image_selector.py\n+++ b/Magpie/modes/benchmark/image_selector.py\n@@ -11,6 +11,7 @@ Selects appropriate Docker images based on framework and GPU architecture.\n \n import logging\n import os\n+import re\n from pathlib import Path\n from typing import Dict, Optional\n \n@@ -21,18 +22,41 @@ from ...utils.gpu import detect_gpu\n logger = logging.getLogger(__name__)\n \n \n+# Family aliases: an exact GPU architecture that has no dedicated entry in\n+# benchmark_images.yaml / the InferenceX runner table falls back to the\n+# closest supported family runner. This keeps generic (framework-agnostic)\n+# benchmark paths working on architectures that are ABI-compatible with a\n+# listed member of the family.\n+_ARCH_FAMILY_RUNNERS: Dict[str, str] = {\n+    # CDNA2 (MI50/MI100/MI210/MI250/MI250X) shares the mi300x script family.\n+    \"gfx90a\": \"mi300x\",\n+}\n+\n+\n+def _canonical_arch(gpu_arch: Optional[str]) -> Optional[str]:\n+    \"\"\"Strip target-feature suffixes from a ROCm arch triple.\n+\n+    e.g. ``\"gfx90a:sramecc+:xnack-\"`` -> ``\"gfx90a\"``, ``\"gfx942\"`` ->\n+    ``\"gfx942\"``. Returns ``None`` for empty/non-string input so callers can\n+    keep their existing \"unknown architecture\" handling.\n+    \"\"\"\n+    if not gpu_arch or not isinstance(gpu_arch, str):\n+        return None\n+    return gpu_arch.split(\":\", 1)[0].strip()\n+\n+\n class ImageSelector:\n     \"\"\"\n     Selects Docker images based on framework and GPU architecture.\n-    \n+\n     Loads image mappings from benchmark_images.yaml and provides\n     automatic selection based on detected GPU hardware.\n     \"\"\"\n-    \n+\n     def __init__(self, config_path: Optional[str] = None):\n         \"\"\"\n         Initialize the image selector.\n-        \n+\n         Args:\n             config_path: Path to benchmark_images.yaml. If None, uses default\n                         location relative to Magpie package.\n@@ -40,18 +64,18 @@ class ImageSelector:\n         if config_path is None:\n             # Default: Magpie/benchmark_images.yaml\n             config_path = str(Path(__file__).parent.parent.parent / \"benchmark_images.yaml\")\n-        \n+\n         self.config_path = config_path\n         self._mapping: Dict[str, Dict[str, str]] = {}\n         self._load_config()\n-    \n+\n     def _load_config(self) -> None:\n         \"\"\"Load image mapping configuration from YAML file.\"\"\"\n         if not os.path.exists(self.config_path):\n             logger.warning(f\"Image config not found: {self.config_path}, using empty mapping\")\n             self._mapping = {}\n             return\n-        \n+\n         try:\n             with open(self.config_path, 'r') as f:\n                 self._mapping = yaml.safe_load(f) or {}\n@@ -60,7 +84,7 @@ class ImageSelector:\n         except Exception as e:\n             logger.error(f\"Failed to load image config: {e}\")\n             self._mapping = {}\n-    \n+\n     def select_image(\n         self,\n         framework: str,\n@@ -69,16 +93,16 @@ class ImageSelector:\n     ) -> str:\n         \"\"\"\n         Select appropriate Docker image for benchmark.\n-        \n+\n         Args:\n             framework: Framework name (\"vllm\", \"sglang\", or \"atom\")\n-            gpu_arch: GPU architecture (e.g., \"gfx942\", \"sm_90\"). \n+            gpu_arch: GPU architecture (e.g., \"gfx942\", \"sm_90\").\n                      Auto-detected if not specified.\n             override_image: If provided, use this image instead of auto-selection\n-        \n+\n         Returns:\n             Docker image name\n-        \n+\n         Raises:\n             ValueError: If no suitable image found\n         \"\"\"\n@@ -86,16 +110,16 @@ cl