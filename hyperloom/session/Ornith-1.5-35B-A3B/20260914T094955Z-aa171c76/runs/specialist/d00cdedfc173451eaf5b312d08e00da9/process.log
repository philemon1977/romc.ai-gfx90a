{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8cf71c4b8241cee3","type":"tool_result","content":"=== image_selector.py ===\n     1\t###############################################################################\n     2\t# Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.\n     3\t#\n     4\t# See LICENSE for license information.\n     5\t###############################################################################\n     6\t\"\"\"\n     7\tImage selector for benchmark mode.\n     8\t\n     9\tSelects appropriate Docker images based on framework and GPU architecture.\n    10\t\"\"\"\n    11\t\n    12\timport logging\n    13\timport os\n    14\tfrom pathlib import Path\n    15\tfrom typing import Dict, Optional\n    16\t\n    17\timport yaml\n    18\t\n    19\tfrom ...utils.gpu import detect_gpu\n    20\t\n    21\tlogger = logging.getLogger(__name__)\n    22\t\n    23\t\n    24\tclass ImageSelector:\n    25\t    \"\"\"\n    26\t    Selects Docker images based on framework and GPU architecture.\n    27\t    \n    28\t    Loads image mappings from benchmark_images.yaml and provides\n    29\t    automatic selection based on detected GPU hardware.\n    30\t    \"\"\"\n    31\t    \n    32\t    def __init__(self, config_path: Optional[str] = None):\n    33\t        \"\"\"\n    34\t        Initialize the image selector.\n    35\t        \n    36\t        Args:\n    37\t            config_path: Path to benchmark_images.yaml. If None, uses default\n    38\t                        location relative to Magpie package.\n    39\t        \"\"\"\n    40\t        if config_path is None:\n    41\t            # Default: Magpie/benchmark_images.yaml\n    42\t            config_path = str(Path(__file__).parent.parent.parent / \"benchmark_images.yaml\")\n    43\t        \n    44\t        self.config_path = config_path\n    45\t        self._mapping: Dict[str, Dict[str, str]] = {}\n    46\t        self._load_config()\n    47\t    \n    48\t    def _load_config(self) -> None:\n    49\t        \"\"\"Load image mapping configuration from YAML file.\"\"\"\n    50\t        if not os.path.exists(self.config_path):\n    51\t            logger.warning(f\"Image config not found: {self.config_path}, using empty mapping\")\n    52\t            self._mapping = {}\n    53\t            return\n    54\t        \n    55\t        try:\n    56\t            with open(self.config_path, 'r') as f:\n    57\t                self._mapping = yaml.safe_load(f) or {}\n    58\t            logger.info(f\"Loaded image mapping from {self.config_path}\")\n    59\t            logger.debug(f\"Available frameworks: {list(self._mapping.keys())}\")\n    60\t        except Exception as e:\n    61\t            logger.error(f\"Failed to load image config: {e}\")\n    62\t            self._mapping = {}\n    63\t    \n    64\t    def select_image(\n    65\t        self,\n    66\t        framework: str,\n    67\t        gpu_arch: Optional[str] = None,\n    68\t        override_image: Optional[str] = None,\n    69\t    ) -> str:\n    70\t        \"\"\"\n    71\t        Select appropriate Docker image for benchmark.\n    72\t        \n    73\t        Args:\n    74\t            framework: Framework name (\"vllm\", \"sglang\", or \"atom\")\n    75\t            gpu_arch: GPU architecture (e.g., \"gfx942\", \"sm_90\"). \n    76\t                     Auto-detected if not specified.\n    77\t            override_image: If provided, use this image instead of auto-selection\n    78\t        \n    79\t        Returns:\n    80\t            Docker image name\n    81\t        \n    82\t        Raises:\n    83\t            ValueError: If no suitable image found\n    84\t        \"\"\"\n    85\t        # Use override if provided\n    86\t        if override_image:\n    87\t            logger.info(f\"Using override image: {override_image}\")\n    88\t            return override_image\n    89\t        \n    90\t        # Auto-detect GPU architecture if not provided\n    91\t        if gpu_arch is None:\n    92\t            vendor, detected_arch = detect_gpu()\n    93\t            gpu_arch = detected_arch\n    94\t            logger.info(f\"Auto-detected GPU: {vendor.name}, arch: {gpu_arch}\")\n    95\t        \n    96\t        # Normalize framework name\n    97\t        framework = framework.lower()\n    98\t        \n    99\t        # Get framework mapping\n   100\t        framework_mapping = self._mapping.get(framework, {})\n   101\t        if not framework_mapping:\n   102\t            raise ValueError(\n   103\t                f\"No image mapping found for framework '{framework}'. \"\n   104\t                f\"Available frameworks: {list(self._mapping.keys())}. \"\n   105\t                f\"Please add '{framework}' to {self.config_path}\"\n   106\t            )\n   107\t        \n   108\t        # Try to find image for the architecture\n   109\t        if gpu_arch and gpu_arch in framework_mapping:\n   110\t            image = framework_mapping[gpu_arch]\n   111\t            logger.info(f\"Selected image for {framework}/{gpu_arch}: {image}\")\n   112\t            return image\n   113\t        \n   114\t        # No matching architecture found - raise error\n   115\t        available_archs = list(framework_mapping.keys())\n   116\t        raise ValueError(\n   117\t            f\"No image found for GPU architecture '{gpu_arch}' with framework '{framework}'. \"\n   118\t            f\"Available architectures: {available_archs}. \"\n   119\t            f\"Please add '{gpu_arch}' to {self.config_path} or use --docker-image to override.\"\n   120\t        )\n   121\t    \n   122\t    def get_runner_type(self, gpu_arch: Optional[str] = None) -> str:\n   123\t        \"\"\"\n   124\t        Get InferenceX runner type based on GPU architecture.\n   125\t        \n   126\t        Args:\n   127\t            gpu_arch: GPU architecture. Auto-detected if not specified.\n   128\t        \n   129\t        Returns:\n   130\t            Runner type string (e.g., \"mi300x\", \"h100\")\n   131\t        \"\"\"\n   132\t        if gpu_arch is None:\n   133\t            _, gpu_arch = detect_gpu()\n   134\t        \n   135\t        # Map GPU architectures to runner types\n   136\t        arch_to_runner = {\n   137\t            # AMD GPUs\n   138\t            \"gfx942\": \"mi300x\",\n   139\t            \"gfx90a\": \"mi300x\",   # AMD MI250 (CDNA2)   # MI300X\n   140\t            \"gfx950\": \"mi355x\",   # MI355X\n   141\t            \"gfx1100\": \"mi325x\",  # MI325X\n   142\t            # NVIDIA GPUs\n   143\t            \"sm_80\": \"a100\",      # A100\n   144\t            \"sm_90\": \"h100\",      # H100\n   145\t            \"sm_90a\": \"h200\",     # H200\n   146\t            \"sm_100\": \"b200\",     # B200\n   147\t        }\n   148\t        \n   149\t        runner = arch_to_runner.get(gpu_arch, None)\n   150\t        if runner is None:\n   151\t            logger.warning(f\"No runner type found for {gpu_arch}\")\n   152\t            raise ValueError(f\"No runner type found for {gpu_arch}\")\n   153\t        logger.debug(f\"Runner type for {gpu_arch}: {runner}\")\n   154\t        return runner\n   155\t    \n   156\t    def list_available_images(self, framework: Optional[str] = None) -> Dict[str, Dict[str, str]]:\n   157\t        \"\"\"\n   158\t        List all available images.\n   159\t        \n   160\t        Args:\n   161\t            framework: Filter by framework name, or None for all\n   162\t        \n   163\t        Returns:\n   164\t            Dictionary of framework -> arch -> image mappings\n   165\t        \"\"\"\n   166\t        if framework:\n   167\t            return {framework: self._mapping.get(framework.lower(), {})}\n   168\t        return self._mapping.copy()\n\n=== benchmark_images.yaml ===\n# Benchmark Docker Image Mapping\n# Format: framework -> gpu_arch -> docker_image\n#\n# GPU Architecture Identifiers:\n#   AMD: gfx942 (MI300X), gfx950 (MI355X)\n#   NVIDIA: sm_80 (A100), sm_90 (H100/H200), sm_100 (B200)\n#\n# Usage:\n#   ImageSelector automatically selects the appropriate image based on detected GPU.\n#   If the architecture is not found, an error will be raised.\n\nvllm:\n  # AMD GPUs\n  gfx942: \"vllm/vllm-openai-rocm:v0.19.1\"\n  gfx950: \"vllm/vllm-openai-rocm:v0.19.1\"\n  # NVIDIA GPUs\n  sm_80: \"vllm/vllm-openai:v0.19.1\"\n  sm_90: \"vllm/vllm-openai:v0.19.1\"\n  sm_100: \"vllm/vllm-openai:v0.19.1\"\n\nsglang:\n  # AMD GPUs\n  gfx942: \"lmsysorg/sglang:v0.5.12-rocm720-mi30x\"\n  gfx950: \"lmsysorg/sglang:v0.5.12-rocm720-mi35x\"\n  # NVIDIA GPUs\n  sm_80: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n  sm_90: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n  sm_100: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n\n# Atom exposes an OpenAI-compatible HTTP server (atom.entrypoints.openai_server)\n# that is wire-compatible with vLLM, so the bench client reuses --backend vllm.\n# Pin a specific tag via --docker-image when reproducibility matters.\n#\n# Atom is AMD-only: there is no NVIDIA/CUDA atom build, so no sm_* entries are\n# listed. Requesting atom on an NVIDIA arch raises an error in ImageSelector\n# rather than silently falling back to a vLLM image that cannot run the atom\n# server.\natom:\n  # AMD GPUs\n  gfx942: \"rocm/atom:latest\"\n  gfx950: \"rocm/atom:latest\"\n\n# NOTE: xDiT is intentionally NOT listed here. It is a server-less (scriptable)\n# diffusion workload that runs natively via the `xdit` CLI (no Docker image), so\n# this file stays a pure Docker-image mapping. BenchmarkConfig enforces\n# run_mode=local for framework=xdit instead.","is_error":false}]},"parent_tool_use_id":null,"session_id":"8f181082-ed15-418f-a6d5-f6b9b40a6948","uuid":"4cc81eec-4205-4b99-bdf2-04936529975a","timestamp":"2026-09-14T10:57:48.360Z","tool_use_result":{"stdout":"=== image_selector.py ===\n     1\t###############################################################################\n     2\t# Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.\n     3\t#\n     4\t# See LICENSE for license information.\n     5\t###############################################################################\n     6\t\"\"\"\n     7\tImage selector for benchmark mode.\n     8\t\n     9\tSelects appropriate Docker images based on framework and GPU architecture.\n    10\t\"\"\"\n    11\t\n    12\timport logging\n    13\timport os\n    14\tfrom pathlib import Path\n    15\tfrom typing import Dict, Optional\n    16\t\n    17\timport yaml\n    18\t\n    19\tfrom ...utils.gpu import detect_gpu\n    20\t\n    21\tlogger = logging.getLogger(__name__)\n    22\t\n    23\t\n    24\tclass ImageSelector:\n    25\t    \"\"\"\n    26\t    Selects Docker images based on framework and GPU architecture.\n    27\t    \n    28\t    Loads image mappings from benchmark_images.yaml and provides\n    29\t    automatic selection based on detected GPU hardware.\n    30\t    \"\"\"\n    31\t    \n    32\t    def __init__(self, config_path: Optional[str] = None):\n    33\t        \"\"\"\n    34\t        Initialize the image selector.\n    35\t        \n    36\t        Args:\n    37\t            config_path: Path to benchmark_images.yaml. If None, uses default\n    38\t                        location relative to Magpie package.\n    39\t        \"\"\"\n    40\t        if config_path is None:\n    41\t            # Default: Magpie/benchmark_images.yaml\n    42\t            config_path = str(Path(__file__).parent.parent.parent / \"benchmark_images.yaml\")\n    43\t        \n    44\t        self.config_path = config_path\n    45\t        self._mapping: Dict[str, Dict[str, str]] = {}\n    46\t        self._load_config()\n    47\t    \n    48\t    def _load_config(self) -> None:\n    49\t        \"\"\"Load image mapping configuration from YAML file.\"\"\"\n    50\t        if not os.path.exists(self.config_path):\n    51\t            logger.warning(f\"Image config not found: {self.config_path}, using empty mapping\")\n    52\t            self._mapping = {}\n    53\t            return\n    54\t        \n    55\t        try:\n    56\t            with open(self.config_path, 'r') as f:\n    57\t                self._mapping = yaml.safe_load(f) or {}\n    58\t            logger.info(f\"Loaded image mapping from {self.config_path}\")\n    59\t            logger.debug(f\"Available frameworks: {list(self._mapping.keys())}\")\n    60\t        except Exception as e:\n    61\t            logger.error(f\"Failed to load image config: {e}\")\n    62\t            self._mapping = {}\n    63\t    \n    64\t    def select_image(\n    65\t        self,\n    66\t        framework: str,\n    67\t        gpu_arch: Optional[str] = None,\n    68\t        override_image: Optional[str] = None,\n    69\t    ) -> str:\n    70\t        \"\"\"\n    71\t        Select appropriate Docker image for benchmark.\n    72\t        \n    73\t        Args:\n    74\t            framework: Framework name (\"vllm\", \"sglang\", or \"atom\")\n    75\t            gpu_arch: GPU architecture (e.g., \"gfx942\", \"sm_90\"). \n    76\t                     Auto-detected if not specified.\n    77\t            override_image: If provided, use this image instead of auto-selection\n    78\t        \n    79\t        Returns:\n    80\t            Docker image name\n    81\t        \n    82\t        Raises:\n    83\t            ValueError: If no suitable image found\n    84\t        \"\"\"\n    85\t        # Use override if provided\n    86\t        if override_image:\n    87\t            logger.info(f\"Using override image: {override_image}\")\n    88\t            return override_image\n    89\t        \n    90\t        # Auto-detect GPU architecture if not provided\n    91\t        if gpu_arch is None:\n    92\t            vendor, detected_arch = detect_gpu()\n    93\t            gpu_arch = detected_arch\n    94\t            logger.info(f\"Auto-detected GPU: {vendor.name}, arch: {gpu_arch}\")\n    95\t        \n    96\t        # Normalize framework name\n    97\t        framework = framework.lower()\n    98\t        \n    99\t        # Get framework mapping\n   100\t        framework_mapping = self._mapping.get(framework, {})\n   101\t        if not framework_mapping:\n   102\t            raise ValueError(\n   103\t                f\"No image mapping found for framework '{framework}'. \"\n   104\t                f\"Available frameworks: {list(self._mapping.keys())}. \"\n   105\t                f\"Please add '{framework}' to {self.config_path}\"\n   106\t            )\n   107\t        \n   108\t        # Try to find image for the architecture\n   109\t        if gpu_arch and gpu_arch in framework_mapping:\n   110\t            image = framework_mapping[gpu_arch]\n   111\t            logger.info(f\"Selected image for {framework}/{gpu_arch}: {image}\")\n   112\t            return image\n   113\t        \n   114\t        # No matching architecture found - raise error\n   115\t        available_archs = list(framework_mapping.keys())\n   116\t        raise ValueError(\n   117\t            f\"No image found for GPU architecture '{gpu_arch}' with framework '{framework}'. \"\n   118\t            f\"Available architectures: {available_archs}. \"\n   119\t            f\"Please add '{gpu_arch}' to {self.config_path} or use --docker-image to override.\"\n   120\t        )\n   121\t    \n   122\t    def get_runner_type(self, gpu_arch: Optional[str] = None) -> str:\n   123\t        \"\"\"\n   124\t        Get InferenceX runner type based on GPU architecture.\n   125\t        \n   126\t        Args:\n   127\t            gpu_arch: GPU architecture. Auto-detected if not specified.\n   128\t        \n   129\t        Returns:\n   130\t            Runner type string (e.g., \"mi300x\", \"h100\")\n   131\t        \"\"\"\n   132\t        if gpu_arch is None:\n   133\t            _, gpu_arch = detect_gpu()\n   134\t        \n   135\t        # Map GPU architectures to runner types\n   136\t        arch_to_runner = {\n   137\t            # AMD GPUs\n   138\t            \"gfx942\": \"mi300x\",\n   139\t            \"gfx90a\": \"mi300x\",   # AMD MI250 (CDNA2)   # MI300X\n   140\t            \"gfx950\": \"mi355x\",   # MI355X\n   141\t            \"gfx1100\": \"mi325x\",  # MI325X\n   142\t            # NVIDIA GPUs\n   143\t            \"sm_80\": \"a100\",      # A100\n   144\t            \"sm_90\": \"h100\",      # H100\n   145\t            \"sm_90a\": \"h200\",     # H200\n   146\t            \"sm_100\": \"b200\",     # B200\n   147\t        }\n   148\t        \n   149\t        runner = arch_to_runner.get(gpu_arch, None)\n   150\t        if runner is None:\n   151\t            logger.warning(f\"No runner type found for {gpu_arch}\")\n   152\t            raise ValueError(f\"No runner type found for {gpu_arch}\")\n   153\t        logger.debug(f\"Runner type for {gpu_arch}: {runner}\")\n   154\t        return runner\n   155\t    \n   156\t    def list_available_images(self, framework: Optional[str] = None) -> Dict[str, Dict[str, str]]:\n   157\t        \"\"\"\n   158\t        List all available images.\n   159\t        \n   160\t        Args:\n   161\t            framework: Filter by framework name, or None for all\n   162\t        \n   163\t        Returns:\n   164\t            Dictionary of framework -> arch -> image mappings\n   165\t        \"\"\"\n   166\t        if framework:\n   167\t            return {framework: self._mapping.get(framework.lower(), {})}\n   168\t        return self._mapping.copy()\n\n=== benchmark_images.yaml ===\n# Benchmark Docker Image Mapping\n# Format: framework -> gpu_arch -> docker_image\n#\n# GPU Architecture Identifiers:\n#   AMD: gfx942 (MI300X), gfx950 (MI355X)\n#   NVIDIA: sm_80 (A100), sm_90 (H100/H200), sm_100 (B200)\n#\n# Usage:\n#   ImageSelector automatically selects the appropriate image based on detected GPU.\n#   If the architecture is not found, an error will be raised.\n\nvllm:\n  # AMD GPUs\n  gfx942: \"vllm/vllm-openai-rocm:v0.19.1\"\n  gfx950: \"vllm/vllm-openai-rocm:v0.19.1\"\n  # NVIDIA GPUs\n  sm_80: \"vllm/vllm-openai:v0.19.1\"\n  sm_90: \"vllm/vllm-openai:v0.19.1\"\n  sm_100: \"vllm/vllm-openai:v0.19.1\"\n\nsglang:\n  # AMD GPUs\n  gfx942: \"lmsysorg/sglang:v0.5.12-rocm720-mi30x\"\n  gfx950: \"lmsysorg/sglang:v0.5.12-rocm720-mi35x\"\n  # NVIDIA GPUs\n  sm_80: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n  sm_90: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n  sm_100: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n\n# Atom exposes an OpenAI-compatible HTTP server (atom.entrypoints.openai_server)\n# that is wire-compatible with vLLM, so the bench client reuses --backend vllm.\n# Pin a specific tag via --docker-image when reproducibility matters.\n#\n# Atom is AMD-only: there is no NVIDIA/CUDA atom build, so no sm_* entries are\n# listed. Requesting atom on an NVIDIA arch raises an error in ImageSelector\n# rather than silently falling back to a vLLM image that cannot run the atom\n# server.\natom:\n  # AMD GPUs\n  gfx942: \"rocm/atom:latest\"\n  gfx950: \"rocm/atom:latest\"\n\n# NOTE: xDiT is intentionally NOT listed here. It is a server-less (scriptable)\n# diffusion workload that runs natively via the `xdit` CLI (no Docker image), so\n# this file stays a pure Docker-image mapping. BenchmarkConfig enforces\n# run_mode=local for framework=xdit instead.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
