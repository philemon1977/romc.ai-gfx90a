+# Family aliases: an exact GPU architecture that has no dedicated entry in
+# benchmark_images.yaml / the InferenceX runner table falls back to the
+# closest supported family runner. This keeps generic (framework-agnostic)
+# benchmark paths working on architectures that are ABI-compatible with a
+# listed member of the family.
+_ARCH_FAMILY_RUNNERS: Dict[str, str] = {
+    # CDNA2 (MI50/MI100/MI210/MI250/MI250X) shares the mi300x script family.
+    "gfx90a": "mi300x",
+}
+
+
+def _canonical_arch(gpu_arch: Optional[str]) -> Optional[str]:
+    """Strip target-feature suffixes from a ROCm arch triple.
+
+    e.g. ``"gfx90a:sramecc+:xnack-"`` -> ``"gfx90a"``, ``"gfx942"`` ->
+    ``"gfx942"``. Returns ``None`` for empty/non-string input so callers can
+    keep their existing "unknown architecture" handling.
+    """
+    if not gpu_arch or not isinstance(gpu_arch, str):
+        return None
+    return gpu_arch.split(":", 1)[0].strip()
