{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_96964e1624bbf671","type":"tool_result","content":"The file /home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-35B-A3B/20260914T094955Z-aa171c76/runs/specialist/78b25f2832ff45ff949ad9c0e9634cf3/scratch/image_selector.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"4dfdd16c-24f2-4b3c-b837-5064eb80c149","uuid":"fa1c9ac0-4454-40dd-8fe9-822efa710c4e","timestamp":"2026-09-14T09:57:39.619Z","tool_use_result":{"filePath":"/home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-35B-A3B/20260914T094955Z-aa171c76/runs/specialist/78b25f2832ff45ff949ad9c0e9634cf3/scratch/image_selector.py","oldString":"import logging\nimport os\nimport re\nfrom pathlib import Path","newString":"import logging\nimport os\nfrom pathlib import Path","originalFile":"###############################################################################\n# Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.\n#\n# See LICENSE for license information.\n###############################################################################\n\"\"\"\nImage selector for benchmark mode.\n\nSelects appropriate Docker images based on framework and GPU architecture.\n\"\"\"\n\nimport logging\nimport os\nimport re\nfrom pathlib import Path\nfrom typing import Dict, Optional\n\nimport yaml\n\nfrom ...utils.gpu import detect_gpu\n\nlogger = logging.getLogger(__name__)\n\n\n# Family aliases: an exact GPU architecture that has no dedicated entry in\n# benchmark_images.yaml / the InferenceX runner table falls back to the\n# closest supported family runner. This keeps generic (framework-agnostic)\n# benchmark paths working on architectures that are ABI-compatible with a\n# listed member of the family.\n_ARCH_FAMILY_RUNNERS: Dict[str, str] = {\n    # CDNA2 (MI50/MI100/MI210/MI250/MI250X) shares the mi300x script family.\n    \"gfx90a\": \"mi300x\",\n}\n\n\ndef _canonical_arch(gpu_arch: Optional[str]) -> Optional[str]:\n    \"\"\"Strip target-feature suffixes from a ROCm arch triple.\n\n    e.g. ``\"gfx90a:sramecc+:xnack-\"`` -> ``\"gfx90a\"``, ``\"gfx942\"`` ->\n    ``\"gfx942\"``. Returns ``None`` for empty/non-string input so callers can\n    keep their existing \"unknown architecture\" handling.\n    \"\"\"\n    if not gpu_arch or not isinstance(gpu_arch, str):\n        return None\n    return gpu_arch.split(\":\", 1)[0].strip()\n\n\nclass ImageSelector:\n    \"\"\"\n    Selects Docker images based on framework and GPU architecture.\n\n    Loads image mappings from benchmark_images.yaml and provides\n    automatic selection based on detected GPU hardware.\n    \"\"\"\n\n    def __init__(self, config_path: Optional[str] = None):\n        \"\"\"\n        Initialize the image selector.\n\n        Args:\n            config_path: Path to benchmark_images.yaml. If None, uses default\n                        location relative to Magpie package.\n        \"\"\"\n        if config_path is None:\n            # Default: Magpie/benchmark_images.yaml\n            config_path = str(Path(__file__).parent.parent.parent / \"benchmark_images.yaml\")\n\n        self.config_path = config_path\n        self._mapping: Dict[str, Dict[str, str]] = {}\n        self._load_config()\n\n    def _load_config(self) -> None:\n        \"\"\"Load image mapping configuration from YAML file.\"\"\"\n        if not os.path.exists(self.config_path):\n            logger.warning(f\"Image config not found: {self.config_path}, using empty mapping\")\n            self._mapping = {}\n            return\n\n        try:\n            with open(self.config_path, 'r') as f:\n                self._mapping = yaml.safe_load(f) or {}\n            logger.info(f\"Loaded image mapping from {self.config_path}\")\n            logger.debug(f\"Available frameworks: {list(self._mapping.keys())}\")\n        except Exception as e:\n            logger.error(f\"Failed to load image config: {e}\")\n            self._mapping = {}\n\n    def select_image(\n        self,\n        framework: str,\n        gpu_arch: Optional[str] = None,\n        override_image: Optional[str] = None,\n    ) -> str:\n        \"\"\"\n        Select appropriate Docker image for benchmark.\n\n        Args:\n            framework: Framework name (\"vllm\", \"sglang\", or \"atom\")\n            gpu_arch: GPU architecture (e.g., \"gfx942\", \"sm_90\").\n                     Auto-detected if not specified.\n            override_image: If provided, use this image instead of auto-selection\n\n        Returns:\n            Docker image name\n\n        Raises:\n            ValueError: If no suitable image found\n        \"\"\"\n        # Use override if provided\n        if override_image:\n            logger.info(f\"Using override image: {override_image}\")\n            return override_image\n\n        # Auto-detect GPU architecture if not provided\n        if gpu_arch is None:\n            vendor, detected_arch = detect_gpu()\n            gpu_arch = detected_arch\n            logger.info(f\"Auto-detected GPU: {vendor.name}, arch: {gpu_arch}\")\n\n        # Normalize framework name\n        framework = framework.lower()\n\n        # Get framework mapping\n        framework_mapping = self._mapping.get(framework, {})\n        if not framework_mapping:\n            raise ValueError(\n                f\"No image mapping found for framework '{framework}'. \"\n                f\"Available frameworks: {list(self._mapping.keys())}. \"\n                f\"Please add '{framework}' to {self.config_path}\"\n            )\n\n        # Try to find image for the architecture (accept a bare or\n        # target-feature-triple form, e.g. \"gfx90a:sramecc+:xnack-\")\n        candidates = self._arch_lookup_keys(gpu_arch)\n        for key in candidates:\n            if key in framework_mapping:\n                image = framework_mapping[key]\n                logger.info(f\"Selected image for {framework}/{key}: {image}\")\n                return image\n\n        # No matching architecture found - raise error\n        available_archs = list(framework_mapping.keys())\n        raise ValueError(\n            f\"No image found for GPU architecture '{gpu_arch}' with framework '{framework}'. \"\n            f\"Available architectures: {available_archs}. \"\n            f\"Please add '{gpu_arch}' to {self.config_path} or use --docker-image to override.\"\n        )\n\n    @staticmethod\n    def _arch_lookup_keys(gpu_arch: Optional[str]) -> list:\n        \"\"\"Return the ordered set of mapping keys to try for ``gpu_arch``.\"\"\"\n        if not gpu_arch or not isinstance(gpu_arch, str):\n            return []\n        keys = [gpu_arch]\n        canonical = _canonical_arch(gpu_arch)\n        if canonical and canonical not in keys:\n            keys.append(canonical)\n        return keys\n\n    def get_runner_type(self, gpu_arch: Optional[str] = None) -> str:\n        \"\"\"\n        Get InferenceX runner type based on GPU architecture.\n\n        Args:\n            gpu_arch: GPU architecture. Auto-detected if not specified.\n\n        Returns:\n            Runner type string (e.g., \"mi300x\", \"h100\")\n\n        Raises:\n            ValueError: If the architecture is unknown and has no family alias.\n        \"\"\"\n        if gpu_arch is None:\n            _, gpu_arch = detect_gpu()\n\n        # Map GPU architectures to runner types\n        arch_to_runner = {\n            # AMD GPUs\n            \"gfx942\": \"mi300x\",   # MI300X\n            \"gfx950\": \"mi355x\",   # MI355X\n            \"gfx1100\": \"mi325x\",  # MI325X\n            # NVIDIA GPUs\n            \"sm_80\": \"a100\",      # A100\n            \"sm_90\": \"h100\",      # H100\n            \"sm_90a\": \"h200\",     # H200\n            \"sm_100\": \"b200\",     # B200\n        }\n\n        for key in self._arch_lookup_keys(gpu_arch):\n            runner = arch_to_runner.get(key)\n            if runner is not None:\n                logger.debug(f\"Runner type for {key}: {runner}\")\n                return runner\n\n        # Exact-entry miss: fall back to the CDNA/CI family alias table so\n        # architectures without a dedicated InferenceX runner (e.g. gfx90a /\n        # MI250X on the CDNA2 line) still resolve to the closest maintained\n        # generic script family.\n        canonical = _canonical_arch(gpu_arch)\n        if canonical is not None:\n            family_runner = _ARCH_FAMILY_RUNNERS.get(canonical)\n            if family_runner is not None:\n                logger.info(\n                    \"No dedicated InferenceX runner for %s; using family \"\n                    \"runner '%s' (generic benchmark path).\",\n                    gpu_arch,\n                    family_runner,\n                )\n                return family_runner\n\n        logger.warning(f\"No runner type found for {gpu_arch}\")\n        raise ValueError(f\"No runner type found for {gpu_arch}\")\n\n    def list_available_images(self, framework: Optional[str] = None) -> Dict[str, Dict[str, str]]:\n        \"\"\"\n        List all available images.\n\n        Args:\n            framework: Filter by framework name, or None for all\n\n        Returns:\n            Dictionary of framework -> arch -> image mappings\n        \"\"\"\n        if framework:\n            return {framework: self._mapping.get(framework.lower(), {})}\n        return self._mapping.copy()\n","structuredPatch":[{"oldStart":11,"oldLines":7,"newStart":11,"newLines":6,"lines":[" "," import logging"," import os","-import re"," from pathlib import Path"," from typing import Dict, Optional"," "]}],"userModified":false,"replaceAll":false}}
