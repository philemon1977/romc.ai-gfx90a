lid rgba(128, 128, 128, 0.15)\">29.4</td>\n<td style=\"padding:7px 7px;text-align:center;border-bottom:1px solid rgba(128, 128, 128, 0.15)\">15.5</td>\n<td style=\"padding:7px 7px;text-align:center;border-bottom:1px solid rgba(128, 128, 128, 0.15)\">-</td>\n<td style=\"padding:7px 7px;text-align:center;border-bottom:1px solid rgba(128, 128, 128, 0.15)\">36.8</td>\n</tr>\n<tr>\n<td style=\"padding:7px 7px;padding-left:20px;border-bottom:1px solid rgba(128, 128, 128, 0.15);\">SWE Atlas - QnA</td>\n<td style=\"padding:7px 7px;text-align:center;border-bottom:1px solid rgba(128, 128, 128, 0.15);font-weight:600;color:#FD8E5B;background:rgba(253, 142, 91, 0.06)\">39.8</td>\n<td style=\"padding:7px 7px;text-align:center;border-bottom:1px solid rgba(128, 128, 128, 0.15)\">37.1</td>\n<td style=\"padding:7px 7px;text-align:center;border-bottom:1px solid rgba(128, 128, 128, 0.15)\">15.5</td>\n<td style=\"padding:7px 7px;text-align:center;border-bottom:1px solid rgba(128, 128, 128, 0.15)\">-</td>\n==== LAUNCHER DIR ====\ntotal 47\ndrwxr-xr-x 2 ubuntu ubuntu    5 Sep  9 09:27 .\ndrwxr-xr-x 5 ubuntu ubuntu    5 Sep 11 17:00 ..\n-rwxr-xr-x 1 ubuntu ubuntu 6145 Sep  9 09:20 ornith1.5_35b_a3b_vllm-moet_gate1_1m_8107_5090.sh\n-rwxr-xr-x 1 ubuntu ubuntu 6234 Sep  9 09:27 ornith_1.5_35b_a3b_vllm_rocm72_mi250x_tp4_256k.sh\n-rwxr-xr-x 1 ubuntu ubuntu 3369 Sep  9 09:20 ornith_1.5_35b_a3b_vllm_rocm72_mi250x_tp4_8k.sh\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (5090 单卡) — vllm-moet gate=1, 专家池全量驻留系统RAM (DMA)\n# Description: Ornith-1.5-35B-A3B (qwen3_5_moe 底座, 67GB BF16, 256专家/8激活,\n#   40层: 30层 linear_attn + 10层 full_attn) 在 RTX 5090 (32GB, GPU index 2)\n#   单卡 vllm027-moet (0.27.1 + Moet 补丁) 上 DMA 方式部署 = 专家池全量装载\n#   系统 RAM (host-side pinned base), GPU 只留 hot-expert cache:\n#   - BASE_CACHE_GB=20: 2-bit 专家 base 全量 pinned 主机 RAM (~20GB, 主机\n#     184GB 可承受), GPU 侧仅 20GiB hot-expert cache\n#   - GATE=1: cache miss → gate 批量 pinned-H2D 抓取 + graph replay\n#     (bit-identical, strict 模式 fail-closed, 绝不静默零贡献)\n#   - PREFETCH=1: draft-affinity 预取 (token→expert 亲和表), 压低 miss 率\n#     (README 实测: ~19% 覆盖服务 ~96% 路由; A3B 每 token 仅 8 专家, 路由更集中)\n#   - STORE_DIR 盘上 pack: 量化结果持久化, 二次启动跳过 67GB 反量化重建\n#   - 上下文 1M: 原生 max_position_embeddings=262144 (256K), 靠\n#     VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 (vllm_moet.conf 已设) 允许\n#     --max-model-len 1048576 覆盖 (full_attn 仅 10/40 层, KV 压力有限)\n# KPI: 启动日志关注 \"[base] KPI: replay X% of last N steps\" (KPI_EVERY=20):\n#   replay 高 → 增大 BASE_CACHE_GB 或显 BASE_MISS_TOL (默认 0 = strict)\nset -euo pipefail\n\n# ── GPU & CUDA (单卡 5090 = index 2) ────────────────────────────────────\nsource ${AI_SERVER_HOME:-/mnt/nvme4t/ai}/config/gpu_5090.conf\n\n# ── 引擎共性 (vllm027-moet python + MOE_W2 共性) ────────────────────────\nsource ${AI_SERVER_HOME:-/mnt/nvme4t/ai}/config/vllm_moet.conf\n\n# ── 功率限制 (加载 67GB 权重时防 5090 满载掉电/显示引擎 hang, 默认 450W) ──\nGPU_POWER_LIMIT=\"${GPU_POWER_LIMIT:-450}\"\n_gpu=${GPU_DEVICE}\n_min=$(nvidia-smi -i \"${_gpu}\" --query-gpu=power.min_limit --format=csv,noheader,nounits 2>/dev/null | tr -d ' ' | cut -d. -f1)\n_target=$(( GPU_POWER_LIMIT > _min ? GPU_POWER_LIMIT : _min ))\nif sudo -n nvidia-smi -i \"${_gpu}\" -pl \"${_target}\" >/dev/null 2>&1; then\n  echo \"GPU ${_gpu}: 功率上限 ${_target}W\"\nelse\n  echo \"警告: GPU ${_gpu} 功率限制失败 (需 root 免密 sudo)\"\nfi\n\n# ── 端口 ────────────────────────────────────────────────────────────────\nPORT=\"${PORT:-8107}\"   # 一底座一端口: ornith-1.5 (8101=qwen3.8 / 8102=qwen3.6 / 8103=dsv4 / 8104=gemma4 / 8105=web-watcher / 8106=muse-glimmer)\n\n# 防重复启动\nexec 9>/tmp/vllm-ornith-1.5-${PORT}.lock\nflock -n 9 || { echo \"错误: 已有实例在运行 (flock 拒绝)\"; exit 1; }\n\nMODEL_PATH=${AI_SERVER_HOME:-/mnt/nvme4t/ai}/models/ornith-ai/Ornith-1.5-35B-A3B\nSTORE_DIR=${AI_SERVER_HOME:-/mnt/nvme4t/ai}/cache/moet-pack-ornith-1.5\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\n\nif ss -tlnp 2>/dev/null | grep -q \":${PORT} \"; then\n  echo \"错误: 端口 ${PORT} 已被占用\"; exit 1\nfi\n\n# 防僵尸残留: 清掉同端口残留 vllm 进程\npkill -f \"vllm.entrypoints.openai.api_server.*--port ${PORT}\" 2>/dev/null && {\n  echo \"已清理同端口残留进程\"\n  sleep 3\n} || true\n\n> \"${LOG_FILE}\"\nmkdir -p \"${STORE_DIR}\"\n\necho \"Starting Ornith-1.5-35B-A3B (vllm-moet gate=1, 专家池全量RAM) on GPU ${GPU_DEVICE} port=${PORT} ...\"\necho \"  Config: TP1 | 专家池pinned RAM全量 + GPU 20GiB hot cache | GATE=1 strict | PREFETCH=1 | 1M ctx | max-seqs 8\"\n\n# ── DMA 方式: 专家池全量装载系统 RAM (host pinned base) + GPU hot-expert cache ──\nexport VLLM_MOE_W2_BASE_CACHE_GB=20      # GPU 侧 hot-expert cache 20GiB (专家池在主机 RAM)\nexport VLLM_MOE_W2_GATE=1                 # miss → 批量 pinned-H2D + graph replay (bit-identical)\nexport VLLM_MOE_W2_REPLAY_MODE=strict     # fail-closed: 不返回静默零贡献的 logits\nexport VLLM_MOE_W2_PREFETCH=1             # draft-affinity 预取, 压低 miss 率\nexport VLLM_MOE_W2_DELTA=0                # 关闭 FP4 delta tier (本模式专家池纯 host base)\nexport VLLM_MOE_W2_STORE_DIR=\"${STORE_DIR}/pack\"   # 盘上 pack: 量化持久化, 免二次重建\nexport VLLM_MOE_W2_BASE_RAM_GB=20         # pinned MRU arena over pack (arena 覆盖 = 全量专家池)\nexport VLLM_MOE_W2_BASE_MISS_TOL=0        # 默认 strict: 任何 miss 都 replay\n\n# ── 本脚本专属 (引擎共性已在 vllm_moet.conf) ────────────────────────────\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8,max_split_size_mb:512\"\nmkdir -p \"${HOME}/.cache/flashinfer\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" --served-model-name ornith-1.5 --trust-remote-code \\\n  --tensor-parallel-size 1 --disable-custom-all-reduce \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --kv-cache-dtype fp8 --block-size 256 \\\n  --max-model-len 1048576 --gpu-memory-utilization 0.97 \\\n  --max-num-batched-tokens 8192 --max-num-seqs 8 \\\n  --enable-prefix-caching \\\n  --enable-chunked-prefill \\\n  --limit-mm-per-prompt '{\"image\":0,\"video\":0}' \\\n  --compilation-config '{\"cudagraph_mode\":\"FULL_AND_PIECEWISE\",\"custom_ops\":[\"all\"]}' \\\n  > \"${LOG_FILE}\" 2>&1 &\n\n# 页缓存清理: 67GB checkpoint 读完即废, 滞留会让常驻阶段可用内存枯竭\nDROP_CKPT=/tmp/vllm-ornith-1.5-${PORT}-drop-ckpt\nrm -f \"${DROP_CKPT}\"\n( exec 9>&-; for i in $(seq 1 960); do\n    if [ ! -f \"${DROP_CKPT}\" ] && grep -qE \"checkpoint shards: 100%|Loading model weights took\" \"${LOG_FILE}\" 2>/dev/null; then\n      echo 3 | sudo tee /proc/sys/vm/drop_caches >/dev/null 2>&1\n      echo \"[drop_caches] checkpoint $(date +%H:%M:%S)\" >> \"${LOG_FILE}\"\n      touch \"${DROP_CKPT}\"\n    fi","is_error":false}]},"parent_tool_use_id":null,"session_id":"4dfdd16c-24f2-4b3c-b837-5064eb80c149","uuid":"048fc3f9-e7ac-4f85-ab90-4bdd852b0d85","timestamp":"2026-09-14T09:54:18.610Z","tool_use_result":{"stdout":"---\nlibrary_name: transformers\nlicense: mit\nlicense_link: https://huggingface.co/ornith-ai/Ornith-1.5-35B-A3B/blob/main/LICENSE\npipeline_tag: text-generation\n---\n\n\n<img width=\"600px\" src=\"assets/ornith_logo.png\">\n\n[![Ornith Blog](https://img.shields.io/badge/%F0%9F%A6%A2%EF%B8%8F%20Ornith%20Blog%20-FD8E5B)](https://deep-reinforce.com/ornith.html)\n\n\n# Ornith-1.5-35B-A3B\n\n\nChirp Chirp! 🐦 We are introducing Ornith-1.5, a major step toward building foundation models through end-to-end self-improvement.\n\nOrnith-1.5 extends Ornith-1.0 (which was developed on top of Qwen3.5 and Gemma4 with additional continued pretraining, mid-training, and post-training) by expanding the self-improvement loop from scaffold and rollout optimization to jointly optimizing task generation, scaffold construction, and solution rollouts. Rather than relying on a fixed set of human-curated tasks and manually designed harnesses, Ornith-1.5 continuously generates new training tasks, discovers effective strategies for solving them, and improves the policy through reinforcement learning. For more details on the task, harness, and rollout reward design, please refer to our [blog](https://ornith.ai/ornith_1_5.html).\n\n<img style=\"width: 100%; max-width: 900px;\" src=\"assets/ornith_35b_eval.png\" alt=\"Ornith 1.5 35B Benchmark Results\" title=\"Ornith 1.5 35B Benchmark Results\">\n\n## Ornith 1.5 35B-A3B\n\nThis model card documents **Ornith-1.5-35B-A3B**, the mid-size mixture-of-experts member of the Ornith-1.5 family. It activates only ~3B parameters per token, yet significantly outperforms its similar-sized peer Qwen 3.6-35B across all coding and agentic benchmarks, and outperforms dense models such as Gemma 4-31B and Muse Glimmer-30B by wide margins on agentic coding.\n\n### Benchmarks\n\n\n<div style=\"font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;width:100%;margin:0 auto;padding:16px 0\">\n<table style=\"width:100%;table-layout:fixed;border-collapse:collapse;font-size:13px\">\n<thead><tr>\n<th style=\"width:22%;padding:10px 7px;text-align:left;font-weight:600;border-bottom:2px solid #FD8E5B;color:#FD8E5B\"></th>\n<th style=\"width:13%;padding:10px 7px;text-align:center;font-weight:700;border-bottom:2px solid #FD8E5B;color:#FD8E5B;font-size:14px;background:rgba(253, 142, 91, 0.12)\">Ornith-1.5-35B-A3B</th>\n<th style=\"width:13%;padding:10px 7px;text-align:center;font-weight:500;border-bottom:2px solid #FD8E5B;color:#FD8E5B;font-size:14px\">Ornith-1.0-35B-A3B</th>\n<th style=\"width:13%;padding:10px 7px;text-align:center;font-weight:500;border-bottom:2px solid #FD8E5B;color:#FD8E5B;font-size:14px\">Qwen3.6-35B-A3B</th>\n<th style=\"width:13%;padding:10px 7px;text-align:center;font-weight:500;border-bottom:2px solid #FD8E5B;color:#FD8E5B;font-size:14px\">Gemma-4-31B <sub></sub></th>\n<th style=\"width:13%;padding:10px 7px;text-align:center;font-weight:500;border-bottom:2px solid #FD8E5B;color:#FD8E5B;font-size:14px\">Muse-Glimmer-30B <sub></sub></th>\n<th style=\"width:13%;padding:10px 7px;text-align:center;font-weight:500;border-bottom:2px solid #FD8E5B;color:#FD8E5B;font-size:14px\">Qwen3.5-397B</th>\n</tr></thead>\n<tbody>\n<tr><td colspan=\"7\" style=\"padding:8px 12px;font-weight:600;color:#FD8E5B;border-bottom:1px so