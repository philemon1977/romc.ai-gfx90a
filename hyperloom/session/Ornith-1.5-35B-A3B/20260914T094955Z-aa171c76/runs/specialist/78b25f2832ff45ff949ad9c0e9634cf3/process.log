{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_aa4863c75d0efd76","type":"tool_result","content":"__init__.py\n__main__.py\n__pycache__\nbenchmark_config.yaml.example\nbenchmark_images.yaml\nconfig\nconfig.yaml\ncore\neval\nkernel_config.yaml.example\nmain.py\nmcp\nmodes\nremote\nscripts\ntools\nutils\n=== benchmark_images.yaml ===\n# Benchmark Docker Image Mapping\n# Format: framework -> gpu_arch -> docker_image\n#\n# GPU Architecture Identifiers:\n#   AMD: gfx942 (MI300X), gfx950 (MI355X)\n#   NVIDIA: sm_80 (A100), sm_90 (H100/H200), sm_100 (B200)\n#\n# Usage:\n#   ImageSelector automatically selects the appropriate image based on detected GPU.\n#   If the architecture is not found, an error will be raised.\n\nvllm:\n  # AMD GPUs\n  gfx942: \"vllm/vllm-openai-rocm:v0.19.1\"\n  gfx950: \"vllm/vllm-openai-rocm:v0.19.1\"\n  # NVIDIA GPUs\n  sm_80: \"vllm/vllm-openai:v0.19.1\"\n  sm_90: \"vllm/vllm-openai:v0.19.1\"\n  sm_100: \"vllm/vllm-openai:v0.19.1\"\n\nsglang:\n  # AMD GPUs\n  gfx942: \"lmsysorg/sglang:v0.5.12-rocm720-mi30x\"\n  gfx950: \"lmsysorg/sglang:v0.5.12-rocm720-mi35x\"\n  # NVIDIA GPUs\n  sm_80: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n  sm_90: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n  sm_100: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n\n# Atom exposes an OpenAI-compatible HTTP server (atom.entrypoints.openai_server)\n# that is wire-compatible with vLLM, so the bench client reuses --backend vllm.\n# Pin a specific tag via --docker-image when reproducibility matters.\n#\n# Atom is AMD-only: there is no NVIDIA/CUDA atom build, so no sm_* entries are\n# listed. Requesting atom on an NVIDIA arch raises an error in ImageSelector\n# rather than silently falling back to a vLLM image that cannot run the atom\n# server.\natom:\n  # AMD GPUs\n  gfx942: \"rocm/atom:latest\"\n  gfx950: \"rocm/atom:latest\"\n\n# NOTE: xDiT is intentionally NOT listed here. It is a server-less (scriptable)\n# diffusion workload that runs natively via the `xdit` CLI (no Docker image), so\n# this file stays a pure Docker-image mapping. BenchmarkConfig enforces\n# run_mode=local for framework=xdit instead.\n=== scripts dir ===\n./scripts/benchmark/atom_mi355x.sh\n./scripts/benchmark/magpie_bench_remote_compat.sh\n./scripts/benchmark/xdit_mi355x.sh\n./scripts/benchmark/vllm_mi355x_mm.sh\n./scripts/benchmark/server_cleanup.sh\n./scripts/benchmark/xdit_mi300x.sh\n./scripts/benchmark/sglang_mi355x.sh\n./scripts/benchmark/xdit_bench_common.sh\n./scripts/benchmark/sglang_mi300x.sh\n./scripts/benchmark/atom_mi300x.sh\n./scripts/benchmark/vllm_mi300x.sh\n./scripts/benchmark/vllm_mi355x.sh\n./scripts/benchmark/vllm_mi300x_mm.sh","is_error":false}]},"parent_tool_use_id":null,"session_id":"4dfdd16c-24f2-4b3c-b837-5064eb80c149","uuid":"f997784b-b378-4ce9-b865-da7ffb462cfa","timestamp":"2026-09-14T09:52:39.136Z","tool_use_result":{"stdout":"__init__.py\n__main__.py\n__pycache__\nbenchmark_config.yaml.example\nbenchmark_images.yaml\nconfig\nconfig.yaml\ncore\neval\nkernel_config.yaml.example\nmain.py\nmcp\nmodes\nremote\nscripts\ntools\nutils\n=== benchmark_images.yaml ===\n# Benchmark Docker Image Mapping\n# Format: framework -> gpu_arch -> docker_image\n#\n# GPU Architecture Identifiers:\n#   AMD: gfx942 (MI300X), gfx950 (MI355X)\n#   NVIDIA: sm_80 (A100), sm_90 (H100/H200), sm_100 (B200)\n#\n# Usage:\n#   ImageSelector automatically selects the appropriate image based on detected GPU.\n#   If the architecture is not found, an error will be raised.\n\nvllm:\n  # AMD GPUs\n  gfx942: \"vllm/vllm-openai-rocm:v0.19.1\"\n  gfx950: \"vllm/vllm-openai-rocm:v0.19.1\"\n  # NVIDIA GPUs\n  sm_80: \"vllm/vllm-openai:v0.19.1\"\n  sm_90: \"vllm/vllm-openai:v0.19.1\"\n  sm_100: \"vllm/vllm-openai:v0.19.1\"\n\nsglang:\n  # AMD GPUs\n  gfx942: \"lmsysorg/sglang:v0.5.12-rocm720-mi30x\"\n  gfx950: \"lmsysorg/sglang:v0.5.12-rocm720-mi35x\"\n  # NVIDIA GPUs\n  sm_80: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n  sm_90: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n  sm_100: \"lmsysorg/sglang:v0.5.8-cu130-amd64-runtime\"\n\n# Atom exposes an OpenAI-compatible HTTP server (atom.entrypoints.openai_server)\n# that is wire-compatible with vLLM, so the bench client reuses --backend vllm.\n# Pin a specific tag via --docker-image when reproducibility matters.\n#\n# Atom is AMD-only: there is no NVIDIA/CUDA atom build, so no sm_* entries are\n# listed. Requesting atom on an NVIDIA arch raises an error in ImageSelector\n# rather than silently falling back to a vLLM image that cannot run the atom\n# server.\natom:\n  # AMD GPUs\n  gfx942: \"rocm/atom:latest\"\n  gfx950: \"rocm/atom:latest\"\n\n# NOTE: xDiT is intentionally NOT listed here. It is a server-less (scriptable)\n# diffusion workload that runs natively via the `xdit` CLI (no Docker image), so\n# this file stays a pure Docker-image mapping. BenchmarkConfig enforces\n# run_mode=local for framework=xdit instead.\n=== scripts dir ===\n./scripts/benchmark/atom_mi355x.sh\n./scripts/benchmark/magpie_bench_remote_compat.sh\n./scripts/benchmark/xdit_mi355x.sh\n./scripts/benchmark/vllm_mi355x_mm.sh\n./scripts/benchmark/server_cleanup.sh\n./scripts/benchmark/xdit_mi300x.sh\n./scripts/benchmark/sglang_mi355x.sh\n./scripts/benchmark/xdit_bench_common.sh\n./scripts/benchmark/sglang_mi300x.sh\n./scripts/benchmark/atom_mi300x.sh\n./scripts/benchmark/vllm_mi300x.sh\n./scripts/benchmark/vllm_mi355x.sh\n./scripts/benchmark/vllm_mi300x_mm.sh","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
