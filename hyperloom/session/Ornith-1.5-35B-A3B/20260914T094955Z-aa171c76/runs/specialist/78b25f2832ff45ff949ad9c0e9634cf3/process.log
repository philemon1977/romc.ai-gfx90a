{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_aa9351e66ac467b3","type":"tool_result","content":"launched\n# SPDX-License-Identifier: Apache-2.0\n\"\"\"gfx90a (MI250X) 小形状快路径内核集合。\n\n背景（实测，见 docs/MI250X-vLLM-优化方案.md）：TP=2 单模组解码一步 14.16 ms，其中\n  * shared_expert_gate 的 GEMM（m=1 输出, n=1 token, k=2048，权重仅 4 KB）\n    因不满足 skinny 分支条件（LLMM1 要 m%4==0，wvSplitK 要 m>8）掉到\n    torch.nn.functional.linear -> hipBLASLt Cijk_MT64x64x32，grid=[256,1,1]，\n    单次 66.5 us x 40 层 = 2.66 ms/步（18.8%）。\n  * _moe_C::topk_softmax grid=[1,1,1] 单次 17.6 us x 40 = 0.70 ms/步。\n  * _C::silu_and_mul grid=[8,1,1] block=[32,1,1] 单次 7.0 us；moe_sum grid=[1,1,1]\n    单次 7.1 us，各 40 次/步。\n本文件用 Triton 把这些\"一个 CTA 就够\"的算子写成能填满 CU 的形式。\n每个都可单独用环境变量关掉（默认 1=开）：\n  MI250_GATE_GEMV / MI250_TOPK / MI250_MOE_ACT / MI250_MOE_SUM\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\n\nimport torch\nimport triton\nimport triton.language as tl\n\n\ndef _flag(name: str, default: str = \"1\") -> bool:\n    return os.environ.get(name, default).strip() not in (\"0\", \"\", \"false\", \"False\")\n\n\nGATE_ON = _flag(\"MI250_GATE_GEMV\")\n# 实测：Triton topk 在真实负载里 28.4 us/次，反而比 CUDA 的 17.6 us 慢 -> 默认关闭\nTOPK_ON = _flag(\"MI250_TOPK\", \"0\")\nACT_ON = _flag(\"MI250_MOE_ACT\")\nSUM_ON = _flag(\"MI250_MOE_SUM\")\n\n# Triton jit 只能读 constexpr 全局\n_NEG_INF = tl.constexpr(float(\"-inf\"))\n\n\n# ---------------------------------------------------------------- 门控 GEMV\n@triton.jit\ndef _gate_gemv_k(X, W, O, M, K, BM: tl.constexpr, BK: tl.constexpr):\n    \"\"\"O[row, 0:M] = sum_k X[row, k] * W[0:M, k]；X:[n,K] W:[M,K] 均 contiguous。\"\"\"\n    row = tl.program_id(0)\n    rm = tl.arange(0, BM)\n    acc = tl.zeros([BM], dtype=tl.float32)\n    xp = X + row * K\n    for k0 in range(0, K, BK):\n        rk = k0 + tl.arange(0, BK)\n        km = rk < K\n        xv = tl.load(xp + rk, mask=km, other=0.0).to(tl.float32)\n        wv = tl.load(\n            W + rm[:, None] * K + rk[None, :],\n            mask=(rm[:, None] < M) & km[None, :],\n            other=0.0,\n        ).to(tl.float32)\n        acc += tl.sum(wv * xv[None, :], axis=1)\n    tl.store(O + row * M + rm, acc.to(O.dtype.element_ty), mask=rm < M)","is_error":false}]},"parent_tool_use_id":null,"session_id":"4dfdd16c-24f2-4b3c-b837-5064eb80c149","uuid":"ace6a0a4-c698-4414-8fba-714726e86e8a","timestamp":"2026-09-14T10:14:10.659Z","tool_use_result":{"stdout":"launched\n# SPDX-License-Identifier: Apache-2.0\n\"\"\"gfx90a (MI250X) 小形状快路径内核集合。\n\n背景（实测，见 docs/MI250X-vLLM-优化方案.md）：TP=2 单模组解码一步 14.16 ms，其中\n  * shared_expert_gate 的 GEMM（m=1 输出, n=1 token, k=2048，权重仅 4 KB）\n    因不满足 skinny 分支条件（LLMM1 要 m%4==0，wvSplitK 要 m>8）掉到\n    torch.nn.functional.linear -> hipBLASLt Cijk_MT64x64x32，grid=[256,1,1]，\n    单次 66.5 us x 40 层 = 2.66 ms/步（18.8%）。\n  * _moe_C::topk_softmax grid=[1,1,1] 单次 17.6 us x 40 = 0.70 ms/步。\n  * _C::silu_and_mul grid=[8,1,1] block=[32,1,1] 单次 7.0 us；moe_sum grid=[1,1,1]\n    单次 7.1 us，各 40 次/步。\n本文件用 Triton 把这些\"一个 CTA 就够\"的算子写成能填满 CU 的形式。\n每个都可单独用环境变量关掉（默认 1=开）：\n  MI250_GATE_GEMV / MI250_TOPK / MI250_MOE_ACT / MI250_MOE_SUM\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\n\nimport torch\nimport triton\nimport triton.language as tl\n\n\ndef _flag(name: str, default: str = \"1\") -> bool:\n    return os.environ.get(name, default).strip() not in (\"0\", \"\", \"false\", \"False\")\n\n\nGATE_ON = _flag(\"MI250_GATE_GEMV\")\n# 实测：Triton topk 在真实负载里 28.4 us/次，反而比 CUDA 的 17.6 us 慢 -> 默认关闭\nTOPK_ON = _flag(\"MI250_TOPK\", \"0\")\nACT_ON = _flag(\"MI250_MOE_ACT\")\nSUM_ON = _flag(\"MI250_MOE_SUM\")\n\n# Triton jit 只能读 constexpr 全局\n_NEG_INF = tl.constexpr(float(\"-inf\"))\n\n\n# ---------------------------------------------------------------- 门控 GEMV\n@triton.jit\ndef _gate_gemv_k(X, W, O, M, K, BM: tl.constexpr, BK: tl.constexpr):\n    \"\"\"O[row, 0:M] = sum_k X[row, k] * W[0:M, k]；X:[n,K] W:[M,K] 均 contiguous。\"\"\"\n    row = tl.program_id(0)\n    rm = tl.arange(0, BM)\n    acc = tl.zeros([BM], dtype=tl.float32)\n    xp = X + row * K\n    for k0 in range(0, K, BK):\n        rk = k0 + tl.arange(0, BK)\n        km = rk < K\n        xv = tl.load(xp + rk, mask=km, other=0.0).to(tl.float32)\n        wv = tl.load(\n            W + rm[:, None] * K + rk[None, :],\n            mask=(rm[:, None] < M) & km[None, :],\n            other=0.0,\n        ).to(tl.float32)\n        acc += tl.sum(wv * xv[None, :], axis=1)\n    tl.store(O + row * M + rm, acc.to(O.dtype.element_ty), mask=rm < M)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
