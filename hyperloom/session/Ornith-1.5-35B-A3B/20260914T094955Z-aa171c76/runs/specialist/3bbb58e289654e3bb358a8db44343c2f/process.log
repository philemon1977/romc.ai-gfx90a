r None,\n        )\n\n\ndef coerce_extra_envs(value: Any) -> dict[str, str]:\n    \"\"\"Normalize Orchestration-supplied ``extra_envs`` to ``dict[str,str]``.\n\n    Accepts the three shapes the LLM emits — canonical dict, shell-style\n    ``\"FOO=1 BAR=2\"`` string, and ``[\"FOO=1\", \"BAR=2\"]`` token list — so\n    downstream ``.items()`` callers never crash on a non-dict. Unknown shapes\n    coerce to an empty dict.\n\n    Args:\n        value (Any): The Orchestration-supplied ``extra_envs`` in any of the\n            accepted shapes (dict, shell-style string, or token list).\n\n    Returns:\n        dict[str, str]: The normalized env mapping; empty for unknown shapes.\n    \"\"\"\n    if isinstance(value, dict):\n        return {str(k): str(v) for k, v in value.items() if k is not None}\n    if isinstance(value, str):\n        out: dict[str, str] = {}\n        # Split on the first ``=`` only to preserve URL-style assignments\n        # like ``HF_ENDPOINT=https://...``.\n        tokens = re.split(r\"[\\s;]+\", value.strip())\n        for tok in tokens:\n            if not tok:\n                continue\n            if \"=\" not in tok:","is_error":false}]},"parent_tool_use_id":null,"session_id":"9087e8e0-3c3d-46ce-bdfb-3ddcba42adf6","uuid":"9e7d68ba-da91-46c4-9d75-d3810e0d766c","timestamp":"2026-09-14T12:11:04.733Z","tool_use_result":{"stdout":"6:Takes a base Magpie YAML + a list of (name, extra_server_args, extra_envs)\n78:    coerce_extra_envs as coerce_extra_envs,\n409:    envs = {str(k): str(v) for k, v in (getattr(variant, \"extra_envs\", None) or {}).items()}\n613:            ``unset_envs`` may not remove a workload pin.\n664:    for k in getattr(variant, \"unset_envs\", []) or []:\n670:    for k, v in variant.extra_envs.items():\n1256:    unset_envs: list[str],\n1266:        variant: The grid variant supplying ``extra_envs``.\n1267:        unset_envs: Env names this variant removes.\n1272:    merged = {k: v for k, v in reference_envs.items() if k not in un