{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a2663c5eb3b20239","type":"tool_result","content":"diff --git a/Magpie/modes/benchmark/benchmarker.py b/Magpie/modes/benchmark/benchmarker.py\nindex 6b44089..18fd992 100644\n--- a/Magpie/modes/benchmark/benchmarker.py\n+++ b/Magpie/modes/benchmark/benchmarker.py\n@@ -15,6 +15,7 @@ import os\n import signal\n import shutil\n import subprocess\n+import sys\n import tempfile\n import time\n import uuid\n@@ -56,6 +57,133 @@ MAGPIE_BUILTIN_SCRIPTS = frozenset(\n     }\n )\n \n+# Device-selection env vars understood by the ROCm/CUDA stacks.\n+_VISIBLE_DEVICE_VARS = (\"HIP_VISIBLE_DEVICES\", \"CUDA_VISIBLE_DEVICES\")\n+\n+\n+def align_rocm_visible_devices(env: Dict[str, str]) -> Dict[str, str]:\n+    \"\"\"Make ``HIP``/``CUDA_VISIBLE_DEVICES`` logical indices of the ROCR set.\n+\n+    ``ROCR_VISIBLE_DEVICES`` filters at the HSA layer and *renumbers* the\n+    agents that survive, so the devices that appear as HIP ids ``0..N-1`` are\n+    the same physical GPUs that appear as ROCR ids ``0..N-1``. Any\n+    ``HIP``/``CUDA`` id taken from a *host-physical* enumeration is therefore\n+    meaningless once ``ROCR_VISIBLE_DEVICES`` is set: HIP filters the already\n+    remapped ROCR list and, when no id survives, the process ends up with zero\n+    usable devices (``torch.cuda.device_count()`` may still report the ROCR\n+    count while every allocation fails with \"No CUDA GPUs are available\").\n+\n+    A launcher (e.g. a container entrypoint pinning a pod's cards) commonly\n+    exports host-physical ``HIP_VISIBLE_DEVICES`` while Magpie's\n+    ``gpu_selection`` pins ``ROCR_VISIBLE_DEVICES`` for the benchmark. Merge\n+    the two here, at the single choke point every local benchmark/server phase\n+    passes through, so the child sees a self-consistent set:\n+\n+    * ``ROCR_VISIBLE_DEVICES`` selects ``N >= 1`` devices -> the request is\n+      satisfiable, so re-pin ``HIP``/``CUDA`` to the logical range ``0..N-1``.\n+    * otherwise, or when the HIP set is already a subset of the ROCR logical\n+      range -> leave the environment untouched.\n+\n+    An explicit ``benchmark.envs.HIP_VISIBLE_DEVICES``/\n+    ``CUDA_VISIBLE_DEVICES`` in the config counts as a request that the caller\n+    resolved themselves and is only rewritten when it cannot be satisfied.\n+\n+    Args:\n+        env: Environment mapping to mutate in place.\n+\n+    Returns:\n+        The same ``env`` mapping (so callers can use either style).\n+    \"\"\"\n+    rocr_raw = (env.get(\"ROCR_VISIBLE_DEVICES\") or \"\").strip()\n+    if not rocr_raw:\n+        return env\n+    rocr_ids = [t.strip() for t in rocr_raw.split(\",\") if t.strip()]\n+    if not rocr_ids:\n+        return env\n+    rocr_count = len(rocr_ids)\n+    logical = {str(i) for i in range(rocr_count)}\n+    derived = \",\".join(str(i) for i in range(rocr_count))\n+\n+    for var in _VISIBLE_DEVICE_VARS:\n+        current = (env.get(var) or \"\").strip()\n+        if not current:\n+            continue\n+        parts = [t.strip() for t in current.split(\",\") if t.strip()]\n+        if parts and all(p in logical for p in parts):\n+            # Already consistent with the ROCR renumbering — respect it as-is.\n+            continue\n+        logger.info(\n+            \"%s=%r is not a logical index set of ROCR_VISIBLE_DEVICES=%r \"\n+            \"(HSA renumbers the visible agents); re-pinning to %r so the \"\n+            \"benchmark child actually sees the selected GPU(s).\",\n+            var,\n+            current,\n+            rocr_raw,\n+            derived,\n+        )\n+        env[var] = derived\n+\n+    return env\n+\n+\n+# CLI each supported framework exposes for serving; used to test whether the\n+# child PATH can actually launch the benchmark it was asked to run.\n+_FRAMEWORK_SERVE_CLI = {\n+    \"vllm\": \"vllm\",\n+    \"sglang\": \"sglang\",\n+}\n+\n+\n+def ensure_framework_env_on_path(\n+    env: Dict[str, str], framework: Optional[str] = None\n+) -> Dict[str, str]:\n+    \"\"\"Guarantee the framework CLI is resolvable in the benchmark child.\n+\n+    The InferenceX benchmark scripts invoke the framework's own CLI\n+    (``vllm serve`` …) and run the serving client with a bare ``python3`` that\n+    imports the framework. ``benchmark.envs.PATH`` is applied verbatim on top\n+    of the parent environment, so a PATH naming only a *different* interpreter\n+    environment than the one the framework is installed into silently shadows\n+    both: ``vllm`` becomes \"command not found\" for the server phase and\n+    ``import vllm`` fails in the client phase, even though Magpie itself is\n+    running from the correct environment.\n+\n+    Repair that by prepending the bin directory of the interpreter running\n+    Magpie — which is, by construction, the environment the framework under\n+    test lives in — but only when the framework CLI is *missing* from the PATH\n+    the child would otherwise get. A caller PATH that already resolves the\n+    framework is left untouched (and left in front, so an intentionally\n+    different environment still wins).\n+\n+    Args:\n+        env: Environment mapping to mutate in place.\n+        framework: Framework name from the benchmark config.\n+\n+    Returns:\n+        The same ``env`` mapping.\n+    \"\"\"\n+    cli = _FRAMEWORK_SERVE_CLI.get((framework or \"\").lower())\n+    if cli is None:\n+        return env\n+\n+    path = env.get(\"PATH\") or os.defpath\n+    if shutil.which(cli, path=path):\n+        return env  # already resolvable — respect the caller's environment\n+\n+    bin_dir = str(Path(sys.executable).parent)\n+    if not bin_dir or not shutil.which(cli, path=bin_dir):\n+        return env\n+\n+    logger.info(\n+        \"benchmark child PATH does not provide '%s'; prepending the \"\n+        \"Magpie-hosting environment bin '%s' so the framework CLI and the \"\n+        \"python3 that imports it resolve inside the InferenceX script.\",\n+        cli,\n+        bin_dir,\n+    )\n+    env[\"PATH\"] = os.pathsep.join([bin_dir, path])\n+    return env\n+\n \n class BenchmarkMode:\n     \"\"\"\n@@ -800,6 +928,9 @@ class BenchmarkMode:\n         for key, value in env_vars.items():\n             env[key] = str(value)\n \n+        align_rocm_visible_devices(env)\n+        ensure_framework_env_on_path(env, self.config.framework)\n+\n         return cmd, env\n \n     def _execute_local_benchmark_with_reuse(\ndiff --git a/Magpie/scripts/benchmark/vllm_mi300x.sh b/Magpie/scripts/benchmark/vllm_mi300x.sh\nindex ccfed15..f3a03f8 100644\n--- a/Magpie/scripts/benchmark/vllm_mi300x.sh\n+++ b/Magpie/scripts/benchmark/vllm_mi300x.sh\n@@ -61,10 +61,27 @@ if [[ \"$version\" == \"\" || $version -lt 177 ]]; then\n fi\n \n # ROCR_VISIBLE_DEVICES already re-indexes visible GPUs to 0..N-1, so HIP\n-# must use the logical range, not the original physical ids.\n-if [ -n \"$ROCR_VISIBLE_DEVICES\" ] && [ -z \"$HIP_VISIBLE_DEVICES\" ]; then\n+# must use the logical range, not the original physical ids. A HIP id past the\n+# end of that re-indexed range filters out every device (the child then sees\n+# 0 usable GPUs), so also repair a HIP/CUDA pin that a launcher exported in\n+# host-physical ids.\n+if [ -n \"${ROCR_VISIBLE_DEVICES:-}\" ]; then\n     n=$(echo \"$ROCR_VISIBLE_DEVICES\" | awk -F, '{print NF}')\n-    export HIP_VISIBLE_DEVICES=$(seq -s, 0 $((n-1)))\n+    logical=$(seq -s, 0 $((n-1)))\n+    for _var in HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES; do\n+        _cur=\"${!_var:-}\"\n+        if [ -z \"$_cur\" ]; then continue; fi\n+        case \",$logical,\" in\n+          *\",$_cur,\"*) : ;;                        # already a logical index\n+          *) echo \"[$_var=$_cur is not logical to ROCR_VISIBLE_DEVICES=$ROCR_VISIBLE_DEVICES; re-pinning to $logical]\"\n+             export \"$_var=$logical\" ;;\n+        esac\n+    done\n+    unset _var _cur\n+    if [ -z \"${HIP_VISIBLE_DEVICES:-}\" ]; then\n+        export HIP_VISIBLE_DEVICES=$logical\n+    fi\n+    unset n logical\n fi\n \n # vLLM optimizations for MI300X","is_error":false}]},"parent_tool_use_id":null,"session_id":"9087e8e0-3c3d-46ce-bdfb-3ddcba42adf6","uuid":"2d74d098-a317-4961-834c-34271d05ee4c","timestamp":"2026-09-14T11:51:12.747Z","tool_use_result":{"stdout":"diff --git a/Magpie/modes/benchmark/benchmarker.py b/Magpie/modes/benchmark/benchmarker.py\nindex 6b44089..18fd992 100644\n--- a/Magpie/modes/benchmark/benchmarker.py\n+++ b/Magpie/modes/benchmark/benchmarker.py\n@@ -15,6 +15,7 @@ import os\n import signal\n import shutil\n import subprocess\n+import sys\n import tempfile\n import time\n import uuid\n@@ -56,6 +57,133 @@ MAGPIE_BUILTIN_SCRIPTS = frozenset(\n     }\n )\n \n+# Device-selection env vars understood by the ROCm/CUDA stacks.\n+_VISIBLE_DEVICE_VARS = (\"HIP_VISIBLE_DEVICES\", \"CUDA_VISIBLE_DEVICES\")\n+\n+\n+def align_rocm_visible_devices(env: Dict[str, str]) -> Dict[str, str]:\n+    \"\"\"Make ``HIP``/``CUDA_VISIBLE_DEVICES`` logical indices of the ROCR set.\n+\n+    ``ROCR_VISIBLE_DEVICES`` filters at the HSA layer and *renumbers* the\n+    agents that survive, so the devices that appear as HIP ids ``0..N-1`` are\n+    the same physical GPUs that appear as ROCR ids ``0..N-1``. Any\n+    ``HIP``/``CUDA`` id taken from a *host-physical* enumeration is therefore\n+    meaningless once ``ROCR_VISIBLE_DEVICES`` is set: HIP filters the already\n+    remapped ROCR list and, when no id survives, the process ends up with zero\n+    usable devices (``torch.cuda.device_count()`` may still report the ROCR\n+    count while every allocation fails with \"No CUDA GPUs are available\").\n+\n+    A launcher (e.g. a container entrypoint pinning a pod's cards) commonly\n+    exports host-physical ``HIP_VISIBLE_DEVICES`` while Magpie's\n+    ``gpu_selection`` pins ``ROCR_VISIBLE_DEVICES`` for the benchmark. Merge\n+    the two here, at the single choke point every local benchmark/server phase\n+    passes