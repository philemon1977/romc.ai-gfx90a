 — and the client phase would die on\n# `ModuleNotFoundError: No module named huggingface_hub`.\n#\n# Repair it here, at the point of use, so the run does not depend on which\n# interpreter the parent harness happens to run from: find an environment that\n# really provides the CLI and prepend it. A PATH that already resolves both is\n# left untouched, so an intentionally different environment still wins.\n# ---------------------------------------------------------------------------\n_magpie_env_has_cli() {  # $1 = bin dir, $2 = command\n    [ -n \"$1\" ] && [ -x \"$1/$2\" ]\n}\n\n_magpie_env_has_module() {  # $1 = bin dir, $2 = python module\n    [ -n \"$1\" ] && [ -x \"$1/python3\" ] \\\n        && \"$1/python3\" -c \"import importlib.util,sys;sys.exit(0 if importlib.util.find_spec('$2') else 1)\" \\\n        >/dev/null 2>&1\n}\n\nif ! command -v vllm >/dev/null 2>&1; then\n    _magpie_bin=\"\"\n    # 1) an interpreter the harness told us can import the framework\n    for _cand in \"${MAGPIE_PYTHON:-}\" \"${VLLM_PYTHON:-}\" \"$(command -v python3 || true)\"; do\n        [ -n \"$_cand\" ] || continue\n        _dir=$(dirname \"$_cand\")\n        if _magpie_env_has_cli \"$_dir\" vllm && _magpie_env_has_module \"$_dir\" vllm; then\n            _magpie_bin=\"$_dir\"; break\n        fi\n    done\n    # 2) an explicit framework root / venv from the environment\n    if [ -z \"$_magpie_bin\" ]; then\n        for _cand in \"${VLLM_VENV_ROOT:+$_cand/bin}\" \"${FRAMEWORK_ROOT%/*}/bin\" /opt/envs/*/bin /opt/venv/bin; do\n            [ -n \"$_cand\" ] || continue\n            if _magpie_env_has_cli \"$_cand\" vllm && _magpie_env_has_module \"$_cand\" huggingface_hub; then\n                _magpie_bin=\"$_cand\"; break\n            fi\n        done\n    fi\n    if [ -n \"$_magpie_bin\" ]; then\n        echo \"[vllm_mi300x] 'vllm' not on PATH; prepending framework bin '$_magpie_bin'\"\n        export PATH=\"$_magpie_bin:$PATH\"\n    else\n        echo \"[vllm_mi300x] WARN: no environment providing 'vllm' found; server launch will likely fail\" >&2\n    fi\n    unset _magpie_bin\n    unset _cand _dir\nfi\n\n# A ROCr-level mask renumbers the surviving agents 0..N-1, so a HIP/CUDA pin in\n# host-physical ids filters out every device. Do this BEFORE the first CUDA\n# consumer (hf download) so the whole script tree inherits a consistent set.\nif [ -n \"${ROCR_VISIBLE_DEVICES:-}\" ]; then\n    _magpie_n=$(echo \"$ROCR_VISIBLE_DEVICES\" | awk -F, '{print NF}')\n    _magpie_logical=$(seq -s, 0 $((_magpie_n-1)))\n    for _magpie_var in HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES; do\n        _magpie_cur=\"${!_magpie_var:-}\"\n        [ -n \"$_magpie_cur\" ] || continue\n        case \",$_magpie_logical,\" in\n          *\",$_magpie_cur,\"*) : ;;                   # already a logical index\n          *) echo \"[vllm_mi300x] $_magpie_var=$_magpie_cur is not logical to ROCR_VISIBLE_DEVICES=$ROCR_VISIBLE_DEVICES; re-pinning to $_magpie_logical\"\n             export \"$_magpie_var=$_magpie_logical\" ;;\n        esac\n    done\n    unset _magpie_var _magpie_cur\nfi\n\nPHASE=\"${MAGPIE_RUN_PHASE:-all}\"","originalFile":"#!/usr/bin/env bash\n###############################################################################\n# Copyright (c) 2026 Advanced Micro Devices, Inc. All rights reserved.\n#\n# See LICENSE for license information.\n###############################################################################\n\n# Magpie Generic vLLM Benchmark Script for MI300X\n#\n# Phases (via MAGPIE_RUN_PHASE): all | server | client (default all).\n# Server-only writes PID to MAGPIE_SERVER_PID_FILE then disowns and exits.\n#\n# Remote server (BENCHMARK_BASE_URL): when set, the client phase points\n# benchmark_serving at an external vLLM-compatible HTTP endpoint\n# instead of localhost:$PORT, and forces PHASE=client (no local server\n# launch, no server-side cleanup, no SERVER_PID monitoring). Use this\n# whenever the server is hosted off-pod (different node, different\n# cluster, externally managed). Leave the env unset to keep the\n# default behaviour of launching a local server.\n\nsource \"$(dirname \"$0\")/benchmark_lib.sh\"\nsource \"$(dirname \"$0\")/server_cleanup.sh\"\n# shellcheck source=magpie_bench_remote_compat.sh\n[[ -f \"$(dirname \"$0\")/magpie_bench_remote_compat.sh\" ]] && source \"$(dirname \"$0\")/magpie_bench_remote_compat.sh\"\n\nPHASE=\"${MAGPIE_RUN_PHASE:-all}\"\ncase \"$PHASE\" in\n  all|server|client) ;;\n  *) echo \"ERROR: Invalid MAGPIE_RUN_PHASE='$PHASE'. Must be all|server|client.\" >&2; exit 2 ;;\nesac\n\nif [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n  if [[ \"$PHASE\" != \"client\" ]]; then\n    echo \"[vllm_mi300x] BENCHMARK_BASE_URL set; forcing PHASE=client (was $PHASE)\"\n    PHASE=client\n  fi\nfi\n\nif [[ \"$PHASE\" == \"server\" || \"$PHASE\" == \"all\" ]]; then\n  check_env_vars MODEL TP\nfi\nif [[ \"$PHASE\" == \"client\" || \"$PHASE\" == \"all\" ]]; then\n  check_env_vars MODEL CONC ISL OSL RANDOM_RANGE_RATIO RESULT_FILENAME\nfi\n\nMAX_MODEL_LEN=${MAX_MODEL_LEN:-4096}\nGPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-0.95}\n\nif [[ -n \"$SLURM_JOB_ID\" ]]; then\n  echo \"JOB $SLURM_JOB_ID running on $SLURMD_NODENAME\"\nfi\n\nif [[ \"$PHASE\" != \"client\" ]]; then\n  hf download \"$MODEL\" 2>/dev/null || true\nfi\n\n# MI300X specific: Check MEC firmware version for RCCL memory reclaim\nversion=$(rocm-smi --showfw 2>/dev/null | grep MEC | head -n 1 | awk '{print $NF}')\nif [[ \"$version\" == \"\" || $version -lt 177 ]]; then\n  export HSA_NO_SCRATCH_RECLAIM=1\nfi\n\n# ROCR_VISIBLE_DEVICES already re-indexes visible GPUs to 0..N-1, so HIP\n# must use the logical range, not the original physical ids. A HIP id past the\n# end of that re-indexed range filters out every device (the child then sees\n# 0 usable GPUs), so also repair a HIP/CUDA pin that a launcher exported in\n# host-physical ids.\nif [ -n \"${ROCR_VISIBLE_DEVICES:-}\" ]; then\n    n=$(echo \"$ROCR_VISIBLE_DEVICES\" | awk -F, '{print NF}')\n    logical=$(seq -s, 0 $((n-1)))\n    for _var in HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES; do\n        _cur=\"${!_var:-}\"\n        if [ -z \"$_cur\" ]; then continue; fi\n        case \",$logical,\" in\n          *\",$_cur,\"*) : ;;                        # already a logical index\n          *) echo \"[$_var=$_cur is not logical to ROCR_VISIBLE_DEVICES=$ROCR_VISIBLE_DEVICES; re-pinning to $logical]\"\n             export \"$_var=$logical\" ;;\n        esac\n    done\n    unset _var _cur\n    if [ -z \"${HIP_VISIBLE_DEVICES:-}\" ]; then\n        export HIP_VISIBLE_DEVICES=$logical\n    fi\n    unset n logical\nfi\n\n# vLLM optimizations for MI300X\n_aiter_default=1\nif /opt/rocm/bin/rocminfo 2>/dev/null | grep -q \"gfx90a\"; then _aiter_default=0; fi\nexport VLLM_ROCM_USE_AITER=${VLLM_ROCM_USE_AITER:-$_aiter_default}\n\nWORKSPACE_DIR=${RESULT_DIR:-/workspace}\nSERVER_LOG=${SERVER_LOG:-$WORKSPACE_DIR/server.log}\nPORT=${PORT:-8888}\n\n# Build profiler args for vLLM >= 0.15 (env var VLLM_TORCH_PROFILER_DIR is deprecated)\nPROFILER_ARGS=()\nif [[ \"${PROFILE:-}\" == \"1\" ]]; then\n  TRACE_DIR=\"${VLLM_TORCH_PROFILER_DIR:-$WORKSPACE_DIR/torch_trace}\"\n  mkdir -p \"$TRACE_DIR\"\n  PROFILER_ARGS+=(--profiler-config.profiler torch)\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_dir \"$TRACE_DIR\")\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_record_shapes True)\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_with_memory True)\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_with_flops True)\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_use_gzip True)\nfi\n\nset -x\nif [[ \"$PHASE\" == \"server\" || \"$PHASE\" == \"all\" ]]; then\n  setsid vllm serve $MODEL --port $PORT \\\n    --tensor-parallel-size=$TP \\\n    --gpu-memory-utilization 0.95 \\\n    --max-model-len $MAX_MODEL_LEN \\\n    --trust-remote-code \\\n    \"${PROFILER_ARGS[@]}\" \\\n    $EXTRA_VLLM_ARGS > $SERVER_LOG 2>&1 &\n\n  SERVER_PID=$!\n  if [[ \"$PHASE\" == \"all\" ]]; then\n    trap 'magpie_stop_benchmark_server_stack \"$SERVER_PID\"' EXIT INT TERM\n  fi\n\n  wait_for_server_ready --port \"$PORT\" --server-log \"$SERVER_LOG\" --server-pid \"$SERVER_PID\"\n\n  if [[ \"$PHASE\" == \"server\" ]]; then\n    if [[ -z \"${MAGPIE_SERVER_PID_FILE:-}\" ]]; then\n      echo \"ERROR: MAGPIE_SERVER_PID_FILE must be set for MAGPIE_RUN_PHASE=server\" >&2\n      kill -TERM \"-$SERVER_PID\" 2>/dev/null || true\n      exit 3\n    fi\n    printf '%s\\n' \"$SERVER_PID\" > \"$MAGPIE_SERVER_PID_FILE\"\n    disown \"$SERVER_PID\" 2>/dev/null || true\n    exit 0\n  fi\nfi\n\nSERVER_MONITOR_ARGS=()\nif [[ -n \"${SERVER_PID:-}\" ]]; then\n  SERVER_MONITOR_ARGS+=(--server-pid \"$SERVER_PID\")\nfi\n\nif [[ \"$PHASE\" == \"client\" || \"$PHASE\" == \"all\" ]]; then\n  if [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n    SERVER_MONITOR_ARGS=()\n    magpie_run_benchmark_serving_remote_direct trust || exit $?\n  else\n    run_benchmark_serving \\\n        --model \"$MODEL\" \\\n        --port \"$PORT\" \\\n        --backend vllm \\\n        --input-len \"$ISL\" \\\n        --output-len \"$OSL\" \\\n        --random-range-ratio \"$RANDOM_RANGE_RATIO\" \\\n        --num-prompts ${NUM_PROMPTS:-$(( $CONC * 10 ))} \\\n        --max-concurrency \"$CONC\" \\\n        --result-filename \"$RESULT_FILENAME\" \\\n        --result-dir \"$WORKSPACE_DIR/\" \\\n        \"${SERVER_MONITOR_ARGS[@]}\" \\\n        --trust-remote-code || exit $?\n  fi\nfi\n\n# After throughput, run evaluation only if RUN_EVAL is true\nif [[ \"$PHASE\" != \"server\" && \"${RUN_EVAL}\" = \"true\" ]]; then\n    if [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n        if declare -F magpie_run_eval_remote_direct &>/dev/null; then\n            magpie_run_eval_remote_direct || exit $?\n        else\n            echo \"[vllm_mi300x] RUN_EVAL=true with BENCHMARK_BASE_URL but magpie_run_eval_remote_direct shim not available; skipping eval (results gate will see accuracy=None).\"\n        fi\n    else\n        run_eval --framework lm-eval --port \"$PORT\" || exit $?\n        append_lm_eval_summary\n    fi\nfi\nset +x\n\n","structuredPatch":[{"oldStart":23,"oldLines":6,"newStart":23,"newLines":80,"lines":[" # shellcheck source=magpie_bench_remote_compat.sh"," [[ -f \"$(dirname \"$0\")/magpie_bench_remote_compat.sh\" ]] && source \"$(dirname \"$0\")/magpie_bench_remote_compat.sh\""," ","+# ---------------------------------------------------------------------------","+# Framework-environment self-alignment.","+#","+# This script launches the server with a bare `vllm` and runs the benchmark","+# client with a bare `python3`, both resolved through PATH. The harness may","+# hand us a PATH that points at a *different* interpreter environment than the","+# one vLLM (and this model's `huggingface_hub`/`transformers` deps) is actually","+# installed into; `benchmark.envs.PATH` is applied verbatim, so the whole run","+# then dies in ~2s with `setsid: failed to execute vllm: No such file or","+# directory` — and the client phase would die on","+# `ModuleNotFoundError: No module named huggingface_hub`.","+#","+# Repair it here, at the point of use, so the run does not depend on which","+# interpreter the parent harness happens to run from: find an environment that","+# really provides the CLI and prepend it. A PATH that already resolves both is","+# left untouched, so an intentionally different environment still wins.","+# ---------------------------------------------------------------------------","+_magpie_env_has_cli() {  # $1 = bin dir, $2 = command","+    [ -n \"$1\" ] && [ -x \"$1/$2\" ]","+}","+","+_magpie_env_has_module() {  # $1 = bin dir, $2 = python module","+    [ -n \"$1\" ] && [ -x \"$1/python3\" ] \\","+        && \"$1/python3\" -c \"import importlib.util,sys;sys.exit(0 if importlib.util.find_spec('$2') else 1)\" \\","+        >/dev/null 2>&1","+}","+","+if ! command -v vllm >/dev/null 2>&1; then","+    _magpie_bin=\"\"","+    # 1) an interpreter the harness told us c