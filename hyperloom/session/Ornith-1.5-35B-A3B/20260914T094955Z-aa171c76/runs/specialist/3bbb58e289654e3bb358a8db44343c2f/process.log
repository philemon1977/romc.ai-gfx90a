se\n833\t            result.errors.append(\n834\t                \"server_lifecycle requires a Magpie built-in InferenceX benchmark \"\n835\t                \"script (vllm_mi300x.sh, vllm_mi355x.sh, sglang_mi300x.sh, \"\n836\t                \"sglang_mi355x.sh, atom_mi300x.sh, atom_mi355x.sh). Current \"\n837\t                f\"resolved script={script_name}. Set benchmark_script accordingly \"\n838\t                \"or omit server_lifecycle.\"\n839\t            )\n840\t            return result, \"\", \"\"\n841\t\n842\t        port = self._reuse_benchmark_port()\n843\t\n844\t        pid_dir, pid_file, meta_file = self._reuse_server_paths(port)\n845\t        desired = self._desired_reuse_server_meta(port)\n846\t\n847\t        if self._reuse_http_healthy(port):\n848\t            stored_meta = self._reuse_read_meta(meta_file)\n849\t            if not lc.force_reuse:\n850\t                mismatch = self._reuse_meta_mismatch(stored_meta, desired)\n851\t                if mismatch:\n852\t                    result.success = False\n853\t                    result.errors.append(\n854\t                        f\"Reuse metadata mismatch ({mismatch}); running server on \"\n855\t                        f\"PORT={port} is incompatible with this benchmark config \"\n856\t                        \"or leftover state is stale. Set server_lifecycle.\"\n857\t                        \"force_reuse=true to skip checks, recycle with cleanup:true, \"\n858\t                        \"or terminate the unrelated process manually.\"\n859\t                    )"}]},"parent_tool_use_id":null,"session_id":"9087e8e0-3c3d-46ce-bdfb-3ddcba42adf6","uuid":"409ee48b-3d5b-483c-bc6f-f24efb83f84a","timestamp":"2026-09-14T11:51:32.572Z","tool_use_result":{"type":"text","file":{"filePath":"/opt/envs/vllm/lib/python3.12/site-packages/Magpie/modes/benchmark/benchmarker.py","content":"        if symlink is None:\n            return\n        try:\n            if symlink.is_symlink():\n                symlink.u