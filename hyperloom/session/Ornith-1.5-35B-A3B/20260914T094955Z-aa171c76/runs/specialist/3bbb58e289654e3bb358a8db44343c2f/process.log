 Server-only writes PID to MAGPIE_SERVER_PID_FILE then disowns and exits.\n#\n# Remote server (BENCHMARK_BASE_URL): when set, the client phase points\n# benchmark_serving at an external vLLM-compatible HTTP endpoint\n# instead of localhost:$PORT, and forces PHASE=client (no local server\n# launch, no server-side cleanup, no SERVER_PID monitoring). Use this\n# whenever the server is hosted off-pod (different node, different\n# cluster, externally managed). Leave the env unset to keep the\n# default behaviour of launching a local server.\n\nsource \"$(dirname \"$0\")/benchmark_lib.sh\"\nsource \"$(dirname \"$0\")/server_cleanup.sh\"\n# shellcheck source=magpie_bench_remote_compat.sh\n[[ -f \"$(dirname \"$0\")/magpie_bench_remote_compat.sh\" ]] && source \"$(dirname \"$0\")/magpie_bench_remote_compat.sh\"\n\n# ---------------------------------------------------------------------------\n# Point-of-use self-alignment of the child environment.\n#\n# Both the server (`setsid vllm serve`) and the accuracy/throughput clients\n# (bare `python3`, `hf download`) are resolved through PATH. `benchmark.envs`\n# is applied to the child verbatim, so a PATH naming only a *different*\n# interpreter environment than the one vLLM is installed into takes the whole\n# run down in ~2s with `setsid: failed to execute vllm: No such file or\n# directory` -- even though Magpie itself is running from the correct one.\n#\n# Repair it here rather than relying on the parent harness: locate an\n# environment that really provides the CLI (and the modules the client imports)\n# and prepend it. A PATH that already resolves the framework is left untouched\n# and left in front, so an intentionally different environment still wins.\n# ---------------------------------------------------------------------------\n_magpie_env_has_cli() {  # $1 = bin dir, $2 = command\n    [ -n \"${1:-}\" ] && [ -x \"$1/$2\" ]\n}\n\n_magpie_env_has_module() {  # $1 = bin dir, $2 = python module\n    [ -n \"${1:-}\" ] && [ -x \"$1/python3\" ]         && \"$1/python3\" -c \"import importlib.util,sys;sys.exit(0 if importlib.util.find_spec('$2') else 1)\" >/dev/null 2>&1\n}\n\n_magpie_lm_eval_importable() {\n    python3 -c \"import importlib.util,sys;sys.exit(0 if importlib.util.find_spec('lm_eval') else 1)\" >/dev/null 2>&1\n}\n\nif ! command -v vllm >/dev/null 2>&1; then\n    _magpie_bin=\"\"\n    for _cand in \"${MAGPIE_PYTHON:-}\" \"${VLLM_PYTHON:-}\" \"$(command -v python3 || true)\"; do\n        [ -n \"$_cand\" ] || continue\n        _dir=$(dirname \"$_cand\")\n        if _magpie_env_has_cli \"$_dir\" vllm && _magpie_env_has_module \"$_dir\" huggingface_hub; then\n            _magpie_bin=\"$_dir\"; break\n        fi\n    done\n    if [ -z \"$_magpie_bin\" ]; then\n        for _cand in ${VLLM_VENV_ROOT:+\"$VLLM_VENV_ROOT/bin\"} ${FRAMEWORK_ROOT:+\"${FRAMEWORK_ROOT%/}/bin\"} /opt/envs/*/bin; do\n            [ -n \"$_cand\" ] || continue\n            if _magpie_env_has_cli \"$_cand\" vllm && _magpie_env_has_module \"$_cand\" huggingface_hub; then\n                _magpie_bin=\"$_cand\"; break\n            fi\n        done\n    fi\n    if [ -n \"$_magpie_bin\" ]; then\n        echo \"[vllm_mi300x] 'vllm' not resolvable on PATH; prepending framework bin '$_magpie_bin'\"\n        export PATH=\"$_magpie_bin:$PATH\"\n    else\n        echo \"[vllm_mi300x] WARN: no environment providing 'vllm' found; the server launch will fail\" >&2\n    fi\n    unset _magpie_bin _cand _dir\nfi\n\n# A ROCr-level mask filters AND renumbers the surviving agents to 0..N-1, so a\n# HIP/CUDA pin carried in host-physical ids selects nothing: the process ends up\n# with 0 usable GPUs while torch.cuda.device_count() still reports the ROCr\n# count, and every allocation dies with \"No CUDA GPUs are available\" (which\n# vLLM surfaces as \"Engine core initialization failed\"). Do this before the\n# first device consumer (`hf download`), and keep it idempotent -- values that\n# are already logical are left alone, so this co-exists with the same repair on\n# the harness side.\nif [ -n \"${ROCR_VISIBLE_DEVICES:-}\" ]; then\n    _magpie_n=$(echo \"$ROCR_VISIBLE_DEVICES\" | awk -F, '{print NF}')\n    _magpie_logical=$(seq -s, 0 $((_magpie_n - 1)))\n    for _magpie_var in HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES; do\n        _magpie_cur=\"${!_magpie_var:-}\"\n        [ -n \"$_magpie_cur\" ] || continue\n        case \",$_magpie_logical,\" in\n          *\",$_magpie_cur,\"*) : ;;                       # already a logical index\n          *) echo \"[vllm_mi300x] $_magpie_var=$_magpie_cur is not logical to ROCR_VISIBLE_DEVICES=$ROCR_VISIBLE_DEVICES; re-pinning to $_magpie_logical\"\n             export \"$_magpie_var=$_magpie_logical\" ;;\n        esac\n    done\n    unset _magpie_var _magpie_cur _magpie_n _magpie_logical\nfi\n\nPHASE=\"${MAGPIE_RUN_PHASE:-all}\"\ncase \"$PHASE\" in\n  all|server|client) ;;\n  *) echo \"ERROR: Invalid MAGPIE_RUN_PHASE='$PHASE'. Must be all|server|client.\" >&2; exit 2 ;;\nesac\n\nif [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n  if [[ \"$PHASE\" != \"client\" ]]; then\n    echo \"[vllm_mi300x] BENCHMARK_BASE_URL set; forcing PHASE=client (was $PHASE)\"\n    PHASE=client\n  fi\nfi\n\nif [[ \"$PHASE\" == \"server\" || \"$PHASE\" == \"all\" ]]; then\n  check_env_vars MODEL TP\nfi\nif [[ \"$PHASE\" == \"client\" || \"$PHASE\" == \"all\" ]]; then\n  check_env_vars MODEL CONC ISL OSL RANDOM_RANGE_RATIO RESULT_FILENAME\nfi\n\nMAX_MODEL_LEN=${MAX_MODEL_LEN:-4096}\nGPU_MEMORY_UTILIZATION=${GPU_MEMORY_UTILIZATION:-0.95}\n\nif [[ -n \"$SLURM_JOB_ID\" ]]; then\n  echo \"JOB $SLURM_JOB_ID running on $SLURMD_NODENAME\"\nfi\n\nif [[ \"$PHASE\" != \"client\" ]]; then\n  hf download \"$MODEL\" 2>/dev/null || true\nfi\n\n# MI300X specific: Check MEC firmware version for RCCL memory reclaim\nversion=$(rocm-smi --showfw 2>/dev/null | grep MEC | head -n 1 | awk '{print $NF}')\nif [[ \"$version\" == \"\" || $version -lt 177 ]]; then\n  export HSA_NO_SCRATCH_RECLAIM=1\nfi\n\n# ROCR_VISIBLE_DEVICES already re-indexes visible GPUs to 0..N-1, so HIP\n# must use the logical range, not the original physical ids.\nif [ -n \"$ROCR_VISIBLE_DEVICES\" ] && [ -z \"$HIP_VISIBLE_DEVICES\" ]; then\n    n=$(echo \"$ROCR_VISIBLE_DEVICES\" | awk -F, '{print NF}')\n    export HIP_VISIBLE_DEVICES=$(seq -s, 0 $((n-1)))\nfi\n\n# vLLM optimizations for MI300X\n_aiter_default=1\nif /opt/rocm/bin/rocminfo 2>/dev/null | grep -q \"gfx90a\"; then _aiter_default=0; fi\nexport VLLM_ROCM_USE_AITER=${VLLM_ROCM_USE_AITER:-$_aiter_default}\n\nWORKSPACE_DIR=${RESULT_DIR:-/workspace}\nSERVER_LOG=${SERVER_LOG:-$WORKSPACE_DIR/server.log}\nPORT=${PORT:-8888}\n\n# Build profiler args for vLLM >= 0.15 (env var VLLM_TORCH_PROFILER_DIR is deprecated)\nPROFILER_ARGS=()\nif [[ \"${PROFILE:-}\" == \"1\" ]]; then\n  TRACE_DIR=\"${VLLM_TORCH_PROFILER_DIR:-$WORKSPACE_DIR/torch_trace}\"\n  mkdir -p \"$TRACE_DIR\"\n  PROFILER_ARGS+=(--profiler-config.profiler torch)\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_dir \"$TRACE_DIR\")\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_record_shapes True)\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_with_memory True)\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_with_flops True)\n  PROFILER_ARGS+=(--profiler-config.torch_profiler_use_gzip True)\nfi\n\nset -x\nif [[ \"$PHASE\" == \"server\" || \"$PHASE\" == \"all\" ]]; then\n  setsid vllm serve $MODEL --port $PORT \\\n    --tensor-parallel-size=$TP \\\n    --gpu-memory-utilization 0.95 \\\n    --max-model-len $MAX_MODEL_LEN \\\n    --trust-remote-code \\\n    \"${PROFILER_ARGS[@]}\" \\\n    $EXTRA_VLLM_ARGS > $SERVER_LOG 2>&1 &\n\n  SERVER_PID=$!\n  if [[ \"$PHASE\" == \"all\" ]]; then\n    trap 'magpie_stop_benchmark_server_stack \"$SERVER_PID\"' EXIT INT TERM\n  fi\n\n  wait_for_server_ready --port \"$PORT\" --server-log \"$SERVER_LOG\" --server-pid \"$SERVER_PID\"\n\n  if [[ \"$PHASE\" == \"server\" ]]; then\n    if [[ -z \"${MAGPIE_SERVER_PID_FILE:-}\" ]]; then\n      echo \"ERROR: MAGPIE_SERVER_PID_FILE must be set for MAGPIE_RUN_PHASE=server\" >&2\n      kill -TERM \"-$SERVER_PID\" 2>/dev/null || true\n      exit 3\n    fi\n    printf '%s\\n' \"$SERVER_PID\" > \"$MAGPIE_SERVER_PID_FILE\"\n    disown \"$SERVER_PID\" 2>/dev/null || true\n    exit 0\n  fi\nfi\n\nSERVER_MONITOR_ARGS=()\nif [[ -n \"${SERVER_PID:-}\" ]]; then\n  SERVER_MONITOR_ARGS+=(--server-pid \"$SERVER_PID\")\nfi\n\nif [[ \"$PHASE\" == \"client\" || \"$PHASE\" == \"all\" ]]; then\n  if [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n    SERVER_MONITOR_ARGS=()\n    magpie_run_benchmark_serving_remote_direct trust || exit $?\n  else\n    run_benchmark_serving \\\n        --model \"$MODEL\" \\\n        --port \"$PORT\" \\\n        --backend vllm \\\n        --input-len \"$ISL\" \\\n        --output-len \"$OSL\" \\\n        --random-range-ratio \"$RANDOM_RANGE_RATIO\" \\\n        --num-prompts ${NUM_PROMPTS:-$(( $CONC * 10 ))} \\\n        --max-concurrency \"$CONC\" \\\n        --result-filename \"$RESULT_FILENAME\" \\\n        --result-dir \"$WORKSPACE_DIR/\" \\\n        \"${SERVER_MONITOR_ARGS[@]}\" \\\n        --trust-remote-code || exit $?\n  fi\nfi\n\n# After throughput, run evaluation only if RUN_EVAL is true\nif [[ \"$PHASE\" != \"server\" && \"${RUN_EVAL}\" = \"true\" ]]; then\n    if [[ -n \"${BENCHMARK_BASE_URL:-}\" ]]; then\n        if declare -F magpie_run_eval_remote_direct &>/dev/null; then\n            magpie_run_eval_remote_direct || exit $?\n        else\n            echo \"[vllm_mi300x] RUN_EVAL=true with BENCHMARK_BASE_URL but magpie_run_eval_remote_direct shim not available; skipping eval (results gate will see accuracy=None).\"\n        fi\n    else\n        run_eval --framework lm-eval --port \"$PORT\"\n        _magpie_eval_rc=$?\n        if [ \"$_magpie_eval_rc\" -eq 0 ]; then\n            append_lm_eval_summary\n        elif ! _magpie_lm_eval_importable; then\n            # The serving image does not ship lm-eval; run_eval installs it\n            # lazily, and when the package index is unreachable that install is\n            # the ONLY thing that failed -- the throughput stage already\n            # completed. Report it as a missing eval dependency (accuracy\n            # stays absent) instead of discarding the finished run. A failing\n            # eval with lm-eval importable is a real result and stays fatal.\n            echo \"[vllm_mi300x] WARN: eval stage failed (rc=${_magpie_eval_rc}) and lm_eval is still not importable; treating as a missing eval dependency, not a model failure. The gate will see accuracy=None for this run.\" >&2\n        else\n            exit \"$_magpie_eval_rc\"\n        fi\n        unset _magpie_eval_rc\n    fi\nfi\nset +x\n\n","structuredPatch":[{"oldStart":50,"oldLines":28,"newStart":50,"newLines":34,"lines":["     python3 -c \"import importlib.util,sys;sys.exit(0 if importlib.util.find_spec('lm_eval') else 1)\" >/dev/null 2>&1"," }"," ","-if ! command -v vllm >/dev/null 2>&1; then","+_magpie_child_env_ok() {  # server CLI AND client interpreter resolve to a working framework env","+    command -v vllm >/dev/null 2>&1 || return 1","+    command -v python3 >/dev/null 2>&1 || return 1","+    python3 -c 'import importlib.util as u, sys; sys.exit(0 if all(u.find_spec(m) for m in (\"transformers\", \"huggingface_hub\")) else 1)' >/dev/null 2>&1 || return 1","+}","+","+if ! _magpie_child_env_ok; then","     _magpie_bin=\"\"","     for _cand in \"${MAGPIE_PYTHON:-}\" \"${VLLM_PYTHON:-}\" \"$(command -v python3 || true)\"; do","         [ -n \"$_cand\" ] || continue","         _dir=$(dirname \"$_cand\")","-        if _magpie_env_has_cli \"$_dir\" vllm && _magpie_env_has_module \"$_dir\" huggingface_hub; then","+        if _magpie_env_has_cli \"$_dir\" vllm && _magpie_env_has_module \"$_dir\" transformers; then","             _magpie_bin=\"$_dir\"; break","         fi","     done","     if [ -z \"$_magpie_bin\" ]; then","         for _cand in ${VLLM_VENV_ROOT:+\"$VLLM_VENV_ROOT/bin\"} ${FRAMEWORK_ROOT:+\"${FRAMEWORK_ROOT%/}/bin\"} /opt/envs/*/bin; do","             [ -n \"$_cand\" ] || continue","-            if _magpie_env_has_cli \"$_cand\" vllm && _magpie_env_has_module \"$_cand\" huggingface_hub; then","+            if _magpie_env_has_cli \"$_cand\" vllm && _magpie_env_has_module \"$_cand\" transformers; then","                 _magpie_bin=\"$_cand\"; break","             fi","         done","     fi","     if [ -n \"$_magpie_bin\" ]; then","-        echo \"[vllm_mi300x] 'vllm' not resolvable on PATH; prepending framework bin '$_magpie_bin'\"","+        echo \"[vllm_mi300x] server CLI or client interpreter cannot resolve the framework env; prepending '$_magpie_bin' to PATH\"","         export PATH=\"$_magpie_bin:$PATH\"","     else","-        echo \"[vllm_mi300x] WARN: no environment providing 'vllm' found; the server launch will fail\" >&2","+        echo \"[vllm_mi300x] WARN: no environment providing 'vllm' + 'transformers' found; the run will likely fail\" >&2","     fi","     unset _magpie_bin _cand _dir"," fi"]}],"userModified":false,"replaceAll":false}}
