 # ROCR_VISIBLE_DEVICES already re-indexes visible GPUs to 0..N-1, so HIP
-# must use the logical range, not the original physical ids.
-if [ -n "$ROCR_VISIBLE_DEVICES" ] && [ -z "$HIP_VISIBLE_DEVICES" ]; then
+# must use the logical range, not the original physical ids. A HIP id past the
+# end of that re-indexed range filters out every device (the child then sees
+# 0 usable GPUs), so also repair a HIP/CUDA pin that a launcher exported in
+# host-physical ids.
+if [ -n "${ROCR_VISIBLE_DEVICES:-}" ]; then
     n=$(echo "$ROCR_VISIBLE_DEVICES" | awk -F, '{print NF}')
-    export HIP_VISIBLE_DEVICES=$(seq -s, 0 $((n-1)))
+    logical=$(seq -s, 0 $((n-1)))
+    for _var in HIP_VISIBLE_DEVICES CUDA_VISIBLE_DEVICES; do
+        _cur="${!_var:-}"
+        if [ -z "$_cur" ]; then continue; fi
+        case ",$logical," in
+          *",$_cur,"*) : ;;                        # already a logical index
+          *) echo "[$_var=$_cur is not logical to ROCR_VISIBLE_DEVICES=$ROCR_VISIBLE_DEVICES; re-pinning to $logical]"
+             export "$_var=$logical" ;;
+        esac
+    done
+    unset _var _cur
+    if [ -z "${HIP_VISIBLE_DEVICES:-}" ]; then
+        export HIP_VISIBLE_DEVICES=$logical
+    fi
+    unset n logical
 fi
 
