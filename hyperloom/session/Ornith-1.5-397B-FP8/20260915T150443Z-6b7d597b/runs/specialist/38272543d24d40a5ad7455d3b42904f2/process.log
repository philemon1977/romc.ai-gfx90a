ale with {scale.numel()} elements \"","-                f\"matches neither N={n} nor K={k}.\"","+        w_f32 = w_nk.to(torch.float32)","+        if weight_scale is None or weight_scale.numel() == 1:","+            scale = (","+                1.0","+                if weight_scale is None","+                else weight_scale.to(torch.float32).reshape(-1)[0]","             )","+            return w_f32 * scale","+        scale = weight_scale.to(torch.float32).reshape(-1)","+        if scale.numel() == n:","+            return w_f32 * scale.unsqueeze(1)","+        if scale.numel() == k:","+            return w_f32 * scale.unsqueeze(0)","+        raise ValueError(","+            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"","+            f\"matches neither N={n} nor K={k}.\"","+        )"," ","+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:","+        weight, weight_scale, _, _ = self._get_layer_params(layer)","+        if weight is None or weight.dtype not in _FP8_DTYPES:","+            # Already dequantized by a previous pass (or never FP8).","+            return","+","         out_dtype = self.config.out_dtype or torch.get_default_dtype()","-        self.__class__._bytes_before += w.numel() * w.element_size()","-        self.__class__._bytes_after += w_dq.numel() * out_dtype.itemsize","+        w_dq = self._dequant_weight(weight, weight_scale).to(out_dtype)","+","+        self.__class__._bytes_before += weight.numel() * weight.element_size()","+        self.__class__._bytes_after += w_dq.numel() * w_dq.element_size()","         logger.info_once(","-            \"Emulating FP8 w8a8 linears with %s GEMM on this GPU (no hardware \"","-            \"FP8 / torch._scaled_mm support): dequantizing dense weights at \"","-            \"load time (%.2f GiB -> %.2f GiB across all such layers).\",","+            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"","+            \"hardware FP8 / torch._scaled_mm support): dequantizing weights at \"","+            \"load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",","             str(out_dtype).replace(\"torch.\", \"\"),","             self.__class__._bytes_before / 2**30,","             self.__class__._bytes_after / 2**30,","             scope=\"global\",","         )"," ","-        replace_parameter(layer, \"weight\", Parameter(w_dq.to(out_dtype), requires_grad=False))","-        # Scales are folded into the weight; keep the parameter (some callers","-        # assert on its presence) but mark it consumed.","-        layer.weight.input_dim = 1","-        layer.weight.output_dim = 0","+        # Store as a [N, K] Parameter so apply_weights can call F.linear","+        # directly (weight_loader is not needed after loading).","+        replace_parameter(layer, \"weight\", Parameter(w_dq, requires_grad=False))"," ","     def apply_weights(","         self,"]},{"oldStart":153,"oldLines":32,"newStart":170,"newLines":26,"lines":["         bias: torch.Tensor | None = None,","     ) -> torch.Tensor:","         if isinstance(x, QuantizedActivation):","-            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype)","+            # Defensive: the base-class contract hands pre-quantized","+            # activations to kernels that opt in via input_quant_key(); this","+            # kernel does not, so a plain tensor is expected.","+            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(","+                *x.orig_shape","+            )"," ","         weight = layer.weight","-        if weight.element_size() < 2:","-            # Not pre-dequantized (e.g. process_weights_after_loading was","-            # skipped): dequantize on the fly.","-            _, w_s, _, _ = self._get_layer_params(layer)","-            weight = weight.t() if weight.stride(1) == 1 else weight","-            n, k = weight.shape","-            scale = None if w_s is None else w_s.to(torch.float32)","-            if scale is None or scale.numel() == 1:","-                weight = weight.to(torch.float32) * (","-                    1.0 if scale is None else scale.reshape(-1)[0]","-                )","-            elif scale.numel() == n:","-                weight = weight.to(torch.float32) * scale.reshape(n, 1)","-            else:","-                weight = weight.to(torch.float32) * scale.reshape(1, k)","+        if weight.dtype in _FP8_DTYPES:","+            # Not pre-dequantized (process_weights_after_loading skipped):","+            # dequantize on the fly so we never reach torch._scaled_mm.","+            _, weight_scale, _, _ = self._get_layer_params(layer)","+            weight = self._dequant_weight(weight, weight_scale)"," ","         # F.linear requires matching dtypes; .to() is a no-op when they agree.","-        weight = weight.to(x.dtype)","-        return torch.nn.functional.linear(x, weight, bias).to(x.dtype)","+        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)"," ","     def apply_scaled_mm(self, **kwargs) -> torch.Tensor:","-        # Unused: this kernel overrides apply_weights and never calls","-        # torch._scaled_mm (which is unavailable on pre-MI300 ROCm).","+        # This kernel overrides apply_weights and must never call","+        # torch._scaled_mm, which is unavailable on pre-MI300 ROCm.","         raise NotImplementedError(","             \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"","             \"apply_scaled_mm is intentionally not implemented.\""]}],"originalFile":"# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\n\"\"\"FP8 w8a8 linear emulation for AMD GPUs without hardware FP8 MMA.\n\n``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm devices older than MI300\n(\"torch._scaled_mm is only supported on CUDA devices with compute capability\n>= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 parts (gfx908/gfx90a, e.g. MI250X)\nhave no FP8 matrix instruction at all, so no scaled-mm provider can serve an\nFP8 checkpoint there -- the pre-MI300 ROCm kernel registry used to fall through\nto ``ChannelWiseTorchFP8ScaledMMLinearKernel`` and abort inside ``profile_run``.\n\nThis kernel bridges that gap by dequantizing the FP8 weight to the activation\ndtype ONCE at load time and running a plain ``F.linear`` -- the same recipe\nalready used in-tree by\n\n* ``model_executor/layers/quantization/fp8.py`` (``VLLM_BATCH_INVARIANT``\n  per-tensor/channel path: \"dequant to BF16 and run GEMM\"), and\n* ``model_executor/kernels/linear/mxfp8/emulation.py``\n  (``EmulationMxfp8LinearKernel``, load-time dequant gated on\n  ``VLLM_MXFP8_EMULATION_DEQUANT_AT_LOAD``).\n\nThe FP8 -> BF16 cast is exact (E4M3's 3-bit mantissa / 4-bit exponent fit in\nBF16), so the only added error is one BF16 rounding of the dequantized product\n(~2^-9 relative), against ~2^-4 intrinsic FP8 weight error. Only *dense*\nlinears take this path, so the 1-byte -> 2-byte weight growth is small; MoE\nexperts keep their own Triton FP8 kernels.\n\nOpt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n\"\"\"\n\nimport torch\nfrom torch.nn.parameter import Parameter\n\nfrom vllm.logger import init_logger\nfrom vllm.model_executor.layers.fusion.quant_activation import (\n    QuantizedActivation,\n)\nfrom vllm.model_executor.layers.quantization.utils import replace_parameter\nfrom vllm.platforms import current_platform\n\nfrom .ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n)\n\nlogger = init_logger(__name__)\n\n\ndef _rocm_lacks_hw_fp8() -> bool:\n    \"\"\"True on AMD CDNA1/CDNA2 GPUs, which have no FP8 MMA / no scaled_mm.\"\"\"\n    if not current_platform.is_rocm():\n        return False\n\n    from vllm.platforms.rocm import get_cdna_version, on_cdna\n\n    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n    # FP8 (and therefore torch._scaled_mm / hipBLASLt FP8) starts at CDNA3.\n    return on_cdna() and get_cdna_version() < 3\n\n\nclass FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n    \"\"\"FP8 w8a8 linear via load-time dequant, for GPUs without FP8 hardware.\"\"\"\n\n    # Track how much weight memory the dequant grows, once per process.\n    _bytes_before = 0\n    _bytes_after = 0\n\n    @classmethod\n    def is_supported(\n        cls, compute_capability: int | None = None\n    ) -> tuple[bool, str | None]:\n        if not _rocm_lacks_hw_fp8():\n            return False, (\n                \"is only used on ROCm CDNA1/CDNA2 (pre-MI300) GPUs, which \"\n                \"have no FP8 hardware and no torch._scaled_mm support.\"\n            )\n        return True, None\n\n    @classmethod\n    def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:\n        if c.weight_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 weights.\"\n        out_dtype = c.out_dtype or torch.get_default_dtype()\n        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n            return False, f\"requires a >= 2-byte floating point output dtype.\"\n        return True, None\n\n    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n        \"\"\"Dequantize the FP8 weight to the activation dtype exactly once.\n\n        CompressedTensors/ModelOpt leave ``layer.weight`` as a transposed\n        ``[K, N]`` view of the ``[N, K]`` checkpoint tensor, and\n        ``layer.weight_scale`` as ``[N, 1]`` (channel) or a scalar-ish tensor\n        (tensor-wise). The dequantized weight is stored ``[N, K]`` so\n        ``apply_weights`` can run ``F.linear`` directly.\n        \"\"\"\n        w, w_s, _, _ = self._get_layer_params(layer)\n        if w is None or w.dtype not in (\n            torch.float8_e4m3fn,\n            torch.float8_e4m3fnuz,\n            torch.float8_e5m2,\n        ):\n            # Already dequantized (or never FP8) -- nothing to do.\n            return\n\n        # [N, K], contiguous where possible.\n        w_nk = w.t() if w.dim() == 2 and w.stride(1) == 1 else w\n        if w_nk.stride(-1) != 1:\n            w_nk = w_nk.contiguous()\n        n, k = w_nk.shape\n\n        scale = w_s.to(torch.float32) if w_s is not None else None\n        if scale is None or scale.numel() == 1:\n            w_dq = w_nk.to(torch.float32) * (0.0 if scale is None else scale.reshape(-1)[0])\n        elif scale.dim() >= 2 and scale.shape[0] == n and scale.shape[-1] == 1:\n            w_dq = w_nk.to(torch.float32) * scale.reshape(n, 1)\n        elif scale.dim() >= 2 and scale.shape[-1] == n and scale.shape[0] == 1:\n            w_dq = w_nk.to(torch.float32) * scale.reshape(1, n)\n        elif scale.numel() == n:\n            w_dq = w_nk.to(torch.float32) * scale.reshape(n, 1)\n        elif scale.numel() == k:\n            w_dq = w_nk.to(torch.float32) * scale.reshape(1, k)\n        else:\n            raise ValueError(\n                f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n                f\"matches neither N={n} nor K={k}.\"\n            )\n\n        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n        self.__class__._bytes_before += w.numel() * w.element_size()\n        self.__class__._bytes_after += w_dq.numel() * out_dtype.itemsize\n        logger.info_once(\n            \"Emulating FP8 w8a8 linears with %s GEMM on this GPU (no hardware \"\n            \"FP8 / torch._scaled_mm support): dequantizing dense weights at \"\n            \"load time (%.2f GiB -> %.2f GiB across all such layers).\",\n            str(out_dtype).replace(\"torch.\", \"\"),\n            self.__class__._bytes_before / 2**30,\n            self.__class__._bytes_after / 2**30,\n            scope=\"global\",\n        )\n\n        replace_parameter(layer, \"weight\", Parameter(w_dq.to(out_dtype), requires_grad=False))\n        # Scales are folded into the weight; keep the parameter (some callers\n        # assert on its presence) but mark it consumed.\n        layer.weight.input_dim = 1\n        layer.weight.output_dim = 0\n\n    def apply_weights(\n        self,\n        layer: torch.nn.Module,\n        x: torch.Tensor | QuantizedActivation,\n        bias: torch.Tensor | None = None,\n    ) -> torch.Tensor:\n        if isinstance(x, QuantizedActivation):\n            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype)\n\n        weight = layer.weight\n        if weight.element_size() < 2:\n            # Not pre-dequantized (e.g. process_weights_after_loading was\n            # skipped): dequantize on the fly.\n            _, w_s, _, _ = self._get_layer_params(layer)\n            weight = weight.t() if weight.stride(1) == 1 else weight\n            n, k = weight.shape\n            scale = None if w_s is None else w_s.to(torch.float32)\n            if scale is None or scale.numel() == 1:\n                weight = weight.to(torch.float32) * (\n                    1.0 if scale is None else scale.reshape(-1)[0]\n                )\n            elif scale.numel() == n:\n                weight = weight.to(torch.float32) * scale.reshape(n, 1)\n            else:\n                weight = weight.to(torch.float32) * scale.reshape(1, k)\n\n        # F.linear requires matching dtypes; .to() is a no-op when they agree.\n        weight = weight.to(x.dtype)\n        return torch.nn.functional.linear(x, weight, bias).to(x.dtype)\n\n    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n        # Unused: this kernel overrides apply_weights and never calls\n        # torch._scaled_mm (which is unavailable on pre-MI300 ROCm).\n        raise NotImplementedError(\n            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n            \"apply_scaled_mm is intentionally not implemented.\"\n        )\n","userModified":false}}
