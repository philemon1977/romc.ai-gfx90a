t-quantization error. The activation is additionally","+NOT re-quantized to FP8 (it stays BF16), which removes the activation-quant","+error term the FP8 path would have had."," "," Opt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``."," \"\"\""]},{"oldStart":66,"oldLines":16,"newStart":75,"newLines":16,"lines":["     from vllm.platforms.rocm import get_cdna_version, on_cdna"," ","     # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.","-    # Hardware FP8 (and therefore hipBLASLt FP8 scaled-mm) starts at CDNA3.","+    # Hardware FP8 (and hence hipBLASLt FP8 scaled-mm) starts at CDNA3.","     return on_cdna() and get_cdna_version() < 3"," "," "," class FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):","     \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\""," ","-    # Accumulated across all rewritten layers, for a single informational log.","-    _bytes_before = 0","-    _bytes_after = 0","+    # Accumulated over all rewritten layers, for one informational log line.","+    _fp8_bytes = 0","+    _dq_bytes = 0"," ","     @classmethod","     def is_supported("]},{"oldStart":92,"oldLines":35,"newStart":101,"newLines":42,"lines":["     def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:","         if c.weight_quant_key.scale.group_shape.is_per_group():","             return False, \"cannot implement block/group-wise FP8 weights.\"","-        if c.activation_quant_key.scale.group_shape.is_per_group():","-            return False, \"cannot implement block/group-wise FP8 activations.\"","         out_dtype = c.out_dtype or torch.get_default_dtype()","         if not out_dtype.is_floating_point or out_dtype.itemsize < 2:","             return False, f\"requires a >= 2-byte floating point output dtype.\"","         return True, None"," ","     @staticmethod","-    def _dequant_weight(","-        weight: torch.Tensor, weight_scale: torch.Tensor | None","-    ) -> torc