{"type":"assistant","message":{"id":"msg_3acafc21-3e04-4894-a67f-d739eba2734d","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call_b7b4fcd54350f9ac","name":"Bash","input":{"command":"cd /home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-397B-FP8/20260915T150443Z-6b7d597b/runs/specialist/38272543d24d40a5ad7455d3b42904f2\ncat > scratch/t_tsm.py <<'EOF'\nimport os, torch, time\nos.environ.setdefault(\"VLLM_ROCM_USE_AITER\",\"0\")\nfrom vllm.model_executor.layers.quantization.compressed_tensors.triton_scaled_mm import triton_scaled_mm\ndev='cuda'; dt=torch.float8_e4m3fn\ntorch.manual_seed(0)\ndef ref(A,B,As,Bs,odtype):\n    return ((A.float()*As) @ (B.float()*Bs.t().float())).to(odtype)\nfor (M,N,K) in [(1024,4096,4096),(64,4096,1024),(1,1024,4096),(256,7168,4096),(6144,4096,512)]:\n    A = (torch.randn(M,K,device=dev)*0.2).clamp(-4,4).to(dt)\n    W = (torch.randn(N,K,device=dev)*0.2).clamp(-4,4).to(dt)   # [N,K] contiguous (like layer.weight before .t())\n    B = W.t()                                                   # [K,N] transposed view, as CompressedTensors leaves it\n    As = (torch.rand(M,1,device=dev,dtype=torch.float32)*0.01+0.001)\n    Bs = (torch.rand(N,1,device=dev,dtype=torch.float32)*0.01+0.001)\n    try:\n        out = triton_scaled_mm(A, B, scale_a=As, scale_b=Bs, out_dtype=torch.bfloat16)\n        r = ref(A,B,As,Bs,torch.bfloat16).float()\n        err = (out.float()-r).abs().max().item(); rel = err/max(1e-6, r.abs().max().item())\n        t0=time.time()\n        for _ in range(10): triton_scaled_mm(A, B, scale_a=As, scale_b=Bs, out_dtype=torch.bfloat16)\n        torch.cuda.synchronize(); tf = 2*M*N*K*10/(time.time()-t0)/1e12\n        # bf16 matmul roofline reference\n        Ab=A.to(torch.bfloat16); Bb=B.to(torch.bfloat16)\n        t0=time.time()\n        for _ in range(10): Ab@Bb\n        torch.cuda.synchronize(); tfb = 2*M*N*K*10/(time.time()-t0)/1e12\n        print(f\"M{M} N{N} K{K}: shape={tuple(out.shape)} dtype={out.dtype} maxabs={err:.4g} rel={rel:.3g} triton_fp8={tf:.1f}TF plain_bf16={tfb:.1f}TF\")\n    except Exception as e:\n        print(f\"M{M} N{N} K{K}: FAIL {type(e).__name__}: {str(e)[:400]}\")\nEOF\nHIP_VISIBLE_DEVICES=7 VLLM_CACHE_ROOT=$PWD/scratch/vcache /opt/envs/vllm/bin/python scratch/t_tsm.py 2>&1 | grep -v \"^W2026\\|WARNING\\|deprecated\" | tail -20","description":"Verify triton_scaled_mm fp8 w8a8 correctness and speed on gfx90a"}}],"model":"qwen3.8-flash-next","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6d8d162a-aacb-49eb-8d41-ca88b571bdc8","uuid":"95d0b7ec-0f06-488a-8963-cce6bf0e5441"}
