{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_8ca6d7221f418992","type":"tool_result","content":"104| class GroupShape(_GroupShape):\n105|     \"\"\"\n106|     This class describes the quantization group shape.\n107|     It includes static members for common shapes (per-tensor, per-token).\n108|     \"\"\"\n109| \n110|     # Aliases for common quantization group shapes\n111|     PER_TENSOR: ClassVar[\"GroupShape\"]\n112|     PER_TOKEN: ClassVar[\"GroupShape\"]\n113|     PER_CHANNEL: ClassVar[\"GroupShape\"]\n114| \n115|     def is_per_tensor(self) -> bool:\n116|         return self.row == -1 and self.col == -1\n117| \n118|     def is_per_token(self) -> bool:\n119|         return self.row == 1 and self.col == -1\n120| \n121|     def is_per_channel(self) -> bool:\n122|         return self.row == -1 and self.col == 1\n123| \n124|     def is_per_group(self) -> bool:\n125|         return self.row == 1 and self.col >= 1\n126| \n127| \n128| GroupShape.PER_TENSOR = GroupShape(-1, -1)\n129| GroupShape.PER_TOKEN = GroupShape(1, -1)\n130| GroupShape.PER_CHANNEL = GroupShape(-1, 1)\n131| \n132| \n133| @dataclass(frozen=True)\n134| class ScaleDesc:\n135|     \"\"\"\n136|     Class for describing a single quantization scaling factor.\n137|     dtype: data type of the scale\n138|     static: static scale if True, dynamic if False\n139|     group_shape: group shape of the scale\n140|     \"\"\"\n141| \n142|     dtype: torch.dtype\n143|     static: bool\n144|     group_shape: GroupShape\n145| \n146|     def __str__(self):\n147|         d = {\n148|             GroupShape.PER_TENSOR: \"per_tensor\",\n149|             GroupShape.PER_TOKEN: \"per_token\",\n150|             GroupShape.PER_CHANNEL: \"per_channel\",\n151|         }\n152|         group_shape = d.get(self.group_shape, str(self.group_shape))\n153| \n154|         return (\n155|             f\"{fx.graph.dtype_abbrs[self.dtype]},\"\n156|             f\"{'static' if self.static else 'dynamic'},{group_shape}\"\n157|         )\n158| \n159| \n160| @dataclass(frozen=True)\n161| class QuantKey:\n162|     \"\"\"\n163|     Class for identifying the type of quantization.\n164|     dtype: quantized data type\n165|     scale: scale descriptor\n166|     scale2: second-level scale descriptor\n167|     symmetric: symmetric if True, asymmetric if False\n168|     \"\"\"\n169| \n170|     # TODO: QuantKey.dtype is assumed to be `torch.dtype` in matcher_utils.py,\n171|     # but #37990 introduced e.g. `kInt4Static` that uses a `ScalarType` dtype,\n172|     # same for kMxfp6 that does not have a native torch representation.\n173|     # Logical dtype and storage (torch) dtype should be separated (see #48949).\n174|     dtype: torch.dtype | ScalarType\n175|     scale: ScaleDesc\n=== kFp8 keys ===\n194:kFp8StaticTensorSym = QuantKey(FP8_DTYPE, kStaticTensorScale, symmetric=True)\n203:kFp8StaticChannelSym = QuantKey(FP8_DTYPE, kStaticChannelScale, symmetric=True)\n206:kFp8DynamicTokenSym = QuantKey(FP8_DTYPE, kDynamicTokenScale, symmetric=True)","is_error":false}]},"parent_tool_use_id":null,"session_id":"6d8d162a-aacb-49eb-8d41-ca88b571bdc8","uuid":"ab400a6b-df24-46d7-82e5-9d735a4cc01e","timestamp":"2026-09-15T15:43:50.768Z","tool_use_result":{"stdout":"104| class GroupShape(_GroupShape):\n105|     \"\"\"\n106|     This class describes the quantization group shape.\n107|     It includes static members for common shapes (per-tensor, per-token).\n108|     \"\"\"\n109| \n110|     # Aliases for common quantization group shapes\n111|     PER_TENSOR: ClassVar[\"GroupShape\"]\n112|     PER_TOKEN: ClassVar[\"GroupShape\"]\n113|     PER_CHANNEL: ClassVar[\"GroupShape\"]\n114| \n115|     def is_per_tensor(self) -> bool:\n116|         return self.row == -1 and self.col == -1\n117| \n118|     def is_per_token(self) -> bool:\n119|         return self.row == 1 and self.col == -1\n120| \n121|     def is_per_channel(self) -> bool:\n122|         return self.row == -1 and self.col == 1\n123| \n124|     def is_per_group(self) -> bool:\n125|         return self.row == 1 and self.col >= 1\n126| \n127| \n128| GroupShape.PER_TENSOR = GroupShape(-1, -1)\n129| GroupShape.PER_TOKEN = GroupShape(1, -1)\n130| GroupShape.PER_CHANNEL = GroupShape(-1, 1)\n131| \n132| \n133| @dataclass(frozen=True)\n134| class ScaleDesc:\n135|     \"\"\"\n136|     Class for describing a single quantization scaling factor.\n137|     dtype: data type of the scale\n138|     static: static scale if True, dynamic if False\n139|     group_shape: group shape of the scale\n140|     \"\"\"\n141| \n142|     dtype: torch.dtype\n143|     static: bool\n144|     group_shape: GroupShape\n145| \n146|     def __str__(self):\n147|         d = {\n148|             GroupShape.PER_TENSOR: \"per_tensor\",\n149|             GroupShape.PER_TOKEN: \"per_token\",\n150|             GroupShape.PER_CHANNEL: \"per_channel\",\n151|         }\n152|         group_shape = d.get(self.group_shape, str(self.group_shape))\n153| \n154|         return (\n155|             f\"{fx.graph.dtype_abbrs[self.dtype]},\"\n156|             f\"{'static' if self.static else 'dynamic'},{group_shape}\"\n157|         )\n158| \n159| \n160| @dataclass(frozen=True)\n161| class QuantKey:\n162|     \"\"\"\n163|     Class for identifying the type of quantization.\n164|     dtype: quantized data type\n165|     scale: scale descriptor\n166|     scale2: second-level scale descriptor\n167|     symmetric: symmetric if True, asymmetric if False\n168|     \"\"\"\n169| \n170|     # TODO: QuantKey.dtype is assumed to be `torch.dtype` in matcher_utils.py,\n171|     # but #37990 introduced e.g. `kInt4Static` that uses a `ScalarType` dtype,\n172|     # same for kMxfp6 that does not have a native torch representation.\n173|     # Logical dtype and storage (torch) dtype should be separated (see #48949).\n174|     dtype: torch.dtype | ScalarType\n175|     scale: ScaleDesc\n=== kFp8 keys ===\n194:kFp8StaticTensorSym = QuantKey(FP8_DTYPE, kStaticTensorScale, symmetric=True)\n203:kFp8StaticChannelSym = QuantKey(FP8_DTYPE, kStaticChannelScale, symmetric=True)\n206:kFp8DynamicTokenSym = QuantKey(FP8_DTYPE, kDynamicTokenScale, symmetric=True)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"assistant","message":{"id":"msg_f0f7c842-efdb-48f8-990a-96ede9c62a8e","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call_ab505c2155457cfd","name":"Write","input":{"file_path":"/home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-397B-FP8/20260915T150443Z-6b7d597b/runs/specialist/38272543d24d40a5ad7455d3b42904f2/wt2/pkg/vllm/model_executor/kernels/linear/scaled_mm/emulation.py","content":"# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\n\"\"\"FP8 w8a8 linear emulation for AMD GPUs that lack hardware FP8.\n\n``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm devices older than MI300\n(\"torch._scaled_mm is only supported on CUDA devices with compute capability\n>= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 parts (gfx908/gfx90a, e.g. MI250X)\nhave no FP8 matrix instruction at all, so *no* scaled-mm provider can serve an\nFP8 checkpoint there: the pre-MI300 ROCm kernel registry fell through every\naiter/skinny/rowwise gate and landed on\n``ChannelWiseTorchFP8ScaledMMLinearKernel``, which aborted inside\n``profile_run``.\n\nThis kernel bridges that gap by dequantizing the FP8 weight to the activation\ndtype ONCE at load time and then running a plain ``F.linear`` -- the same\nrecipe already used in-tree by\n\n* ``model_executor/layers/quantization/fp8.py`` (``VLLM_BATCH_INVARIANT``\n  per-tensor/per-channel path: \"dequant to BF16 and run GEMM\"), and\n* ``model_executor/kernels/linear/mxfp8/emulation.py``\n  (``EmulationMxfp8LinearKernel``: dequantize at load, run a plain BF16 linear).\n\nThe FP8 -> BF16 cast is exact (E4M3's 3+1-bit mantissa and 4-bit exponent both\nfit in BF16), so the only error added versus the intended scaled-GEMM is one\nBF16 rounding of the dequantized weight (~2^-9 relative) against ~2^-4\nintrinsic FP8 weight quantization error.\n\nOnly *dense* linears take this path -- MoE experts have their own kernels -- so\nthe 1-byte -> 2-byte weight growth is bounded by the dense (non-expert)\nparameter count. On a 512-expert MoE that is a small fraction of the checkpoint.\n\nOpt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n\"\"\"\n\nimport torch\nfrom torch.nn.parameter import Parameter\n\nfrom vllm.logger import init_logger\nfrom vllm.model_executor.layers.fusion.quant_activation import (\n    QuantizedActivation,\n)\nfrom vllm.model_executor.utils import replace_parameter\nfrom vllm.platforms import current_platform\n\nfrom .ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n)\n\nlogger = init_logger(__name__)\n\n_FP8_DTYPES = (\n    torch.float8_e4m3fn,\n    torch.float8_e4m3fnuz,\n    torch.float8_e5m2,\n    torch.float8_e5m2fnuz,\n)\n\n\ndef rocm_lacks_hardware_fp8() -> bool:\n    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n    if not current_platform.is_rocm():\n        return False\n\n    from vllm.platforms.rocm import get_cdna_version, on_cdna\n\n    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n    # Hardware FP8 (and therefore hipBLASLt FP8 scaled-mm) starts at CDNA3.\n    return on_cdna() and get_cdna_version() < 3\n\n\nclass FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n\n    # Accumulated across all rewritten layers, for a single informational log.\n    _bytes_before = 0\n    _bytes_after = 0\n\n    @classmethod\n    def is_supported(\n        cls, compute_capability: int | None = None\n    ) -> tuple[bool, str | None]:\n        if not rocm_lacks_hardware_fp8():\n            return False, (\n                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n                \"FP8 and no torch._scaled_mm support.\"\n            )\n        return True, None\n\n    @classmethod\n    def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:\n        if c.weight_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 weights.\"\n        if c.activation_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 activations.\"\n        out_dtype = c.out_dtype or torch.get_default_dtype()\n        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n            return False, f\"requires a >= 2-byte floating point output dtype.\"\n        return True, None\n\n    @staticmethod\n    def _dequant_weight(\n        weight: torch.Tensor, weight_scale: torch.Tensor | None\n    ) -> torch.Tensor:\n        \"\"\"Return the dequantized weight as a [N, K] float tensor.\n\n        CompressedTensors/ModelOpt leave ``layer.weight`` as a transposed\n        ``[K, N]`` view of the ``[N, K]`` checkpoint tensor, with\n        ``weight_scale`` shaped ``[N, 1]`` (channel) or 1-element (tensor).\n        \"\"\"\n        # Undo the process-time transpose so we are back to [N, K].\n        if weight.dim() == 2 and weight.stride(1) == 1 and weight.shape[0] != weight.stride(0):\n            w_nk = weight  # already [N, K]-ish\n        elif weight.dim() == 2 and weight.stride(0) == 1:\n            w_nk = weight.t()\n        else:\n            w_nk = weight\n        if w_nk.stride(-1) != 1:\n            w_nk = w_nk.contiguous()\n        n, k = w_nk.shape\n\n        w_f32 = w_nk.to(torch.float32)\n        if weight_scale is None or weight_scale.numel() == 1:\n            scale = (\n                1.0\n                if weight_scale is None\n                else weight_scale.to(torch.float32).reshape(-1)[0]\n            )\n            return w_f32 * scale\n        scale = weight_scale.to(torch.float32).reshape(-1)\n        if scale.numel() == n:\n            return w_f32 * scale.unsqueeze(1)\n        if scale.numel() == k:\n            return w_f32 * scale.unsqueeze(0)\n        raise ValueError(\n            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n            f\"matches neither N={n} nor K={k}.\"\n        )\n\n    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n        weight, weight_scale, _, _ = self._get_layer_params(layer)\n        if weight is None or weight.dtype not in _FP8_DTYPES:\n            # Already dequantized by a previous pass (or never FP8).\n            return\n\n        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n        w_dq = self._dequant_weight(weight, weight_scale).to(out_dtype)\n\n        self.__class__._bytes_before += weight.numel() * weight.element_size()\n        self.__class__._bytes_after += w_dq.numel() * w_dq.element_size()\n        logger.info_once(\n            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"\n            \"hardware FP8 / torch._scaled_mm support): dequantizing weights at \"\n            \"load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",\n            str(out_dtype).replace(\"torch.\", \"\"),\n            self.__class__._bytes_before / 2**30,\n            self.__class__._bytes_after / 2**30,\n            scope=\"global\",\n        )\n\n        # Store as a [N, K] Parameter so apply_weights can call F.linear\n        # directly (weight_loader is not needed after loading).\n        replace_parameter(layer, \"weight\", Parameter(w_dq, requires_grad=False))\n\n    def apply_weights(\n        self,\n        layer: torch.nn.Module,\n        x: torch.Tensor | QuantizedActivation,\n        bias: torch.Tensor | None = None,\n    ) -> torch.Tensor:\n        if isinstance(x, QuantizedActivation):\n            # Defensive: the base-class contract hands pre-quantized\n            # activations to kernels that opt in via input_quant_key(); this\n            # kernel does not, so a plain tensor is expected.\n            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(\n                *x.orig_shape\n            )\n\n        weight = layer.weight\n        if weight.dtype in _FP8_DTYPES:\n            # Not pre-dequantized (process_weights_after_loading skipped):\n            # dequantize on the fly so we never reach torch._scaled_mm.\n            _, weight_scale, _, _ = self._get_layer_params(layer)\n            weight = self._dequant_weight(weight, weight_scale)\n\n        # F.linear requires matching dtypes; .to() is a no-op when they agree.\n        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)\n\n    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n        # This kernel overrides apply_weights and must never call\n        # torch._scaled_mm, which is unavailable on pre-MI300 ROCm.\n        raise NotImplementedError(\n            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n            \"apply_scaled_mm is intentionally not implemented.\"\n        )\n"}}],"model":"qwen3.8-flash-next","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6d8d162a-aacb-49eb-8d41-ca88b571bdc8","uuid":"96c32782-fa40-46df-aece-7b2f20712d2c"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ab505c2155457cfd","type":"tool_result","content":"The file /home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-397B-FP8/20260915T150443Z-6b7d597b/runs/specialist/38272543d24d40a5ad7455d3b42904f2/wt2/pkg/vllm/model_executor/kernels/linear/scaled_mm/emulation.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"6d8d162a-aacb-49eb-8d41-ca88b571bdc8","uuid":"dae78d3d-6178-4329-8ed9-f4af0a582200","timestamp":"2026-09-15T15:44:05.875Z","tool_use_result":{"type":"update","filePath":"/home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-397B-FP8/20260915T150443Z-6b7d597b/runs/specialist/38272543d24d40a5ad7455d3b42904f2/wt2/pkg/vllm/model_executor/kernels/linear/scaled_mm/emulation.py","content":"# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\n\"\"\"FP8 w8a8 linear emulation for AMD GPUs that lack hardware FP8.\n\n``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm devices older than MI300\n(\"torch._scaled_mm is only supported on CUDA devices with compute capability\n>= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 parts (gfx908/gfx90a, e.g. MI250X)\nhave no FP8 matrix instruction at all, so *no* scaled-mm provider can serve an\nFP8 checkpoint there: the pre-MI300 ROCm kernel registry fell through every\naiter/skinny/rowwise gate and landed on\n``ChannelWiseTorchFP8ScaledMMLinearKernel``, which aborted inside\n``profile_run``.\n\nThis kernel bridges that gap by dequantizing the FP8 weight to the activation\ndtype ONCE at load time and then running a plain ``F.linear`` -- the same\nrecipe already used in-tree by\n\n* ``model_executor/layers/quantization/fp8.py`` (``VLLM_BATCH_INVARIANT``\n  per-tensor/per-channel path: \"dequant to BF16 and run GEMM\"), and\n* ``model_executor/kernels/linear/mxfp8/emulation.py``\n  (``EmulationMxfp8LinearKernel``: dequantize at load, run a plain BF16 linear).\n\nThe FP8 -> BF16 cast is exact (E4M3's 3+1-bit mantissa and 4-bit exponent both\nfit in BF16), so the only error added versus the intended scaled-GEMM is one\nBF16 rounding of the dequantized weight (~2^-9 relative) against ~2^-4\nintrinsic FP8 weight quantization error.\n\nOnly *dense* linears take this path -- MoE experts have their own kernels -- so\nthe 1-byte -> 2-byte weight growth is bounded by the dense (non-expert)\nparameter count. On a 512-expert MoE that is a small fraction of the checkpoint.\n\nOpt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n\"\"\"\n\nimport torch\nfrom torch.nn.parameter import Parameter\n\nfrom vllm.logger import init_logger\nfrom vllm.model_executor.layers.fusion.quant_activation import (\n    QuantizedActivation,\n)\nfrom vllm.model_executor.utils import replace_parameter\nfrom vllm.platforms import current_platform\n\nfrom .ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n)\n\nlogger = init_logger(__name__)\n\n_FP8_DTYPES = (\n    torch.float8_e4m3fn,\n    torch.float8_e4m3fnuz,\n    torch.float8_e5m2,\n    torch.float8_e5m2fnuz,\n)\n\n\ndef rocm_lacks_hardware_fp8() -> bool:\n    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n    if not current_platform.is_rocm():\n        return False\n\n    from vllm.platforms.rocm import get_cdna_version, on_cdna\n\n    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n    # Hardware FP8 (and therefore hipBLASLt FP8 scaled-mm) starts at CDNA3.\n    return on_cdna() and get_cdna_version() < 3\n\n\nclass FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n\n    # Accumulated across all rewritten layers, for a single informational log.\n    _bytes_before = 0\n    _bytes_after = 0\n\n    @classmethod\n    def is_supported(\n        cls, compute_capability: int | None = None\n    ) -> tuple[bool, str | None]:\n        if not rocm_lacks_hardware_fp8():\n            return False, (\n                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n                \"FP8 and no torch._scaled_mm support.\"\n            )\n        return True, None\n\n    @classmethod\n    def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:\n        if c.weight_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 weights.\"\n        if c.activation_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 activations.\"\n        out_dtype = c.out_dtype or torch.get_default_dtype()\n        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n            return False, f\"requires a >= 2-byte floating point output dtype.\"\n        return True, None\n\n    @staticmethod\n    def _dequant_weight(\n        weight: torch.Tensor, weight_scale: torch.Tensor | None\n    ) -> torch.Tensor:\n        \"\"\"Return the dequantized weight as a [N, K] float tensor.\n\n        CompressedTensors/ModelOpt leave ``layer.weight`` as a transposed\n        ``[K, N]`` view of the ``[N, K]`` checkpoint tensor, with\n        ``weight_scale`` shaped ``[N, 1]`` (channel) or 1-element (tensor).\n        \"\"\"\n        # Undo the process-time transpose so we are back to [N, K].\n        if weight.dim() == 2 and weight.stride(1) == 1 and weight.shape[0] != weight.stride(0):\n            w_nk = weight  # already [N, K]-ish\n        elif weight.dim() == 2 and weight.stride(0) == 1:\n            w_nk = weight.t()\n        else:\n            w_nk = weight\n        if w_nk.stride(-1) != 1:\n            w_nk = w_nk.contiguous()\n        n, k = w_nk.shape\n\n        w_f32 = w_nk.to(torch.float32)\n        if weight_scale is None or weight_scale.numel() == 1:\n            scale = (\n                1.0\n                if weight_scale is None\n                else weight_scale.to(torch.float32).reshape(-1)[0]\n            )\n            return w_f32 * scale\n        scale = weight_scale.to(torch.float32).reshape(-1)\n        if scale.numel() == n:\n            return w_f32 * scale.unsqueeze(1)\n        if scale.numel() == k:\n            return w_f32 * scale.unsqueeze(0)\n        raise ValueError(\n            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n            f\"matches neither N={n} nor K={k}.\"\n        )\n\n    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n        weight, weight_scale, _, _ = self._get_layer_params(layer)\n        if weight is None or weight.dtype not in _FP8_DTYPES:\n            # Already dequantized by a previous pass (or never FP8).\n            return\n\n        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n        w_dq = self._dequant_weight(weight, weight_scale).to(out_dtype)\n\n        self.__class__._bytes_before += weight.numel() * weight.element_size()\n        self.__class__._bytes_after += w_dq.numel() * w_dq.element_size()\n        logger.info_once(\n            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"\n            \"hardware FP8 / torch._scaled_mm support): dequantizing weights at \"\n            \"load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",\n            str(out_dtype).replace(\"torch.\", \"\"),\n            self.__class__._bytes_before / 2**30,\n            self.__class__._bytes_after / 2**30,\n            scope=\"global\",\n        )\n\n        # Store as a [N, K] Parameter so apply_weights can call F.linear\n        # directly (weight_loader is not needed after loading).\n        replace_parameter(layer, \"weight\", Parameter(w_dq, requires_grad=False))\n\n    def apply_weights(\n        self,\n        layer: torch.nn.Module,\n        x: torch.Tensor | QuantizedActivation,\n        bias: torch.Tensor | None = None,\n    ) -> torch.Tensor:\n        if isinstance(x, QuantizedActivation):\n            # Defensive: the base-class contract hands pre-quantized\n            # activations to kernels that opt in via input_quant_key(); this\n            # kernel does not, so a plain tensor is expected.\n            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(\n                *x.orig_shape\n            )\n\n        weight = layer.weight\n        if weight.dtype in _FP8_DTYPES:\n            # Not pre-dequantized (process_weights_after_loading skipped):\n            # dequantize on the fly so we never reach torch._scaled_mm.\n            _, weight_scale, _, _ = self._get_layer_params(layer)\n            weight = self._dequant_weight(weight, weight_scale)\n\n        # F.linear requires matching dtypes; .to() is a no-op when they agree.\n        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)\n\n    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n        # This kernel overrides apply_weights and must never call\n        # torch._scaled_mm, which is unavailable on pre-MI300 ROCm.\n        raise NotImplementedError(\n            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n            \"apply_scaled_mm is intentionally not implemented.\"\n        )\n","structuredPatch":[{"oldStart":1,"oldLines":31,"newStart":1,"newLines":35,"lines":[" # SPDX-License-Identifier: Apache-2.0"," # SPDX-FileCopyrightText: Copyright contributors to the vLLM project"," ","-\"\"\"FP8 w8a8 linear emulation for AMD GPUs without hardware FP8 MMA.","+\"\"\"FP8 w8a8 linear emulation for AMD GPUs that lack hardware FP8."," "," ``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm devices older than MI300"," (\"torch._scaled_mm is only supported on CUDA devices with compute capability"," >= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 parts (gfx908/gfx90a, e.g. MI250X)","-have no FP8 matrix instruction at all, so no scaled-mm provider can serve an","-FP8 checkpo