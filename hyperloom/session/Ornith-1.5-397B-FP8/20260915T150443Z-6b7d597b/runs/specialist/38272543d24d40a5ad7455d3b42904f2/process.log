layer)\nprint(\"post-process weight:\", tuple(layer.weight.shape), layer.weight.dtype)\nerr_load = (layer.weight.float()-Wd_ref).abs().max().item()\nprint(\"dequant-vs-ref maxabs:\", err_load, \" rel:\", err_load/Wd_ref.abs().max().item())\n\nx = (torch.randn(256, Kd, device=dev, dtype=torch.bfloat16)*1.5)\nref = (x.float() @ Wd_ref.t().float())\nout = c.apply_weights(layer, x)\nerr=(out.float()-ref).abs().max().item(); rel=err/ref.abs().max().item()\nprint(\"apply out:\", tuple(out.shape), out.dtype, \"maxabs\", err, \"rel\", rel)\nEOF\nCUDA_VISIBLE_DEVICES=7 HIP_VISIBLE_DEVICES=7 PYTHONPATH=$PWD/wt2/pkg timeout 900 /opt/envs/vllm/bin/python scratch/t_kern.py 2>&1 | grep -v \"^W2026\\|WARN\" | tail -25","description":"Unit-test the emulation kernel selection and numerics"}}],"model":"qwen3.8-flash-next","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6d8d162a-aacb-49eb-8d41-ca88b571bdc8","uuid":"9a3423b5-5788-4e53-8ec9-4bbc148fd4dd"}
