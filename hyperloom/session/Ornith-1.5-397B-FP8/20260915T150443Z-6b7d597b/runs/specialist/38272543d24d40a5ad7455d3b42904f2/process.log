{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b94c0ced3bd7371c","type":"tool_result","content":"1| # SPDX-License-Identifier: Apache-2.0\n2| # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3| \n4| import torch\n5| from torch.nn.parameter import Parameter\n6| \n7| from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (\n8|     MXFP8_BLOCK_SIZE,\n9|     MXFP8_SCALE_DTYPE,\n10|     dequant_mxfp8_to_bf16,\n11| )\n12| \n13| from .Mxfp8LinearKernel import Mxfp8LinearKernel, Mxfp8LinearLayerConfig\n14| \n15| \n16| class EmulationMxfp8LinearKernel(Mxfp8LinearKernel):\n17|     \"\"\"Software emulation fallback for MXFP8 (dequant to BF16).\"\"\"\n18| \n19|     @classmethod\n20|     def is_supported(\n21|         cls, compute_capability: int | None = None\n22|     ) -> tuple[bool, str | None]:\n23|         return True, None\n24| \n25|     @classmethod\n26|     def can_implement(cls, c: Mxfp8LinearLayerConfig) -> tuple[bool, str | None]:\n27|         return True, None\n28| \n29|     def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n30|         weight = layer.weight.data  # [N, K]\n31|         N, K = weight.shape\n32|         scale_k = K // MXFP8_BLOCK_SIZE\n33| \n34|         weight_scale = layer.weight_scale.data[:N, :scale_k].contiguous()\n35| \n36|         # Dequantize MXFP8 -> BF16 ONCE here, at load time, so apply_weights runs\n37|         # a plain BF16 linear with no per-step dequant -- i.e. run as if from a\n38|         # BF16 checkpoint. The 1-byte MXFP8 weight is replaced by BF16 (2x its\n39|         # size, but linear weights are small vs the MoE experts); the tiny E8M0\n40|         # scale is kept for the dtype/ndim asserts but is otherwise unused.\n41|         # Opt out (VLLM_MXFP8_EMULATION_DEQUANT_AT_LOAD=0) to keep the MXFP8\n42|         # weight and dequant per-step in apply_weights instead.\n43|         import vllm.envs as envs\n44| \n45|         if envs.VLLM_MXFP8_EMULATION_DEQUANT_AT_LOAD:\n46|             weight = dequant_mxfp8_to_bf16(weight.contiguous(), weight_scale)\n47|         layer.weight = Parameter(weight.contiguous(), requires_grad=False)\n48|         layer.weight_scale = Parameter(weight_scale, requires_grad=False)\n49| \n50|     def apply_weights(\n51|         self,\n52|         layer: torch.nn.Module,\n53|         x: torch.Tensor,\n54|         bias: torch.Tensor | None = None,\n55|     ) -> torch.Tensor:\n56|         weight = layer.weight\n57|         # Load-time dequant path: weights are already BF16/FP16 (>= 2-byte), so\n58|         # run a plain linear -- no per-step dequant. (MXFP8 weights are 1-byte.)\n59|         if weight.element_size() >= 2:\n60|             # F.linear requires x and weight share a dtype; .to() is a no-op when\n=== mxfp8 emulation is_supported ===\n            # F.linear requires x and weight share a dtype; .to() is a no-op when\n            # they already match (e.g. both BF16).\n            output = torch.nn.functional.linear(x, weight.to(x.dtype), bias)\n            return output.to(x.dtype)\n\n        # Fallback: weights still in MXFP8 -- dequant on the fly (other archs /\n        # if a future caller skips the load-time conversion above).\n        weight_scale = layer.weight_scale\n        if weight_scale.dtype != MXFP8_SCALE_DTYPE:\n            raise ValueError(\n                f\"Emulation backend requires {MXFP8_SCALE_DTYPE} \"\n                f\"weight_scale dtype, got {weight_scale.dtype}.\"\n            )\n        if weight_scale.ndim != 2:\n            raise ValueError(\n                f\"Emulation backend requires 2D weight_scale, \"\n                f\"got {weight_scale.ndim}D. \"\n                f\"Ensure process_weights_after_loading was called.\"\n            )\n\n        # Cast to x's dtype: dequant yields BF16, but F.linear needs both operands\n        # to match (e.g. an FP16 model). No-op when x is already BF16.\n        weight_bf16 = dequant_mxfp8_to_bf16(weight, weight_scale).to(x.dtype)\n        output = torch.nn.functional.linear(x, weight_bf16, bias)\n        return output.to(x.dtype)","is_error":false}]},"parent_tool_use_id":null,"session_id":"6d8d162a-aacb-49eb-8d41-ca88b571bdc8","uuid":"7945e3df-49e7-4963-8fa4-96e5f514d625","timestamp":"2026-09-15T15:26:23.306Z","tool_use_result":{"stdout":"1| # SPDX-License-Identifier: Apache-2.0\n2| # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3| \n4| import torch\n5| from torch.nn.parameter import Parameter\n6| \n7| from vllm.model_executor.layers.quantization.utils.mxfp8_utils import (\n8|     MXFP8_BLOCK_SIZE,\n9|     MXFP8_SCALE_DTYPE,\n10|     dequant_mxfp8_to_bf16,\n11| )\n12| \n13| from .Mxfp8LinearKernel import Mxfp8LinearKernel, Mxfp8LinearLayerConfig\n14| \n15| \n16| class EmulationMxfp8LinearKernel(Mxfp8LinearKernel):\n17|     \"\"\"Software emulation fallback for MXFP8 (dequant to BF16).\"\"\"\n18| \n19|     @classmethod\n20|     def is_supported(\n21|         cls, compute_capability: int | None = None\n22|     ) -> tuple[bool, str | None]:\n23|         return True, None\n24| \n25|     @classmethod\n26|     def can_implement(cls, c: Mxfp8LinearLayerConfig) -> tuple[bool, str | None]:\n27|         return True, None\n28| \n29|     def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n30|         weight = layer.weight.data  # [N, K]\n31|         N, K = weight.shape\n32|         scale_k = K // MXFP8_BLOCK_SIZE\n33| \n34|         weight_scale = layer.weight_scale.data[:N, :scale_k].contiguous()\n35| \n36|         # Dequantize MXFP8 -> BF16 ONCE here, at load time, so apply_weights runs\n37|         # a plain BF16 linear with no per-step dequant -- i.e. run as if from a\n38|         # BF16 checkpoint. The 1-byte MXFP8 weight is replaced by BF16 (2x its\n39|         # size, but linear weights are small vs the MoE experts); the tiny E8M0\n40|         # scale is kept for the dtype/ndim asserts but is otherwise unused.\n41|         # Opt out 