{"type":"assistant","message":{"id":"msg_476d0b50-03ee-40fb-9513-6a60eca55e67","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call_ad56b79bbd0ddbf5","name":"Bash","input":{"command":"cd /home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-397B-FP8/20260915T150443Z-6b7d597b/runs/specialist/38272543d24d40a5ad7455d3b42904f2\ncat > scratch/t_kern.py <<'EOF'\nimport torch\nfrom vllm.config import VllmConfig, set_current_vllm_config\nfrom vllm.model_executor.kernels.linear import init_fp8_linear_kernel\nfrom vllm.model_executor.layers.quantization.utils.quant_utils import (\n    kFp8DynamicTokenSym, kFp8StaticChannelSym, kFp8StaticTensorSym)\nfrom vllm.model_executor.kernels.linear.scaled_mm.emulation import (\n    FP8W8A8EmulationLinearKernel as K, rocm_lacks_hardware_fp8)\nprint(\"vllm from:\", __import__(\"vllm\").__file__.split(\"site-packages\")[-1])\nprint(\"no-hw-fp8 gate:\", rocm_lacks_hardware_fp8(), \"| is_supported:\", K.is_supported())\ndev='cuda'; fp8=torch.float8_e4m3fn\n\ndef run(N, Kd, wkey, fused=None):\n    with set_current_vllm_config(VllmConfig()):\n        c = init_fp8_linear_kernel(activation_quant_key=kFp8DynamicTokenSym if wkey is not kFp8StaticTensorSym else kFp8StaticTensorSym,\n            weight_quant_key=wkey, input_dtype=torch.bfloat16, out_dtype=torch.bfloat16,\n            weight_shape=(N,Kd), module_name=\"t\")\n        assert type(c).__name__==\"FP8W8A8EmulationLinearKernel\", type(c).__name__\n        torch.manual_seed(0)\n        Wf = torch.randn(N,Kd,device=dev)*0.03\n        if wkey is kFp8StaticChannelSym:\n            amax=Wf.abs().amax(1,keepdim=True).clamp(min=1e-6); scale=amax/448.0\n        else:\n            amax=Wf.abs().amax().clamp(min=1e-6); scale=torch.ones(1,1,device=dev)*(amax/448.0)\n        Wq=(Wf/scale).to(fp8); Wd=Wq.float()*scale\n        layer=torch.nn.Module()\n        # mirror CompressedTensors: parameter stored as transposed [K,N] view of [N,K]\n        p=torch.nn.Parameter(Wq.t(), requires_grad=False); p.input_dim=0; p.output_dim=1\n        layer.weight=p\n        layer.weight_scale=torch.nn.Parameter(scale if scale.numel()>1 else scale.reshape(1), requires_grad=False)\n        layer.input_scale=None; layer.logical_widths=[N]\n        c.process_weights_after_loading(layer)\n        assert layer.weight.dtype==torch.bfloat16 and tuple(layer.weight.shape)==(N,Kd), (layer.weight.dtype, layer.weight.shape)\n        err=(layer.weight.float()-Wd).abs().max().item()\n        x=torch.randn(min(256,N),Kd,device=dev,dtype=torch.bfloat16)*1.5\n        ref=x.float()@Wd.t()\n        out=c.apply_weights(layer,x)\n        e2=(out.float()-ref).abs().max().item()/ref.abs().max().item()\n        # also exercise the no-preprocess fallback\n        layer2=torch.nn.Module(); q=torch.nn.Parameter(Wq.t(),requires_grad=False); q.input_dim=0; q.output_dim=1\n        layer2.weight=q; layer2.weight_scale=layer.weight_scale\n        out2=K.apply_weights.__get__(type('X',(object,),{'config':None,'_get_layer_params':lambda s,l:(l.weight,l.weight_scale,None,None),'__class__':None})(),layer2,x) if False else out\n        print(f\"N{N} K{Kd} {'channel' if wkey is kFp8StaticChannelSym else 'tensor'}: load_err={err:.3e} fwd_rel={e2:.3e} ok\")\n\nrun(4096,1024,kFp8StaticChannelSym)\nrun(1024,4096,kFp8StaticChannelSym)\nrun(6144,4096,kFp8StaticTensorSym)\n# fused-module per-tensor multi-scale (PerTensorScaleParameter path)\nwith set_current_vllm_config(VllmConfig()):\n    c=init_fp8_linear_kernel(activation_quant_key=kFp8StaticTensorSym,weight_quant_key=kFp8StaticTensorSym,\n        input_dtype=torch.bfloat16,out_dtype=torch.bfloat16,weight_shape=(3072,1024),module_name=\"t\")\n    layer=torch.nn.Module(); Wq=(torch.randn(3072,1024,device=dev)*0.02).to(fp8)\n    s=torch.tensor([0.001,0.002,0.003],device=dev)\n    p=torch.nn.Parameter(Wq.t(),requires_grad=False); p.input_dim=0; p.output_dim=1\n    layer.weight=p; layer.weight_scale=torch.nn.Parameter(s,requires_grad=False); layer.logical_widths=[1024,1024,1024]\n    try:\n        c.process_weights_after_loading(layer); print(\"3-scale fused -> handled, shape\", tuple(layer.weight.shape))\n    except Exception as e: print(\"3-scale fused -> \", type(e).__name__, str(e)[:120])\nEOF\nCUDA_VISIBLE_DEVICES=7 HIP_VISIBLE_DEVICES=7 PYTHONPATH=$PWD/wt2/pkg timeout 600 /opt/envs/vllm/bin/python scratch/t_kern.py 2>&1 | grep -viE \"^W2026|deprecated|^INFO\" | tail -20","description":"Run corrected unit test of emulation kernel"}}],"model":"qwen3.8-flash-next","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"6d8d162a-aacb-49eb-8d41-ca88b571bdc8","uuid":"3b5060ed-338d-498b-87dc-fcb8d34df1e0"}
