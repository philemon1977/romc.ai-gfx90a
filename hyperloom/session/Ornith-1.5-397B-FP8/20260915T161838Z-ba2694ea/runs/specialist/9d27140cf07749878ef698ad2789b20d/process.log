{"type":"assistant","message":{"id":"msg_b8dcbbb1-63f8-4988-b52c-2a39402e0df4","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call_a38cb6ca448373e8","name":"Write","input":{"file_path":"/home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-397B-FP8/20260915T161838Z-ba2694ea/runs/specialist/9d27140cf07749878ef698ad2789b20d/scratch/t_kernel.py","content":"# Standalone check of the gfx90a FP8 w8a8 emulation kernel:\n#  1. does the ROCm FP8 registry now select it on this (CDNA2) host?\n#  2. does it produce numerics matching a true per-token/per-channel FP8 GEMM?\nimport os\nimport torch\n\nfrom vllm.platforms import current_platform\nfrom vllm.model_executor.kernels.linear.scaled_mm.pytorch import (\n    ChannelWiseTorchFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.emulation import (\n    FP8W8A8EmulationLinearKernel,\n    rocm_lacks_hardware_fp8,\n)\nfrom vllm.model_executor.kernels.linear import _POSSIBLE_FP8_KERNELS\n\nprint(\"platform\", current_platform._enum, \"cc\", torch.cuda.get_device_capability())\nprint(\"rocm_lacks_hardware_fp8 ->\", rocm_lacks_hardware_fp8())\nprint(\"emulation is_supported ->\", FP8W8A8EmulationLinearKernel.is_supported())\nprint(\"ChannelWise is_supported ->\", ChannelWiseTorchFP8ScaledMMLinearKernel.is_supported(90))\n\norder = _POSSIBLE_FP8_KERNELS[current_platform._enum]\nprint(\"ROCm FP8 registry order:\")\nfor k in order:\n    ok, why = k.is_supported()\n    print(f\"  {k.__name__:52s} supported={ok}  {why or ''}\")\nsel = [k.__name__ for k in order if k.is_supported()[0]]\nprint(\"first arch-supported:\", sel[0] if sel else None)\n\n# ---- numerics on a real per-channel-weight / per-token-activation layer ----\nfrom vllm.model_executor.layers.quantization.utils.quant_utils import (\n    GroupShape,\n    QuantKey,\n    ScaleType,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.ScaledMMLinearKernel import (\n    FP8ScaledMMLinearLayerConfig,\n)\nimport vllm.model_executor.layers.fusion.quant_activation  # noqa: F401  (import order)\n\ntorch.manual_seed(0)\ndev = \"cuda\"\nM, K, N = 33, 512, 768\nw_bf16 = (torch.randn(N, K, device=dev, dtype=torch.float32) / 8.0)\nx_bf16 = torch.randn(M, K, device=dev, dtype=torch.float32)\n\nFP8 = torch.float8_e4m3fn\nws = w_bf16.abs().amax(dim=1, keepdim=True).clamp_min(1e-8) / 448.0  # [N,1] per-channel\nw_fp8 = (w_bf16 / ws).clamp(-448.0, 448.0).to(FP8)\n\nxs = x_bf16.abs().amax(dim=1, keepdim=True).clamp_min(1e-8) / 448.0  # [M,1] per-token\nx_fp8 = (x_bf16 / xs).clamp(-448.0, 448.0).to(FP8)\n\n# Reference: exact math the FP8 path is supposed to do.\nref = ((x_fp8.float() * xs) @ (w_fp8.float() * ws.t()).t()).to(torch.bfloat16)\n\ncfg = FP8ScaledMMLinearLayerConfig(\n    weight_quant_key=QuantKey(\n        scale_type=ScaleType.PER_CHANNEL,\n        group_shape=GroupShape(1, K),  # per-channel along K\n        static=True,\n        symmetric=True,\n    ),\n    activation_quant_key=QuantKey(\n        scale_type=ScaleType.PER_TOKEN,\n        group_shape=GroupShape(1, K),\n        static=False,\n        symmetric=True,\n    ),\n    weight_shape=(N, K),\n    input_dtype=torch.bfloat16,\n    out_dtype=torch.bfloat16,\n)\nok, why = FP8W8A8EmulationLinearKernel.can_implement(cfg)\nprint(\"can_implement(ptpc) ->\", ok, why)\n\nlayer = torch.nn.Module()\nlayer.weight = torch.nn.Parameter(w_fp8.t().contiguous().t(), requires_grad=False)\n# compressed-tensors leaves weight as a [K,N]-oriented view tagged input_dim=0\nlayer.weight.data = w_fp8.t()  # [K, N] view of [N, K]\nlayer.weight.input_dim = 0\nlayer.weight.output_dim = 1\nlayer.weight_scale = torch.nn.Parameter(ws, requires_grad=False)\nlayer.input_scale = None\n\nkern = FP8W8A8EmulationLinearKernel(\n    cfg, layer_param_names=[\"weight\", \"weight_scale\", \"input_scale\", \"input_scale_ub\"]\n)\nkern.process_weights_after_loading(layer)\nprint(\"post-process weight:\", tuple(layer.weight.shape), layer.weight.dtype,\n      \"input_dim\", getattr(layer.weight, \"input_dim\", None))\n\nx_in = x_bf16.to(torch.bfloat16)\nout = kern.apply_weights(layer, x_in).to(torch.bfloat16)\nerr = (out.float() - ref.float()).abs()\nden = ref.float().abs().clamp_min(1.0)\nprint(f\"max_abs_err={err.max().item():.3e}  max_rel={float((err/den).max()):.3e}\")\nxref = x_in.float() @ w_bf16.to(torch.bfloat16).float().t()\nerrb = (out.float() - xref).abs()\nprint(f\"vs-bf16-exact max_abs_err={errb.max().item():.3e}  (bf16 GEMM scale {xref.abs().max().item():.1f})\")\nprint(\"finite:\", bool(torch.isfinite(out).all()))\n"}}],"model":"qwen3.8-flash-next","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"0b6ae9cf-5f72-4206-979f-afe7dc600f73","uuid":"2c8743f4-2b80-4f54-a25f-b437e6186186"}
