{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_858c6ca10119de91","type":"tool_result","content":"=== __init__ ===\n# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\nfrom vllm.model_executor.kernels.linear.scaled_mm.aiter import (\n    AiterInt8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.BlockScaledMMLinearKernel import (\n    Fp8BlockScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.cpu import (\n    CPUFp8BlockScaledMMKernel,\n    CPUInt8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.cutlass import (\n    CutlassFP8ScaledMMLinearKernel,\n    CutlassInt8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.flashinfer import (\n    FlashInferFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.marlin import (\n    MarlinFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.pytorch import (\n    ChannelWiseTorchFP8ScaledMMLinearKernel,\n    PerTensorTorchFP8ScaledMMLinearKernel,\n    RowWiseTorchFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.rocm import (\n    ROCmFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n    Int8ScaledMMLinearKernel,\n    Int8ScaledMMLinearLayerConfig,\n    ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.triton import (\n    TritonInt8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.xpu import (\n    XPUFp8BlockScaledMMKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.zentorch import (\n    ZentorchInt8ScaledMMLinearKernel,\n)\n\n__all__ = [\n    \"FP8ScaledMMLinearKernel\",\n    \"FP8ScaledMMLinearLayerConfig\",\n    \"Int8ScaledMMLinearKernel\",\n    \"Int8ScaledMMLinearLayerConfig\",\n    \"ScaledMMLinearKernel\",\n    \"ScaledMMLinearLayerConfig\",\n    \"AiterInt8ScaledMMLinearKernel\",\n    \"CPUInt8ScaledMMLinearKernel\",\n    \"CutlassFP8ScaledMMLinearKernel\",\n    \"CutlassInt8ScaledMMLinearKernel\",\n    \"FlashInferFP8ScaledMMLinearKernel\",\n    \"MarlinFP8ScaledMMLinearKernel\",\n    \"ChannelWiseTorchFP8ScaledMMLinearKernel\",\n    \"PerTensorTorchFP8ScaledMMLinearKernel\",\n    \"RowWiseTorchFP8ScaledMMLinearKernel\",\n    \"ROCmFP8ScaledMMLinearKernel\",\n    \"TritonInt8ScaledMMLinearKernel\",\n    \"ZentorchInt8ScaledMMLinearKernel\",\n    \"Fp8BlockScaledMMLinearKernel\",\n    \"CPUFp8BlockScaledMMKernel\",\n    \"XPUFp8BlockScaledMMKernel\",\n]\n=== rocm.py ===\n# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\n\nimport torch\n\nimport vllm.envs as envs\nfrom vllm import _custom_ops as ops\nfrom vllm.platforms import current_platform\nfrom vllm.utils.platform_utils import num_compute_units\nfrom vllm.utils.torch_utils import direct_register_custom_op\n\nfrom .ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n)\n\n\ndef rocm_per_tensor_float_w8a8_scaled_mm_impl(\n    A: torch.Tensor,\n    B: torch.Tensor,\n    out_dtype: torch.dtype,\n    As: torch.Tensor,\n    Bs: torch.Tensor,\n    bias: torch.Tensor,\n) -> torch.Tensor:\n    if (\n        A.shape[0] <= 4\n        and B.shape[0] % 16 == 0  # M TODO: needed?\n        and B.shape[1] % 16 == 0  # K\n        and ((bias is None) or (bias.dtype == out_dtype))\n    ):\n        output = ops.wvSplitKQ(\n            B.t(),\n            A,\n            out_dtype,\n            As,\n            Bs,\n            num_compute_units(),\n            bias,\n        )\n    # Fallback\n    else:\n        output = torch._scaled_mm(\n            A,\n            B,\n            out_dtype=out_dtype,\n            scale_a=As,\n            scale_b=Bs,\n            bias=bias,\n        )\n    return output\n\n\ndef rocm_per_tensor_float_w8a8_scaled_mm_fake(\n    A: torch.Tensor,\n    B: torch.Tensor,\n    out_dtype: torch.dtype,\n    As: torch.Tensor,\n    Bs: torch.Tensor,\n    bias: torch.Tensor,\n) -> torch.Tensor:\n    return A.new_empty((*A.shape[:-1], B.shape[1]), dtype=out_dtype)\n\n\nif current_platform.is_rocm():\n    direct_register_custom_op(\n        op_name=\"rocm_per_tensor_float_w8a8_scaled_mm_impl\",\n        op_func=rocm_per_tensor_float_w8a8_scaled_mm_impl,\n        fake_impl=rocm_per_tensor_float_w8a8_scaled_mm_fake,\n    )\n\n\nclass ROCmFP8ScaledMMLinearKernel(FP8ScaledMMLinearKernel):\n    @classmethod\n    def is_supported(\n        cls, compute_capability: int | None = None\n    ) -> tuple[bool, str | None]:\n        if not current_platform.is_rocm():\n            return False, \"requires ROCm.\"\n\n        from vllm.platforms.rocm import get_cdna_version, on_gfx12x, on_gfx1250\n\n        # wvSplitKQ (skinny GEMM) is excluded from the gfx1250 build.\n        if on_gfx1250():\n            return False, \"wvSplitKQ (skinny GEMM) is not built on gfx1250\"\n\n        # Restore RDNA4 (gfx12x) dropped by the get_cdna_version()>2 refactor.\n        if get_cdna_version() <= 2 and not on_gfx12x():\n            return False, \"requires CDNA3+ (gfx942/gfx950) or RDNA4 (gfx12x)\"\n\n        if not envs.VLLM_ROCM_USE_SKINNY_GEMM:\n            return False, \"requires VLLM_ROCM_USE_SKINNY_GEMM to be enabled.\"\n\n        return True, None\n\n    @classmethod\n    def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:\n        per_tensor_activation_scales = (\n            c.activation_quant_key.scale.group_shape.is_per_tensor()\n        )\n        per_tensor_weight_scales = c.weight_quant_key.scale.group_shape.is_per_tensor()\n\n        if not (per_tensor_activation_scales and per_tensor_weight_scales):\n            return False, \"requires per tensor activation and weight scales.\"\n\n        return True, None\n\n    def apply_scaled_mm(\n        self,\n        *,\n        A: torch.Tensor,\n        B: torch.Tensor,\n        out_dtype: torch.dtype,\n        As: torch.Tensor,\n        Bs: torch.Tensor,\n        bias: torch.Tensor | None,\n        output_shape: list,\n    ) -> torch.Tensor:\n        output = torch.ops.vllm.rocm_per_tensor_float_w8a8_scaled_mm_impl(\n            A, B, out_dtype, As, Bs, bias\n        )\n        return torch.narrow(output, 0, 0, A.shape[0]).view(*output_shape)","is_error":false}]},"parent_tool_use_id":null,"session_id":"0b6ae9cf-5f72-4206-979f-afe7dc600f73","uuid":"77b0336a-438c-442e-bc11-393d9c87f2a7","timestamp":"2026-09-15T16:25:00.816Z","tool_use_result":{"stdout":"=== __init__ ===\n# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\nfrom vllm.model_executor.kernels.linear.scaled_mm.aiter import (\n    AiterInt8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.BlockScaledMMLinearKernel import (\n    Fp8BlockScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.cpu import (\n    CPUFp8BlockScaledMMKernel,\n    CPUInt8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.cutlass import (\n    CutlassFP8ScaledMMLinearKernel,\n    CutlassInt8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.flashinfer import (\n    FlashInferFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.marlin import (\n    MarlinFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.pytorch import (\n    ChannelWiseTorchFP8ScaledMMLinearKernel,\n    PerTensorTorchFP8ScaledMMLinearKernel,\n    RowWiseTorchFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.rocm import (\n    ROCmFP8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n    Int8ScaledMMLinearKernel,\n    Int8ScaledMMLinearLayerConfig,\n    ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.triton import (\n    TritonInt8ScaledMMLinearKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.xpu import (\n    XPUFp8BlockScaledMMKernel,\n)\nfrom vllm.model_executor.kernels.linear.scaled_mm.zentorch import (\n    ZentorchInt8ScaledMMLinearKernel,\n)\n\n__all__ = [\n    \"FP8ScaledMMLinearKernel\",\n    \"FP8ScaledMMLinearLayerConfig\",\n    \"Int8ScaledMMLinearKernel\",\n    \"Int8ScaledMMLinearLayerConfig\",\n    \"ScaledMMLinearKernel\",\n    \"ScaledMMLinearLayerConfig\",\n    \"AiterInt8ScaledMMLinearKernel\",\n    \"CPUInt8ScaledMMLinearKernel\",\n    \"CutlassFP8ScaledMMLinearKernel\",\n    \"CutlassInt8ScaledMMLinearKernel\",\n    \"FlashInferFP8ScaledMMLinearKernel\",\n    \"MarlinFP8ScaledMMLinearKernel\",\n    \"ChannelWiseTorchFP8ScaledMMLinearKernel\",\n    \"PerTensorTorchFP8ScaledMMLinearKernel\",\n    \"RowWiseTorchFP8ScaledMMLinearKernel\",\n    \"ROCmFP8ScaledMMLinearKernel\",\n    \"TritonInt8ScaledMMLinearKernel\",\n    \"ZentorchInt8ScaledMMLinearKernel\",\n    \"Fp8BlockScaledMMLinearKernel\",\n    \"CPUFp8BlockScaledMMKernel\",\n    \"XPUFp8BlockScaledMMKernel\",\n]\n=== rocm.py ===\n# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\n\nimport torch\n\nimport vllm.envs as envs\nfrom vllm import _custom_ops as ops\nfrom vllm.platforms import current_platform\nfrom vllm.utils.platform_utils import num_compute_units\nfrom vllm.utils.torch_utils import direct_register_custom_op\n\nfrom .ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n)\n\n\ndef rocm_per_tensor_float_w8a8_scaled_mm_impl(\n    A: torch.Tensor,\n    B: torch.Tensor,\n    out_dtype: torch.dtype,\n    As: torch.Tensor,\n    Bs: torch.Tensor,\n    bias: torch.Tensor,\n) -> torch.Tensor:\n    if (\n        A.shape[0] <= 4\n        and B.shape[0] % 16 == 0  # M TODO: needed?\n        and B.shape[1] % 16 == 0  # K\n        and ((bias is None) or (bias.dtype == out_dtype))\n    ):\n        output = ops.wvSplitKQ(\n            B.t(),\n            A,\n            out_dtype,\n            As,\n            Bs,\n            num_compute_units(),\n            bias,\n        )\n    # Fallback\n    else:\n        output = torch._scaled_mm(\n            A,\n            B,\n            out_dtype=out_dtype,\n            scale_a=As,\n            scale_b=Bs,\n            bias=bias,\n        )\n    return output\n\n\ndef rocm_per_tensor_float_w8a8_scaled_mm_fake(\n    A: torch.Tensor,\n    B: torch.Tensor,\n    out_dtype: torch.dtype,\n    As: torch.Tensor,\n    Bs: torch.Tensor,\n    bias: torch.Tensor,\n) -> torch.Tensor:\n    return A.new_empty((*A.shape[:-1], B.shape[1]), dtype=out_dtype)\n\n\nif current_platform.is_rocm():\n    direct_register_custom_op(\n        op_name=\"rocm_per_tensor_float_w8a8_scaled_mm_impl\",\n        op_func=rocm_per_tensor_float_w8a8_scaled_mm_impl,\n        fake_impl=rocm_per_tensor_float_w8a8_scaled_mm_fake,\n    )\n\n\nclass ROCmFP8ScaledMMLinearKernel(FP8ScaledMMLinearKernel):\n    @classmethod\n    def is_supported(\n        cls, compute_capability: int | None = None\n    ) -> tuple[bool, str | None]:\n        if not current_platform.is_rocm():\n            return False, \"requires ROCm.\"\n\n        from vllm.platforms.rocm import get_cdna_version, on_gfx12x, on_gfx1250\n\n        # wvSplitKQ (skinny GEMM) is excluded from the gfx1250 build.\n        if on_gfx1250():\n            return False, \"wvSplitKQ (skinny GEMM) is not built on gfx1250\"\n\n        # Restore RDNA4 (gfx12x) dropped by the get_cdna_version()>2 refactor.\n        if get_cdna_version() <= 2 and not on_gfx12x():\n            return False, \"requires CDNA3+ (gfx942/gfx950) or RDNA4 (gfx12x)\"\n\n        if not envs.VLLM_ROCM_USE_SKINNY_GEMM:\n            return False, \"requires VLLM_ROCM_USE_SKINNY_GEMM to be enabled.\"\n\n        return True, None\n\n    @classmethod\n    def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:\n        per_tensor_activation_scales = (\n            c.activation_quant_key.scale.group_shape.is_per_tensor()\n        )\n        per_tensor_weight_scales = c.weight_quant_key.scale.group_shape.is_per_tensor()\n\n        if not (per_tensor_activation_scales and per_tensor_weight_scales):\n            return False, \"requires per tensor activation and weight scales.\"\n\n        return True, None\n\n    def apply_scaled_mm(\n        self,\n        *,\n        A: torch.Tensor,\n        B: torch.Tensor,\n        out_dtype: torch.dtype,\n        As: torch.Tensor,\n        Bs: torch.Tensor,\n        bias: torch.Tensor | None,\n        output_shape: list,\n    ) -> torch.Tensor:\n        output = torch.ops.vllm.rocm_per_tensor_float_w8a8_scaled_mm_impl(\n            A, B, out_dtype, As, Bs, bias\n        )\n        return torch.narrow(output, 0, 0, A.shape[0]).view(*output_shape)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
{"type":"assistant","message":{"id":"msg_2523b54a-d200-4c79-9e78-c5c83e78cc11","type":"message","role":"assistant","content":[{"type":"tool_use","id":"call_931d701ff9f7cad3","name":"Bash","input":{"command":"cat /mnt/stripe-3mix-3t2/models/ornith-ai/launcher/ornith_1.5_35b_a3b_vllm_rocm72_mi250x_tp4_8k.sh; echo \"=== 256k ===\"; cat /mnt/stripe-3mix-3t2/models/ornith-ai/launcher/ornith_1.5_35b_a3b_vllm_rocm72_mi250x_tp4_256k.sh","description":"Read official MI250X launcher scripts for Ornith 35B"}}],"model":"qwen3.8-flash-next","stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":0,"output_tokens":0,"cache_creation_input_tokens":0,"cache_read_input_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"0b6ae9cf-5f72-4206-979f-afe7dc600f73","uuid":"eb0aaddb-7277-4df9-bc06-0a9edfb8ee88"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_931d701ff9f7cad3","type":"tool_result","content":"#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (MI250X GPU0-3, vLLM rocm7.2 wheel, TP4, 8k, AITER)\n# Desc: 由原系统版启动命令(存于 ~/ornith_serve_cmd.txt)迁移到 vllm_0.28.0_rocm72 环境。\n#   原参数逐字保留(--served-model-name ornith --language-model-only --max-model-len 8192\n#   --gpu-memory-utilization 0.85 --trust-remote-code --port 8000)，差异: TP 8→4；\n#   2026-09-03 更新: 启用 ROCm AITER 全家桶(主开关 VLLM_ROCM_USE_AITER=1，含 AITER MoE/\n#   RMSNorm/CUSTOM_AR)，并移除 --disable-custom-all-reduce 以放行定制 allreduce。\nset -euo pipefail\n\nAI_HOME=\"${AI_HOME:-/mnt/nvme2t-samsung/ai}\"\nVLLM_PYTHON=\"${VLLM_PYTHON:-${AI_HOME}/envs/vllm_0.28.0_rocm72/bin/python}\"\n\nROCM724=\"${ROCM724:-/opt/rocm-7.2.4}\"\nexport LD_LIBRARY_PATH=\"${ROCM724}/lib:${LD_LIBRARY_PATH:-}\"\nexport ROCM_PATH=\"${ROCM724}\"\nexport PATH=\"${ROCM724}/bin:${PATH}\"\n\n# --- ROCm AITER 加速路径 ---\nexport VLLM_ROCM_USE_AITER=\"${VLLM_ROCM_USE_AITER:-0}\"    # CDNA2(gfx90a) 被 vllm 硬门槛禁用(>2 才放行)\n\nPORT=\"${PORT:-8000}\"\nMODEL_PATH=\"${MODEL_PATH:-${AI_HOME}/models/ornith-ai/Ornith-1.5-35B-A3B}\"\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\nGPU_MEM_UTIL=\"${GPU_MEM_UTIL:-0.85}\"\nMAX_MODEL_LEN=\"${MAX_MODEL_LEN:-8192}\"\nTP=\"${TP:-4}\"\n\nexport HIP_VISIBLE_DEVICES=\"${HIP_VISIBLE_DEVICES:-0,1,2,3}\"\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8\"\nexport RAY_memory_monitor_refresh_ms=\"0\"\n\n# --- MI250X(gfx90a) P1+C2+C3（原生 env 已打补丁，2026-09-03 实测）---------------\n# P1 门控 GEMV：与 F.linear 逐位相同；Ornith TP4 单流 71.2 -> 85.3 t/s (+19.8%)。\n# C2/C3 QuickReduce：默认下限表 (bf16,4)=8MB 会把 decode 的 4-10KB 全 reduce 挡在门外，\n#   必须同时给 MIN_SIZE_BYTES_MB=0 才真上场；缺这行 = 设了 FP 也没用（我踩过）。\n#   实测增益 Ornith TP4 单流 +12.5% / 并发4 +24.9%；稠密 TP2 单流 +4.7% / 并发 +2.0%。\n#   数值：world=2 与 NCCL 逐位一致；world>=4 是求和顺序不同（平均误差与 NCCL 相等\n#   0.231 ULP、优劣对称 19/62/19），temp=0 的逐 token 输出会与旧基线不同 -> 基线需重跑。\nexport MI250_GATE_GEMV=\"${MI250_GATE_GEMV:-1}\"\nexport VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"${VLLM_ROCM_QUICK_REDUCE_QUANTIZATION:-FP}\"\nexport VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB=\"${VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB:-0}\"\nexport VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=\"${VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16:-0}\"\n\nif nc -z 127.0.0.1 \"${PORT}\" 2>/dev/null; then\n  echo \"错误：端口 $PORT 已被占用\"; exit 1\nfi\n\n> \"${LOG_FILE}\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" \\\n  --served-model-name ornith \\\n  --language-model-only \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --tensor-parallel-size \"${TP}\" \\\n  --gpu-memory-utilization \"${GPU_MEM_UTIL}\" \\\n  --max-model-len \"${MAX_MODEL_LEN}\" \\\n  --enable-auto-tool-choice \\\n  --tool-call-parser qwen3_coder \\\n  --trust-remote-code \\\n  --no-use-tqdm-on-load \\\n  > \"${LOG_FILE}\" 2>&1 &\n\nsleep 1\necho \"✅ ornith-1.5-35b-a3b (MI250X GPU ${HIP_VISIBLE_DEVICES}, TP=${TP}, vLLM+AITER) http://localhost:${PORT}/v1\"\necho \"   AITER=1(moe/rmsnorm/mla/custom_ar) | ctx=${MAX_MODEL_LEN} | util=${GPU_MEM_UTIL} | 限功率400W/模组\"\necho \"   查看日志: tail -f ${LOG_FILE}\"\n\n=== 256k ===\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (MI250X GPU0-3, vLLM rocm7.2 wheel, TP4, 256k, AITER)\n# Desc: 由原系统版启动命令(存于 ~/ornith_serve_cmd.txt)迁移到 vllm_0.28.0_rocm72 环境。\n#   原参数逐字保留(--served-model-name ornith --language-model-only --max-model-len 8192\n#   --gpu-memory-utilization 0.85 --trust-remote-code --port 8000)，差异: TP 8→4；\n#   2026-09-03 更新: 启用 ROCm AITER 全家桶(主开关 VLLM_ROCM_USE_AITER=1，含 AITER MoE/\n#   RMSNorm/CUSTOM_AR)，并移除 --disable-custom-all-reduce 以放行定制 allreduce。\n#   2026-09-07 更新: ctx 8k→**256k**(MAX_MODEL_LEN=262144)。依据：config.json\n#   max_position_embeddings=262,144 ⇒ 原生上限内，无需 YaRN/外挂（CLAUDE.md §9 同族\n#   Flash-Next 已定稿 262,144；1M 判定被用户取消，见 docs/research-notes/{1M-上下文可行性,256k-上下文}-2026-09-07.md）。\n#   ⚠️ 改名后 beta 封装 serve_ornith_splitkv_ab.sh 的 LAUNCHER 路径与 LOGPAT 需同步（已同步）。\nset -euo pipefail\n\nAI_HOME=\"${AI_HOME:-/home/qiba/ai}\"\nVLLM_PYTHON=\"${VLLM_PYTHON:-${AI_HOME}/envs/vllm_0.28.0_rocm72/bin/python}\"\n\nROCM724=\"${ROCM724:-/opt/rocm-7.2.4}\"\nexport LD_LIBRARY_PATH=\"${ROCM724}/lib:${LD_LIBRARY_PATH:-}\"\nexport ROCM_PATH=\"${ROCM724}\"\nexport PATH=\"${ROCM724}/bin:${PATH}\"\n\n# --- ROCm AITER 加速路径 ---\nexport VLLM_ROCM_USE_AITER=\"${VLLM_ROCM_USE_AITER:-0}\"    # CDNA2(gfx90a) 被 vllm 硬门槛禁用(>2 才放行)\n\nPORT=\"${PORT:-8000}\"\nMODEL_PATH=\"${MODEL_PATH:-${AI_HOME}/models/ornith-ai/Ornith-1.5-35B-A3B}\"\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\nGPU_MEM_UTIL=\"${GPU_MEM_UTIL:-0.85}\"\nMAX_MODEL_LEN=\"${MAX_MODEL_LEN:-262144}\"   # 2026-09-07: 8192→262144（原生上限，见头部注释）\nTP=\"${TP:-4}\"\n\nexport HIP_VISIBLE_DEVICES=\"${HIP_VISIBLE_DEVICES:-0,1,2,3}\"\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8\"\nexport RAY_memory_monitor_refresh_ms=\"0\"\n\n# --- MI250X(gfx90a) P1+C2+C3（原生 env 已打补丁，2026-09-03 实测）---------------\n# P1 门控 GEMV：与 F.linear 逐位相同；Ornith TP4 单流 71.2 -> 85.3 t/s (+19.8%)。\n# C2/C3 QuickReduce：默认下限表 (bf16,4)=8MB 会把 decode 的 4-10KB 全 reduce 挡在门外，\n#   必须同时给 MIN_SIZE_BYTES_MB=0 才真上场；缺这行 = 设了 FP 也没用（我踩过）。\n#   实测增益 Ornith TP4 单流 +12.5% / 并发4 +24.9%；稠密 TP2 单流 +4.7% / 并发 +2.0%。\n#   数值：world=2 与 NCCL 逐位一致；world>=4 是求和顺序不同（平均误差与 NCCL 相等\n#   0.231 ULP、优劣对称 19/62/19），temp=0 的逐 token 输出会与旧基线不同 -> 基线需重跑。\nexport MI250_GATE_GEMV=\"${MI250_GATE_GEMV:-1}\"\nexport VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"${VLLM_ROCM_QUICK_REDUCE_QUANTIZATION:-FP}\"\nexport VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB=\"${VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB:-0}\"\nexport VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=\"${VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16:-0}\"\n\n# --- MI250X split-KV paged-decode（2026-09-07 转正，进生产默认开）---\n# 病根：现役 Triton 参考内核 grid 只有 (num_seqs, num_kv_heads) ⇒ 单流时 **1 个 program / 104 CU**，\n#       带宽恒定 7-12 GB/s（纯读峰 1171）。split-KV 把 KV 维切成 partition 作为 grid 第三维。\n# 实测收益（die0-3、同二进制两臂、只差这一个 env）：单流 @30720 ctx 13.1 -> 94.5 t/s（×7.22）；\n#       并发 8/32/64 的 Phase2 tok/s +1.39% / +1.83% / +0.20%，SE-Bench Phase1 逐项无回退。\n# 范围（**超出即走原路径，是设计不是遗漏**）：纯 decode(max_query_len==1) ∧ bf16 ∧ hd=256 ∧\n#       非2幂 block(528) ∧ kv_cache_dtype=auto ∧ 无 sliding_window/sinks/alibi ∧ num_seqs*kv_heads<=64。\n# ⚠️ 代价：分段 + log-sum-exp 归并改了求和顺序 ⇒ **破 temp=0 逐字可比性**（与上面 QuickReduce w>=4\n#       同类）。本模型历史基线全部作废：SE-Bench Phase2 新基线 = OFF 481.61 / ON 488.30 tok/s。\n# 证据：docs/research-notes/splitkv-{落地端到端,拐点与税收,转正许可证}-2026-09-0{7,8}.md\n# 正确性裁判：bench/pa256_golden.py（float32 独立手算）81 格全过，含 b=24/32/64 与 partition 边界±1。\n# ⚠️ **故意不设 VLLM_ROCM_SPLITKV_PA_MAX_SEQS**：门限唯一真值在内核 DEFAULT_MAX_SEQS=64；\n#    在这里再写一遍会制造\"两个真值来源\"（beta 封装里曾因此把 64 按回 16）。要改请改内核。\n# 关它（回退对照/排障）：VLLM_ROCM_SPLITKV_PA=0 bash <本脚本>\nexport VLLM_ROCM_SPLITKV_PA=\"${VLLM_ROCM_SPLITKV_PA:-1}\"\n# scratch 单 key 预算（内核 :676，默认 32 MiB/key）。本臂 256k 实测：seqs=16..64 七档全部被\n# `scratch 34078720..136314880 超预算` 打回 Triton——最小那次 **只超阈值 524,288 B（1.6%）**，\n# 最大 136,314,880 B=130 MiB。⇒ 与 27B 两臂统一抬到 192 MiB/key（130 + ~48% 余量；64/96 救不了\n# 本臂的 seqs≥32）。总基座仍受内核 MAX_TOTAL_MIB=192 MiB 约束（capture 从大到小 ⇒ hist≈0），\n# scratch 在 KV 池 sizing 后独立分配 ⇒ 不吃 KV 池（实测见 256k-上下文-2026-09-07.md §6）。\n# 一行回退：VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB=32 bash <本脚本>\nexport VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB=\"${VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB:-192}\"\n\nif nc -z 127.0.0.1 \"${PORT}\" 2>/dev/null; then\n  echo \"错误：端口 $PORT 已被占用\"; exit 1\nfi\n\n> \"${LOG_FILE}\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" \\\n  --served-model-name ornith \\\n  --language-model-only \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --tensor-parallel-size \"${TP}\" \\\n  --gpu-memory-utilization \"${GPU_MEM_UTIL}\" \\\n  --max-model-len \"${MAX_MODEL_LEN}\" \\\n  --enable-auto-tool-choice \\\n  --tool-call-parser qwen3_coder \\\n  --trust-remote-code \\\n  --no-use-tqdm-on-load \\\n  > \"${LOG_FILE}\" 2>&1 &\n\nsleep 1\necho \"✅ ornith-1.5-35b-a3b (MI250X GPU ${HIP_VISIBLE_DEVICES}, TP=${TP}, vLLM+AITER) http://localhost:${PORT}/v1\"\necho \"   AITER=1(moe/rmsnorm/mla/custom_ar) | ctx=${MAX_MODEL_LEN} | util=${GPU_MEM_UTIL} | 限功率400W/模组\"\necho \"   查看日志: tail -f ${LOG_FILE}\"","is_error":false}]},"parent_tool_use_id":null,"session_id":"0b6ae9cf-5f72-4206-979f-afe7dc600f73","uuid":"687c9129-6267-49a9-9ded-2d04ba1e16b6","timestamp":"2026-09-15T16:25:25.810Z","tool_use_result":{"stdout":"#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (MI250X GPU0-3, vLLM rocm7.2 wheel, TP4, 8k, AITER)\n# Desc: 由原系统版启动命令(存于 ~/ornith_serve_cmd.txt)迁移到 vllm_0.28.0_rocm72 环境。\n#   原参数逐字保留(--served-model-name ornith --language-model-only --max-model-len 8192\n#   --gpu-memory-utilization 0.85 --trust-remote-code --port 8000)，差异: TP 8→4；\n#   2026-09-03 更新: 启用 ROCm AITER 全家桶(主开关 VLLM_ROCM_USE_AITER=1，含 AITER MoE/\n#   RMSNorm/CUSTOM_AR)，并移除 --disable-custom-all-reduce 以放行定制 allreduce。\nset -euo pipefail\n\nAI_HOME=\"${AI_HOME:-/mnt/nvme2t-samsung/ai}\"\nVLLM_PYTHON=\"${VLLM_PYTHON:-${AI_HOME}/envs/vllm_0.28.0_rocm72/bin/python}\"\n\nROCM724=\"${ROCM724:-/opt/rocm-7.2.4}\"\nexport LD_LIBRARY_PATH=\"${ROCM724}/lib:${LD_LIBRARY_PATH:-}\"\nexport ROCM_PATH=\"${ROCM724}\"\nexport PATH=\"${ROCM724}/bin:${PATH}\"\n\n# --- ROCm AITER 加速路径 ---\nexport VLLM_ROCM_USE_AITER=\"${VLLM_ROCM_USE_AITER:-0}\"    # CDNA2(gfx90a) 被 vllm 硬门槛禁用(>2 才放行)\n\nPORT=\"${PORT:-8000}\"\nMODEL_PATH=\"${MODEL_PATH:-${AI_HOME}/models/ornith-ai/Ornith-1.5-35B-A3B}\"\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\nGPU_MEM_UTIL=\"${GPU_MEM_UTIL:-0.85}\"\nMAX_MODEL_LEN=\"${MAX_MODEL_LEN:-8192}\"\nTP=\"${TP:-4}\"\n\nexport HIP_VISIBLE_DEVICES=\"${HIP_VISIBLE_DEVICES:-0,1,2,3}\"\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8\"\nexport RAY_memory_monitor_refresh_ms=\"0\"\n\n# --- MI250X(gfx90a) P1+C2+C3（原生 env 已打补丁，2026-09-03 实测）---------------\n# P1 门控 GEMV：与 F.linear 逐位相同；Ornith TP4 单流 71.2 -> 85.3 t/s (+19.8%)。\n# C2/C3 QuickReduce：默认下限表 (bf16,4)=8MB 会把 decode 的 4-10KB 全 reduce 挡在门外，\n#   必须同时给 MIN_SIZE_BYTES_MB=0 才真上场；缺这行 = 设了 FP 也没用（我踩过）。\n#   实测增益 Ornith TP4 单流 +12.5% / 并发4 +24.9%；稠密 TP2 单流 +4.7% / 并发 +2.0%。\n#   数值：world=2 与 NCCL 逐位一致；world>=4 是求和顺序不同（平均误差与 NCCL 相等\n#   0.231 ULP、优劣对称 19/62/19），temp=0 的逐 token 输出会与旧基线不同 -> 基线需重跑。\nexport MI250_GATE_GEMV=\"${MI250_GATE_GEMV:-1}\"\nexport VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"${VLLM_ROCM_QUICK_REDUCE_QUANTIZATION:-FP}\"\nexport VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB=\"${VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB:-0}\"\nexport VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=\"${VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16:-0}\"\n\nif nc -z 127.0.0.1 \"${PORT}\" 2>/dev/null; then\n  echo \"错误：端口 $PORT 已被占用\"; exit 1\nfi\n\n> \"${LOG_FILE}\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" \\\n  --served-model-name ornith \\\n  --language-model-only \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --tensor-parallel-size \"${TP}\" \\\n  --gpu-memory-utilization \"${GPU_MEM_UTIL}\" \\\n  --max-model-len \"${MAX_MODEL_LEN}\" \\\n  --enable-auto-tool-choice \\\n  --tool-call-parser qwen3_coder \\\n  --trust-remote-code \\\n  --no-use-tqdm-on-load \\\n  > \"${LOG_FILE}\" 2>&1 &\n\nsleep 1\necho \"✅ ornith-1.5-35b-a3b (MI250X GPU ${HIP_VISIBLE_DEVICES}, TP=${TP}, vLLM+AITER) http://localhost:${PORT}/v1\"\necho \"   AITER=1(moe/rmsnorm/mla/custom_ar) | ctx=${MAX_MODEL_LEN} | util=${GPU_MEM_UTIL} | 限功率400W/模组\"\necho \"   查看日志: tail -f ${LOG_FILE}\"\n\n=== 256k ===\n#!/bin/bash\n# Name: Ornith-1.5-35B-A3B (MI250X GPU0-3, vLLM rocm7.2 wheel, TP4, 256k, AITER)\n# Desc: 由原系统版启动命令(存于 ~/ornith_serve_cmd.txt)迁移到 vllm_0.28.0_rocm72 环境。\n#   原参数逐字保留(--served-model-name ornith --language-model-only --max-model-len 8192\n#   --gpu-memory-utilization 0.85 --trust-remote-code --port 8000)，差异: TP 8→4；\n#   2026-09-03 更新: 启用 ROCm AITER 全家桶(主开关 VLLM_ROCM_USE_AITER=1，含 AITER MoE/\n#   RMSNorm/CUSTOM_AR)，并移除 --disable-custom-all-reduce 以放行定制 allreduce。\n#   2026-09-07 更新: ctx 8k→**256k**(MAX_MODEL_LEN=262144)。依据：config.json\n#   max_position_embeddings=262,144 ⇒ 原生上限内，无需 YaRN/外挂（CLAUDE.md §9 同族\n#   Flash-Next 已定稿 262,144；1M 判定被用户取消，见 docs/research-notes/{1M-上下文可行性,256k-上下文}-2026-09-07.md）。\n#   ⚠️ 改名后 beta 封装 serve_ornith_splitkv_ab.sh 的 LAUNCHER 路径与 LOGPAT 需同步（已同步）。\nset -euo pipefail\n\nAI_HOME=\"${AI_HOME:-/home/qiba/ai}\"\nVLLM_PYTHON=\"${VLLM_PYTHON:-${AI_HOME}/envs/vllm_0.28.0_rocm72/bin/python}\"\n\nROCM724=\"${ROCM724:-/opt/rocm-7.2.4}\"\nexport LD_LIBRARY_PATH=\"${ROCM724}/lib:${LD_LIBRARY_PATH:-}\"\nexport ROCM_PATH=\"${ROCM724}\"\nexport PATH=\"${ROCM724}/bin:${PATH}\"\n\n# --- ROCm AITER 加速路径 ---\nexport VLLM_ROCM_USE_AITER=\"${VLLM_ROCM_USE_AITER:-0}\"    # CDNA2(gfx90a) 被 vllm 硬门槛禁用(>2 才放行)\n\nPORT=\"${PORT:-8000}\"\nMODEL_PATH=\"${MODEL_PATH:-${AI_HOME}/models/ornith-ai/Ornith-1.5-35B-A3B}\"\nLOG_FILE=\"/tmp/$(basename \"$0\" .sh)-$(date +%Y%m%d-%H%M).log\"\nGPU_MEM_UTIL=\"${GPU_MEM_UTIL:-0.85}\"\nMAX_MODEL_LEN=\"${MAX_MODEL_LEN:-262144}\"   # 2026-09-07: 8192→262144（原生上限，见头部注释）\nTP=\"${TP:-4}\"\n\nexport HIP_VISIBLE_DEVICES=\"${HIP_VISIBLE_DEVICES:-0,1,2,3}\"\nexport PYTORCH_CUDA_ALLOC_CONF=\"expandable_segments:True,garbage_collection_threshold:0.8\"\nexport RAY_memory_monitor_refresh_ms=\"0\"\n\n# --- MI250X(gfx90a) P1+C2+C3（原生 env 已打补丁，2026-09-03 实测）---------------\n# P1 门控 GEMV：与 F.linear 逐位相同；Ornith TP4 单流 71.2 -> 85.3 t/s (+19.8%)。\n# C2/C3 QuickReduce：默认下限表 (bf16,4)=8MB 会把 decode 的 4-10KB 全 reduce 挡在门外，\n#   必须同时给 MIN_SIZE_BYTES_MB=0 才真上场；缺这行 = 设了 FP 也没用（我踩过）。\n#   实测增益 Ornith TP4 单流 +12.5% / 并发4 +24.9%；稠密 TP2 单流 +4.7% / 并发 +2.0%。\n#   数值：world=2 与 NCCL 逐位一致；world>=4 是求和顺序不同（平均误差与 NCCL 相等\n#   0.231 ULP、优劣对称 19/62/19），temp=0 的逐 token 输出会与旧基线不同 -> 基线需重跑。\nexport MI250_GATE_GEMV=\"${MI250_GATE_GEMV:-1}\"\nexport VLLM_ROCM_QUICK_REDUCE_QUANTIZATION=\"${VLLM_ROCM_QUICK_REDUCE_QUANTIZATION:-FP}\"\nexport VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB=\"${VLLM_ROCM_QUICK_REDUCE_MIN_SIZE_BYTES_MB:-0}\"\nexport VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16=\"${VLLM_ROCM_QUICK_REDUCE_CAST_BF16_TO_FP16:-0}\"\n\n# --- MI250X split-KV paged-decode（2026-09-07 转正，进生产默认开）---\n# 病根：现役 Triton 参考内核 grid 只有 (num_seqs, num_kv_heads) ⇒ 单流时 **1 个 program / 104 CU**，\n#       带宽恒定 7-12 GB/s（纯读峰 1171）。split-KV 把 KV 维切成 partition 作为 grid 第三维。\n# 实测收益（die0-3、同二进制两臂、只差这一个 env）：单流 @30720 ctx 13.1 -> 94.5 t/s（×7.22）；\n#       并发 8/32/64 的 Phase2 tok/s +1.39% / +1.83% / +0.20%，SE-Bench Phase1 逐项无回退。\n# 范围（**超出即走原路径，是设计不是遗漏**）：纯 decode(max_query_len==1) ∧ bf16 ∧ hd=256 ∧\n#       非2幂 block(528) ∧ kv_cache_dtype=auto ∧ 无 sliding_window/sinks/alibi ∧ num_seqs*kv_heads<=64。\n# ⚠️ 代价：分段 + log-sum-exp 归并改了求和顺序 ⇒ **破 temp=0 逐字可比性**（与上面 QuickReduce w>=4\n#       同类）。本模型历史基线全部作废：SE-Bench Phase2 新基线 = OFF 481.61 / ON 488.30 tok/s。\n# 证据：docs/research-notes/splitkv-{落地端到端,拐点与税收,转正许可证}-2026-09-0{7,8}.md\n# 正确性裁判：bench/pa256_golden.py（float32 独立手算）81 格全过，含 b=24/32/64 与 partition 边界±1。\n# ⚠️ **故意不设 VLLM_ROCM_SPLITKV_PA_MAX_SEQS**：门限唯一真值在内核 DEFAULT_MAX_SEQS=64；\n#    在这里再写一遍会制造\"两个真值来源\"（beta 封装里曾因此把 64 按回 16）。要改请改内核。\n# 关它（回退对照/排障）：VLLM_ROCM_SPLITKV_PA=0 bash <本脚本>\nexport VLLM_ROCM_SPLITKV_PA=\"${VLLM_ROCM_SPLITKV_PA:-1}\"\n# scratch 单 key 预算（内核 :676，默认 32 MiB/key）。本臂 256k 实测：seqs=16..64 七档全部被\n# `scratch 34078720..136314880 超预算` 打回 Triton——最小那次 **只超阈值 524,288 B（1.6%）**，\n# 最大 136,314,880 B=130 MiB。⇒ 与 27B 两臂统一抬到 192 MiB/key（130 + ~48% 余量；64/96 救不了\n# 本臂的 seqs≥32）。总基座仍受内核 MAX_TOTAL_MIB=192 MiB 约束（capture 从大到小 ⇒ hist≈0），\n# scratch 在 KV 池 sizing 后独立分配 ⇒ 不吃 KV 池（实测见 256k-上下文-2026-09-07.md §6）。\n# 一行回退：VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB=32 bash <本脚本>\nexport VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB=\"${VLLM_ROCM_SPLITKV_PA_MAX_SCRATCH_MIB:-192}\"\n\nif nc -z 127.0.0.1 \"${PORT}\" 2>/dev/null; then\n  echo \"错误：端口 $PORT 已被占用\"; exit 1\nfi\n\n> \"${LOG_FILE}\"\n\nnohup \"${VLLM_PYTHON}\" -m vllm.entrypoints.openai.api_server \\\n  --model \"${MODEL_PATH}\" \\\n  --served-model-name ornith \\\n  --language-model-only \\\n  --host 0.0.0.0 --port \"${PORT}\" \\\n  --tensor-parallel-size \"${TP}\" \\\n  --gpu-memory-utilization \"${GPU_MEM_UTIL}\" \\\n  --max-model-len \"${MAX_MODEL_LEN}\" \\\n  --enable-auto-tool-choice \\\n  --tool-call-parser qwen3_coder \\\n  --trust-remote-code \\\n  --no-use-tqdm-on-load \\\n  > \"${LOG_FILE}\" 2>&1 &\n\nsleep 1\necho \"✅ ornith-1.5-35b-a3b (MI250X GPU ${HIP_VISIBLE_DEVICES}, TP=${TP}, vLLM+AITER) http://localhost:${PORT}/v1\"\necho \"   AITER=1(moe/rmsnorm/mla/custom_ar) | ctx=${MAX_MODEL_LEN} | util=${GPU_MEM_UTIL} | 限功率400W/模组\"\necho \"   查看日志: tail -f ${LOG_FILE}\"","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
