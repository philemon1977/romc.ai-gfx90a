{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_aecc978a44826c9c","type":"tool_result","content":"total 1040\ndrwxr-xr-x 7 root root   4096 Sep 15 17:01 .\ndrwxr-xr-x 6 root root   4096 Sep 15 17:31 ..\ndrwxr-xr-x 2 root root   4096 Sep 15 16:47 artifacts\ndrwxr-xr-x 3 root root   4096 Sep 15 16:48 boot\n-rw------- 1 root root    125 Sep 15 17:01 heartbeat.json\ndrwxr-xr-x 2 root root   4096 Sep 15 16:42 patches\n-rw------- 1 root root 985561 Sep 15 17:01 process.log\n-rw------- 1 root root  13153 Sep 15 16:24 prompt.md\ndrwxr-xr-x 3 root root   4096 Sep 15 17:00 scratch\n-rw------- 1 root root   2371 Sep 15 17:01 specialist_done.json\n-rw-r--r-- 1 root root   1742 Sep 15 16:53 specialist_done.partial.json\n-rw------- 1 root root  13777 Sep 15 16:24 system_prompt.md\n-rw-r--r-- 1 root root    508 Sep 15 17:01 transcript.jsonl\ndrwxr-xr-x 4 root root   4096 Sep 15 16:37 wt\n=== PATCH ===\ndiff --git a/vllm/model_executor/kernels/linear/__init__.py b/vllm/model_executor/kernels/linear/__init__.py\nindex 3413d4a..99a2a19 100644\n--- a/vllm/model_executor/kernels/linear/__init__.py\n+++ b/vllm/model_executor/kernels/linear/__init__.py\n@@ -178,6 +178,9 @@ from vllm.model_executor.kernels.linear.scaled_mm.b12x_block import (\n from vllm.model_executor.kernels.linear.scaled_mm.b12x_tensor import (\n     B12xTensorFP8ScaledMMLinearKernel,\n )\n+from vllm.model_executor.kernels.linear.scaled_mm.emulation import (\n+    FP8W8A8EmulationLinearKernel,\n+)\n from vllm.model_executor.kernels.linear.scaled_mm.cpu import (\n     CPUFp8BlockScaledMMKernel,\n     CPUInt8ScaledMMLinearKernel,\n@@ -326,6 +329,7 @@ _LINEAR_BACKEND_KERNEL_MAP: dict[str, set[type]] = {\n         ExllamaLinearKernel,\n     },\n     \"emulation\": {\n+        FP8W8A8EmulationLinearKernel,\n         EmulationMxfp8LinearKernel,\n         EmulationNvFp4LinearKernel,\n         EmulationMxfp6LinearKernel,\n@@ -409,6 +413,14 @@ _POSSIBLE_FP8_KERNELS: dict[PlatformEnum, list[type[FP8ScaledMMLinearKernel]]] =\n         AiterPreshuffledPerTokenFp8ScaledMMLinearKernel,\n         AiterPerTokenFp8ScaledMMLinearKernel,\n         ROCmFP8ScaledMMLinearKernel,\n+        # CDNA1/CDNA2 (gfx908/gfx90a, e.g. MI250X) have no FP8 matrix unit and\n+        # torch._scaled_mm rejects FP8 there outright, but the Torch kernels\n+        # below are selected anyway: gfx90a reports compute capability (9, 0),\n+        # so their inherited `compute_capability < 89` gate does not fire and\n+        # the engine aborts inside profile_run. Dequantize-and-run-BF16 comes\n+        # ahead of them; its is_supported() is gated to exactly those GPUs, so\n+        # CDNA3+/CUDA selection is unchanged.\n+        FP8W8A8EmulationLinearKernel,\n         PerTensorTorchFP8ScaledMMLinearKernel,\n         RowWiseTorchFP8ScaledMMLinearKernel,\n         ChannelWiseTorchFP8ScaledMMLinearKernel,\n@@ -1179,6 +1191,7 @@ __all__ = [\n     \"CutlassInt8ScaledMMLinearKernel\",\n     \"FlashInferFP8ScaledMMLinearKernel\",\n     \"ChannelWiseTorchFP8ScaledMMLinearKernel\",\n+    \"FP8W8A8EmulationLinearKernel\",\n     \"PerTensorTorchFP8ScaledMMLinearKernel\",\n     \"RowWiseTorchFP8ScaledMMLinearKernel\",\n     \"ROCmFP8ScaledMMLinearKernel\",\ndiff --git a/vllm/model_executor/kernels/linear/scaled_mm/__init__.py b/vllm/model_executor/kernels/linear/scaled_mm/__init__.py\nindex 39f9abd..339bf29 100644\n--- a/vllm/model_executor/kernels/linear/scaled_mm/__init__.py\n+++ b/vllm/model_executor/kernels/linear/scaled_mm/__init__.py\n@@ -7,6 +7,9 @@ from vllm.model_executor.kernels.linear.scaled_mm.aiter import (\n from vllm.model_executor.kernels.linear.scaled_mm.BlockScaledMMLinearKernel import (\n     Fp8BlockScaledMMLinearKernel,\n )\n+from vllm.model_executor.kernels.linear.scaled_mm.emulation import (\n+    FP8W8A8EmulationLinearKernel,\n+)\n from vllm.model_executor.kernels.linear.scaled_mm.cpu import (\n     CPUFp8BlockScaledMMKernel,\n     CPUInt8ScaledMMLinearKernel,\n@@ -67,5 +70,6 @@ __all__ = [\n     \"ZentorchInt8ScaledMMLinearKernel\",\n     \"Fp8BlockScaledMMLinearKernel\",\n     \"CPUFp8BlockScaledMMKernel\",\n+    \"FP8W8A8EmulationLinearKernel\",\n     \"XPUFp8BlockScaledMMKernel\",\n ]\ndiff --git a/vllm/model_executor/kernels/linear/scaled_mm/emulation.py b/vllm/model_executor/kernels/linear/scaled_mm/emulation.py\nnew file mode 100644\nindex 0000000..12cba47\n--- /dev/null\n+++ b/vllm/model_executor/kernels/linear/scaled_mm/emulation.py\n@@ -0,0 +1,230 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+\"\"\"FP8 w8a8 dense-linear emulation for AMD GPUs without hardware FP8.\n+\n+``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm parts older than MI300\n+(\"torch._scaled_mm is only supported on CUDA devices with compute capability\n+>= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 GPUs (gfx908 / gfx90a, e.g.\n+MI250X) have no FP8 matrix instruction at all, so *no* scaled-mm provider can\n+serve an FP8 checkpoint there. Before this kernel existed, the ROCm FP8\n+registry fell through the aiter / skinny-GEMM / rowwise gates (all correctly\n+arch-gated) and landed on ``ChannelWiseTorchFP8ScaledMMLinearKernel``, whose\n+inherited ``compute capability >= 89`` gate is fooled by gfx90a reporting\n+capability ``(9, 0)`` -- so the engine aborted inside ``profile_run``.\n+\n+This kernel bridges the gap: it dequantizes the FP8 weight to the activation\n+dtype ONCE at load time and then runs a plain ``F.linear``. That is the same\n+recipe already used in-tree by\n+\n+* ``model_executor/kernels/linear/mxfp8/emulation.py`` and\n+  ``nvfp4/emulation.py`` -- dequantize, then run a plain higher-precision GEMM,\n+* ``model_executor/layers/quantization/fp8.py`` -- the ``VLLM_BATCH_INVARIANT``\n+  per-tensor / per-channel path (\"dequant to BF16 and run GEMM\").\n+\n+Why dequantize instead of writing a Triton FP8 GEMM: on gfx90a a Triton FP8\n+w8a8 ``tl.dot`` has to upconvert the operands anyway and reaches only a small\n+fraction of what a native BF16 ``torch.mm`` does, so keeping the weights in\n+FP8 to save memory would buy memory at a large dense-GEMM speed cost. Only\n+*dense* linears take this path (MoE experts keep their own kernels), so the\n+1-byte -> 2-byte growth is bounded by the non-expert parameter count.\n+\n+Accuracy: the FP8 (E4M3) -> BF16 cast is exact -- E4M3's 3+1 mantissa bits and\n+4-bit exponent both fit in BF16 -- so the only error added versus a true scaled\n+GEMM is one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic\n+FP8 weight-quantization error. The activation is additionally NOT re-quantized\n+to FP8 (it stays BF16), which removes the activation-quant error term the FP8\n+path would have had.\n+\n+Opt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n+\"\"\"\n+\n+import torch\n+from torch.nn.parameter import Parameter\n+\n+from vllm.logger import init_logger\n+from vllm.model_executor.layers.fusion.quant_activation import (\n+    QuantizedActivation,\n+)\n+from vllm.model_executor.layers.quantization.utils.quant_utils import GroupShape\n+from vllm.platforms import current_platform\n+from vllm.model_executor.utils import replace_parameter\n+\n+from .ScaledMMLinearKernel import (\n+    FP8ScaledMMLinearKernel,\n+    FP8ScaledMMLinearLayerConfig,\n+)\n+\n+logger = init_logger(__name__)\n+\n+_FP8_DTYPES = (\n+    torch.float8_e4m3fn,\n+    torch.float8_e4m3fnuz,\n+    torch.float8_e5m2,\n+    torch.float8_e5m2fnuz,\n+)\n+\n+\n+def rocm_lacks_hardware_fp8() -> bool:\n+    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n+    if not current_platform.is_rocm():\n+        return False\n+\n+    from vllm.platforms.rocm import get_cdna_version, on_cdna\n+\n+    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n+    # Hardware FP8 (and hence hipBLASLt FP8 scaled-mm) starts at CDNA3.\n+    return on_cdna() and get_cdna_version() < 3\n+\n+\n+class FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n+    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n+\n+    # Accumulated over all rewritten layers, for one informational log line.\n+    _fp8_bytes = 0\n+    _dq_bytes = 0\n+\n+    @classmethod\n+    def is_supported(\n+        cls, compute_capability: int | None = None\n+    ) -> tuple[bool, str | None]:\n+        if not rocm_lacks_hardware_fp8():\n+            return False, (\n+                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n+                \"FP8 and no torch._scaled_mm support.\"\n+            )\n+        return True, None\n+\n+    @classmethod\n+    def can_implement(\n+        cls, c: FP8ScaledMMLinearLayerConfig\n+    ) -> tuple[bool, str | None]:\n+        if c.weight_quant_key.scale.group_shape.is_per_group():\n+            return False, \"cannot implement block/group-wise FP8 weights.\"\n+        if c.activation_quant_key.scale.group_shape.is_per_group():\n+            return False, \"cannot implement block/group-wise FP8 activations.\"\n+        out_dtype = c.out_dtype or torch.get_default_dtype()\n+        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n+            return False, f\"requires a >= 2-byte floating point output dtype.\"\n+        return True, None\n+\n+    @staticmethod\n+    def _as_nk(weight: torch.Tensor) -> torch.Tensor:\n+        \"\"\"Return ``weight`` oriented as [N, K] (out_features, in_features).\n+\n+        Quant methods leave the prepared parameter transposed to [K, N] and\n+        tag it with ``input_dim=0`` / ``output_dim=1``; prefer that contract\n+        over guessing from strides.\n+        \"\"\"\n+        if weight.dim() != 2:\n+            return weight\n+        input_dim = getattr(weight, \"input_dim\", None)\n+        if input_dim == 0:\n+            return weight.t()\n+        if input_dim == 1:\n+            return weight\n+        # No dim tags: fall back to the layout the compressed-tensors schemes\n+        # produce (transposed view => stride(0) == 1).\n+        if weight.stride(0) == 1 and weight.stride(1) != 1:\n+            return weight.t()\n+        return weight\n+\n+    def _dequant(\n+        self,\n+        weight: torch.Tensor,\n+        weight_scale: torch.Tensor | None,\n+    ) -> torch.Tensor:\n+        \"\"\"Dequantize an FP8 weight, returning a float32 [N, K] tensor.\"\"\"\n+        w_nk = self._as_nk(weight)\n+        if w_nk.stride(-1) != 1:\n+            w_nk = w_nk.contiguous()\n+        n, k = w_nk.shape\n+        w_f32 = w_nk.to(torch.float32)\n+\n+        if weight_scale is None:\n+            return w_f32\n+        if weight_scale.numel() == 1:\n+            return w_f32 * weight_scale.to(torch.float32).reshape(-1)[0]\n+\n+        scale = weight_scale.to(torch.float32).reshape(-1)\n+        if scale.numel() == n:\n+            return w_f32 * scale.unsqueeze(1)\n+        if scale.numel() == k:\n+            return w_f32 * scale.unsqueeze(0)\n+        raise ValueError(\n+            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n+            f\"matches neither N={n} nor K={k}.\"\n+        )\n+\n+    def input_quant_key(self):\n+        # The activation is never quantized here, so no manual-fusion partner\n+        # may hoist FP8 quantization upstream of this layer.\n+        return None\n+\n+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n+        weight, weight_scale, _, _ = self._get_layer_params(layer)\n+        if weight is None or weight.dtype not in _FP8_DTYPES:\n+            # Already dequantized by an earlier pass, or never FP8 at all.\n+            return\n+\n+        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n+        w_dq = self._dequant(weight, weight_scale).to(out_dtype)\n+\n+        self.__class__._fp8_bytes += weight.numel() * weight.element_size()\n+        self.__class__._dq_bytes += w_dq.numel() * w_dq.element_size()\n+        logger.info_once(\n+            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"\n+            \"hardware FP8 and no torch._scaled_mm support): dequantizing \"\n+            \"weights at load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",\n+            str(out_dtype).replace(\"torch.\", \"\"),\n+            self.__class__._fp8_bytes / 2**30,\n+            self.__class__._dq_bytes / 2**30,\n+            scope=\"global\",\n+        )\n+\n+        # Store as a [N, K] parameter so apply_weights can call F.linear\n+        # directly; the weight loader has already run.\n+        replace_parameter(\n+            layer, \"weight\", Parameter(w_dq, requires_grad=False)\n+        )\n+        layer.weight.input_dim = 1\n+        layer.weight.output_dim = 0\n+        # The scale has been folded into the weight: drop the reference so the\n+        # FP8-side bookkeeping cannot be mistaken for a live quantized tensor.\n+        if weight_scale is not None:\n+            replace_parameter(\n+                layer,\n+                \"weight_scale\",\n+                Parameter(torch.ones((), dtype=out_dtype), requires_grad=False),\n+            )\n+\n+    def apply_weights(\n+        self,\n+        layer: torch.nn.Module,\n+        x: torch.Tensor | QuantizedActivation,\n+        bias: torch.Tensor | None = None,\n+    ) -> torch.Tensor:\n+        if isinstance(x, QuantizedActivation):\n+            # Defensive only: this kernel does not advertise input_quant_key(),\n+            # so manual fusion never hands us a pre-quantized activation.\n+            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(\n+                *x.orig_shape\n+            )\n+\n+        weight = layer.weight\n+        if weight.dtype in _FP8_DTYPES:\n+            # Not pre-dequantized (process_weights_after_loading was skipped):\n+            # dequantize on the fly so we never reach torch._scaled_mm.\n+            _, weight_scale, _, _ = self._get_layer_params(layer)\n+            weight = self._dequant(weight, weight_scale)\n+\n+        # F.linear needs matching dtypes; .to() is a no-op when they already do.\n+        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)\n+\n+    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n+        # This kernel overrides apply_weights and must never call\n+        # torch._scaled_mm, which does not exist on pre-MI300 ROCm.\n+        raise NotImplementedError(\n+            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n+            \"apply_scaled_mm is intentionally not implemented.\"\n+        )","is_error":false}]},"parent_tool_use_id":null,"session_id":"0bdd9947-a518-4714-97ad-d090d3f8ef30","uuid":"0a4040b0-c9e5-4fdc-973a-dae0f86467aa","timestamp":"2026-09-15T17:32:04.914Z","tool_use_result":{"stdout":"total 1040\ndrwxr-xr-x 7 root root   4096 Sep 15 17:01 .\ndrwxr-xr-x 6 root root   4096 Sep 15 17:31 ..\ndrwxr-xr-x 2 root root   4096 Sep 15 16:47 artifacts\ndrwxr-xr-x 3 root root   4096 Sep 15 16:48 boot\n-rw------- 1 root root    125 Sep 15 17:01 heartbeat.json\ndrwxr-xr-x 2 root root   4096 Sep 15 16:42 patches\n-rw------- 1 root root 985561 Sep 15 17:01 process.log\n-rw------- 1 root root  13153 Sep 15 16:24 prompt.md\ndrwxr-xr-x 3 root root   4096 Sep 15 17:00 scratch\n-rw------- 1 root root   2371 Sep 15 17:01 specialist_done.json\n-rw-r--r-- 1 root root   1742 Sep 15 16:53 specialist_done.partial.json\n-rw------- 1 root root  13777 Sep 15 16:24 system_prompt.md\n-rw-r--r-- 1 root root    508 Sep 15 17:01 transcript.jsonl\ndrwxr-xr-x 4 root root   4096 Sep 15 16:37 wt\n=== PATCH ===\ndiff --git a/vllm/model_executor/kernels/linear/__init__.py b/vllm/model_executor/kernels/linear/__init__.py\nindex 3413d4a..99a2a19 100644\n--- a/vllm/model_executor/kernels/linear/__init__.py\n+++ b/vllm/model_executor/kernels/linear/__init__.py\n@@ -178,6 +178,9 @@ from vllm.model_executor.kernels.linear.scaled_mm.b12x_block import (\n from vllm.model_executor.kernels.linear.scaled_mm.b12x_tensor import (\n     B12xTensorFP8ScaledMMLinearKernel,\n )\n+from vllm.model_executor.kernels.linear.scaled_mm.emulation import (\n+    FP8W8A8EmulationLinearKernel,\n+)\n from vllm.model_executor.kernels.linear.scaled_mm.cpu import (\n     CPUFp8BlockScaledMMKernel,\n     CPUInt8ScaledMMLinearKernel,\n@@ -326,6 +329,7 @@ _LINEAR_BACKEND_KERNEL_MAP: dict[str, set[type]] = {\n         ExllamaLinearKernel,\n     },\n     \"emulation\": {\n+        FP8W8A8EmulationLinearKernel,\n         EmulationMxfp8LinearKernel,\n         EmulationNvFp4LinearKernel,\n         EmulationMxfp6LinearKernel,\n@@ -409,6 +413,14 @@ _POSSIBLE_FP8_KERNELS: dict[PlatformEnum, list[type[FP8ScaledMMLinearKernel]]] =\n         AiterPreshuffledPerTokenFp8ScaledMMLinearKernel,\n         AiterPerTokenFp8ScaledMMLinearKernel,\n         ROCmFP8ScaledMMLinearKernel,\n+        # CDNA1/CDNA2 (gfx908/gfx90a, e.g. MI250X) have no FP8 matrix unit and\n+        # torch._scaled_mm rejects FP8 there outright, but the Torch kernels\n+        # below are selected anyway: gfx90a reports compute capability (9, 0),\n+        # so their inherited `compute_capability < 89` gate does not fire and\n+        # the engine aborts inside profile_run. Dequantize-and-run-BF16 comes\n+        # ahead of them; its is_supported() is gated to exactly those GPUs, so\n+        # CDNA3+/CUDA selection is unchanged.\n+        FP8W8A8EmulationLinearKernel,\n         PerTensorTorchFP8ScaledMMLinearKernel,\n         RowWiseTorchFP8ScaledMMLinearKernel,\n         ChannelWiseTorchFP8ScaledMMLinearKernel,\n@@ -1179,6 +1191,7 @@ __all__ = [\n     \"CutlassInt8ScaledMMLinearKernel\",\n     \"FlashInferFP8ScaledMMLinearKernel\",\n     \"ChannelWiseTorchFP8ScaledMMLinearKernel\",\n+    \"FP8W8A8EmulationLinearKernel\",\n     \"PerTensorTorchFP8ScaledMMLinearKernel\",\n     \"RowWiseTorchFP8ScaledMMLinearKernel\",\n     \"ROCmFP8ScaledMMLinearKernel\",\ndiff --git a/vllm/model_executor/kernels/linear/scaled_mm/__init__.py b/vllm/model_executor/kernels/linear/scaled_mm/__init__.py\nindex 39f9abd..339bf29 100644\n--- a/vllm/model_executor/kernels/linear/scaled_mm/__init__.py\n+++ b/vllm/model_executor/kernels/linear/scaled_mm/__init__.py\n@@ -7,6 +7,9 @@ from vllm.model_executor.kernels.linear.scaled_mm.aiter import (\n from vllm.model_executor.kernels.linear.scaled_mm.BlockScaledMMLinearKernel import (\n     Fp8BlockScaledMMLinearKernel,\n )\n+from vllm.model_executor.kernels.linear.scaled_mm.emulation import (\n+    FP8W8A8EmulationLinearKernel,\n+)\n from vllm.model_executor.kernels.linear.scaled_mm.cpu import (\n     CPUFp8BlockScaledMMKernel,\n     CPUInt8ScaledMMLinearKernel,\n@@ -67,5 +70,6 @@ __all__ = [\n     \"ZentorchInt8ScaledMMLinearKernel\",\n     \"Fp8BlockScaledMMLinearKernel\",\n     \"CPUFp8BlockScaledMMKernel\",\n+    \"FP8W8A8EmulationLinearKernel\",\n     \"XPUFp8BlockScaledMMKernel\",\n ]\ndiff --git a/vllm/model_executor/kernels/linear/scaled_mm/emulation.py b/vllm/model_executor/kernels/linear/scaled_mm/emulation.py\nnew file mode 100644\nindex 0000000..12cba47\n--- /dev/null\n+++ b/vllm/model_executor/kernels/linear/scaled_mm/emulation.py\n@@ -0,0 +1,230 @@\n+# SPDX-License-Identifier: Apache-2.0\n+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n+\n+\"\"\"FP8 w8a8 dense-linear emulation for AMD GPUs without hardware FP8.\n+\n+``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm parts older than MI300\n+(\"torch._scaled_mm is only supported on CUDA devices with compute capability\n+>= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 GPUs (gfx908 / gfx90a, e.g.\n+MI250X) have no FP8 matrix instruction at all, so *no* scaled-mm provider can\n+serve an FP8 checkpoint there. Before this kernel existed, the ROCm FP8\n+registry fell through the aiter / skinny-GEMM / rowwise gates (all correctly\n+arch-gated) and landed on ``ChannelWiseTorchFP8ScaledMMLinearKernel``, whose\n+inherited ``compute capability >= 89`` gate is fooled by gfx90a reporting\n+capability ``(9, 0)`` -- so the engine aborted inside ``profile_run``.\n+\n+This kernel bridges the gap: it dequantizes the FP8 weight to the activation\n+dtype ONCE at load time and then runs a plain ``F.linear``. That is the same\n+recipe already used in-tree by\n+\n+* ``model_executor/kernels/linear/mxfp8/emulation.py`` and\n+  ``nvfp4/emulation.py`` -- dequantize, then run a plain higher-precision GEMM,\n+* ``model_executor/layers/quantization/fp8.py`` -- the ``VLLM_BATCH_INVARIANT``\n+  per-tensor / per-channel path (\"dequant to BF16 and run GEMM\").\n+\n+Why dequantize instead of writing a Triton FP8 GEMM: on gfx90a a Triton FP8\n+w8a8 ``tl.dot`` has to upconvert the operands anyway and reaches only a small\n+fraction of what a native BF16 ``torch.mm`` does, so keeping the weights in\n+FP8 to save memory would buy memory at a large dense-GEMM speed cost. Only\n+*dense* linears take this path (MoE experts keep their own kernels), so the\n+1-byte -> 2-byte growth is bounded by the non-expert parameter count.\n+\n+Accuracy: the FP8 (E4M3) -> BF16 cast is exact -- E4M3's 3+1 mantissa bits and\n+4-bit exponent both fit in BF16 -- so the only error added versus a true scaled\n+GEMM is one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic\n+FP8 weight-quantization error. The activation is additionally NOT re-quantized\n+to FP8 (it stays BF16), which removes the activation-quant error term the FP8\n+path would have had.\n+\n+Opt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n+\"\"\"\n+\n+import torch\n+from torch.nn.parameter import Parameter\n+\n+from vllm.logger import init_logger\n+from vllm.model_executor.layers.fusion.quant_activation import (\n+    QuantizedActivation,\n+)\n+from vllm.model_executor.layers.quantization.utils.quant_utils import GroupShape\n+from vllm.platforms import current_platform\n+from vllm.model_executor.utils import replace_parameter\n+\n+from .ScaledMMLinearKernel import (\n+    FP8ScaledMMLinearKernel,\n+    FP8ScaledMMLinearLayerConfig,\n+)\n+\n+logger = init_logger(__name__)\n+\n+_FP8_DTYPES = (\n+    torch.float8_e4m3fn,\n+    torch.float8_e4m3fnuz,\n+    torch.float8_e5m2,\n+    torch.float8_e5m2fnuz,\n+)\n+\n+\n+def rocm_lacks_hardware_fp8() -> bool:\n+    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n+    if not current_platform.is_rocm():\n+        return False\n+\n+    from vllm.platforms.rocm import get_cdna_version, on_cdna\n+\n+    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n+    # Hardware FP8 (and hence hipBLASLt FP8 scaled-mm) starts at CDNA3.\n+    return on_cdna() and get_cdna_version() < 3\n+\n+\n+class FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n+    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n+\n+    # Accumulated over all rewritten layers, for one informational log line.\n+    _fp8_bytes = 0\n+    _dq_bytes = 0\n+\n+    @classmethod\n+    def is_supported(\n+        cls, compute_capability: int | None = None\n+    ) -> tuple[bool, str | None]:\n+        if not rocm_lacks_hardware_fp8():\n+            return False, (\n+                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n+                \"FP8 and no torch._scaled_mm support.\"\n+            )\n+        return True, None\n+\n+    @classmethod\n+    def can_implement(\n+        cls, c: FP8ScaledMMLinearLayerConfig\n+    ) -> tuple[bool, str | None]:\n+        if c.weight_quant_key.scale.group_shape.is_per_group():\n+            return False, \"cannot implement block/group-wise FP8 weights.\"\n+        if c.activation_quant_key.scale.group_shape.is_per_group():\n+            return False, \"cannot implement block/group-wise FP8 activations.\"\n+        out_dtype = c.out_dtype or torch.get_default_dtype()\n+        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n+            return False, f\"requires a >= 2-byte floating point output dtype.\"\n+        return True, None\n+\n+    @staticmethod\n+    def _as_nk(weight: torch.Tensor) -> torch.Tensor:\n+        \"\"\"Return ``weight`` oriented as [N, K] (out_features, in_features).\n+\n+        Quant methods leave the prepared parameter transposed to [K, N] and\n+        tag it with ``input_dim=0`` / ``output_dim=1``; prefer that contract\n+        over guessing from strides.\n+        \"\"\"\n+        if weight.dim() != 2:\n+            return weight\n+        input_dim = getattr(weight, \"input_dim\", None)\n+        if input_dim == 0:\n+            return weight.t()\n+        if input_dim == 1:\n+            return weight\n+        # No dim tags: fall back to the layout the compressed-tensors schemes\n+        # produce (transposed view => stride(0) == 1).\n+        if weight.stride(0) == 1 and weight.stride(1) != 1:\n+            return weight.t()\n+        return weight\n+\n+    def _dequant(\n+        self,\n+        weight: torch.Tensor,\n+        weight_scale: torch.Tensor | None,\n+    ) -> torch.Tensor:\n+        \"\"\"Dequantize an FP8 weight, returning a float32 [N, K] tensor.\"\"\"\n+        w_nk = self._as_nk(weight)\n+        if w_nk.stride(-1) != 1:\n+            w_nk = w_nk.contiguous()\n+        n, k = w_nk.shape\n+        w_f32 = w_nk.to(torch.float32)\n+\n+        if weight_scale is None:\n+            return w_f32\n+        if weight_scale.numel() == 1:\n+            return w_f32 * weight_scale.to(torch.float32).reshape(-1)[0]\n+\n+        scale = weight_scale.to(torch.float32).reshape(-1)\n+        if scale.numel() == n:\n+            return w_f32 * scale.unsqueeze(1)\n+        if scale.numel() == k:\n+            return w_f32 * scale.unsqueeze(0)\n+        raise ValueError(\n+            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n+            f\"matches neither N={n} nor K={k}.\"\n+        )\n+\n+    def input_quant_key(self):\n+        # The activation is never quantized here, so no manual-fusion partner\n+        # may hoist FP8 quantization upstream of this layer.\n+        return None\n+\n+    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n+        weight, weight_scale, _, _ = self._get_layer_params(layer)\n+        if weight is None or weight.dtype not in _FP8_DTYPES:\n+            # Already dequantized by an earlier pass, or never FP8 at all.\n+            return\n+\n+        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n+        w_dq = self._dequant(weight, weight_scale).to(out_dtype)\n+\n+        self.__class__._fp8_bytes += weight.numel() * weight.element_size()\n+        self.__class__._dq_bytes += w_dq.numel() * w_dq.element_size()\n+        logger.info_once(\n+            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"\n+            \"hardware FP8 and no torch._scaled_mm support): dequantizing \"\n+            \"weights at load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",\n+            str(out_dtype).replace(\"torch.\", \"\"),\n+            self.__class__._fp8_bytes / 2**30,\n+            self.__class__._dq_bytes / 2**30,\n+            scope=\"global\",\n+        )\n+\n+        # Store as a [N, K] parameter so apply_weights can call F.linear\n+        # directly; the weight loader has already run.\n+        replace_parameter(\n+            layer, \"weight\", Parameter(w_dq, requires_grad=False)\n+        )\n+        layer.weight.input_dim = 1\n+        layer.weight.output_dim = 0\n+        # The scale has been folded into the weight: drop the reference so the\n+        # FP8-side bookkeeping cannot be mistaken for a live quantized tensor.\n+        if weight_scale is not None:\n+            replace_parameter(\n+                layer,\n+                \"weight_scale\",\n+                Parameter(torch.ones((), dtype=out_dtype), requires_grad=False),\n+            )\n+\n+    def apply_weights(\n+        self,\n+        layer: torch.nn.Module,\n+        x: torch.Tensor | QuantizedActivation,\n+        bias: torch.Tensor | None = None,\n+    ) -> torch.Tensor:\n+        if isinstance(x, QuantizedActivation):\n+            # Defensive only: this kernel does not advertise input_quant_key(),\n+            # so manual fusion never hands us a pre-quantized activation.\n+            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(\n+                *x.orig_shape\n+            )\n+\n+        weight = layer.weight\n+        if weight.dtype in _FP8_DTYPES:\n+            # Not pre-dequantized (process_weights_after_loading was skipped):\n+            # dequantize on the fly so we never reach torch._scaled_mm.\n+            _, weight_scale, _, _ = self._get_layer_params(layer)\n+            weight = self._dequant(weight, weight_scale)\n+\n+        # F.linear needs matching dtypes; .to() is a no-op when they already do.\n+        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)\n+\n+    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n+        # This kernel overrides apply_weights and must never call\n+        # torch._scaled_mm, which does not exist on pre-MI300 ROCm.\n+        raise NotImplementedError(\n+            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n+            \"apply_scaled_mm is intentionally not implemented.\"\n+        )","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
