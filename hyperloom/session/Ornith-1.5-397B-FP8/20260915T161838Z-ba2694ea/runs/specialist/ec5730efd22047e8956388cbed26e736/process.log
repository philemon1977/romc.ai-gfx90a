{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9746ed67f4118426","type":"tool_result","content":"1\t# SPDX-License-Identifier: Apache-2.0\n2\t# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3\t\n4\t\n5\timport torch\n6\tfrom compressed_tensors.quantization import (\n7\t    QuantizationArgs,\n8\t    QuantizationStrategy,\n9\t)\n10\t\n11\tfrom vllm.distributed import get_tensor_model_parallel_world_size\n12\tfrom vllm.logger import init_logger\n13\tfrom vllm.model_executor.layers.fused_moe import (\n14\t    FusedMoeWeightScaleSupported,\n15\t    RoutedExperts,\n16\t    SharedExperts,\n17\t)\n18\tfrom vllm.model_executor.layers.fused_moe.config import (\n19\t    FusedMoEConfig,\n20\t    FusedMoEQuantConfig,\n21\t)\n22\tfrom vllm.model_executor.layers.fused_moe.oracle.fp8 import (\n23\t    convert_to_fp8_moe_kernel_format,\n24\t    make_fp8_moe_kernel,\n25\t    make_fp8_moe_quant_config,\n26\t    select_fp8_moe_backend,\n27\t)\n28\tfrom vllm.model_executor.layers.quantization.compressed_tensors.compressed_tensors_moe import (  # noqa E501\n29\t    CompressedTensorsMoEMethod,\n30\t)\n31\tfrom vllm.model_executor.layers.quantization.utils.fp8_utils import (\n32\t    process_fp8_input_tensor_strategy_moe,\n33\t    process_fp8_weight_tensor_strategy_moe,\n34\t)\n35\tfrom vllm.model_executor.layers.quantization.utils.quant_utils import (\n36\t    kFp8Dynamic128Sym,\n37\t    kFp8DynamicTokenSym,\n38\t    kFp8Static128BlockSym,\n39\t    kFp8StaticChannelSym,\n40\t    kFp8StaticTensorSym,\n41\t)\n42\tfrom vllm.model_executor.layers.quantization.utils.w8a8_utils import (\n43\t    normalize_e4m3fn_to_e4m3fnuz,\n44\t)\n45\tfrom vllm.model_executor.utils import replace_parameter, set_weight_attrs\n46\tfrom vllm.platforms import current_platform\n47\t\n48\tlogger = init_logger(__name__)\n49\t\n50\t\n51\tclass CompressedTensorsW8A8Fp8MoEMethod(CompressedTensorsMoEMethod):\n52\t    \"\"\"W8A8 FP8 MoE quantization using compressed tensors.\"\"\"\n53\t\n54\t    def __init__(\n55\t        self,\n56\t        weight_quant: QuantizationArgs,\n57\t        input_quant: QuantizationArgs,\n58\t        moe: FusedMoEConfig,\n59\t        layer_name: str | None = None,\n60\t    ):\n61\t        super().__init__(moe)\n62\t        self.weight_quant = weight_quant\n63\t        self.input_quant = input_quant\n64\t\n65\t        per_tensor = (\n66\t            self.weight_quant.strategy == QuantizationStrategy.TENSOR\n67\t            and self.input_quant.strategy == QuantizationStrategy.TENSOR\n68\t        )\n69\t        per_channel = (\n70\t            self.weight_quant.strategy == QuantizationStrategy.CHANNEL\n71\t            and self.input_quant.strategy == QuantizationStrategy.TOKEN\n72\t        )\n73\t        if not (per_tensor or per_channel):\n74\t            assert self.weight_quant.strategy == QuantizationStrategy.BLOCK\n75\t            self.weight_block_size = self.weight_quant.block_structure\n76\t            assert self.weight_quant.dynamic is not None\n77\t        else:\n78\t            self.weight_block_size = None\n79\t        self.block_quant = self.weight_block_size is not None\n80\t\n81\t        self.static_input_scales = not self.input_quant.dynamic\n82\t        if self.static_input_scales and per_channel:\n83\t            raise ValueError(\n84\t                \"For FP8 Fused MoE layer, we require either per tensor or \"\n85\t                \"channelwise, dynamic per token quantization.\"\n86\t            )\n87\t\n88\t        ct2vllm_weight = {\n89\t            QuantizationStrategy.CHANNEL: kFp8StaticChannelSym,\n90\t            QuantizationStrategy.TENSOR: kFp8StaticTensorSym,\n91\t            QuantizationStrategy.BLOCK: kFp8Static128BlockSym,\n92\t        }\n93\t        ct2vllm_act = {\n94\t            QuantizationStrategy.TOKEN: kFp8DynamicTokenSym,\n95\t            QuantizationStrategy.TENSOR: (\n96\t                kFp8StaticTensorSym if self.static_input_scales else kFp8Dynamic128Sym\n97\t            ),\n98\t        }\n99\t        weight_key = ct2vllm_weight[self.weight_quant.strategy]\n100\t        if weight_key == kFp8Static128BlockSym:\n101\t            activation_key = kFp8Dynamic128Sym\n102\t        else:\n103\t            activation_key = ct2vllm_act[self.input_quant.strategy]\n104\t\n105\t        # Select Fp8 MoE backend\n106\t        self.fp8_backend, self.experts_cls = select_fp8_moe_backend(\n107\t            config=self.moe,\n108\t            weight_key=weight_key,\n109\t            activation_key=activation_key,\n110\t            allow_vllm_cutlass=True,\n111\t        )\n112\t\n113\t    def create_weights(\n114\t        self,\n115\t        layer: torch.nn.Module,\n116\t        num_experts: int,\n117\t        hidden_size: int,\n118\t        intermediate_size_per_partition: int,\n119\t        params_dtype: torch.dtype,\n120\t        **extra_weight_attrs,\n121\t    ):\n122\t        layer.num_experts = num_experts\n123\t        layer.orig_dtype = params_dtype\n124\t        layer.weight_block_size = None\n125\t\n126\t        params_dtype = torch.float8_e4m3fn\n127\t        w13_num_shards = 2 if self.moe.is_act_and_mul else 1\n128\t\n129\t        if self.block_quant:\n130\t            assert self.weight_block_size is not None\n131\t            layer.weight_block_size = self.weight_block_size\n132\t            tp_size = get_tensor_model_parallel_world_size()\n133\t            block_n, block_k = (\n134\t                self.weight_block_size[0],\n135\t                self.weight_block_size[1],\n136\t            )\n137\t            # NOTE: To ensure proper alignment of the block-wise quantization\n138\t            # scales, the output_size of the weights for both the gate and up\n139\t            # layers must be divisible by block_n.\n140\t            # Required by column parallel or enabling merged weights\n141\t            if intermediate_size_per_partition % block_n != 0:\n142\t                raise ValueError(\n143\t                    f\"The output_size of gate's and up's weight = \"\n144\t                    f\"{intermediate_size_per_partition} is not divisible by \"\n145\t                    f\"weight quantization block_n = {block_n}.\"\n146\t                )\n147\t            if tp_size > 1 and intermediate_size_per_partition % block_k != 0:\n148\t                # Required by row parallel\n149\t                raise ValueError(\n150\t                    f\"The input_size of down's weight = \"\n151\t                    f\"{intermediate_size_per_partition} is not divisible by \"\n152\t                    f\"weight quantization block_k = {block_k}.\"\n153\t                )\n154\t\n155\t        # WEIGHTS\n156\t        w13_weight = torch.nn.Parameter(\n157\t            torch.empty(\n158\t                num_experts,\n159\t                w13_num_shards * intermediate_size_per_partition,\n160\t                hidden_size,\n161\t                dtype=params_dtype,\n162\t            ),\n163\t            requires_grad=False,\n164\t        )\n165\t        layer.register_parameter(\"w13_weight\", w13_weight)\n166\t        set_weight_attrs(w13_weight, extra_weight_attrs)\n167\t\n168\t        w2_weight = torch.nn.Parameter(\n169\t            torch.empty(\n170\t                num_experts,\n171\t                hidden_size,\n172\t                intermediate_size_per_partition,\n173\t                dtype=params_dtype,\n174\t            ),\n175\t            requires_grad=False,\n176\t        )\n177\t        layer.register_parameter(\"w2_weight\", w2_weight)\n178\t        set_weight_attrs(w2_weight, extra_weight_attrs)\n179\t\n180\t        # WEIGHT_SCALES\n181\t        if self.weight_quant.strategy == QuantizationStrategy.TENSOR:\n182\t            # For gated MoE, allocate 2 scales for w1 and w3 respectively.\n183\t            # They will be combined to a single scale after weight loading.\n184\t            # For non-gated MoE, allocate 1 scale for w13.\n185\t            w13_weight_scale = torch.nn.Parameter(\n186\t                torch.ones(num_experts, w13_num_shards, dtype=torch.float32),\n187\t                requires_grad=False,\n188\t            )\n189\t            layer.register_parameter(\"w13_weight_scale\", w13_weight_scale)\n190\t            w2_weight_scale = torch.nn.Parameter(\n191\t                torch.ones(num_experts, dtype=torch.float32), requires_grad=False\n192\t            )\n193\t            layer.register_parameter(\"w2_weight_scale\", w2_weight_scale)\n194\t            # Add PER-TENSOR quantization for RoutedExperts.weight_loader.\n195\t            extra_weight_attrs.update(\n196\t                {\"quant_method\": FusedMoeWeightScaleSupported.TENSOR.value}\n197\t            )\n198\t            set_weight_attrs(w13_weight_scale, extra_weight_attrs)\n199\t            set_weight_attrs(w2_weight_scale, extra_weight_attrs)\n200\t\n201\t        elif self.weight_quant.strategy == QuantizationStrategy.CHANNEL:\n202\t            w13_weight_scale = torch.nn.Parameter(\n203\t                torch.ones(\n204\t                    num_experts,\n205\t                    w13_num_shards * intermediate_size_per_partition,\n206\t                    1,\n207\t                    dtype=torch.float32,\n208\t                ),\n209\t                requires_grad=False,\n210\t            )\n211\t            layer.register_parameter(\"w13_weight_scale\", w13_weight_scale)\n212\t            w2_weight_scale = torch.nn.Parameter(\n213\t                torch.ones(num_experts, hidden_size, 1, dtype=torch.float32),\n214\t                requires_grad=False,\n215\t            )\n216\t            layer.register_parameter(\"w2_weight_scale\", w2_weight_scale)\n217\t            # Add PER-CHANNEL quantization for RoutedExperts.weight_loader.\n218\t            extra_weight_attrs.update(\n219\t                {\"quant_method\": FusedMoeWeightScaleSupported.CHANNEL.value}\n220\t            )\n221\t            set_weight_attrs(w13_weight_scale, extra_weight_attrs)\n222\t            set_weight_attrs(w2_weight_scale, extra_weight_attrs)\n223\t\n224\t        elif self.weight_quant.strategy == QuantizationStrategy.BLOCK:\n225\t            w13_weight_scale = torch.nn.Parameter(\n226\t                torch.ones(\n227\t                    num_experts,\n228\t                    w13_num_shards\n229\t                    * ((intermediate_size_per_partition + block_n - 1) // block_n),\n230\t                    (hidden_size + block_k - 1) // block_k,\n231\t                    dtype=torch.float32,\n232\t                ),\n233\t                requires_grad=False,\n234\t            )\n235\t            layer.register_parameter(\"w13_weight_scale\", w13_weight_scale)\n236\t            w2_weight_scale = torch.nn.Parameter(\n237\t                torch.ones(\n238\t                    num_experts,\n239\t                    (hidden_size + block_n - 1) // block_n,\n240\t                    (intermediate_size_per_partition + block_k - 1) // block_k,\n241\t                    dtype=torch.float32,\n242\t                ),\n243\t                requires_grad=False,\n244\t            )\n245\t            layer.register_parameter(\"w2_weight_scale\", w2_weight_scale)\n246\t            # Add PER-CHANNEL quantization for RoutedExperts.weight_loader.\n247\t            extra_weight_attrs.update(\n248\t                {\"quant_method\": FusedMoeWeightScaleSupported.BLOCK.value}\n249\t            )\n250\t            set_weight_attrs(w13_weight_scale, extra_weight_attrs)\n251\t            set_weight_attrs(w2_weight_scale, extra_weight_attrs)\n252\t\n253\t        # INPUT_SCALES\n254\t        if self.static_input_scales:\n255\t            w13_input_scale = torch.nn.Parameter(\n256\t                torch.ones(num_experts, dtype=torch.float32), requires_grad=False\n257\t            )\n258\t            layer.register_parameter(\"w13_input_scale\", w13_input_scale)\n259\t            set_weight_attrs(w13_input_scale, extra_weight_attrs)\n260\t\n261\t            w2_input_scale = torch.nn.Parameter(\n262\t                torch.ones(num_experts, dtype=torch.float32), requires_grad=False\n263\t            )\n264\t            layer.register_parameter(\"w2_input_scale\", w2_input_scale)\n265\t            set_weight_attrs(w2_input_scale, extra_weight_attrs)\n266\t        else:\n267\t            layer.w13_input_scale = None\n268\t            layer.w2_input_scale = None\n269\t\n270\t    def process_weights_after_loading(self, layer: RoutedExperts) -> None:\n271\t        # Allow for accessing weights and scales in standard way.\n272\t        w13 = layer.w13_weight\n273\t        w2 = layer.w2_weight\n274\t        w13_scale = layer.w13_weight_scale\n275\t        w2_scale = layer.w2_weight_scale\n276\t        w13_input_scale = layer.w13_input_scale\n277\t        w2_input_scale = layer.w2_input_scale\n278\t\n279\t        # MI300x and MI325x use FNUZ format for FP8. Convert if needed.\n280\t        if current_platform.is_fp8_fnuz():\n281\t            w13, w13_scale, w13_input_scale = normalize_e4m3fn_to_e4m3fnuz(\n282\t                w13, w13_scale, w13_input_scale\n283\t            )\n284\t            w2, w2_scale, w2_input_scale = normalize_e4m3fn_to_e4m3fnuz(\n285\t                w2, w2_scale, w2_input_scale\n286\t            )\n287\t\n288\t        # Per tensor kernels require single activation scale. Use the max.\n289\t        if self.static_input_scales:\n290\t            assert self.input_quant.strategy == QuantizationStrategy.TENSOR\n291\t            assert w13_input_scale is not None and w2_input_scale is not None\n292\t            w13_input_scale, w2_input_scale = process_fp8_input_tensor_strategy_moe(\n293\t                w13_input_scale,\n294\t                w2_input_scale,\n295\t                layer.moe_config.moe_parallel_config.enable_eplb,\n296\t            )\n297\t            replace_parameter(layer, \"w13_input_scale\", w13_input_scale)\n298\t            replace_parameter(layer, \"w2_input_scale\", w2_input_scale)\n299\t\n300\t        # Per-tensor kernels use a single scale, for W13, but on disk there\n301\t        # is a separate scale for W1 and W3. Requantize with the max scale.\n302\t        if self.weight_quant.strategy == QuantizationStrategy.TENSOR:\n303\t            w13, w13_scale = process_fp8_weight_tensor_strategy_moe(\n304\t                w13,\n305\t                w13_scale,\n306\t                shard_size=layer.intermediate_size_per_partition,\n307\t                num_experts=layer.local_num_experts,\n308\t                is_act_and_mul=self.moe.is_act_and_mul,\n309\t            )\n310\t\n311\t        w13, w2, w13_scale, w2_scale = convert_to_fp8_moe_kernel_format(\n312\t            fp8_backend=self.fp8_backend,\n313\t            layer=layer,\n314\t            w13=w13,\n315\t            w2=w2,\n316\t            w13_scale=w13_scale,\n317\t            w2_scale=w2_scale,\n318\t            w13_input_scale=w13_input_scale,\n319\t            w2_input_scale=w2_input_scale,\n320\t        )\n321\t\n322\t        # Replace parameters with updated versions. Note that this helper\n323\t        # function ensures the replacement is compatible with RL weight reloads.\n324\t        replace_parameter(layer, \"w13_weight\", w13)\n325\t        replace_parameter(layer, \"w2_weight\", w2)\n326\t        replace_parameter(layer, \"w13_weight_scale\", w13_scale)\n327\t        replace_parameter(layer, \"w2_weight_scale\", w2_scale)\n328\t\n329\t        # Setup modular kernel for TP case and naive DP/EP case.\n330\t        # In non-naive DP/EP case, we will create a ModularKernelMethod.\n331\t        # TODO(rob): unify these so FP8MoEMethod owns the ModularKernel\n332\t        # in both cases.\n333\t        self.moe_quant_config = self.get_fused_moe_quant_config(layer)\n334\t        if self.moe_quant_config:\n335\t            assert self.experts_cls is not None\n336\t            self.moe_kernel = make_fp8_moe_kernel(\n337\t                moe_quant_config=self.moe_quant_config,\n338\t                moe_config=self.moe,\n339\t                fp8_backend=self.fp8_backend,\n340\t                experts_cls=self.experts_cls,\n341\t                routing_tables=layer._expert_routing_tables(),\n342\t            )\n343\t\n344\t    def get_fused_moe_quant_config(self, layer: torch.nn.Module) -> FusedMoEQuantConfig:\n345\t        is_per_token = [REDACTED] == QuantizationStrategy.TOKEN\n346\t        return make_fp8_moe_quant_config(\n347\t            fp8_backend=self.fp8_backend,\n348\t            w1_scale=layer.w13_weight_scale,\n349\t            w2_scale=layer.w2_weight_scale,\n350\t            a1_scale=getattr(layer, \"w13_input_scale\", None),\n351\t            a2_scale=getattr(layer, \"w2_input_scale\", None),\n352\t            per_act_token_quant=is_per_token,\n353\t            per_out_ch_quant=is_per_token,\n354\t            block_shape=self.weight_block_size,\n355\t            gemm1_alpha=getattr(layer, \"swiglu_alpha\", None),\n356\t            gemm1_beta=getattr(layer, \"swiglu_beta\", None),\n357\t            swiglu_limit=getattr(layer, \"swiglu_limit\", None),\n358\t            layer=layer,\n359\t        )\n360\t\n361\t    def apply_monolithic(\n362\t        self,\n363\t        layer: RoutedExperts,\n364\t        x: torch.Tensor,\n365\t        router_logits: torch.Tensor,\n366\t        input_ids: torch.Tensor | None = None,\n367\t    ) -> torch.Tensor:\n368\t        assert self.moe_kernel is not None\n369\t        return self.moe_kernel.apply_monolithic(\n370\t            x,\n371\t            layer.w13_weight,\n372\t            layer.w2_weight,\n373\t            router_logits,\n374\t            activation=layer.activation,\n375\t            global_num_experts=layer.global_num_experts,\n376\t            expert_map=layer.expert_map,\n377\t            apply_router_weight_on_input=layer.apply_router_weight_on_input,\n378\t            num_expert_group=layer.num_expert_group,\n379\t            topk_group=layer.topk_group,\n380\t            e_score_correction_bias=layer.e_score_correction_bias,\n381\t            routed_scaling_factor=layer.routed_scaling_factor,\n382\t        )\n383\t\n384\t    def apply(\n385\t        self,\n386\t        layer: RoutedExperts,\n387\t        x: torch.Tensor,\n388\t        topk_weights: torch.Tensor,\n389\t        topk_ids: torch.Tensor,\n390\t        shared_experts: SharedExperts | None,\n391\t        shared_experts_input: torch.Tensor | None,\n392\t    ) -> torch.Tensor:\n393\t        assert not self.is_monolithic\n394\t        assert self.moe_kernel is not None\n395\t        return self.moe_kernel.apply(\n396\t            x,\n397\t            layer.w13_weight,\n398\t            layer.w2_weight,\n399\t            topk_weights,\n400\t            topk_ids,\n401\t            activation=layer.activation,\n402\t            global_num_experts=layer.global_num_experts,\n403\t            expert_map=layer.expert_map,\n404\t            apply_router_weight_on_input=layer.apply_router_weight_on_input,\n405\t            shared_experts=shared_experts,\n406\t            shared_experts_input=shared_experts_input,\n407\t        )\n408\t\n409\t    @property\n410\t    def supports_eplb(self) -> bool:\n411\t        return True\n412\t"}]},"parent_tool_use_id":"call_b26eb1c9c410c553","session_id":"0bdd9947-a518-4714-97ad-d090d3f8ef30","uuid":"ae7b9e5f-9182-489a-806d-8cf828f74776","timestamp":"2026-09-15T17:34:20.080Z","subagent_type":"hyperloom-leaf","task_description":"Diagnose MoE FP8 path on gfx90a"}
