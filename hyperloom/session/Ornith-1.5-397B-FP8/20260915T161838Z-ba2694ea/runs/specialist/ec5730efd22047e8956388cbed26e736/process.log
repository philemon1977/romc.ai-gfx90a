{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a313ce9135c74ad6","type":"tool_result","content":"1\t# SPDX-License-Identifier: Apache-2.0\n2\t# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3\tfrom enum import Enum\n4\tfrom typing import Any\n5\t\n6\timport torch\n7\t\n8\timport vllm.model_executor.layers.fused_moe.modular_kernel as mk\n9\tfrom vllm import envs\n10\tfrom vllm._aiter_ops import rocm_aiter_ops\n11\tfrom vllm.config.kernel import MoEBackend\n12\tfrom vllm.logger import init_logger\n13\tfrom vllm.model_executor.layers.fused_moe.all2all_utils import (\n14\t    maybe_make_prepare_finalize,\n15\t)\n16\tfrom vllm.model_executor.layers.fused_moe.config import (\n17\t    FusedMoEConfig,\n18\t    FusedMoEQuantConfig,\n19\t    fp8_w8a8_moe_quant_config,\n20\t    fp8_w8a16_moe_quant_config,\n21\t)\n22\tfrom vllm.model_executor.layers.fused_moe.routed_experts import RoutedExperts\n23\tfrom vllm.model_executor.layers.quantization.utils.flashinfer_utils import (\n24\t    prepare_fp8_moe_layer_for_fi,\n25\t)\n26\tfrom vllm.model_executor.layers.quantization.utils.fp8_utils import (\n27\t    prepare_fp8_moe_layer_for_deepgemm,\n28\t)\n29\tfrom vllm.model_executor.layers.quantization.utils.marlin_utils_fp8 import (\n30\t    prepare_fp8_moe_layer_for_marlin,\n31\t)\n32\tfrom vllm.model_executor.layers.quantization.utils.quant_utils import (\n33\t    QuantKey,\n34\t    kFp8Dynamic128Sym,\n35\t    kFp8Static128BlockSym,\n36\t)\n37\tfrom vllm.platforms import current_platform\n38\t\n39\tlogger = init_logger(__name__)\n40\t\n41\t\n42\tclass Fp8MoeBackend(Enum):\n43\t    NONE = \"NONE\"\n44\t    FLASHINFER_TRTLLM = \"FLASHINFER_TRTLLM\"\n45\t    FLASHINFER_CUTLASS = \"FLASHINFER_CUTLASS\"\n46\t    DEEPGEMM = \"DEEPGEMM\"\n47\t    BATCHED_DEEPGEMM = \"BATCHED_DEEPGEMM\"\n48\t    MARLIN = \"MARLIN\"\n49\t    HUMMING = \"HUMMING\"\n50\t    TRITON = \"TRITON\"\n51\t    BATCHED_TRITON = \"BATCHED_TRITON\"\n52\t    AITER = \"AITER\"\n53\t    VLLM_CUTLASS = \"VLLM_CUTLASS\"\n54\t    BATCHED_VLLM_CUTLASS = \"BATCHED_VLLM_CUTLASS\"\n55\t    XPU = \"XPU\"\n56\t    CPU = \"CPU\"\n57\t    HPC = \"HPC\"\n58\t    # Dequantize-to-BF16 emulation for MXFP8 on devices without a native\n59\t    # MXFP8 MoE kernel (e.g. ROCm). Weights pass through unchanged here.\n60\t    EMULATION = \"EMULATION\"\n61\t    # MXFP8 MoE via a Triton ``dot_scaled`` kernel that lowers to CDNA4\n62\t    # (gfx950) native MX matrix-core ops. Weights stay in MXFP8 (no load-time\n63\t    # format conversion); the FP8 values + E8M0 scales are consumed directly.\n64\t    TRITON_MXFP8 = \"TRITON_MXFP8\"\n65\t    # MXFP8 MoE via AITER (FlyDSL two-stage grouped GEMM) on gfx950.\n66\t    AITER_MXFP8 = \"AITER_MXFP8\"\n67\t\n68\t\n69\tdef _get_priority_backends(\n70\t    moe_config: FusedMoEConfig,\n71\t    weight_key: QuantKey | None,\n72\t    activation_key: QuantKey | None,\n73\t) -> list[Fp8MoeBackend]:\n74\t    \"\"\"\n75\t    Get available backends in priority order based on platform and config.\n76\t\n77\t    This function can be extended to become more complex as needed.\n78\t    \"\"\"\n79\t\n80\t    _AVAILABLE_BACKENDS = [\n81\t        Fp8MoeBackend.AITER,\n82\t        Fp8MoeBackend.FLASHINFER_TRTLLM,\n83\t        Fp8MoeBackend.FLASHINFER_CUTLASS,\n84\t        Fp8MoeBackend.DEEPGEMM,\n85\t        Fp8MoeBackend.VLLM_CUTLASS,\n86\t        Fp8MoeBackend.TRITON,\n87\t        Fp8MoeBackend.MARLIN,\n88\t        Fp8MoeBackend.HUMMING,\n89\t        Fp8MoeBackend.BATCHED_DEEPGEMM,\n90\t        Fp8MoeBackend.BATCHED_VLLM_CUTLASS,\n91\t        Fp8MoeBackend.BATCHED_TRITON,\n92\t        Fp8MoeBackend.XPU,\n93\t        Fp8MoeBackend.CPU,\n94\t        Fp8MoeBackend.HPC,\n95\t    ]\n96\t\n97\t    def _move_to_front(backends: list[Fp8MoeBackend], backend: Fp8MoeBackend) -> None:\n98\t        backends.insert(0, backends.pop(backends.index(backend)))\n99\t\n100\t    # With DeepEP v2 contiguous layout (do_expand=False), tensors are\n101\t    # worst-case allocated with padding. TrtLLM's tile-level skipping\n102\t    # avoids wasted compute on padding rows; other backends process all rows.\n103\t    if (\n104\t        current_platform.is_cuda()\n105\t        and current_platform.is_device_capability_family(100)\n106\t        and moe_config.moe_parallel_config.use_deepep_v2_kernels\n107\t        and activation_key == kFp8Dynamic128Sym\n108\t        and weight_key == kFp8Static128BlockSym\n109\t    ):\n110\t        _move_to_front(_AVAILABLE_BACKENDS, Fp8MoeBackend.FLASHINFER_TRTLLM)\n111\t\n112\t    # On Hopper for Block Fp8, prefer Triton for TP and FI CUTLASS for EP.\n113\t    if (\n114\t        current_platform.is_cuda()\n115\t        and current_platform.is_device_capability(90)\n116\t        and activation_key == kFp8Dynamic128Sym\n117\t        and weight_key == kFp8Static128BlockSym\n118\t    ):\n119\t        if moe_config.moe_parallel_config.ep_size > 1:\n120\t            _move_to_front(_AVAILABLE_BACKENDS, Fp8MoeBackend.FLASHINFER_CUTLASS)\n121\t        else:\n122\t            _move_to_front(_AVAILABLE_BACKENDS, Fp8MoeBackend.TRITON)\n123\t\n124\t    if current_platform.is_xpu():\n125\t        # XPU platform supports TritonExperts and XPUExpertsFp8,\n126\t        # move XPU backend to the front.\n127\t        _move_to_front(_AVAILABLE_BACKENDS, Fp8MoeBackend.XPU)\n128\t\n129\t    if current_platform.is_cpu():\n130\t        # CPU platform uses FP8 W8A16 fused MoE kernel.\n131\t        _move_to_front(_AVAILABLE_BACKENDS, Fp8MoeBackend.CPU)\n132\t\n133\t    return _AVAILABLE_BACKENDS\n134\t\n135\t\n136\tdef backend_to_kernel_cls(\n137\t    backend: Fp8MoeBackend,\n138\t) -> list[type[mk.FusedMoEExperts]]:\n139\t    if backend == Fp8MoeBackend.FLASHINFER_TRTLLM:\n140\t        from vllm.model_executor.layers.fused_moe.experts.trtllm_fp8_moe import (  # noqa: E501\n141\t            TrtLlmFp8ExpertsModular,\n142\t            TrtLlmFp8ExpertsMonolithic,\n143\t        )\n144\t\n145\t        return [TrtLlmFp8ExpertsMonolithic, TrtLlmFp8ExpertsModular]\n146\t\n147\t    elif backend == Fp8MoeBackend.FLASHINFER_CUTLASS:\n148\t        from vllm.model_executor.layers.fused_moe.experts.flashinfer_cutlass_moe import (  # noqa: E501\n149\t            FlashInferExperts,\n150\t        )\n151\t\n152\t        return [FlashInferExperts]\n153\t\n154\t    elif backend == Fp8MoeBackend.DEEPGEMM:\n155\t        from vllm.model_executor.layers.fused_moe.experts.triton_deep_gemm_moe import (\n156\t            TritonOrDeepGemmExperts,\n157\t        )\n158\t\n159\t        return [TritonOrDeepGemmExperts]\n160\t\n161\t    elif backend == Fp8MoeBackend.BATCHED_DEEPGEMM:\n162\t        from vllm.model_executor.layers.fused_moe.experts.batched_deep_gemm_moe import (\n163\t            BatchedDeepGemmExperts,\n164\t        )\n165\t\n166\t        return [BatchedDeepGemmExperts]\n167\t\n168\t    elif backend == Fp8MoeBackend.HUMMING:\n169\t        from vllm.model_executor.layers.fused_moe.experts.fused_humming_moe import (\n170\t            BatchedHummingGroupedExperts,\n171\t            HummingGroupedExperts,\n172\t            HummingIndexedExperts,\n173\t        )\n174\t\n175\t        return [\n176\t            BatchedHummingGroupedExperts,\n177\t            HummingGroupedExperts,\n178\t            HummingIndexedExperts,\n179\t        ]\n180\t\n181\t    elif backend == Fp8MoeBackend.MARLIN:\n182\t        from vllm.model_executor.layers.fused_moe.experts.marlin_moe import (\n183\t            MarlinExperts,\n184\t        )\n185\t\n186\t        return [MarlinExperts]\n187\t\n188\t    elif backend == Fp8MoeBackend.TRITON:\n189\t        from vllm.model_executor.layers.fused_moe.experts.triton_moe import (\n190\t            TritonExperts,\n191\t        )\n192\t\n193\t        return [TritonExperts]\n194\t\n195\t    elif backend == Fp8MoeBackend.BATCHED_TRITON:\n196\t        from vllm.model_executor.layers.fused_moe.experts.fused_batched_moe import (\n197\t            BatchedTritonExperts,\n198\t        )\n199\t\n200\t        return [BatchedTritonExperts]\n201\t\n202\t    elif backend == Fp8MoeBackend.AITER:\n203\t        from vllm.model_executor.layers.fused_moe.experts.rocm_aiter_moe import (\n204\t            AiterExperts,\n205\t        )\n206\t\n207\t        return [AiterExperts]\n208\t\n209\t    elif backend == Fp8MoeBackend.VLLM_CUTLASS:\n210\t        from vllm.model_executor.layers.fused_moe.experts.triton_cutlass_moe import (\n211\t            TritonOrCutlassExperts,\n212\t        )\n213\t\n214\t        return [TritonOrCutlassExperts]\n215\t\n216\t    elif backend == Fp8MoeBackend.BATCHED_VLLM_CUTLASS:\n217\t        from vllm.model_executor.layers.fused_moe.experts.cutlass_moe import (\n218\t            CutlassBatchedExpertsFp8,\n219\t        )\n220\t\n221\t        return [CutlassBatchedExpertsFp8]\n222\t\n223\t    elif backend == Fp8MoeBackend.XPU:\n224\t        from vllm.model_executor.layers.fused_moe.experts.xpu_moe import (\n225\t            XPUExpertsBlockFp8,\n226\t            XPUExpertsFp8,\n227\t            XPUExpertsMxFp8,\n228\t        )\n229\t\n230\t        return [XPUExpertsFp8, XPUExpertsMxFp8, XPUExpertsBlockFp8]\n231\t\n232\t    elif backend == Fp8MoeBackend.CPU:\n233\t        from vllm.model_executor.layers.fused_moe.experts.cpu_moe import (\n234\t            CPUExpertsFp8,\n235\t        )\n236\t\n237\t        return [CPUExpertsFp8]\n238\t\n239\t    elif backend == Fp8MoeBackend.HPC:\n240\t        from vllm.model_executor.layers.fused_moe.hpc_moe import (\n241\t            HPCExperts,\n242\t        )\n243\t\n244\t        return [HPCExperts]\n245\t\n246\t    else:\n247\t        raise ValueError(f\"Unknown FP8 MoE backend: {backend.value}\")\n248\t\n249\t\n250\tdef map_fp8_backend(runner_backend: MoEBackend) -> Fp8MoeBackend:\n251\t    \"\"\"Map user's MoEBackend to Fp8MoeBackend.\"\"\"\n252\t    mapping = {\n253\t        \"triton\": Fp8MoeBackend.TRITON,\n254\t        \"deep_gemm\": Fp8MoeBackend.DEEPGEMM,\n255\t        \"cutlass\": Fp8MoeBackend.VLLM_CUTLASS,\n256\t        \"flashinfer_trtllm\": Fp8MoeBackend.FLASHINFER_TRTLLM,\n257\t        \"flashinfer_cutlass\": Fp8MoeBackend.FLASHINFER_CUTLASS,\n258\t        \"marlin\": Fp8MoeBackend.MARLIN,\n259\t        \"humming\": Fp8MoeBackend.HUMMING,\n260\t        \"aiter\": Fp8MoeBackend.AITER,\n261\t        \"hpc\": Fp8MoeBackend.HPC,\n262\t    }\n263\t    if backend := mapping.get(runner_backend):\n264\t        return backend\n265\t    raise ValueError(\n266\t        f\"moe_backend='{runner_backend}' is not supported for FP8 MoE. \"\n267\t        f\"Expected one of {list(mapping.keys())}.\"\n268\t    )\n269\t\n270\t\n271\tdef select_fp8_moe_backend(\n272\t    config: FusedMoEConfig,\n273\t    weight_key: QuantKey | None,\n274\t    activation_key: QuantKey | None,\n275\t    allow_vllm_cutlass: bool = False,\n276\t) -> tuple[Fp8MoeBackend, type[mk.FusedMoEExperts] | None]:\n277\t    \"\"\"\n278\t    Select the primary FP8 MoE backend\n279\t    Note: Shape-specific fallbacks may still occur at runtime.\n280\t    \"\"\"\n281\t\n282\t    # NOTE: the kernels are selected in the following order.\n283\t    AVAILABLE_BACKENDS = _get_priority_backends(config, weight_key, activation_key)\n284\t\n285\t    # NOTE(rob): We need to peak into the P/F selection to determine\n286\t    # if we are using the batched or standard expert format, which\n287\t    # if not ideal. Once we unify TP + DP/EP, we can select P/F first.\n288\t    activation_format = (\n289\t        mk.FusedMoEActivationFormat.BatchedExperts\n290\t        if config.moe_parallel_config.use_batched_activation_format\n291\t        else mk.FusedMoEActivationFormat.Standard\n292\t    )\n293\t\n294\t    def _make_log_backend(backend: Fp8MoeBackend):\n295\t        available_backend_strs = [b.value for b in AVAILABLE_BACKENDS]\n296\t        return (\n297\t            f\"Using {backend.value} Fp8 MoE backend out \"\n298\t            f\"of potential backends: {available_backend_strs}.\"\n299\t        )\n300\t\n301\t    def _make_log_unsupported(backend: Fp8MoeBackend, reason: str | None) -> str:\n302\t        if reason:\n303\t            return (\n304\t                f\"FP8 MoE backend {backend.value} does not support the \"\n305\t                f\"deployment configuration since {reason}.\"\n306\t            )\n307\t        else:\n308\t            return (\n309\t                f\"FP8 MoE backend '{backend.value}' does not support the \"\n310\t                \"deployment configuration.\"\n311\t            )\n312\t\n313\t    def _return_or_raise(\n314\t        backend: Fp8MoeBackend,\n315\t        config: FusedMoEConfig,\n316\t        weight_key: QuantKey | None,\n317\t        activation_key: QuantKey | None,\n318\t        activation_format: mk.FusedMoEActivationFormat,\n319\t    ) -> tuple[Fp8MoeBackend, type[mk.FusedMoEExperts]]:\n320\t        for k_cls in backend_to_kernel_cls(backend):\n321\t            supported, reason = k_cls.is_supported_config(\n322\t                k_cls, config, weight_key, activation_key, activation_format\n323\t            )\n324\t            if supported:\n325\t                logger.info_once(_make_log_backend(backend))\n326\t                return backend, k_cls\n327\t        raise ValueError(_make_log_unsupported(backend, reason))\n328\t\n329\t    # Handle explicit moe_backend from user.\n330\t    runner_backend = config.moe_backend\n331\t    if runner_backend != \"auto\":\n332\t        requested_backend = map_fp8_backend(runner_backend)\n333\t        # For batched activation format, use batched variants if available.\n334\t        if activation_format == mk.FusedMoEActivationFormat.BatchedExperts:\n335\t            if requested_backend == Fp8MoeBackend.DEEPGEMM:\n336\t                requested_backend = Fp8MoeBackend.BATCHED_DEEPGEMM\n337\t            elif requested_backend == Fp8MoeBackend.TRITON:\n338\t                requested_backend = Fp8MoeBackend.BATCHED_TRITON\n339\t            elif requested_backend == Fp8MoeBackend.VLLM_CUTLASS:\n340\t                requested_backend = Fp8MoeBackend.BATCHED_VLLM_CUTLASS\n341\t\n342\t        if (\n343\t            requested_backend\n344\t            in [\n345\t                Fp8MoeBackend.VLLM_CUTLASS,\n346\t                Fp8MoeBackend.BATCHED_VLLM_CUTLASS,\n347\t            ]\n348\t            and not allow_vllm_cutlass\n349\t        ):\n350\t            raise ValueError(\n351\t                \"vLLM CUTLASS FP8 MoE backend is disabled for this configuration.\"\n352\t            )\n353\t\n354\t        return _return_or_raise(\n355\t            requested_backend, config, weight_key, activation_key, activation_format\n356\t        )\n357\t\n358\t    # Handle explicit DeepGEMM FP8 configuration.\n359\t    if envs.is_set(\"VLLM_USE_DEEP_GEMM\") or envs.is_set(\"VLLM_MOE_USE_DEEP_GEMM\"):\n360\t        if not envs.VLLM_USE_DEEP_GEMM or not envs.VLLM_MOE_USE_DEEP_GEMM:\n361\t            AVAILABLE_BACKENDS.remove(Fp8MoeBackend.DEEPGEMM)\n362\t            AVAILABLE_BACKENDS.remove(Fp8MoeBackend.BATCHED_DEEPGEMM)\n363\t        else:\n364\t            backend = (\n365\t                Fp8MoeBackend.DEEPGEMM\n366\t                if activation_format == mk.FusedMoEActivationFormat.Standard\n367\t                else Fp8MoeBackend.BATCHED_DEEPGEMM\n368\t            )\n369\t            return _return_or_raise(\n370\t                backend, config, weight_key, activation_key, activation_format\n371\t            )\n372\t\n373\t    # Handle explicit MARLIN FP8 configuration.\n374\t    if envs.VLLM_TEST_FORCE_FP8_MARLIN:\n375\t        backend = Fp8MoeBackend.MARLIN\n376\t        return _return_or_raise(\n377\t            backend, config, weight_key, activation_key, activation_format\n378\t        )\n379\t\n380\t    # Handle explicit AITER FP8 configuration.\n381\t    if envs.is_set(\"VLLM_ROCM_USE_AITER\") or envs.is_set(\"VLLM_ROCM_USE_AITER_MOE\"):\n382\t        skip_aiter_moe = (\n383\t            not envs.VLLM_ROCM_USE_AITER\n384\t            or not envs.VLLM_ROCM_USE_AITER_MOE\n385\t            or rocm_aiter_ops.is_rdna_aiter_enabled()\n386\t        )\n387\t        if skip_aiter_moe:\n388\t            if Fp8MoeBackend.AITER in AVAILABLE_BACKENDS:\n389\t                AVAILABLE_BACKENDS.remove(Fp8MoeBackend.AITER)\n390\t        else:\n391\t            backend = Fp8MoeBackend.AITER\n392\t            return _return_or_raise(\n393\t                backend, config, weight_key, activation_key, activation_format\n394\t            )\n395\t\n396\t    if not allow_vllm_cutlass:\n397\t        AVAILABLE_BACKENDS.remove(Fp8MoeBackend.VLLM_CUTLASS)\n398\t        AVAILABLE_BACKENDS.remove(Fp8MoeBackend.BATCHED_VLLM_CUTLASS)\n399\t\n400\t    # Select kernels in order of backend.\n401\t    for backend in AVAILABLE_BACKENDS:\n402\t        for k_cls in backend_to_kernel_cls(backend):\n403\t            supported, reason = k_cls.is_supported_config(\n404\t                k_cls,\n405\t                config,\n406\t                weight_key,\n407\t                activation_key,\n408\t                activation_format,\n409\t            )\n410\t            if supported:\n411\t                logger.info_once(_make_log_backend(backend))\n412\t                return backend, k_cls\n413\t            else:\n414\t                logger.debug_once(_make_log_unsupported(backend, reason))\n415\t\n416\t    # TODO(rob): per discussion with TPU team, we need a way to register\n417\t    # MoE backends by OOT plugins, rather than having an explicit list\n418\t    # of AVAILABLE_BACKENDS. Enabling returning `Fp8MoeBackend.NONE` is\n419\t    # a temporary measure until these register APIs are complete.\n420\t    if current_platform.is_cuda() or current_platform.is_rocm():\n421\t        raise NotImplementedError(\n422\t            \"No FP8 MoE backend supports the deployment configuration.\"\n423\t        )\n424\t\n425\t    return Fp8MoeBackend.NONE, None\n426\t\n427\t\n428\tdef _humming_fp8_weight_schema(\n429\t    layer: RoutedExperts, weight: torch.Tensor, weight_scale: torch.Tensor\n430\t) -> dict[str, Any]:\n431\t    \"\"\"Build the humming weight schema from the canonical on-device fp8/mxfp8\n432\t    tensors (scale dtype/shape, block size), not the producing quant method.\"\"\"\n433\t    # mxfp8: e8m0 group-32 scales (stored as uint8 bytes or e8m0). humming has\n434\t    # no compressed-tensors mxfp8 loader; its modelopt schema fits both sources.\n435\t    if weight_scale.dtype in (torch.uint8, torch.float8_e8m0fnu):\n436\t        return {\"quant_method\": \"modelopt\", \"quant_algo\": \"mxfp8\"}\n437\t\n438\t    if hasattr(layer, \"w13_weight_scale_inv\"):\n439\t        assert hasattr(layer, \"weight_block_size\")\n440\t        return {\"quant_method\": \"fp8\", \"weight_block_size\": layer.weight_block_size}\n441\t\n442\t    # fp8 (e4m3): recover the strategy from the scale layout (block from\n443\t    # weight_block_size, else channel vs tensor by per-expert scale count).\n444\t    config: dict[str, Any] = {\n445\t        \"quant_method\": \"compressed-tensors\",\n446\t        \"format\": \"float-quantized\",\n447\t        \"type\": \"float\",\n448\t        \"num_bits\": 8,\n449\t        \"symmetric\": True,\n450\t    }\n451\t    weight_block_size = getattr(layer, \"weight_block_size\", None)\n452\t    num_experts, num_output = weight.shape[0], weight.shape[-2]\n453\t    if weight_block_size is not None:\n454\t        config[\"strategy\"] = \"block\"\n455\t        config[\"block_structure\"] = list(weight_block_size)\n456\t    elif weight_scale.numel() >= num_experts * num_output:\n457\t        config[\"strategy\"] = \"channel\"\n458\t    else:\n459\t        config[\"strategy\"] = \"tensor\"\n460\t    return config\n461\t\n462\t\n463\tdef convert_to_fp8_moe_kernel_format(\n464\t    fp8_backend: Fp8MoeBackend,\n465\t    # TODO(bnell): replace layer with weight_block_size\n466\t    layer: RoutedExperts,\n467\t    w13: torch.Tensor,\n468\t    w2: torch.Tensor,\n469\t    w13_scale: torch.Tensor,\n470\t    w2_scale: torch.Tensor,\n471\t    w13_input_scale: torch.Tensor | None,\n472\t    w2_input_scale: torch.Tensor | None,\n473\t) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:\n474\t    block_quant = hasattr(layer, \"weight_block_size\")\n475\t    if fp8_backend in [Fp8MoeBackend.DEEPGEMM, Fp8MoeBackend.BATCHED_DEEPGEMM]:\n476\t        assert block_quant\n477\t        w13, w2, w13_scale, w2_scale = prepare_fp8_moe_layer_for_deepgemm(\n478\t            w13,\n479\t            w2,\n480\t            w13_scale,\n481\t            w2_scale,\n482\t            tuple(layer.weight_block_size),\n483\t        )\n484\t    elif fp8_backend == Fp8MoeBackend.AITER:\n485\t        w13, w2 = rocm_aiter_ops.shuffle_weights(w13, w2)\n486\t        w13.is_shuffled = True\n487\t        w2.is_shuffled = True\n488\t    elif fp8_backend == Fp8MoeBackend.AITER_MXFP8:\n489\t        w13, w2, w13_scale, w2_scale = rocm_aiter_ops.shuffle_mxfp8_moe_weights(\n490\t            w13, w2, w13_scale, w2_scale\n491\t        )\n492\t        w13.is_shuffled = True\n493\t        w2.is_shuffled = True\n494\t    elif fp8_backend == Fp8MoeBackend.HUMMING:\n495\t        from vllm.model_executor.layers.quantization.utils.humming_utils import (\n496\t            convert_to_humming_moe_kernel_format,\n497\t        )\n498\t\n499\t        convert_to_humming_moe_kernel_format(\n500\t            layer, quant_config=_humming_fp8_weight_schema(layer, w13, w13_scale)\n501\t        )\n502\t        w13 = layer.w13_weight\n503\t        w2 = layer.w2_weight\n504\t        w13_scale = layer.w13_weight_scale\n505\t        w2_scale = layer.w2_weight_scale\n506\t    elif fp8_backend == Fp8MoeBackend.MARLIN:\n507\t        weight_block_size = getattr(layer, \"weight_block_size\", None)\n508\t        if weight_block_size == [1, 32]:\n509\t            from vllm.model_executor.layers.quantization.utils.marlin_utils_fp8 import (\n510\t                prepare_mxfp8_moe_layer_for_marlin,\n511\t            )\n512\t\n513\t            w13, w2, w13_scale, w2_scale = prepare_mxfp8_moe_layer_for_marlin(\n514\t                layer,\n515\t                w13,\n516\t                w2,\n517\t                w13_scale,\n518\t                w2_scale,\n519\t            )\n520\t        else:\n521\t            w13, w2, w13_scale, w2_scale = prepare_fp8_moe_layer_for_marlin(\n522\t                layer,\n523\t                w13,\n524\t                w2,\n525\t                w13_scale,\n526\t                w2_scale,\n527\t            )\n528\t    elif fp8_backend in [\n529\t        Fp8MoeBackend.FLASHINFER_CUTLASS,\n530\t        Fp8MoeBackend.FLASHINFER_TRTLLM,\n531\t    ]:\n532\t        w13, w2, w13_scale, w2_scale = prepare_fp8_moe_layer_for_fi(\n533\t            layer=layer,\n534\t            w13=w13,\n535\t            w2=w2,\n536\t            w13_scale=w13_scale,\n537\t            w13_input_scale=w13_input_scale,\n538\t            w2_scale=w2_scale,\n539\t            w2_input_scale=w2_input_scale,\n540\t            is_trtllm=(fp8_backend == Fp8MoeBackend.FLASHINFER_TRTLLM),\n541\t        )\n542\t    elif fp8_backend == Fp8MoeBackend.XPU:\n543\t        from vllm.model_executor.layers.fused_moe.experts.xpu_moe import (\n544\t            prepare_fp8_moe_layer_for_xpu,\n545\t        )\n546\t\n547\t        w13, w13_scale, w2, w2_scale = prepare_fp8_moe_layer_for_xpu(\n548\t            w13, w13_scale, w2, w2_scale\n549\t        )\n550\t    elif fp8_backend == Fp8MoeBackend.CPU:\n551\t        from vllm.model_executor.layers.fused_moe.experts.cpu_moe import (\n552\t            prepare_fp8_moe_layer_for_cpu,\n553\t        )\n554\t\n555\t        w13, w2 = prepare_fp8_moe_layer_for_cpu(w13, w2)\n556\t    else:\n557\t        if fp8_backend not in [\n558\t            Fp8MoeBackend.TRITON,\n559\t            Fp8MoeBackend.BATCHED_TRITON,\n560\t            Fp8MoeBackend.VLLM_CUTLASS,\n561\t            Fp8MoeBackend.BATCHED_VLLM_CUTLASS,\n562\t            Fp8MoeBackend.XPU,\n563\t            Fp8MoeBackend.HPC,\n564\t            # EMULATION dequantizes weights at runtime; NATIVE_MXFP8 consumes\n565\t            # the MXFP8 weights as-is — neither needs a load-time layout change.\n566\t            Fp8MoeBackend.EMULATION,\n567\t            Fp8MoeBackend.TRITON_MXFP8,\n568\t        ]:\n569\t            raise ValueError(f\"Unsupported FP8 MoE backend: {fp8_backend.value}\")\n570\t\n571\t    return w13, w2, w13_scale, w2_scale\n572\t\n573\t\n574\tdef make_fp8_moe_quant_config(\n575\t    fp8_backend: Fp8MoeBackend,\n576\t    w1_scale: torch.Tensor,\n577\t    w2_scale: torch.Tensor,\n578\t    a1_scale: torch.Tensor | None,\n579\t    a2_scale: torch.Tensor | None,\n580\t    w1_bias: torch.Tensor | None = None,\n581\t    w2_bias: torch.Tensor | None = None,\n582\t    block_shape: list[int] | None = None,\n583\t    per_act_token_quant: bool = False,\n584\t    per_out_ch_quant: bool = False,\n585\t    swiglu_limit: float | None = None,\n586\t    gemm1_alpha: float | None = None,\n587\t    gemm1_beta: float | None = None,\n588\t    layer: torch.nn.Module | None = None,\n589\t) -> FusedMoEQuantConfig:\n590\t    \"\"\"\n591\t    Create FusedMoEQuantConfig for the specified FP8 Backend.\n592\t    The FusedMoEQuantConfig holds the scales that are used\n593\t    at runtime by the Modular Kernel abstraction.\n594\t\n595\t    Note that certain kernels (e.g. Flashinfer CUTLASS) need\n596\t    special Quant configs to handle non-standard inputs to\n597\t    their kernel interfaces.\n598\t\n599\t    In a future PR, we will have this function should be\n600\t    a method of the modular kernel itself.\n601\t    \"\"\"\n602\t\n603\t    # MARLIN and CPU are mixed precision W8A16 config.\n604\t    if fp8_backend == Fp8MoeBackend.MARLIN or fp8_backend == Fp8MoeBackend.CPU:\n605\t        return fp8_w8a16_moe_quant_config(\n606\t            w1_scale=w1_scale,\n607\t            w2_scale=w2_scale,\n608\t            w1_bias=w1_bias,\n609\t            w2_bias=w2_bias,\n610\t            block_shape=block_shape,\n611\t            gemm1_alpha=gemm1_alpha,\n612\t            gemm1_beta=gemm1_beta,\n613\t            gemm1_clamp_limit=swiglu_limit,\n614\t        )\n615\t    elif fp8_backend == Fp8MoeBackend.HUMMING:\n616\t        from vllm.model_executor.layers.fused_moe import RoutedExperts\n617\t        from vllm.model_executor.layers.quantization.utils.humming_utils import (\n618\t            get_humming_moe_quant_config,\n619\t        )\n620\t\n621\t        assert isinstance(layer, RoutedExperts)\n622\t        return get_humming_moe_quant_config(\n623\t            layer,\n624\t            gemm1_alpha=gemm1_alpha,\n625\t            gemm1_beta=gemm1_beta,\n626\t            gemm1_clamp_limit=swiglu_limit,\n627\t        )\n628\t\n629\t    # Flashinfer CUTLASS or HPC per-tensor uses single dq scale\n630\t    # (alpha = w_scale * a_scale) and inverse a2 scale.\n631\t    if (\n632\t        fp8_backend in [Fp8MoeBackend.FLASHINFER_CUTLASS, Fp8MoeBackend.HPC]\n633\t        and block_shape is None\n634\t    ):\n635\t        assert a1_scale is not None and a2_scale is not None\n636\t        g1_alphas = w1_scale * a1_scale\n637\t        g2_alphas = w2_scale * a2_scale\n638\t        if layer is not None:\n639\t            layer.register_parameter(\n640\t                \"g1_alphas\", torch.nn.Parameter(g1_alphas, requires_grad=False)\n641\t            )\n642\t            layer.register_parameter(\n643\t                \"g2_alphas\", torch.nn.Parameter(g2_alphas, requires_grad=False)\n644\t            )\n645\t            g1_alphas = layer.g1_alphas\n646\t            g2_alphas = layer.g2_alphas\n647\t        return fp8_w8a8_moe_quant_config(\n648\t            w1_scale=w1_scale,\n649\t            w2_scale=w2_scale,\n650\t            w1_bias=w1_bias,\n651\t            w2_bias=w2_bias,\n652\t            a1_scale=a1_scale,\n653\t            a2_scale=a2_scale,\n654\t            a1_gscale=(1.0 / a1_scale),\n655\t            a2_gscale=(1.0 / a2_scale),\n656\t            g1_alphas=g1_alphas,\n657\t            g2_alphas=g2_alphas,\n658\t            gemm1_clamp_limit=swiglu_limit,\n659\t        )\n660\t    # MXFP8 (block [1, 32]) dispatches to the mxfp8 activation quant. Scales are\n661\t    # the non-swizzled (num_tokens, hidden_dim // 32) uint8 UE8M0 layout for all\n662\t    # backends; the DeepGEMM expert permute repacks them for the grouped GEMM.\n663\t    if block_shape == [1, 32]:\n664\t        return FusedMoEQuantConfig.make(\n665\t            \"mxfp8\",\n666\t            w1_scale=w1_scale,\n667\t            w2_scale=w2_scale,\n668\t            w1_bias=w1_bias,\n669\t            w2_bias=w2_bias,\n670\t            a1_scale=a1_scale,\n671\t            a2_scale=a2_scale,\n672\t            block_shape=block_shape,\n673\t            is_scale_swizzled=False,\n674\t            gemm1_alpha=gemm1_alpha,\n675\t            gemm1_beta=gemm1_beta,\n676\t            gemm1_clamp_limit=swiglu_limit,\n677\t        )\n678\t\n679\t    # All other backends use normal config.\n680\t    return fp8_w8a8_moe_quant_config(\n681\t        w1_scale=w1_scale,\n682\t        w2_scale=w2_scale,\n683\t        w1_bias=w1_bias,\n684\t        w2_bias=w2_bias,\n685\t        a1_scale=a1_scale,\n686\t        a2_scale=a2_scale,\n687\t        block_shape=block_shape,\n688\t        per_act_token_quant=per_act_token_quant,\n689\t        per_out_ch_quant=per_out_ch_quant,\n690\t        gemm1_alpha=gemm1_alpha,\n691\t        gemm1_beta=gemm1_beta,\n692\t        gemm1_clamp_limit=swiglu_limit,\n693\t    )\n694\t\n695\t\n696\tdef make_fp8_moe_kernel(\n697\t    moe_quant_config: FusedMoEQuantConfig,\n698\t    moe_config: FusedMoEConfig,\n699\t    experts_cls: type[mk.FusedMoEExperts],\n700\t    fp8_backend: Fp8MoeBackend,\n701\t    routing_tables: tuple[torch.Tensor, torch.Tensor, torch.Tensor] | None = None,\n702\t) -> mk.FusedMoEKernel:\n703\t    # Create Prepare/Finalize.\n704\t    prepare_finalize = maybe_make_prepare_finalize(\n705\t        moe=moe_config,\n706\t        quant_config=moe_quant_config,\n707\t        routing_tables=routing_tables,\n708\t        allow_new_interface=True,\n709\t        use_monolithic=issubclass(experts_cls, mk.FusedMoEExpertsMonolithic),\n710\t    )\n711\t    assert prepare_finalize is not None\n712\t\n713\t    logger.info_once(\"Using %s\", prepare_finalize.__class__.__name__)\n714\t\n715\t    # Create Experts.\n716\t    if prepare_finalize.activation_format == mk.FusedMoEActivationFormat.BatchedExperts:\n717\t        max_num_tokens = prepare_finalize.max_num_tokens_per_rank()\n718\t        assert max_num_tokens is not None\n719\t        experts = experts_cls(\n720\t            moe_config=moe_config,\n721\t            quant_config=moe_quant_config,\n722\t            max_num_tokens=max_num_tokens,\n723\t            num_dispatchers=prepare_finalize.num_dispatchers(),\n724\t        )\n725\t    else:\n726\t        experts = experts_cls(\n727\t            moe_config=moe_config,\n728\t            quant_config=moe_quant_config,\n729\t        )\n730\t\n731\t    kernel = mk.FusedMoEKernel(\n732\t        prepare_finalize,\n733\t        experts,\n734\t    )\n735\t\n736\t    return kernel\n737\t"}]},"parent_tool_use_id":"call_b26eb1c9c410c553","session_id":"0bdd9947-a518-4714-97ad-d090d3f8ef30","uuid":"ed47c4ac-48d1-4af1-ab0f-9a027aef641e","timestamp":"2026-09-15T17:34:20.508Z","subagent_type":"hyperloom-leaf","task_description":"Diagnose MoE FP8 path on gfx90a"}
