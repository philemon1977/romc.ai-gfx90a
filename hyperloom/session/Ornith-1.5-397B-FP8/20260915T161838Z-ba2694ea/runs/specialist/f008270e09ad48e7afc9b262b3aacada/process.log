dtype. That is the same\nrecipe already used in-tree by\n\n* ``model_executor/kernels/linear/mxfp8|nvfp4|*/emulation.py`` -- dequantize,\n  then run a plain higher-precision GEMM;\n* ``model_executor/layers/quantization/fp8.py`` -- the ``VLLM_BATCH_INVARIANT``\n  per-tensor / per-channel path (\"dequant to BF16 and run GEMM\").\n\nWhy dequantize instead of writing a Triton FP8 GEMM: on gfx90a a Triton FP8\nw8a8 ``tl.dot`` has to upconvert the operands anyway and reaches only a small\nfraction of what a native BF16 ``torch.mm`` does, so keeping the weights in\nFP8 to save memory would buy memory at a large dense-GEMM speed cost. Only\n*dense* linears take this path (MoE experts keep their own backends, selected\nseparately in ``fp8.py``), so the 1-byte -> 2-byte growth is bounded by the\nnon-expert parameter count.\n\nAccuracy: the FP8 (E4M3) -> BF16 cast is exact -- E4M3's 3+1 mantissa bits and\n4-bit exponent both fit in BF16 -- so the only error added versus a true scaled\nGEMM is one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic\nFP8 weight-quantization error. The activation is additionally NOT re-quantized\nto FP8 (it stays BF16), which removes the activation-quant error term the FP8\npath would have had.\n\nGATED OFF BY DEFAULT. With no environment set, ``is_supported()`` returns\nFalse, kernel selection is byte-for-byte the original, and this module only\nadds an unused import. Enable with ``VLLM_GFX90A_FP8_EMULATION=1``; opt back\nout with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n\"\"\"\n\nimport os\n\nimport torch\nfrom torch.nn.parameter import Parameter\n\nfrom vllm.logger import init_logger\nfrom vllm.model_executor.layers.fusion.quant_activation import (\n    QuantizedActivation,\n)\nfrom vllm.model_executor.layers.quantization.utils.quant_utils import GroupShape\nfrom vllm.model_executor.utils import replace_parameter\nfrom vllm.platforms import current_platform\n\nfrom .ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n)\n\nlogger = init_logger(__name__)\n\n#: Environment switch that arms this rewrite. Default OFF. Namespaced so it\n#: cannot collide with an upstream variable of the same name.\nFP8_EMULATION_ENV = \"VLLM_GFX90A_FP8_EMULATION\"\n\n_FP8_DTYPES = (\n    torch.float8_e4m3fn,\n    torch.float8_e4m3fnuz,\n    torch.float8_e5m2,\n    torch.float8_e5m2fnuz,\n)\n\n\ndef fp8_emulation_enabled() -> bool:\n    \"\"\"True when ``VLLM_GFX90A_FP8_EMULATION`` is set to a truthy value.\"\"\"\n    return os.environ.get(FP8_EMULATION_ENV, \"0\").strip().lower() not in (\n        \"\",\n        \"0\",\n        \"false\",\n        \"no\",\n        \"off\",\n    )\n\n\ndef rocm_lacks_hardware_fp8() -> bool:\n    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n    if not current_platform.is_rocm():\n        return False\n\n    from vllm.platforms.rocm import get_cdna_version, on_cdna\n\n    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n    # Hardware FP8 (and hence hipBLASLt FP8 scaled-mm) starts at CDNA3.\n    return on_cdna() and get_cdna_version() < 3\n\n\nclass FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n\n    # Accumulated over all rewritten layers, for one informational log line.\n    _fp8_bytes = 0\n    _dq_bytes = 0\n\n    @classmethod\n    def is_supported(\n        cls, compute_capability: int | None = None\n    ) -> tuple[bool, str | None]:\n        if not fp8_emulation_enabled():\n            return False, f\"is disabled (set {FP8_EMULATION_ENV}=1 to enable).\"\n        if not rocm_lacks_hardware_fp8():\n            return False, (\n                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n                \"FP8 and no torch._scaled_mm support.\"\n            )\n        return True, None\n\n    @classmethod\n    def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:\n        # Fallback contract: only per-tensor / per-channel (row/column) FP8 is\n        # emulated. Anything block- or group-wise degrades to the original\n        # selection instead of silently producing a wrong GEMM.\n        if c.weight_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 weights.\"\n        if c.activation_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 activations.\"\n        out_dtype = c.out_dtype or torch.get_default_dtype()\n        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n            return False, \"requires a >= 2-byte floating point output dtype.\"\n        return True, None\n\n    @staticmethod\n    def _as_nk(weight: torch.Tensor) -> torch.Tensor:\n        \"\"\"Return ``weight`` oriented as [N, K] (out_features, in_features).\n\n        Quant methods leave the prepared parameter transposed to [K, N] and\n        tag it with ``input_dim=0`` / ``output_dim=1``; prefer that contract\n        over guessing from strides.\n        \"\"\"\n        if weight.dim() != 2:\n            return weight\n        input_dim = getattr(weight, \"input_dim\", None)\n        if input_dim == 0:\n            return weight.t()\n        if input_dim == 1:\n            return weight\n        # No dim tags: fall back to the layout the compressed-tensors schemes\n        # produce (transposed view => stride(0) == 1).\n        if weight.stride(0) == 1 and weight.stride(1) != 1:\n            return weight.t()\n        return weight\n\n    def _dequant(\n        self,\n        weight: torch.Tensor,\n        weight_scale: torch.Tensor | None,\n    ) -> torch.Tensor:\n        \"\"\"Dequantize an FP8 weight, returning a float32 [N, K] tensor.\"\"\"\n        w_nk = self._as_nk(weight)\n        if w_nk.stride(-1) != 1:\n            w_nk = w_nk.contiguous()\n        n, k = w_nk.shape\n        w_f32 = w_nk.to(torch.float32)\n\n        if weight_scale is None:\n            return w_f32\n        if weight_scale.numel() == 1:\n            return w_f32 * weight_scale.to(torch.float32).reshape(-1)[0]\n\n        scale = weight_scale.to(torch.float32).reshape(-1)\n        if scale.numel() == n:\n            return w_f32 * scale.unsqueeze(1)\n        if scale.numel() == k:\n            return w_f32 * scale.unsqueeze(0)\n        raise ValueError(\n            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n            f\"matches neither N={n} nor K={k}.\"\n        )\n\n    def input_quant_key(self):\n        # The activation is never quantized here, so no manual-fusion partner\n        # may hoist FP8 quantization upstream of this layer.\n        return None\n\n    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n        weight, weight_scale, _, _ = self._get_layer_params(layer)\n        if weight is None or weight.dtype not in _FP8_DTYPES:\n            # Already dequantized by an earlier pass, or never FP8 at all.\n            return\n\n        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n        w_dq = self._dequant(weight, weight_scale).to(out_dtype)\n\n        self.__class__._fp8_bytes += weight.numel() * weight.element_size()\n        self.__class__._dq_bytes += w_dq.numel() * w_dq.element_size()\n        logger.info_once(\n            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"\n            \"hardware FP8 and no torch._scaled_mm support): dequantizing \"\n            \"weights at load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",\n            str(out_dtype).replace(\"torch.\", \"\"),\n            self.__class__._fp8_bytes / 2**30,\n            self.__class__._dq_bytes / 2**30,\n            scope=\"global\",\n        )\n\n        # Store as a [N, K] parameter so apply_weights can call F.linear\n        # directly; the weight loader has already run.\n        replace_parameter(layer, \"weight\", Parameter(w_dq, requires_grad=False))\n        layer.weight.input_dim = 1\n        layer.weight.output_dim = 0\n        # The scale has been folded into the weight: drop the reference so the\n        # FP8-side bookkeeping cannot be mistaken for a live quantized tensor.\n        if weight_scale is not None:\n            replace_parameter(\n                layer,\n                \"weight_scale\",\n                Parameter(torch.ones((), dtype=out_dtype), requires_grad=False),\n            )\n\n    def apply_weights(\n        self,\n        layer: torch.nn.Module,\n        x: torch.Tensor | QuantizedActivation,\n        bias: torch.Tensor | None = None,\n    ) -> torch.Tensor:\n        if isinstance(x, QuantizedActivation):\n            # Defensive only: this kernel does not advertise input_quant_key(),\n            # so manual fusion never hands us a pre-quantized activation.\n            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(\n                *x.orig_shape\n            )\n\n        weight = layer.weight\n        if weight.dtype in _FP8_DTYPES:\n            # Not pre-dequantized (process_weights_after_loading was skipped):\n            # dequantize on the fly so we never reach torch._scaled_mm.\n            _, weight_scale, _, _ = self._get_layer_params(layer)\n            weight = self._dequant(weight, weight_scale)\n\n        # F.linear needs matching dtypes; .to() is a no-op when they already do.\n        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)\n\n    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n        # This kernel overrides apply_weights and must never call\n        # torch._scaled_mm, which does not exist on pre-MI300 ROCm.\n        raise NotImplementedError(\n            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n            \"apply_scaled_mm is intentionally not implemented.\"\n        )\n","structuredPatch":[{"oldStart":7,"oldLines":38,"newStart":7,"newLines":43,"lines":[" (\"torch._scaled_mm is only supported on CUDA devices with compute capability"," >= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 GPUs (gfx908 / gfx90a, e.g."," MI250X) have no FP8 matrix instruction at all, so *no* scaled-mm provider can","-serve an FP8 checkpoint there. On gfx90a the ROCm FP8 registry falls straight","-through the aiter / skinny-GEMM gates and lands on","+serve an FP8 checkpoint there. On gfx90a the ROCm FP8 registry falls through","+the aiter gates (all correctly arch-gated off) and lands on"," ``ChannelWiseTorchFP8ScaledMMLinearKernel``, whose inherited","-``compute capability >= 89`` gate is fooled by gfx90a reporting capability","-``(9, 0)`` -- so the engine aborts inside ``profile_run`` on the very first","-FP8 linear (server.log: \"Selected ChannelWiseTorchFP8ScaledMMLinearKernel for","-CompressedTensorsW8A8Fp8\", then the scaled_mm RuntimeError from all 8 TP","+\"compute capability >= 89\" gate is fooled by gfx90a reporting capability","+``(9, 0)`` -- so engine init dies inside ``profile_run`` on the first FP8","+linear (observed: ``Selected ChannelWiseTorchFP8ScaledMMLinearKernel for","+CompressedTensorsW8A8Fp8`` followed by the scaled_mm RuntimeError in all 8 TP"," workers)."," "," This kernel bridges the gap: it dequantizes the FP8 weight ONCE at load time","-and then runs a plain ``F.linear`` in the activation dtype. Same recipe","-already used in-tree by ``kernels/linear/mxfp8|nvfp4/emulation.py``","-(dequantize, run a higher-precision GEMM) and by","-``model_executor/layers/quantization/fp8.py`` under ``VLLM_BATCH_INVARIANT``","-(\"dequant to BF16 and run GEMM\").","+and then runs a plain ``F.linear`` in the activation dtype. That is the same","+recipe already used in-tree by"," ","-Why dequantize rather than a Triton FP8 GEMM: on gfx90a a ``tl.dot`` has to","-upconvert the FP8 operands anyway, so it reaches only a small fraction of what","-a native BF16 ``torch.mm`` does. Only *dense* linears take this path (MoE","-experts keep their own backends), so the 1-byte -> 2-byte growth is bounded by","-the non-expert parameter count.","+* ``model_executor/kernels/linear/mxfp8|nvfp4|*/emulation.py`` -- dequantize,","+  then run a plain higher-precision GEMM;","+* ``model_executor/layers/quantization/fp8.py`` -- the ``VLLM_BATCH_INVARIANT``","+  per-tensor / per-channel path (\"dequant to BF16 and run GEMM\")."," ","-Accuracy: the E4M3 -> BF16 cast is exact (3+1 mantissa bits and a 4-bit","-exponent both fit in BF16), so the only error added versus a true scaled GEMM","-is one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic FP8","-weight-quant error. The activation is additionally NOT re-quantized to FP8,","-which removes the activation-quant error term the FP8 path would have had.","+Why dequantize instead of writing a Triton FP8 GEMM: on gfx90a a Triton FP8","+w8a8 ``tl.dot`` has to upconvert the operands anyway and reaches only a small","+fraction of what a native BF16 ``torch.mm`` does, so keeping the weights in","+FP8 to save memory would buy memory at a large dense-GEMM speed cost. Only","+*dense* linears take this path (MoE experts keep their own backends, selected","+separately in ``fp8.py``), so the 1-byte -> 2-byte growth is bounded by the","+non-expert parameter count."," ","-Enabled by ``VLLM_GFX90A_FP8_EMULATION=1`` (default OFF: with no switch set,","-this module registers no kernel and the code path is the original). Opt out of","-an already-selected instance with","-``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.","+Accuracy: the FP8 (E4M3) -> BF16 cast is exact -- E4M3's 3+1 mantissa bits and","+4-bit exponent both fit in BF16 -- so the only error added versus a true scaled","+GEMM is one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic","+FP8 weight-quantization error. The activation is additionally NOT re-quantized","+to FP8 (it stays BF16), which removes the activation-quant error term the FP8","+path would have had.","+","+GATED OFF BY DEFAULT. With no environment set, ``is_supported()`` returns","+False, kernel selection is byte-for-byte the original, and this module only","+adds an unused import. Enable with ``VLLM_GFX90A_FP8_EMULATION=1``; opt back","+out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``."," \"\"\""," "," import os"]},{"oldStart":61,"oldLines":9,"newStart":66,"newLines":8,"lines":[" "," logger = init_logger(__name__)"," ","-#: Env switch naming this rewrite. Defaults OFF so that, with no environment","-#: set, every gate below reports unsupported and selection is byte-for-byte","-#: the original. Namespace is unique: nothing else in vLLM reads it.","+#: Environment switch that arms this rewrite. Default OFF. Namespaced so it","+#: cannot collide with an upstream variable of the same name."," FP8_EMULATION_ENV = \"VLLM_GFX90A_FP8_EMULATION\""," "," _FP8_DTYPES = ("]},{"oldStart":74,"oldLines":7,"newStart":78,"newLines":7,"lines":[" )"," "," ","-def fp8_emulation_env_enabled() -> bool:","+def fp8_emulation_enabled() -> bool:","     \"\"\"True when ``VLLM_GFX90A_FP8_EMULATION`` is set to a truthy value.\"\"\"","     return os.environ.get(FP8_EMULATION_ENV, \"0\").strip().lower() not in (","         \"\","]},{"oldStart":108,"oldLines":8,"newStart":112,"newLines":8,"lines":["     def is_supported(","         cls, compute_capability: int | None = None","     ) -> tuple[bool, str | None]:","-        if not fp8_emulation_env_enabled():","-            return False, f\"is disabled ({FP8_EMULATION_ENV} not set).\"","+        if not fp8_emulation_enabled():","+            return False, f\"is disabled (set {FP8_EMULATION_ENV}=1 to enable).\"","         if not rocm_lacks_hardware_fp8():","             return False, (","                 \"is only used on pre-MI300 ROCm GPUs, which have no hardware \""]},{"oldStart":119,"oldLines":6,"newStart":123,"newLines":9,"lines":[" ","     @classmethod","     def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:","+        # Fallback contract: only per-tensor / per-channel (row/column) FP8 is","+        # emulated. Anything block- or group-wise degrades to the original","+        # selection instead of silently producing a wrong GEMM.","         if c.weight_quant_key.scale.group_shape.is_per_group():","             return False, \"cannot implement block/group-wise FP8 weights.\"","         if c.activation_quant_key.scale.group_shape.is_per_group():"]}],"originalFile":"# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\n\"\"\"FP8 w8a8 dense-linear emulation for AMD GPUs without hardware FP8.\n\n``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm parts older than MI300\n(\"torch._scaled_mm is only supported on CUDA devices with compute capability\n>= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 GPUs (gfx908 / gfx90a, e.g.\nMI250X) have no FP8 matrix instruction at all, so *no* scaled-mm provider can\nserve an FP8 checkpoint there. On gfx90a the ROCm FP8 registry falls straight\nthrough the aiter / skinny-GEMM gates and lands on\n``ChannelWiseTorchFP8ScaledMMLinearKernel``, whose inherited\n``compute capability >= 89`` gate is fooled by gfx90a reporting capability\n``(9, 0)`` -- so the engine aborts inside ``profile_run`` on the very first\nFP8 linear (server.log: \"Selected ChannelWiseTorchFP8ScaledMMLinearKernel for\nCompressedTensorsW8A8Fp8\", then the scaled_mm RuntimeError from all 8 TP\nworkers).\n\nThis kernel bridges the gap: it dequantizes the FP8 weight ONCE at load time\nand then runs a plain ``F.linear`` in the activation dtype. Same recipe\nalready used in-tree by ``kernels/linear/mxfp8|nvfp4/emulation.py``\n(dequantize, run a higher-precision GEMM) and by\n``model_executor/layers/quantization/fp8.py`` under ``VLLM_BATCH_INVARIANT``\n(\"dequant to BF16 and run GEMM\").\n\nWhy dequantize rather than a Triton FP8 GEMM: on gfx90a a ``tl.dot`` has to\nupconvert the FP8 operands anyway, so it reaches only a small fraction of what\na native BF16 ``torch.mm`` does. Only *dense* linears take this path (MoE\nexperts keep their own backends), so the 1-byte -> 2-byte growth is bounded by\nthe non-expert parameter count.\n\nAccuracy: the E4M3 -> BF16 cast is exact (3+1 mantissa bits and a 4-bit\nexponent both fit in BF16), so the only error added versus a true scaled GEMM\nis one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic FP8\nweight-quant error. The activation is additionally NOT re-quantized to FP8,\nwhich removes the activation-quant error term the FP8 path would have had.\n\nEnabled by ``VLLM_GFX90A_FP8_EMULATION=1`` (default OFF: with no switch set,\nthis module registers no kernel and the code path is the original). Opt out of\nan already-selected instance with\n``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n\"\"\"\n\nimport os\n\nimport torch\nfrom torch.nn.parameter import Parameter\n\nfrom vllm.logger import init_logger\nfrom vllm.model_executor.layers.fusion.quant_activation import (\n    QuantizedActivation,\n)\nfrom vllm.model_executor.layers.quantization.utils.quant_utils import GroupShape\nfrom vllm.model_executor.utils import replace_parameter\nfrom vllm.platforms import current_platform\n\nfrom .ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n)\n\nlogger = init_logger(__name__)\n\n#: Env switch naming this rewrite. Defaults OFF so that, with no environment\n#: set, every gate below reports unsupported and selection is byte-for-byte\n#: the original. Namespace is unique: nothing else in vLLM reads it.\nFP8_EMULATION_ENV = \"VLLM_GFX90A_FP8_EMULATION\"\n\n_FP8_DTYPES = (\n    torch.float8_e4m3fn,\n    torch.float8_e4m3fnuz,\n    torch.float8_e5m2,\n    torch.float8_e5m2fnuz,\n)\n\n\ndef fp8_emulation_env_enabled() -> bool:\n    \"\"\"True when ``VLLM_GFX90A_FP8_EMULATION`` is set to a truthy value.\"\"\"\n    return os.environ.get(FP8_EMULATION_ENV, \"0\").strip().lower() not in (\n        \"\",\n        \"0\",\n        \"false\",\n        \"no\",\n        \"off\",\n    )\n\n\ndef rocm_lacks_hardware_fp8() -> bool:\n    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n    if not current_platform.is_rocm():\n        return False\n\n    from vllm.platforms.rocm import get_cdna_version, on_cdna\n\n    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n    # Hardware FP8 (and hence hipBLASLt FP8 scaled-mm) starts at CDNA3.\n    return on_cdna() and get_cdna_version() < 3\n\n\nclass FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n\n    # Accumulated over all rewritten layers, for one informational log line.\n    _fp8_bytes = 0\n    _dq_bytes = 0\n\n    @classmethod\n    def is_supported(\n        cls, compute_capability: int | None = None\n    ) -> tuple[bool, str | None]:\n        if not fp8_emulation_env_enabled():\n            return False, f\"is disabled ({FP8_EMULATION_ENV} not set).\"\n        if not rocm_lacks_hardware_fp8():\n            return False, (\n                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n                \"FP8 and no torch._scaled_mm support.\"\n            )\n        return True, None\n\n    @classmethod\n    def can_implement(cls, c: FP8ScaledMMLinearLayerConfig) -> tuple[bool, str | None]:\n        if c.weight_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 weights.\"\n        if c.activation_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 activations.\"\n        out_dtype = c.out_dtype or torch.get_default_dtype()\n        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n            return False, \"requires a >= 2-byte floating point output dtype.\"\n        return True, None\n\n    @staticmethod\n    def _as_nk(weight: torch.Tensor) -> torch.Tensor:\n        \"\"\"Return ``weight`` oriented as [N, K] (out_features, in_features).\n\n        Quant methods leave the prepared parameter transposed to [K, N] and\n        tag it with ``input_dim=0`` / ``output_dim=1``; prefer that contract\n        over guessing from strides.\n        \"\"\"\n        if weight.dim() != 2:\n            return weight\n        input_dim = getattr(weight, \"input_dim\", None)\n        if input_dim == 0:\n            return weight.t()\n        if input_dim == 1:\n            return weight\n        # No dim tags: fall back to the layout the compressed-tensors schemes\n        # produce (transposed view => stride(0) == 1).\n        if weight.stride(0) == 1 and weight.stride(1) != 1:\n            return weight.t()\n        return weight\n\n    def _dequant(\n        self,\n        weight: torch.Tensor,\n        weight_scale: torch.Tensor | None,\n    ) -> torch.Tensor:\n        \"\"\"Dequantize an FP8 weight, returning a float32 [N, K] tensor.\"\"\"\n        w_nk = self._as_nk(weight)\n        if w_nk.stride(-1) != 1:\n            w_nk = w_nk.contiguous()\n        n, k = w_nk.shape\n        w_f32 = w_nk.to(torch.float32)\n\n        if weight_scale is None:\n            return w_f32\n        if weight_scale.numel() == 1:\n            return w_f32 * weight_scale.to(torch.float32).reshape(-1)[0]\n\n        scale = weight_scale.to(torch.float32).reshape(-1)\n        if scale.numel() == n:\n            return w_f32 * scale.unsqueeze(1)\n        if scale.numel() == k:\n            return w_f32 * scale.unsqueeze(0)\n        raise ValueError(\n            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n            f\"matches neither N={n} nor K={k}.\"\n        )\n\n    def input_quant_key(self):\n        # The activation is never quantized here, so no manual-fusion partner\n        # may hoist FP8 quantization upstream of this layer.\n        return None\n\n    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n        weight, weight_scale, _, _ = self._get_layer_params(layer)\n        if weight is None or weight.dtype not in _FP8_DTYPES:\n            # Already dequantized by an earlier pass, or never FP8 at all.\n            return\n\n        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n        w_dq = self._dequant(weight, weight_scale).to(out_dtype)\n\n        self.__class__._fp8_bytes += weight.numel() * weight.element_size()\n        self.__class__._dq_bytes += w_dq.numel() * w_dq.element_size()\n        logger.info_once(\n            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"\n            \"hardware FP8 and no torch._scaled_mm support): dequantizing \"\n            \"weights at load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",\n            str(out_dtype).replace(\"torch.\", \"\"),\n            self.__class__._fp8_bytes / 2**30,\n            self.__class__._dq_bytes / 2**30,\n            scope=\"global\",\n        )\n\n        # Store as a [N, K] parameter so apply_weights can call F.linear\n        # directly; the weight loader has already run.\n        replace_parameter(layer, \"weight\", Parameter(w_dq, requires_grad=False))\n        layer.weight.input_dim = 1\n        layer.weight.output_dim = 0\n        # The scale has been folded into the weight: drop the reference so the\n        # FP8-side bookkeeping cannot be mistaken for a live quantized tensor.\n        if weight_scale is not None:\n            replace_parameter(\n                layer,\n                \"weight_scale\",\n                Parameter(torch.ones((), dtype=out_dtype), requires_grad=False),\n            )\n\n    def apply_weights(\n        self,\n        layer: torch.nn.Module,\n        x: torch.Tensor | QuantizedActivation,\n        bias: torch.Tensor | None = None,\n    ) -> torch.Tensor:\n        if isinstance(x, QuantizedActivation):\n            # Defensive only: this kernel does not advertise input_quant_key(),\n            # so manual fusion never hands us a pre-quantized activation.\n            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(\n                *x.orig_shape\n            )\n\n        weight = layer.weight\n        if weight.dtype in _FP8_DTYPES:\n            # Not pre-dequantized (process_weights_after_loading was skipped):\n            # dequantize on the fly so we never reach torch._scaled_mm.\n            _, weight_scale, _, _ = self._get_layer_params(layer)\n            weight = self._dequant(weight, weight_scale)\n\n        # F.linear needs matching dtypes; .to() is a no-op when they already do.\n        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)\n\n    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n        # This kernel overrides apply_weights and must never call\n        # torch._scaled_mm, which does not exist on pre-MI300 ROCm.\n        raise NotImplementedError(\n            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n            \"apply_scaled_mm is intentionally not implemented.\"\n        )\n","userModified":false}}
