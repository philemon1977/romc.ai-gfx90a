{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_aebe60e4866bfc2e","type":"tool_result","content":"1\t# SPDX-License-Identifier: Apache-2.0\n2\t# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3\t\n4\t\"\"\"FP8 w8a8 dense-linear emulation for AMD GPUs without hardware FP8.\n5\t\n6\t``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm parts older than MI300\n7\t(\"torch._scaled_mm is only supported on CUDA devices with compute capability\n8\t>= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 GPUs (gfx908 / gfx90a, e.g.\n9\tMI250X) have no FP8 matrix instruction at all, so *no* scaled-mm provider can\n10\tserve an FP8 checkpoint there. Before this kernel existed, the ROCm FP8\n11\tregistry fell through the aiter / skinny-GEMM / rowwise gates (all correctly\n12\tarch-gated) and landed on ``ChannelWiseTorchFP8ScaledMMLinearKernel``, whose\n13\tinherited ``compute capability >= 89`` gate is fooled by gfx90a reporting\n14\tcapability ``(9, 0)`` -- so the engine aborted inside ``profile_run``.\n15\t\n16\tThis kernel bridges the gap: it dequantizes the FP8 weight to the activation\n17\tdtype ONCE at load time and then runs a plain ``F.linear``. That is the same\n18\trecipe already used in-tree by\n19\t\n20\t* ``model_executor/kernels/linear/mxfp8/emulation.py`` and\n21\t  ``nvfp4/emulation.py`` -- dequantize, then run a plain higher-precision GEMM,\n22\t* ``model_executor/layers/quantization/fp8.py`` -- the ``VLLM_BATCH_INVARIANT``\n23\t  per-tensor / per-channel path (\"dequant to BF16 and run GEMM\").\n24\t\n25\tWhy dequantize instead of writing a Triton FP8 GEMM: on gfx90a a Triton FP8\n26\tw8a8 ``tl.dot`` has to upconvert the operands anyway and reaches only a small\n27\tfraction of what a native BF16 ``torch.mm`` does, so keeping the weights in\n28\tFP8 to save memory would buy memory at a large dense-GEMM speed cost. Only\n29\t*dense* linears take this path (MoE experts keep their own kernels), so the\n30\t1-byte -> 2-byte growth is bounded by the non-expert parameter count.\n31\t\n32\tAccuracy: the FP8 (E4M3) -> BF16 cast is exact -- E4M3's 3+1 mantissa bits and\n33\t4-bit exponent both fit in BF16 -- so the only error added versus a true scaled\n34\tGEMM is one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic\n35\tFP8 weight-quantization error. The activation is additionally NOT re-quantized\n36\tto FP8 (it stays BF16), which removes the activation-quant error term the FP8\n37\tpath would have had.\n38\t\n39\tOpt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n40\t\"\"\"\n41\t\n42\timport torch\n43\tfrom torch.nn.parameter import Parameter\n44\t\n45\tfrom vllm.logger import init_logger\n46\tfrom vllm.model_executor.layers.fusion.quant_activation import (\n47\t    QuantizedActivation,\n48\t)\n49\tfrom vllm.model_executor.layers.quantization.utils.quant_utils import GroupShape\n50\tfrom vllm.platforms import current_platform\n51\tfrom vllm.model_executor.utils import replace_parameter\n52\t\n53\tfrom .ScaledMMLinearKernel import (\n54\t    FP8ScaledMMLinearKernel,\n55\t    FP8ScaledMMLinearLayerConfig,\n56\t)\n57\t\n58\tlogger = init_logger(__name__)\n59\t\n60\t_FP8_DTYPES = (\n61\t    torch.float8_e4m3fn,\n62\t    torch.float8_e4m3fnuz,\n63\t    torch.float8_e5m2,\n64\t    torch.float8_e5m2fnuz,\n65\t)\n66\t\n67\t\n68\tdef rocm_lacks_hardware_fp8() -> bool:\n69\t    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n70\t    if not current_platform.is_rocm():\n71\t        return False\n72\t\n73\t    from vllm.platforms.rocm import get_cdna_version, on_cdna\n74\t\n75\t    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n76\t    # Hardware FP8 (and hence hipBLASLt FP8 scaled-mm) starts at CDNA3.\n77\t    return on_cdna() and get_cdna_version() < 3\n78\t\n79\t\n80\tclass FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n81\t    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n82\t\n83\t    # Accumulated over all rewritten layers, for one informational log line.\n84\t    _fp8_bytes = 0\n85\t    _dq_bytes = 0\n86\t\n87\t    @classmethod\n88\t    def is_supported(\n89\t        cls, compute_capability: int | None = None\n90\t    ) -> tuple[bool, str | None]:\n91\t        if not rocm_lacks_hardware_fp8():\n92\t            return False, (\n93\t                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n94\t                \"FP8 and no torch._scaled_mm support.\"\n95\t            )\n96\t        return True, None\n97\t\n98\t    @classmethod\n99\t    def can_implement(\n100\t        cls, c: FP8ScaledMMLinearLayerConfig\n101\t    ) -> tuple[bool, str | None]:\n102\t        if c.weight_quant_key.scale.group_shape.is_per_group():\n103\t            return False, \"cannot implement block/group-wise FP8 weights.\"\n104\t        if c.activation_quant_key.scale.group_shape.is_per_group():\n105\t            return False, \"cannot implement block/group-wise FP8 activations.\"\n106\t        out_dtype = c.out_dtype or torch.get_default_dtype()\n107\t        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n108\t            return False, f\"requires a >= 2-byte floating point output dtype.\"\n109\t        return True, None\n110\t\n111\t    @staticmethod\n112\t    def _as_nk(weight: torch.Tensor) -> torch.Tensor:\n113\t        \"\"\"Return ``weight`` oriented as [N, K] (out_features, in_features).\n114\t\n115\t        Quant methods leave the prepared parameter transposed to [K, N] and\n116\t        tag it with ``input_dim=0`` / ``output_dim=1``; prefer that contract\n117\t        over guessing from strides.\n118\t        \"\"\"\n119\t        if weight.dim() != 2:\n120\t            return weight\n121\t        input_dim = getattr(weight, \"input_dim\", None)\n122\t        if input_dim == 0:\n123\t            return weight.t()\n124\t        if input_dim == 1:\n125\t            return weight\n126\t        # No dim tags: fall back to the layout the compressed-tensors schemes\n127\t        # produce (transposed view => stride(0) == 1).\n128\t        if weight.stride(0) == 1 and weight.stride(1) != 1:\n129\t            return weight.t()\n130\t        return weight\n131\t\n132\t    def _dequant(\n133\t        self,\n134\t        weight: torch.Tensor,\n135\t        weight_scale: torch.Tensor | None,\n136\t    ) -> torch.Tensor:\n137\t        \"\"\"Dequantize an FP8 weight, returning a float32 [N, K] tensor.\"\"\"\n138\t        w_nk = self._as_nk(weight)\n139\t        if w_nk.stride(-1) != 1:\n140\t            w_nk = w_nk.contiguous()\n141\t        n, k = w_nk.shape\n142\t        w_f32 = w_nk.to(torch.float32)\n143\t\n144\t        if weight_scale is None:\n145\t            return w_f32\n146\t        if weight_scale.numel() == 1:\n147\t            return w_f32 * weight_scale.to(torch.float32).reshape(-1)[0]\n148\t\n149\t        scale = weight_scale.to(torch.float32).reshape(-1)\n150\t        if scale.numel() == n:\n151\t            return w_f32 * scale.unsqueeze(1)\n152\t        if scale.numel() == k:\n153\t            return w_f32 * scale.unsqueeze(0)\n154\t        raise ValueError(\n155\t            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n156\t            f\"matches neither N={n} nor K={k}.\"\n157\t        )\n158\t\n159\t    def input_quant_key(self):\n160\t        # The activation is never quantized here, so no manual-fusion partner\n161\t        # may hoist FP8 quantization upstream of this layer.\n162\t        return None\n163\t\n164\t    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n165\t        weight, weight_scale, _, _ = self._get_layer_params(layer)\n166\t        if weight is None or weight.dtype not in _FP8_DTYPES:\n167\t            # Already dequantized by an earlier pass, or never FP8 at all.\n168\t            return\n169\t\n170\t        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n171\t        w_dq = self._dequant(weight, weight_scale).to(out_dtype)\n172\t\n173\t        self.__class__._fp8_bytes += weight.numel() * weight.element_size()\n174\t        self.__class__._dq_bytes += w_dq.numel() * w_dq.element_size()\n175\t        logger.info_once(\n176\t            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"\n177\t            \"hardware FP8 and no torch._scaled_mm support): dequantizing \"\n178\t            \"weights at load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",\n179\t            str(out_dtype).replace(\"torch.\", \"\"),\n180\t            self.__class__._fp8_bytes / 2**30,\n181\t            self.__class__._dq_bytes / 2**30,\n182\t            scope=\"global\",\n183\t        )\n184\t\n185\t        # Store as a [N, K] parameter so apply_weights can call F.linear\n186\t        # directly; the weight loader has already run.\n187\t        replace_parameter(\n188\t            layer, \"weight\", Parameter(w_dq, requires_grad=False)\n189\t        )\n190\t        layer.weight.input_dim = 1\n191\t        layer.weight.output_dim = 0\n192\t        # The scale has been folded into the weight: drop the reference so the\n193\t        # FP8-side bookkeeping cannot be mistaken for a live quantized tensor.\n194\t        if weight_scale is not None:\n195\t            replace_parameter(\n196\t                layer,\n197\t                \"weight_scale\",\n198\t                Parameter(torch.ones((), dtype=out_dtype), requires_grad=False),\n199\t            )\n200\t\n201\t    def apply_weights(\n202\t        self,\n203\t        layer: torch.nn.Module,\n204\t        x: torch.Tensor | QuantizedActivation,\n205\t        bias: torch.Tensor | None = None,\n206\t    ) -> torch.Tensor:\n207\t        if isinstance(x, QuantizedActivation):\n208\t            # Defensive only: this kernel does not advertise input_quant_key(),\n209\t            # so manual fusion never hands us a pre-quantized activation.\n210\t            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(\n211\t                *x.orig_shape\n212\t            )\n213\t\n214\t        weight = layer.weight\n215\t        if weight.dtype in _FP8_DTYPES:\n216\t            # Not pre-dequantized (process_weights_after_loading was skipped):\n217\t            # dequantize on the fly so we never reach torch._scaled_mm.\n218\t            _, weight_scale, _, _ = self._get_layer_params(layer)\n219\t            weight = self._dequant(weight, weight_scale)\n220\t\n221\t        # F.linear needs matching dtypes; .to() is a no-op when they already do.\n222\t        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)\n223\t\n224\t    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n225\t        # This kernel overrides apply_weights and must never call\n226\t        # torch._scaled_mm, which does not exist on pre-MI300 ROCm.\n227\t        raise NotImplementedError(\n228\t            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n229\t            \"apply_scaled_mm is intentionally not implemented.\"\n230\t        )\n231\t"}]},"parent_tool_use_id":null,"session_id":"4398ab91-ecaa-4257-90d2-2cd3a9bc7624","uuid":"4c692b53-aed2-4add-84eb-0ca50cf2547e","timestamp":"2026-09-15T18:24:25.021Z","tool_use_result":{"type":"text","file":{"filePath":"/home/qiba/ROCm.AI/hyperloom/session/Ornith-1.5-397B-FP8/20260915T161838Z-ba2694ea/runs/specialist/8628519056b24176b3fa5c9a0e106dd6/wt/vllm/model_executor/kernels/linear/scaled_mm/emulation.py","content":"# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n\n\"\"\"FP8 w8a8 dense-linear emulation for AMD GPUs without hardware FP8.\n\n``torch._scaled_mm`` hard-rejects FP8 inputs on ROCm parts older than MI300\n(\"torch._scaled_mm is only supported on CUDA devices with compute capability\n>= 9.0 or 8.9, or ROCm MI300+\"). CDNA1/CDNA2 GPUs (gfx908 / gfx90a, e.g.\nMI250X) have no FP8 matrix instruction at all, so *no* scaled-mm provider can\nserve an FP8 checkpoint there. Before this kernel existed, the ROCm FP8\nregistry fell through the aiter / skinny-GEMM / rowwise gates (all correctly\narch-gated) and landed on ``ChannelWiseTorchFP8ScaledMMLinearKernel``, whose\ninherited ``compute capability >= 89`` gate is fooled by gfx90a reporting\ncapability ``(9, 0)`` -- so the engine aborted inside ``profile_run``.\n\nThis kernel bridges the gap: it dequantizes the FP8 weight to the activation\ndtype ONCE at load time and then runs a plain ``F.linear``. That is the same\nrecipe already used in-tree by\n\n* ``model_executor/kernels/linear/mxfp8/emulation.py`` and\n  ``nvfp4/emulation.py`` -- dequantize, then run a plain higher-precision GEMM,\n* ``model_executor/layers/quantization/fp8.py`` -- the ``VLLM_BATCH_INVARIANT``\n  per-tensor / per-channel path (\"dequant to BF16 and run GEMM\").\n\nWhy dequantize instead of writing a Triton FP8 GEMM: on gfx90a a Triton FP8\nw8a8 ``tl.dot`` has to upconvert the operands anyway and reaches only a small\nfraction of what a native BF16 ``torch.mm`` does, so keeping the weights in\nFP8 to save memory would buy memory at a large dense-GEMM speed cost. Only\n*dense* linears take this path (MoE experts keep their own kernels), so the\n1-byte -> 2-byte growth is bounded by the non-expert parameter count.\n\nAccuracy: the FP8 (E4M3) -> BF16 cast is exact -- E4M3's 3+1 mantissa bits and\n4-bit exponent both fit in BF16 -- so the only error added versus a true scaled\nGEMM is one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic\nFP8 weight-quantization error. The activation is additionally NOT re-quantized\nto FP8 (it stays BF16), which removes the activation-quant error term the FP8\npath would have had.\n\nOpt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n\"\"\"\n\nimport torch\nfrom torch.nn.parameter import Parameter\n\nfrom vllm.logger import init_logger\nfrom vllm.model_executor.layers.fusion.quant_activation import (\n    QuantizedActivation,\n)\nfrom vllm.model_executor.layers.quantization.utils.quant_utils import GroupShape\nfrom vllm.platforms import current_platform\nfrom vllm.model_executor.utils import replace_parameter\n\nfrom .ScaledMMLinearKernel import (\n    FP8ScaledMMLinearKernel,\n    FP8ScaledMMLinearLayerConfig,\n)\n\nlogger = init_logger(__name__)\n\n_FP8_DTYPES = (\n    torch.float8_e4m3fn,\n    torch.float8_e4m3fnuz,\n    torch.float8_e5m2,\n    torch.float8_e5m2fnuz,\n)\n\n\ndef rocm_lacks_hardware_fp8() -> bool:\n    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n    if not current_platform.is_rocm():\n        return False\n\n    from vllm.platforms.rocm import get_cdna_version, on_cdna\n\n    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n    # Hardware FP8 (and hence hipBLASLt FP8 scaled-mm) starts at CDNA3.\n    return on_cdna() and get_cdna_version() < 3\n\n\nclass FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n\n    # Accumulated over all rewritten layers, for one informational log line.\n    _fp8_bytes = 0\n    _dq_bytes = 0\n\n    @classmethod\n    def is_supported(\n        cls, compute_capability: int | None = None\n    ) -> tuple[bool, str | None]:\n        if not rocm_lacks_hardware_fp8():\n            return False, (\n                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n                \"FP8 and no torch._scaled_mm support.\"\n            )\n        return True, None\n\n    @classmethod\n    def can_implement(\n        cls, c: FP8ScaledMMLinearLayerConfig\n    ) -> tuple[bool, str | None]:\n        if c.weight_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 weights.\"\n        if c.activation_quant_key.scale.group_shape.is_per_group():\n            return False, \"cannot implement block/group-wise FP8 activations.\"\n        out_dtype = c.out_dtype or torch.get_default_dtype()\n        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n            return False, f\"requires a >= 2-byte floating point output dtype.\"\n        return True, None\n\n    @staticmethod\n    def _as_nk(weight: torch.Tensor) -> torch.Tensor:\n        \"\"\"Return ``weight`` oriented as [N, K] (out_features, in_features).\n\n        Quant methods leave the prepared parameter transposed to [K, N] and\n        tag it with ``input_dim=0`` / ``output_dim=1``; prefer that contract\n        over guessing from strides.\n        \"\"\"\n        if weight.dim() != 2:\n            return weight\n        input_dim = getattr(weight, \"input_dim\", None)\n        if input_dim == 0:\n            return weight.t()\n        if input_dim == 1:\n            return weight\n        # No dim tags: fall back to the layout the compressed-tensors schemes\n        # produce (transposed view => stride(0) == 1).\n        if weight.stride(0) == 1 and weight.stride(1) != 1:\n            return weight.t()\n        return weight\n\n    def _dequant(\n        self,\n        weight: torch.Tensor,\n        weight_scale: torch.Tensor | None,\n    ) -> torch.Tensor:\n        \"\"\"Dequantize an FP8 weight, returning a float32 [N, K] tensor.\"\"\"\n        w_nk = self._as_nk(weight)\n        if w_nk.stride(-1) != 1:\n            w_nk = w_nk.contiguous()\n        n, k = w_nk.shape\n        w_f32 = w_nk.to(torch.float32)\n\n        if weight_scale is None:\n            return w_f32\n        if weight_scale.numel() == 1:\n            return w_f32 * weight_scale.to(torch.float32).reshape(-1)[0]\n\n        scale = weight_scale.to(torch.float32).reshape(-1)\n        if scale.numel() == n:\n            return w_f32 * scale.unsqueeze(1)\n        if scale.numel() == k:\n            return w_f32 * scale.unsqueeze(0)\n        raise ValueError(\n            f\"FP8 emulation: weight_scale with {scale.numel()} elements \"\n            f\"matches neither N={n} nor K={k}.\"\n        )\n\n    def input_quant_key(self):\n        # The activation is never quantized here, so no manual-fusion partner\n        # may hoist FP8 quantization upstream of this layer.\n        return None\n\n    def process_weights_after_loading(self, layer: torch.nn.Module) -> None:\n        weight, weight_scale, _, _ = self._get_layer_params(layer)\n        if weight is None or weight.dtype not in _FP8_DTYPES:\n            # Already dequantized by an earlier pass, or never FP8 at all.\n            return\n\n        out_dtype = self.config.out_dtype or torch.get_default_dtype()\n        w_dq = self._dequant(weight, weight_scale).to(out_dtype)\n\n        self.__class__._fp8_bytes += weight.numel() * weight.element_size()\n        self.__class__._dq_bytes += w_dq.numel() * w_dq.element_size()\n        logger.info_once(\n            \"Emulating FP8 w8a8 dense linears with %s GEMM on this GPU (no \"\n            \"hardware FP8 and no torch._scaled_mm support): dequantizing \"\n            \"weights at load time. So far %.2f GiB of FP8 weights -> %.2f GiB.\",\n            str(out_dtype).replace(\"torch.\", \"\"),\n            self.__class__._fp8_bytes / 2**30,\n            self.__class__._dq_bytes / 2**30,\n            scope=\"global\",\n        )\n\n        # Store as a [N, K] parameter so apply_weights can call F.linear\n        # directly; the weight loader has already run.\n        replace_parameter(\n            layer, \"weight\", Parameter(w_dq, requires_grad=False)\n        )\n        layer.weight.input_dim = 1\n        layer.weight.output_dim = 0\n        # The scale has been folded into the weight: drop the reference so the\n        # FP8-side bookkeeping cannot be mistaken for a live quantized tensor.\n        if weight_scale is not None:\n            replace_parameter(\n                layer,\n                \"weight_scale\",\n                Parameter(torch.ones((), dtype=out_dtype), requires_grad=False),\n            )\n\n    def apply_weights(\n        self,\n        layer: torch.nn.Module,\n        x: torch.Tensor | QuantizedActivation,\n        bias: torch.Tensor | None = None,\n    ) -> torch.Tensor:\n        if isinstance(x, QuantizedActivation):\n            # Defensive only: this kernel does not advertise input_quant_key(),\n            # so manual fusion never hands us a pre-quantized activation.\n            x = (x.data.to(torch.float32) * x.scale).to(x.orig_dtype).view(\n                *x.orig_shape\n            )\n\n        weight = layer.weight\n        if weight.dtype in _FP8_DTYPES:\n            # Not pre-dequantized (process_weights_after_loading was skipped):\n            # dequantize on the fly so we never reach torch._scaled_mm.\n            _, weight_scale, _, _ = self._get_layer_params(layer)\n            weight = self._dequant(weight, weight_scale)\n\n        # F.linear needs matching dtypes; .to() is a no-op when they already do.\n        return torch.nn.functional.linear(x, weight.to(x.dtype), bias).to(x.dtype)\n\n    def apply_scaled_mm(self, **kwargs) -> torch.Tensor:\n        # This kernel overrides apply_weights and must never call\n        # torch._scaled_mm, which does not exist on pre-MI300 ROCm.\n        raise NotImplementedError(\n            \"FP8W8A8EmulationLinearKernel dequantizes and runs F.linear; \"\n            \"apply_scaled_mm is intentionally not implemented.\"\n        )\n","numLines":231,"startLine":1,"totalLines":231}}}
