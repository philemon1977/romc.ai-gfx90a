ll correctly\n+arch-gated) and landed on ``ChannelWiseTorchFP8ScaledMMLinearKernel``, whose\n+inherited ``compute capability >= 89`` gate is fooled by gfx90a reporting\n+capability ``(9, 0)`` -- so the engine aborted inside ``profile_run``.\n+\n+This kernel bridges the gap: it dequantizes the FP8 weight to the activation\n+dtype ONCE at load time and then runs a plain ``F.linear``. That is the same\n+recipe already used in-tree by\n+\n+* ``model_executor/kernels/linear/mxfp8/emulation.py`` and\n+  ``nvfp4/emulation.py`` -- dequantize, then run a plain higher-precision GEMM,\n+* ``model_executor/layers/quantization/fp8.py`` -- the ``VLLM_BATCH_INVARIANT``\n+  per-tensor / per-channel path (\"dequant to BF16 and run GEMM\").\n+\n+Why dequantize instead of writing a Triton FP8 GEMM: on gfx90a a Triton FP8\n+w8a8 ``tl.dot`` has to upconvert the operands anyway and reaches only a small\n+fraction of what a native BF16 ``torch.mm`` does, so keeping the weights in\n+FP8 to save memory would buy memory at a large dense-GEMM speed cost. Only\n+*dense* linears take this path (MoE experts keep their own kernels), so the\n+1-byte -> 2-byte growth is bounded by the non-expert parameter count.\n+\n+Accuracy: the FP8 (E4M3) -> BF16 cast is exact -- E4M3's 3+1 mantissa bits and\n+4-bit exponent both fit in BF16 -- so the only error added versus a true scaled\n+GEMM is one BF16 rounding of the dequantized weight against the ~2^-4 intrinsic\n+FP8 weight-quantization error. The activation is additionally NOT re-quantized\n+to FP8 (it stays BF16), which removes the activation-quant error term the FP8\n+path would have had.\n+\n+Opt out with ``VLLM_DISABLED_KERNELS=FP8W8A8EmulationLinearKernel``.\n+\"\"\"\n+\n+import torch\n+from torch.nn.parameter import Parameter\n+\n+from vllm.logger import init_logger\n+from vllm.model_executor.layers.fusion.quant_activation import (\n+    QuantizedActivation,\n+)\n+from vllm.model_executor.layers.quantization.utils.quant_utils import GroupShape\n+from vllm.platforms import current_platform\n+from vllm.model_executor.utils import replace_parameter\n+\n+from .ScaledMMLinearKernel import (\n+    FP8ScaledMMLinearKernel,\n+    FP8ScaledMMLinearLayerConfig,\n+)\n+\n+logger = init_logger(__name__)\n+\n+_FP8_DTYPES = (\n+    torch.float8_e4m3fn,\n+    torch.float8_e4m3fnuz,\n+    torch.float8_e5m2,\n+    torch.float8_e5m2fnuz,\n+)\n+\n+\n+def rocm_lacks_hardware_fp8() -> bool:\n+    \"\"\"True on AMD CDNA1/CDNA2 GPUs: no FP8 MMA, no ``torch._scaled_mm``.\"\"\"\n+    if not current_platform.is_rocm():\n+        return False\n+\n+    from vllm.platforms.rocm import get_cdna_version, on_cdna\n+\n+    # get_cdna_version(): gfx908 -> 1, gfx90a -> 2, gfx942 -> 3, gfx950 -> 4.\n+    # Hardware FP8 (and hence hipBLASLt FP8 scaled-mm) starts at CDNA3.\n+    return on_cdna() and get_cdna_version() < 3\n+\n+\n+class FP8W8A8EmulationLinearKernel(FP8ScaledMMLinearKernel):\n+    \"\"\"FP8 w8a8 dense linear via load-time dequant, for GPUs without FP8 HW.\"\"\"\n+\n+    # Accumulated over all rewritten layers, for one informational log line.\n+    _fp8_bytes = 0\n+    _dq_bytes = 0\n+\n+    @classmethod\n+    def is_supported(\n+        cls, compute_capability: int | None = None\n+    ) -> tuple[bool, str | None]:\n+        if not rocm_lacks_hardware_fp8():\n+            return False, (\n+                \"is only used on pre-MI300 ROCm GPUs, which have no hardware \"\n+                \"FP8 and no torch._scaled_mm support.\"\n+            )\n+        return True, None\n+\n+    @classmethod\n+    def can_implement(\n+        cls, c: FP8ScaledMMLinearLayerConfig\n+    ) -> tuple[bool, str | None]:\n+        if c.weight_quant_key.scale.group_shape.is_per_group():\n+            return False, \"cannot implement block/group-wise FP8 weights.\"\n+        if c.activation_quant_key.scale.group_shape.is_per_group():\n+            return False, \"cannot implement block/group-wise FP8 activations.\"\n+        out_dtype = c.out_dtype or torch.get_default_dtype()\n+        if not out_dtype.is_floating_point or out_dtype.itemsize < 2:\n+            return False, f\"requires a >= 2-byte floating point output dtype.\"\n+        return True, None\n+\n+    @staticmethod\n+    def _as_nk(weight: torch.Tensor) -> torch.Tensor:\n+        \"\"\"Return ``weight`` oriented as [N, K] (out_features, in_features).\n+\n+        Quant methods leave the prepared parameter transposed to [K, N] and\n+        tag it with ``input_dim=0`` / ``output_dim=1``; prefer that contract\n+        over guessing from strides.\n+        \"\"\"\n+        if weight.dim() != 2:\n+            return weight\n+        input_dim = getattr(weight, \"input_dim\", None)\n+        if input_dim == 0:\n+            return weight.t()\n+        if input_dim == 1:\n+            return weight\n+        # No dim tags: fall back to the layout the compressed-tensors schemes\n+        # produce (transposed view => stride(0) == 1).\n+        if weight.stride(0) == 1 and weight.stride(1) != 1:","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
