{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_a972288f6eae6b2c","type":"tool_result","content":"diff --git a/vllm/compilation/caching.py b/vllm/compilation/caching.py\nindex 94456fc..a6d52a4 100644\n--- a/vllm/compilation/caching.py\n+++ b/vllm/compilation/caching.py\n@@ -2,6 +2,7 @@\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n \n import contextlib\n+import functools\n import hashlib\n import inspect\n import os\n@@ -570,6 +571,76 @@ def reconstruct_serializable_fn_from_mega_artifact(\n     return fn\n \n \n+# Source directories whose *contents* change which ops/aten calls Dynamo\n+# traces into the forwarded graph, without appearing in the traced-file set\n+# recorded by an AOT artifact: the quantized-linear kernel registry\n+# (`kernels/linear/**`), the quant methods' `process_weights_after_loading`\n+# layout contracts (`layers/quantization/**`) and the MoE backend oracle\n+# (`layers/fused_moe/oracle/**`).\n+#\n+# Enabling a (model, backend) combo by swapping a kernel implementation --\n+# e.g. registering a BF16-dequant FP8 kernel on GPUs without hardware FP8 --\n+# edits exactly these files and none of the traced model files. See\n+# `_kernel_selection_hash` below for why that poisons the compile cache.\n+_KERNEL_SELECTION_DIRS: tuple[str, ...] = (\n+    \"model_executor/kernels\",\n+    \"model_executor/layers/quantization\",\n+    \"model_executor/layers/fused_moe/oracle\",\n+)\n+\n+\n+@functools.lru_cache(maxsize=1)\n+def _kernel_selection_hash() -> str:\n+    \"\"\"Digest of the kernel/quant-layout sources that shape the traced graph.\n+\n+    The AOT compile-cache key (`aot_compile_hash_factors`) covers the env,\n+    the VllmConfig and the model's forward function, and\n+    `_verify_source_unchanged` additionally re-checks the *traced* files\n+    recorded inside an existing artifact. Neither covers a very common class\n+    of change: a source edit that only alters *which* implementation gets\n+    traced, e.g. a kernel-registry / backend-selection patch.\n+\n+    Concretely, when a patch makes a linear layer dequantize its FP8 weight to\n+    BF16 [N, K] at load time, the traced model files are untouched, so the\n+    stale artifact (built for an FP8 [K, N] `aten._scaled_mm`) still verifies\n+    and is reloaded. It then calls its hard-coded `_scaled_mm` with the wrong\n+    tensor layout and dies in `profile_run` with::\n+\n+        AssertionError: expected size 2560==4096, stride 4096==1 at dim=0 ...\n+\n+    even though the eager (uncompiled) path would have run fine. Hashing these\n+    sources makes any such patch change the cache key, forcing a correct\n+    recompile instead of a silent stale-graph replay.\n+\n+    Returns an empty string (i.e. contributes nothing) if the sources cannot be\n+    read, so a failure here can never block startup.\n+    \"\"\"\n+    try:\n+        root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n+        hasher = hashlib.sha256()\n+        paths: list[str] = []\n+        for rel_dir in _KERNEL_SELECTION_DIRS:\n+            abs_dir = os.path.join(root, rel_dir.replace(\"/\", os.sep))\n+            if not os.path.isdir(abs_dir):\n+                continue\n+            for dirpath, _dirnames, filenames in os.walk(abs_dir):\n+                for name in filenames:\n+                    if name.endswith(\".py\"):\n+                        paths.append(os.path.join(dirpath, name))\n+        for path in sorted(paths):\n+            hasher.update(os.path.relpath(path, root).encode())\n+            try:\n+                with open(path, \"rb\") as f:\n+                    hasher.update(f.read())\n+            except OSError as exc:  # pragma: no cover - unreadable file\n+                logger.debug(\"compile-cache: skipping %s: %s\", path, exc)\n+                hasher.update(b\"<unreadable>\")\n+        return hasher.hexdigest()\n+    except Exception as exc:  # pragma: no cover - never block startup\n+        logger.warning(\"compile-cache: kernel-selection hash unavailable: %s\", exc)\n+        return \"\"\n+\n+\n def aot_compile_hash_factors(vllm_config: VllmConfig) -> list[str]:\n     factors = []\n     # 0. factors come from the env, for example, The values of\n@@ -586,6 +657,11 @@ def aot_compile_hash_factors(vllm_config: VllmConfig) -> list[str]:\n     if envs.VLLM_USE_MEGA_AOT_ARTIFACT:\n         factors.extend(get_inductor_factors())\n \n+    # 3. which kernel implementations exist / what layout they leave the\n+    #    weights in. Not part of the env, the config or the traced files, but\n+    #    it fully determines the traced graph -- see the docstring above.\n+    factors.append(_kernel_selection_hash())\n+\n     return factors","is_error":false}]},"parent_tool_use_id":null,"session_id":"1c4cfbc9-eb2f-4f52-bf56-a5054517960a","uuid":"70b4bf5e-4080-4c9e-a047-a0dd20bd2152","timestamp":"2026-09-15T18:00:28.609Z","tool_use_result":{"stdout":"diff --git a/vllm/compilation/caching.py b/vllm/compilation/caching.py\nindex 94456fc..a6d52a4 100644\n--- a/vllm/compilation/caching.py\n+++ b/vllm/compilation/caching.py\n@@ -2,6 +2,7 @@\n # SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n \n import contextlib\n+import functools\n import hashlib\n import inspect\n import os\n@@ -570,6 +571,76 @@ def reconstruct_serializable_fn_from_mega_artifact(\n     return fn\n \n \n+# Source directories whose *contents* change which ops/aten calls Dynamo\n+# traces into the forwarded graph, without appearing in the traced-file set\n+# recorded by an AOT artifact: the quantized-linear kernel registry\n+# (`kernels/linear/**`), the quant methods' `process_weights_after_loading`\n+# layout contracts (`layers/quantization/**`) and the MoE backend oracle\n+# (`layers/fused_moe/oracle/**`).\n+#\n+# Enabling a (model, backend) combo by swapping a kernel implementation --\n+# e.g. registering a BF16-dequant FP8 kernel on GPUs without hardware FP8 --\n+# edits exactly these 