e_masks(env: Dict[str, str]) -> Optional[str]:\\n+    \\\"\\\"\\\"Make ``HIP``/``CUDA_VISIBLE_DEVICES`` consistent with ``ROCR`` in a child env.\\n+\\n+    A launcher inherited from the harness can carry a ``HIP_VISIBLE_DEVICES`` /\\n+    ``CUDA_VISIBLE_DEVICES`` carve written in *physical* device ids, while the\\n+    benchmark config contributes ``ROCR_VISIBLE_DEVICES`` sized to ``TP``. ROCR\\n+    filters at the HSA agent layer and re-indexes what survives to ``0..n-1``, so\\n+    HIP/CUDA must then carry *logical* indices into that reduced set; forwarding\\n+    the inherited physical ids is wrong twice over. Two distinct launch failures\\n+    come out of that contradiction, both upstream of any model code:\\n+\\n+    * ``len(HIP) > len(ROCR)`` - ``torch._parse_visible_devices()`` raises\\n+      outright. vLLM calls it during ``import vllm`` (``env_override`` probes\\n+      ``torch.cuda.is_available()`` at import time), so the server dies before\\n+      binding a port and the run surfaces only as \\\"never became healthy\\\", with\\n+      nothing model-side to classify.\\n+    * equal count but out of range (``ROCR=0`` with ``HIP=2``) - does *not*\\n+      raise; it yields ``torch.cuda.is_available() == False``, so the server\\n+      fails later and far less legibly on the first device placement.\\n+\\n+    A leaked ``CUDA_VISIBLE_DEVICES`` alone is enough to reach the first case:\\n+    vLLM's ``_sync_hip_cuda_env_vars`` copies it onto ``HIP_VISIBLE_DEVICES`` at\\n+    import, and a HIP/CUDA disagreement is itself a hard ``ValueError`` there.\\n+\\n+    The InferenceX launchers already encode the intended rule -\\n+    ``benchmarks/vllm_mi300x.sh`` derives ``HIP_VISIBLE_DEVICES=0..n-1`` from\\n+    ``ROCR_VISIBLE_DEVICES`` - but guard it with ``[ -z \\\"$HIP_VISIBLE_DEVICES\\\" ]``\\n+    and so cannot fire for a value inherited from the parent environment. This is\\n+    that same reconciliation, applied at the layer that owns the merge.\\n+\\n+    Behaviour is deliberately conservative:\\n+\\n+    * acts only on a ROCm host, and only when an effective ROCR mask exists (a\\n+      config that pins nothing is the launcher's business, not ours);\\n+    * a mask already valid for the ROCR set is left untouched, so an\\n+      intentionally multi-card launch stays multi-card;\\n+    * ROCR is never modified or removed - it is the harness's own pin and is\\n+      taken as the authority the other masks are reconciled *against*;\\n+    * on a HIP/CUDA disagreement HIP wins, matching vLLM's own precedence;\\n+    * any unexpected shape returns ``None`` without touching ``env`` - env\\n+      hygiene must never itself break a launch.\\n+\\n+    Args:\\n+        env: The child environment about to be handed to the benchmark launcher.\\n+            Mutated in place when a repair is made.\\n+\\n+    Returns:\\n+        Optional[str]: Description of the repair, or ``None`` when nothing changed.\\n+    \\\"\\\"\\\"\\n+    try:\\n+        if not isinstance(env, dict):\\n+            return None\\n+\\n+        # Match case-insensitively but write through the key that exists, so a\\n+        # lower-cased entry cannot survive alongside its corrected twin.\\n+        present: Dict[str, str] = {}\\n+        for key in env:\\n+            name = str(key).upper()\\n+            if name in _ROCM_DEVICE_MASK_VARS:\\n+                present.setdefault(name, key)\\n+\\n+        def _mask(name: str) -> Optional[str]:\\n+            key = present.get(name)\\n+            if key is None:\\n+                return None\\n+            value = str(env[key] if env[key] is not None else \\\"\\\").strip()\\n+            # Empty string means \\\"unset\\\" to both ROCr and vLLM.\\n+            return value or None\\n+\\n+        rocr = _mask(\\\"ROCR_VISIBLE_DEVICES\\\")\\n+        if rocr is None:\\n+            return None\\n+\\n+        hip = _mask(\\\"HIP_VISIBLE_DEVICES\\\")\\n+        cuda = _mask(\\\"CUDA_VISIBLE_DEVICES\\\")\\n+        if hip is None and cuda is None:\\n+            # Nothing inherited to contradict: the launcher derives HIP itself.\\n+            return None\\n+\\n+        if not _gpu_is_amd():\\n+            return None\\n+\\n+        rocr_ids = [d for d in (p.strip() for p in rocr.split(\\\",\\\")) if d]\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"582fd5be-f992-4a34-84f4-93e0bf876a21\",\"uuid\":\"3fb595ad-8ac6-4acd-8a3f-3f9a66d96290\",\"timestamp\":\"2026-09-14T15:54:07.482Z\",\"tool_use_result\":{\"stdout\":\"diff --git a/Magpie/modes/benchmark/benchmarker.py b/Magpie/modes/benchmark/benchmarker.py\\nindex 6b44089..fef6869 100644\\n--- a/Magpie/modes/benchmark/benchmarker.py\\n+++ b/Magpie/modes/benchmark/benchmarker.py\\n@@ -56,6 +56,164 @@ MAGPIE_BUILTIN_SCRIPTS = frozenset(\\n     }\\n )\\n \\n+# Cached once: the vendor probe shells out to ``rocminfo``, and the reconciliation\\n+# below runs on every local benchmark invocation.\\n+_GPU_VENDOR_CACHE: Optional[Tuple[Any, Any]] = None\\n+\\n+# Visible-device masks on a ROCm host, outermost (inherited) first.\\n+_ROCM_DEVICE_MASK_VARS: Tuple[str, ...] = (\\n+    \\\"ROCR_VISIBLE_DEVICES\\\",\\n+    \\\"HIP_VISIBLE_DEVICES\\\",\\n+    \\\"CUDA_VISIBLE_DEVICES\\\",\\n+)\\n+\\n+\\n+def _gpu_is_amd() -> bool:\\n+    \\\"\\\"\\\"True on a ROCm host, using Magpie's own vendor probe (cached).\\n+\\n+    Returns:\\n+        bool: False whenever the vendor cannot be established, so an\\n+        unidentifiable host is left exactly as the caller configured it.\\n+    \\\"\\\"\\\"\\n+    global _GPU_VENDOR_CACHE\\n+    if _GPU_VENDOR_CACHE is None:\\n+        try:\\n+            _GPU_VENDOR_CACHE = detect_gpu()\\n+        except Exception:\\n+            logger.debug(\\\"detect_gpu() failed; skipping device-mask reconciliation\\\")\\n+            _GPU_VENDOR_CACHE = (GPUVendor.UNKNOWN, None)\\n+    return _GPU_VENDOR_CACHE[0] == GPUVendor.AMD\\n+\\n+\\n+def _reconcile_rocm_device_masks(env: Dict[str, str]) -> Optional[str]:\\n+    \\\"\\\"\\\"Make ``HIP``/``CUDA_VISIBLE_DEVICES`` consistent with ``ROCR`` in a child env.\\n+\\n+    A launcher inherited from the harness can carry a ``HIP_VISIBLE_DEVICES`` /\\n+    ``CUDA_VISIBLE_DEVICES`` carve written in *physical* device ids, while the\\n+    benchmark config contributes ``ROCR_VISIBLE_DEVICES`` sized to ``TP``. ROCR\\n+    filters at the HSA agent layer and re-indexes what survives to ``0..n-1``, so\\n+    HIP/CUDA must then carry *logical* indices into that reduced set; forwarding\\n+    the inherited physical ids is wrong twice over. Two distinct launch failures\\n+    come out of that contradiction, both upstream of any model code:\\n+\\n+    * ``len(HIP) > len(ROCR)`` - ``torch._parse_visible_devices()`` raises\\n+      outright. vLLM calls it during ``import vllm`` (``env_override`` probes\\n+      ``torch.cuda.is_available()`` at import time), so the server dies before\\n+      binding a port and the run surfaces only as \\\"never became healthy\\\", with\\n+      nothing model-side to classify.\\n+    * equal count but out of range (``ROCR=0`` with ``HIP=2``) - does *not*\\n+      raise; it yields ``torch.cuda.is_available() == False``, so the server\\n+      fails later and far less legibly on the first device placement.\\n+\\n+    A leaked ``CUDA_VISIBLE_DEVICES`` alone is enough to reach the first case:\\n+    vLLM's ``_sync_hip_cuda_env_vars`` copies it onto ``HIP_VISIBLE_DEVICES`` at\\n+    import, and a HIP/CUDA disagreement is itself a hard ``ValueError`` there.\\n+\\n+    The InferenceX launchers already encode the intended rule -\\n+    ``benchmarks/vllm_mi300x.sh`` derives ``HIP_VISIBLE_DEVICES=0..n-1`` from\\n+    ``ROCR_VISIBLE_DEVICES`` - but guard it with ``[ -z \\\"$HIP_VISIBLE_DEVICES\\\" ]``\\n+    and so cannot fire for a value inherited from the parent environment. This is\\n+    that same reconciliation, applied at the layer that owns the merge.\\n+\\n+    Behaviour is deliberately conservative:\\n+\\n+    * acts only on a ROCm host, and only when an effective ROCR mask exists (a\\n+      config that pins nothing is the launcher's business, not ours);\\n+    * a mask already valid for the ROCR set is left untouched, so an\\n+      intentionally multi-card launch stays multi-card;\\n+    * ROCR is never modified or removed - it is the harness's own pin and is\\n+      taken as the authority the other masks are reconciled *against*;\\n+    * on a HIP/CUDA disagreement HIP wins, matching vLLM's own precedence;\\n+    * any unexpected shape returns ``None`` without touching ``env`` - env\\n+      hygiene must never itself break a launch.\\n+\\n+    Args:\\n+        env: The child environment about to be handed to the benchmark launcher.\\n+            Mutated in place when a repair is made.\\n+\\n+    Returns:\\n+        Optional[str]: Description of the repair, or ``None`` when nothing changed.\\n+    \\\"\\\"\\\"\\n+    try:\\n+        if not isinstance(env, dict):\\n+            return None\\n+\\n+        # Match case-insensitively but write through the key that exists, so a\\n+        # lower-cased entry cannot survive alongside its corrected twin.\\n+        present: Dict[str, str] = {}\\n+        for key in env:\\n+            name = str(key).upper()\\n+            if name in _ROCM_DEVICE_MASK_VARS:\\n+                present.setdefault(name, key)\\n+\\n+        def _mask(name: str) -> Optional[str]:\\n+            key = present.get(name)\\n+            if key is None:\\n+                return None\\n+            value = str(env[key] if env[key] is not None else \\\"\\\").strip()\\n+            # Empty string means \\\"unset\\\" to both ROCr and vLLM.\\n+            return value or None\\n+\\n+        rocr = _mask(\\\"ROCR_VISIBLE_DEVICES\\\")\\n+        if rocr is None:\\n+            return None\\n+\\n+        hip = _mask(\\\"HIP_VISIBLE_DEVICES\\\")\\n+        cuda = _mask(\\\"CUDA_VISIBLE_DEVICES\\\")\\n+        if hip is None and cuda is None:\\n+            # Nothing inherited to contradict: the launcher derives HIP itself.\\n+            return None\\n+\\n+        if not _gpu_is_amd():\\n+            return None\\n+\\n+        rocr_ids = [d for d in (p.strip() for p in rocr.split(\\\",\\\")) if d]\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n{\"type\":\"assistant\",\"message\":{\"id\":\"msg_4d7ff7dd-1dd6-49ed-ac76-117dfb82adaa\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"call_bf71bdeca1ff5491\",\"name\":\"Bash\",\"input\":{\"command\":\"cd /home/qiba/ROCm.AI/hyperloom/session/Qwen3.8-27B-ABLITERATED-W8A8-gdnint8/20260914T134902Z-244d9455/ && ls -la && echo \\\"=== RUNS ===\\\" && ls -la runs/ 2>&1 | head -40\",\"description\":\"Explore session dir\"}}],\"model\":\"qwen3.8-flash-next\",\"stop_reason\":null,\"stop_sequence\":null,\"usage\":{\"input_tokens\":0,\"output_tokens\":0,\"cache_creation_input_tokens\":0,\"cache_read_input_tokens\":0},\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"582fd5be-f992-4a34-84f4-93e0bf876a21\",\"uuid\":\"d5da5383-ae33-4433-83f9-a2f6c9022321\"}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"call_bf71bdeca1ff5491\",\"type\":\"tool_result\",\"content\":\"total 160\\ndrwxr-xr-x 19 root root  4096 Sep 14 15:52 .\\ndrwxr-xr-x  3 root root  4096 Sep 14 13:49 ..\\ndrwxr-xr-x  5 root root  4096 Sep 14 13:49 agents\\ndrwxr-xr-x  2 root root  4096 Sep 14 13:49 checkpoints\\ndrwxr-xr-x  3 root root  4096 Sep 14 13:49 critic-session-memory\\ndrwxr-xr-x  7 root root  4096 Sep 14 15:15 critic-workdir\\ndrwxr-xr-x  2 root root  4096 Sep 14 13:49 findings\\ndrwxr-xr-x  2 root root  4096 Sep 14 13:49 kb\\ndrwxr-xr-x  2 root root  4096 Sep 14 13:49 kernel-agent\\ndrwxr-xr-x  2 root root  4096 Sep 14 13:49 kernel-agent-workspace\\n-rw-------  1 root root  1962 Sep 14 13:49 manifest.json\\n-rw-r--r--  1 root root  2311 Sep 14 13:49 model_arch.json\\ndr