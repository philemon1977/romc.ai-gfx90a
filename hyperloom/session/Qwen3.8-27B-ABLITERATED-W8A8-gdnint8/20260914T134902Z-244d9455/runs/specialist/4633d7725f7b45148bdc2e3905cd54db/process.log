{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_aaac4bc67ac5d970","type":"tool_result","content":"1040\t        \"ISL\",\n1041\t        \"OSL\",\n1042\t        \"MAX_MODEL_LEN\",\n1043\t        \"TP\",\n1044\t        \"PORT\",\n1045\t    ):\n1046\t        val = os.environ.get(env_key, \"\").strip()\n1047\t        if val:\n1048\t            envs[env_key] = _coerce_workload_int_env(env_key, val)\n1049\t    # RANDOM_RANGE_RATIO is a float feeding the steady-state formulas below; do\n1050\t    # NOT coerce to int.\n1051\t    r_env = os.environ.get(\"RANDOM_RANGE_RATIO\", \"\").strip()\n1052\t    if r_env:\n1053\t        envs[\"RANDOM_RANGE_RATIO\"] = float(r_env)\n1054\t    rocr_env = os.environ.get(\"ROCR_VISIBLE_DEVICES\", \"\").strip()\n1055\t    if rocr_env:\n1056\t        envs[\"ROCR_VISIBLE_DEVICES\"] = rocr_env\n1057\t    tp_from_env = os.environ.get(\"TP\", \"\").strip()\n1058\t    tp_from_yaml = envs.get(\"TP\")\n1059\t    rocr_yaml = str(envs.get(\"ROCR_VISIBLE_DEVICES\") or \"\").strip()\n1060\t    rocr_devices = [d.strip() for d in rocr_yaml.split(\",\") if d.strip()]\n1061\t    if tp_from_env:\n1062\t        resolved_tp = int(tp_from_env)\n1063\t    elif rocr_yaml and not tp_from_yaml:\n1064\t        # Derive TP from the user-pinned GPU list when the YAML doesn't set TP.\n1065\t        resolved_tp = len(rocr_devices)\n1066\t        envs[\"TP\"] = resolved_tp\n1067\t    else:\n1068\t        resolved_tp = int(tp_from_yaml or 1)\n1069\t    # Auto-clamp TP to the visible GPU count. Override via\n1070\t    # $INFERENCE_OPTIMIZER_DISABLE_TP_CLAMP=1.\n1071\t    if os.environ.get(\"INFERENCE_OPTIMIZER_DISABLE_TP_CLAMP\", \"\").strip() != \"1\":\n1072\t        visible = _visible_gpu_count()\n1073\t        if visible and resolved_tp > visible:\n1074\t            log.warning(\n1075\t                \"TP=%d but only %d GPU(s) visible to this pod; clamping \"\n1076\t                \"TP=%d so sglang/vllm can actually load weights. Export \"\n1077\t                \"INFERENCE_OPTIMIZER_DISABLE_TP_CLAMP=1 to opt out (the \"\n1078\t                \"subprocess will then fail at server launch).\",\n1079\t                resolved_tp,\n1080\t                visible,\n1081\t                visible,\n1082\t            )\n1083\t            resolved_tp = visible\n1084\t    envs[\"TP\"] = resolved_tp\n1085\t    if not rocr_yaml or len(rocr_devices) < resolved_tp:\n1086\t        derived = \",\".join(str(i) for i in range(resolved_tp))\n1087\t        if rocr_yaml and rocr_yaml != derived:\n1088\t            log.warning(\n1089\t                \"ROCR_VISIBLE_DEVICES=%r has %d devices but TP=%d; \"\n1090\t                \"expanding to %r so SGLang sees enough GPUs. Set \"\n1091\t                \"ROCR_VISIBLE_DEVICES explicitly to override.\",\n1092\t                rocr_yaml,\n1093\t                len(rocr_devices),\n1094\t                resolved_tp,\n1095\t                derived,\n1096\t            )\n1097\t        envs[\"ROCR_VISIBLE_DEVICES\"] = derived\n1098\t\n1099\t    # Last-resort fallbacks kept in sync with the CLI workload defaults\n1100\t    # (parser.DEFAULT_ISL/OSL/CONC); normally the CLI has already projected the\n1101\t    # resolved values into these envs before materialization."}]},"parent_tool_use_id":null,"session_id":"0475c2f4-1a0e-481c-86a6-d19f3a20bb66","uuid":"7f5fb152-a62e-472e-878d-998f27ccc893","timestamp":"2026-09-14T16:26:42.953Z","tool_use_result":{"type":"text","file":{"filePath":"/home/qiba/ROCm.AI/hyperloom/session/Qwen3.8-27B-ABLITERATED-W8A8-gdnint8/20260914T134902Z-244d9455/runs/specialist/4633d7725f7b45148bdc2e3905cd54db/wt/hyperloom/orchestrator/actions/executors/_workload_envs.py","content":"        \"ISL\",\n        \"OSL\",\n        \"MAX_MODEL_LEN\",\n        \"TP\",\n        \"PORT\",\n    ):\n        val = os.environ.get(env_key, \"\").strip()\n        if val:\n            envs[env_key] = _coerce_workload_int_env(env_key, val)\n    # RANDOM_RANGE_RATIO is a float feeding the steady-state formulas below; do\n    # NOT coerce to int.\n    r_env = os.environ.get(\"RANDOM_RANGE_RATIO\", \"\").strip()\n    if r_env:\n        envs[\"RANDOM_RANGE_RATIO\"] = float(r_env)\n    rocr_env = os.environ.get(\"ROCR_VISIBLE_DEVICES\", \"\").strip()\n    if rocr_env:\n        envs[\"ROCR_VISIBLE_DEVICES\"] = rocr_env\n    tp_from_env = os.environ.get(\"TP\", \"\").strip()\n    tp_from_yaml = envs.get(\"TP\")\n    rocr_yaml = str(envs.get(\"ROCR_VISIBLE_DEVICES\") or \"\").strip()\n    rocr_devices = [d.strip() for d in rocr_yaml.split(\",\") if d.strip()]\n    if tp_from_env:\n        resolved_tp = int(tp_from_env)\n    elif rocr_yaml and not tp_from_yaml:\n        # Derive TP from the user-pinned GPU list when the YAML doesn't set TP.\n        resolved_tp = len(rocr_devices)\n        envs[\"TP\"] = resolved_tp\n    else:\n        resolved_tp = int(tp_from_yaml or 1)\n    # Auto-clamp TP to the visible GPU count. Override via\n    # $INFERENCE_OPTIMIZER_DISABLE_TP_CLAMP=1.\n    if os.environ.get(\"INFERENCE_OPTIMIZER_DISABLE_TP_CLAMP\", \"\").strip() != \"1\":\n        visible = _visible_gpu_count()\n        if visible and resolved_tp > visible:\n            log.warning(\n                \"TP=%d but only %d GPU(s) visible to this pod; clamping \"\n                \"TP=%d so sglang/vllm can actually load weights. Export \"\n                \"INFERENCE_OPTIMIZER_DISABLE_TP_CLAMP=1 to opt out (the \"\n                \"subprocess will then fail at server launch).\",\n                resolved_tp,\n                visible,\n                visible,\n            )\n            resolved_tp = visible\n    envs[\"TP\"] = resolved_tp\n    if not rocr_yaml or len(rocr_devices) < resolved_tp:\n        derived = \",\".join(str(i) for i in range(resolved_tp))\n        if rocr_yaml and rocr_yaml != derived:\n            log.warning(\n                \"ROCR_VISIBLE_DEVICES=%r has %d devices but TP=%d; \"\n                \"expanding to %r so SGLang sees enough GPUs. Set \"\n                \"ROCR_VISIBLE_DEVICES explicitly to override.\",\n                rocr_yaml,\n                len(rocr_devices),\n                resolved_tp,\n                derived,\n            )\n        envs[\"ROCR_VISIBLE_DEVICES\"] = derived\n\n    # Last-resort fallbacks kept in sync with the CLI workload defaults\n    # (parser.DEFAULT_ISL/OSL/CONC); normally the CLI has already projected the\n    # resolved values into these envs before materialization.","numLines":62,"startLine":1040,"totalLines":1897}}}
