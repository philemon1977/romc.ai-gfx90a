{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_98a76a842859b426","type":"tool_result","content":"diff --git a/Magpie/modes/benchmark/benchmarker.py b/Magpie/modes/benchmark/benchmarker.py\nindex 6b44089..fef6869 100644\n--- a/Magpie/modes/benchmark/benchmarker.py\n+++ b/Magpie/modes/benchmark/benchmarker.py\n@@ -56,6 +56,164 @@ MAGPIE_BUILTIN_SCRIPTS = frozenset(\n     }\n )\n \n+# Cached once: the vendor probe shells out to ``rocminfo``, and the reconciliation\n+# below runs on every local benchmark invocation.\n+_GPU_VENDOR_CACHE: Optional[Tuple[Any, Any]] = None\n+\n+# Visible-device masks on a ROCm host, outermost (inherited) first.\n+_ROCM_DEVICE_MASK_VARS: Tuple[str, ...] = (\n+    \"ROCR_VISIBLE_DEVICES\",\n+    \"HIP_VISIBLE_DEVICES\",\n+    \"CUDA_VISIBLE_DEVICES\",\n+)\n+\n+\n+def _gpu_is_amd() -> bool:\n+    \"\"\"True on a ROCm host, using Magpie's own vendor probe (cached).\n+\n+    Returns:\n+        bool: False whenever the vendor cannot be established, so an\n+        unidentifiable host is left exactly as the caller configured it.\n+    \"\"\"\n+    global _GPU_VENDOR_CACHE\n+    if _GPU_VENDOR_CACHE is None:\n+        try:\n+            _GPU_VENDOR_CACHE = detect_gpu()\n+        except Exception:\n+            logger.debug(\"detect_gpu() failed; skipping device-mask reconciliation\")\n+            _GPU_VENDOR_CACHE = (GPUVendor.UNKNOWN, None)\n+    return _GPU_VENDOR_CACHE[0] == GPUVendor.AMD\n+\n+\n+def _reconcile_rocm_device_masks(env: Dict[str, str]) -> Optional[str]:\n+    \"\"\"Make ``HIP``/``CUDA_VISIBLE_DEVICES`` consistent with ``ROCR`` in a child env.\n+\n+    A launcher inherited from the harness can carry a ``HIP_VISIBLE_DEVICES`` /\n+    ``CUDA_VISIBLE_DEVICES`` carve written in *physical* device ids, while the\n+    benchmark config contributes ``ROCR_VISIBLE_DEVICES`` sized to ``TP``. ROCR\n+    filters at the HSA agent layer and re-indexes what survives to ``0..n-1``, so\n+    HIP/CUDA must then carry *logical* indices into that reduced set; forwarding\n+    the inherited physical ids is wrong twice over. Two distinct launch failures\n+    come out of that contradiction, both upstream of any model code:\n+\n+    * ``len(HIP) > len(ROCR)`` - ``torch._parse_visible_devices()`` raises\n+      outright. vLLM calls it during ``import vllm`` (``env_override`` probes\n+      ``torch.cuda.is_available()`` at import time), so the server dies before\n+      binding a port and the run surfaces only as \"never became healthy\", with\n+      nothing model-side to classify.\n+    * equal count but out of range (``ROCR=0`` with ``HIP=2``) - does *not*\n+      raise; it yields ``torch.cuda.is_available() == False``, so the server\n+      fails later and far less legibly on the first device placement.\n+\n+    A leaked ``CUDA_VISIBLE_DEVICES`` alone is enough to reach the first case:\n+    vLLM's ``_sync_hip_cuda_env_vars`` copies it onto ``HIP_VISIBLE_DEVICES`` at\n+    import, and a HIP/CUDA disagreement is itself a hard ``ValueError`` there.\n+\n+    The InferenceX launchers already encode the intended rule -\n+    ``benchmarks/vllm_mi300x.sh`` derives ``HIP_VISIBLE_DEVICES=0..n-1`` from\n+    ``ROCR_VISIBLE_DEVICES`` - but guard it with ``[ -z \"$HIP_VISIBLE_DEVICES\" ]``\n+    and so cannot fire for a value inherited from the parent environment. This is\n+    that same reconciliation, applied at the layer that owns the merge.\n+\n+    Behaviour is deliberately conservative:\n+\n+    * acts only on a ROCm host, and only when an effective ROCR mask exists (a\n+      config that pins nothing is the launcher's business, not ours);\n+    * a mask already valid for the ROCR set is left untouched, so an\n+      intentionally multi-card launch stays multi-card;\n+    * ROCR is never modified or removed - it is the harness's own pin and is\n+      taken as the authority the other masks are reconciled *against*;\n+    * on a HIP/CUDA disagreement HIP wins, matching vLLM's own precedence;\n+    * any unexpected shape returns ``None`` without touching ``env`` - env\n+      hygiene must never itself break a launch.\n+\n+    Args:\n+        env: The child environment about to be handed to the benchmark launcher.\n+            Mutated in place when a repair is made.\n+\n+    Returns:\n+        Optional[str]: Description of the repair, or ``None`` when nothing changed.\n+    \"\"\"\n+    try:\n+        if not isinstance(env, dict):\n+            return None\n+\n+        # Match case-insensitively but write through the key that exists, so a\n+        # lower-cased entry cannot survive alongside its corrected twin.\n+        present: Dict[str, str] = {}\n+        for key in env:\n+            name = str(key).upper()\n+            if name in _ROCM_DEVICE_MASK_VARS:\n+                present.setdefault(name, key)\n+\n+        def _mask(name: str) -> Optional[str]:\n+            key = present.get(name)\n+            if key is None:\n+                return None\n+            value = str(env[key] if env[key] is not None else \"\").strip()\n+            # Empty string means \"unset\" to both ROCr and vLLM.\n+            return value or None\n+\n+        rocr = _mask(\"ROCR_VISIBLE_DEVICES\")\n+        if rocr is None:\n+            return None\n+\n+        hip = _mask(\"HIP_VISIBLE_DEVICES\")\n+        cuda = _mask(\"CUDA_VISIBLE_DEVICES\")\n+        if hip is None and cuda is None:\n+            # Nothing inherited to contradict: the launcher derives HIP itself.\n+            return None\n+\n+        if not _gpu_is_amd():\n+            return None\n+\n+        rocr_ids = [d for d in (p.strip() for p in rocr.split(\",\")) if d]\n+        count = len(rocr_ids)\n+        if count == 0:\n+            return None\n+        logical = \",\".join(str(i) for i in range(count))\n+\n+        def _valid(mask: str) -> bool:\n+            \"\"\"True when ``mask`` indexes the re-indexed set without exceeding it.\"\"\"\n+            parts = [d for d in (p.strip() for p in mask.split(\",\")) if d]\n+            if not parts or len(parts) > count:\n+                return False\n+            # Non-numeric entries are UUIDs; leave those to the runtime.\n+            return all(not d.isdigit() or int(d) < count for d in parts)\n+\n+        fixed: Dict[str, str] = {}\n+        for name, mask in (\n+            (\"HIP_VISIBLE_DEVICES\", hip),\n+            (\"CUDA_VISIBLE_DEVICES\", cuda),\n+        ):\n+            if mask is not None and not _valid(mask):\n+                fixed[name] = logical\n+        if (\n+            \"HIP_VISIBLE_DEVICES\" not in fixed\n+            and hip is not None\n+            and cuda is not None\n+            and hip != cuda\n+        ):\n+            # vLLM raises on the pair disagreeing even when both are in range.\n+            fixed[\"CUDA_VISIBLE_DEVICES\"] = hip\n+\n+        if not fixed:\n+            return None\n+\n+        changes = []\n+        for name, value in fixed.items():\n+            key = present.get(name, name)\n+            before = env.get(key)\n+            env[key] = value\n+            changes.append(f\"{name}: {before!r} -> {value!r}\")\n+        return (\n+            f\"ROCR_VISIBLE_DEVICES={rocr!r} re-indexes the visible set to \"\n+            f\"0..{count - 1}; reconciled \" + \"; \".join(changes)\n+        )\n+    except Exception:  # pragma: no cover - env hygiene must never break a launch\n+        logger.debug(\"device-mask reconciliation skipped\", exc_info=True)\n+        return None\n+\n \n class BenchmarkMode:\n     \"\"\"\n@@ -800,6 +958,15 @@ class BenchmarkMode:\n         for key, value in env_vars.items():\n             env[key] = str(value)\n \n+        # ``env`` started as ``os.environ.copy()``, so any device mask the harness\n+        # exported (typically a physical HIP/CUDA carve) is in it right next to\n+        # the ROCR pin this config just wrote. Reconcile them before the launcher\n+        # inherits the pair; the launcher's own derivation only covers the case\n+        # where HIP arrives unset.\n+        repair = _reconcile_rocm_device_masks(env)\n+        if repair:\n+            logger.warning(\"Device-mask reconciliation for local run: %s\", repair)\n+\n         return cmd, env\n \n     def _execute_local_benchmark_with_reuse(","is_error":false}]},"parent_tool_use_id":null,"session_id":"0475c2f4-1a0e-481c-86a6-d19f3a20bb66","uuid":"4f9f84de-a67a-45ba-af03-c95bea40a636","timestamp":"2026-09-14T16:09:22.970Z","tool_use_result":{"stdout":"diff --git a/Magpie/modes/benchmark/benchmarker.py b/Magpie/modes/benchmark/benchmarker.py\nindex 6b44089..fef6869 100644\n--- a/Magpie/modes/benchmark/benchmarker.py\n+++ b/Magpie/modes/benchmark/benchmarker.py\n@@ -56,6 +56,164 @@ MAGPIE_BUILTIN_SCRIPTS = frozenset(\n     }\n )\n \n+# Cached once: the vendor probe shells out to ``rocminfo``, and the reconciliation\n+# below runs on every local benchmark invocation.\n+_GPU_VENDOR_CACHE: Optional[Tuple[Any, Any]] = None\n+\n+# Visible-device masks on a ROCm host, outermost (inherited) first.\n+_ROCM_DEVICE_MASK_VARS: Tuple[str, ...] = (\n+    \"ROCR_VISIBLE_DEVICES\",\n+    \"HIP_VISIBLE_DEVICES\",\n+    \"CUDA_VISIBLE_DEVICES\",\n+)\n+\n+\n+def _gpu_is_amd() -> bool:\n+    \"\"\"True on a ROCm host, using Magpie's own vendor probe (cached).\n+\n+    Returns:\n+        bool: False whenever the vendor cannot be established, so an\n+        unidentifiable host is left exactly as the caller configured it.\n+    \"\"\"\n+    global _GPU_VENDOR_CACHE\n+    if _GPU_VENDOR_CACHE is None:\n+        try:\n+            _GPU_VENDOR_CACHE = detect_gpu()\n+        except Exception:\n+            logger.debug(\"detect_gpu() failed; skipping device-mask reconciliation\")\n+            _GPU_VENDOR_CACHE = (GPUVendor.UNKNOWN, None)\n+    return _GPU_VENDOR_CACHE[0] == GPUVendor.AMD\n+\n+\n+def _reconcile_rocm_device_masks(env: Dict[str, str]) -> Optional[str]:\n+    \"\"\"Make ``HIP``/``CUDA_VISIBLE_DEVICES`` consistent with ``ROCR`` in a child env.\