{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_94fabed87b1f6001","type":"tool_result","content":"200\t    result = chunk_gated_delta_rule_fi(\n201\t        q=q,\n202\t        k=k,\n203\t        v=v,\n204\t        g=torch.exp(fi_g),\n205\t        beta=fi_beta,\n206\t        initial_state=fi_state,\n207\t        output_final_state=output_final_state,\n208\t        cu_seqlens=cu_seqlens,\n209\t    )\n210\t    # FlashInfer returns (output, state) when output_final_state=True,\n211\t    # or just output when output_final_state=False.\n212\t    # Unsqueeze back to 4D (1, L, H, D) to match fla output format\n213\t    if output_final_state:\n214\t        output, final_state = result\n215\t        return output.unsqueeze(0), final_state\n216\t    else:\n217\t        return result.unsqueeze(0), None\n218\t\n219\t\n220\t@CustomOp.register(\"chunk_gated_delta_rule\")\n221\tclass ChunkGatedDeltaRule(CustomOp):\n222\t    def __init__(self) -> None:\n223\t        super().__init__()\n224\t        vllm_config = get_current_vllm_config()\n225\t        backend, active_backend = _resolve_gdn_prefill_backend(vllm_config)\n226\t        self.gdn_prefill_backend = active_backend\n227\t\n228\t        if backend in (\"flashinfer\", \"cutedsl\") and active_backend != backend:\n229\t            logger.warning_once(\n230\t                \"GDN prefill backend '%s' is selected but cannot use this \"\n231\t                \"kernel on the current platform. Falling back to Triton/FLA.\",\n232\t                backend,\n233\t            )\n234\t        _log_gdn_backend_decision(vllm_config, backend, active_backend)\n235\t\n236\t        if active_backend == \"flashinfer\":\n237\t            self._forward_method = self.forward_cuda\n238\t        elif active_backend == \"cutedsl\":\n239\t            self._forward_method = self.forward_cutedsl\n240\t        else:\n241\t            self._forward_method = self.forward_native\n242\t\n243\t    def forward_cuda(\n244\t        self,\n245\t        q: torch.Tensor,\n246\t        k: torch.Tensor,\n247\t        v: torch.Tensor,\n248\t        g: torch.Tensor,\n249\t        beta: torch.Tensor,\n250\t        initial_state: torch.Tensor,\n251\t        output_final_state: bool,\n252\t        cu_seqlens: torch.Tensor | None = None,\n253\t        chunk_indices: torch.Tensor | None = None,\n254\t        chunk_offsets: torch.Tensor | None = None,\n255\t        use_qk_l2norm_in_kernel: bool = True,\n256\t        core_attn_out: torch.Tensor | None = None,\n257\t    ):\n258\t        o, final_state = fi_chunk_gated_delta_rule(\n259\t            q=q,\n260\t            k=k,\n261\t            v=v,\n262\t            g=g,\n263\t            beta=beta,\n264\t            initial_state=initial_state,\n265\t            output_final_state=output_final_state,\n266\t            cu_seqlens=cu_seqlens,\n267\t            use_qk_l2norm_in_kernel=use_qk_l2norm_in_kernel,\n268\t        )\n269\t        if core_attn_out is not None:\n270\t            o_flat = o.squeeze(0).reshape(-1)\n271\t            co_flat = core_attn_out.reshape(-1)\n272\t            co_flat[: o_flat.numel()].copy_(o_flat)\n273\t        return o, final_state\n274\t\n275\t    def forward_native(\n276\t        self,\n277\t        q: torch.Tensor,\n278\t        k: torch.Tensor,\n279\t        v: torch.Tensor,\n280\t        g: torch.Tensor,\n281\t        beta: torch.Tensor,\n282\t        initial_state: torch.Tensor,\n283\t        output_final_state: bool,\n284\t        cu_seqlens: torch.Tensor | None = None,\n285\t        chunk_indices: torch.Tensor | None = None,\n286\t        chunk_offsets: torch.Tensor | None = None,\n287\t        use_qk_l2norm_in_kernel: bool = True,\n288\t        core_attn_out: torch.Tensor | None = None,\n289\t    ):\n290\t        return fla_chunk_gated_delta_rule(\n291\t            q=q,\n292\t            k=k,\n293\t            v=v,\n294\t            g=g,\n295\t            beta=beta,\n296\t            initial_state=initial_state,\n297\t            output_final_state=output_final_state,\n298\t            cu_seqlens=cu_seqlens,\n299\t            chunk_indices=chunk_indices,\n300\t            chunk_offsets=chunk_offsets,\n301\t            use_qk_l2norm_in_kernel=use_qk_l2norm_in_kernel,\n302\t            core_attn_out=core_attn_out,\n303\t        )\n304\t\n305\t    def forward_cutedsl(\n306\t        self,\n307\t        q: torch.Tensor,\n308\t        k: torch.Tensor,\n309\t        v: torch.Tensor,\n310\t        g: torch.Tensor,\n311\t        beta: torch.Tensor,\n312\t        initial_state: torch.Tensor,\n313\t        output_final_state: bool,\n314\t        cu_seqlens: torch.Tensor | None = None,\n315\t        chunk_indices: torch.Tensor | None = None,\n316\t        chunk_offsets: torch.Tensor | None = None,\n317\t        use_qk_l2norm_in_kernel: bool = True,\n318\t        core_attn_out: torch.Tensor | None = None,\n319\t    ):\n320\t        from vllm.model_executor.layers.mamba.ops.gdn_chunk_cutedsl import (\n321\t            chunk_gated_delta_rule_cutedsl,\n322\t        )\n323\t\n324\t        if use_qk_l2norm_in_kernel:\n325\t            q = l2norm_fwd(q)\n326\t            k = l2norm_fwd(k)\n327\t\n328\t        assert cu_seqlens is not None\n329\t        assert chunk_indices is not None\n330\t        assert chunk_offsets is not None\n331\t\n332\t        o, final_state = chunk_gated_delta_rule_cutedsl(\n333\t            q=q,\n334\t            k=k,\n335\t            v=v,\n336\t            g=g,\n337\t            beta=beta,\n338\t            initial_state=initial_state,\n339\t            cu_seqlens=cu_seqlens,\n340\t            chunk_indices=chunk_indices,\n341\t            chunk_offsets=chunk_offsets,\n342\t            core_attn_out=core_attn_out,\n343\t        )\n344\t        if not output_final_state:\n345\t            final_state = None\n346\t        return o, final_state\n347\t\n348\t\n349\t@PluggableLayer.register(\"qwen_gated_delta_net_attention\")\n350\tclass QwenGatedDeltaNetAttention(GatedDeltaNetAttention):\n351\t    def get_state_shape(\n352\t        self,\n353\t    ) -> tuple[tuple[int, ...], tuple[int, ...], tuple[int, ...], tuple[int, ...]]:\n354\t        return MambaStateShapeCalculator.gated_delta_net_state_shape(\n355\t            self.tp_size,\n356\t            self.num_k_heads,\n357\t            self.num_v_heads,\n358\t            self.head_k_dim,\n359\t            self.head_v_dim,\n360\t            self.conv_kernel_size,\n361\t            self.num_spec,\n362\t        )\n363\t\n364\t    def __init__(\n365\t        self,\n366\t        config: Qwen3NextConfig,\n367\t        vllm_config: VllmConfig,\n368\t        prefix: str = \"\",\n369\t        gqa_interleaved_layout=False,\n370\t        reduce_results: bool = True,\n371\t    ) -> None:\n372\t        super().__init__(config, vllm_config, prefix)\n373\t\n374\t        self.num_k_heads = config.linear_num_key_heads\n375\t        self.num_v_heads = config.linear_num_value_heads\n376\t        self.head_k_dim = config.linear_key_head_dim\n377\t        self.head_v_dim = config.linear_value_head_dim\n378\t        self.conv_kernel_size = config.linear_conv_kernel_dim\n379\t        self.key_dim = self.head_k_dim * self.num_k_heads\n380\t        self.value_dim = self.head_v_dim * self.num_v_heads\n381\t        self.gqa_interleaved_layout = gqa_interleaved_layout\n382\t        if current_platform.is_xpu():\n383\t            self._forward_method = self.forward_xpu\n384\t        elif current_platform.is_cpu():\n385\t            from vllm.model_executor.layers.mamba.ops.cpu.gdn_attention import (\n386\t                register_cpu_gdn_attention_ops,\n387\t            )\n388\t\n389\t            register_cpu_gdn_attention_ops()\n390\t            self._forward_method = self.forward_cpu\n391\t        elif current_platform.is_rocm():\n392\t            self._forward_method = self.forward_hip\n393\t        else:\n394\t            self._forward_method = self.forward_cuda\n395\t\n396\t        # QKV\n397\t        self.conv_dim = self.key_dim * 2 + self.value_dim\n398\t        self.conv1d = ColumnParallelLinear(\n399\t            input_size=self.conv_kernel_size,\n400\t            output_size=self.conv_dim,\n401\t            bias=False,\n402\t            prefix=f\"{prefix}.conv1d\",\n403\t        )\n404\t        self.conv1d.weight.data = self.conv1d.weight.data.unsqueeze(1)\n405\t\n406\t        # projection of the input hidden states\n407\t        # Qwen3-Next and Qwen3.5 has a different qkv_proj layout,\n408\t        # we need to create qkvz_proj adaptively here.\n409\t        # When create_in_proj_qkvz is False (e.g. LoRA enabled in Qwen3.5),\n410\t        # in_proj_qkv and in_proj_z are created separately instead.\n411\t        self.in_proj_qkvz = self.create_qkvz_proj(\n412\t            hidden_size=self.hidden_size,\n413\t            key_dim=self.key_dim,\n414\t            value_dim=self.value_dim,\n415\t            quant_config=self.quant_config,\n416\t            prefix=f\"{prefix}.in_proj_qkvz\",\n417\t        )\n418\t\n419\t        # ba_proj doesn't support blockwise fp8 quantization.\n420\t        # Qwen3-Next and Qwen3.5 have different in_proj_ba checkpoint\n421\t        # layouts, so we use a factory method to create the projection.\n422\t        self.in_proj_ba = self.create_ba_proj(\n423\t            hidden_size=self.hidden_size,\n424\t            num_v_heads=self.num_v_heads,\n425\t            quant_config=self.quant_config,\n426\t            prefix=f\"{prefix}.in_proj_ba\",\n427\t        )\n428\t        self.disable_tp_for_ba_proj = self.maybe_disable_tp(self.quant_config)\n429\t\n430\t        query_key_settings = (self.key_dim, 0, False)\n431\t        value_settings = (self.value_dim, 0, False)\n432\t\n433\t        self.conv1d.weight.weight_loader = mamba_v2_sharded_weight_loader(\n434\t            [\n435\t                query_key_settings,\n436\t                query_key_settings,\n437\t                value_settings,\n438\t            ],\n439\t            self.tp_size,\n440\t            self.tp_rank,\n441\t        )\n442\t\n443\t        # selective projection used to make dt, B and C input dependent\n444\t\n445\t        # time step projection (discretization)\n446\t        # instantiate once and copy inv_dt in init_weights of PretrainedModel\n447\t        self.dt_bias = nn.Parameter(\n448\t            torch.ones(self.num_v_heads // self.tp_size),\n449\t        )\n450\t        self.A_log = nn.Parameter(\n451\t            torch.empty(\n452\t                divide(self.num_v_heads, self.tp_size),\n453\t                dtype=torch.float32,\n454\t            )\n455\t        )\n456\t\n457\t        set_weight_attrs(self.A_log, {\"weight_loader\": sharded_weight_loader(0)})\n458\t        set_weight_attrs(self.dt_bias, {\"weight_loader\": sharded_weight_loader(0)})\n459\t\n460\t        output_gate_type = getattr(config, \"output_gate_type\", \"silu\")\n461\t        if output_gate_type == \"swish\":\n462\t            output_gate_type = \"silu\"\n463\t        assert output_gate_type in [\"silu\", \"swish\", \"sigmoid\"], (\n464\t            f\"unsupported {output_gate_type=}\"\n465\t        )\n466\t\n467\t        self.norm = RMSNormGated(\n468\t            self.head_v_dim,\n469\t            eps=self.layer_norm_epsilon,\n470\t            group_size=None,\n471\t            norm_before_gate=True,\n472\t            activation=output_gate_type,\n473\t            device=current_platform.current_device(),\n474\t        )\n475\t\n476\t        self.out_proj = RowParallelLinear(\n477\t            self.value_dim,\n478\t            self.hidden_size,\n479\t            bias=False,\n480\t            input_is_parallel=True,\n481\t            reduce_results=reduce_results,\n482\t            quant_config=self.quant_config,\n483\t            prefix=f\"{prefix}.out_proj\",\n484\t        )\n485\t\n486\t        self.chunk_gated_delta_rule = ChunkGatedDeltaRule()\n487\t        self.gdn_prefill_backend = self.chunk_gated_delta_rule.gdn_prefill_backend\n488\t        self._prefill_kernels_warmed_up = False\n489\t        self.enable_packed_recurrent_decode = (\n490\t            envs.VLLM_ENABLE_FLA_PACKED_RECURRENT_DECODE\n491\t        )\n492\t        self.gdn_decode_kernel = envs.VLLM_GDN_DECODE_KERNEL.strip().lower()\n493\t        if self.gdn_decode_kernel == \"cuda\":\n494\t            reason = self._fused_gdn_decode_unsupported_reason(vllm_config)\n495\t            if reason is not None:\n496\t                if \"VLLM_GDN_DECODE_KERNEL\" in os.environ:\n497\t                    raise ValueError(\n498\t                        f\"VLLM_GDN_DECODE_KERNEL=cuda is not supported: {reason}\"\n499\t                    )\n500\t                logger.info_once(\n501\t                    \"Falling back to the Triton GDN decode path: %s\", reason\n502\t                )\n503\t                self.gdn_decode_kernel = \"triton\"\n504\t        self.enable_fused_gdn_decode = self.gdn_decode_kernel == \"cuda\"\n505\t        logger.info_once(\"GDN decode kernel: %s\", self.gdn_decode_kernel)\n506\t\n507\t        compilation_config = get_current_vllm_config().compilation_config\n508\t        if prefix in compilation_config.static_forward_context:\n509\t            raise ValueError(f\"Duplicate layer name: {prefix}\")\n510\t        compilation_config.static_forward_context[prefix] = self\n511\t\n512\t    def _fused_gdn_decode_unsupported_reason(\n513\t        self, vllm_config: VllmConfig\n514\t    ) -> str | None:\n515\t        conv_state_dtype, recurrent_state_dtype = self.get_state_dtype()\n516\t        if (\n517\t            self.gqa_interleaved_layout\n518\t            or self.head_k_dim != 128\n519\t            or self.head_v_dim != 128\n520\t            or self.norm.activation != \"silu\"\n521\t            or vllm_config.model_config.dtype != torch.bfloat16\n522\t            or conv_state_dtype != torch.bfloat16\n523\t            or recurrent_state_dtype not in FUSED_GDN_STATE_DTYPES\n524\t            or not current_platform.has_device_capability(80)\n525\t        ):\n526\t            return (\n527\t                \"the fused CUDA kernel requires a BF16 GDN model with \"\n528\t                \"K=V=128, SiLU gating, non-interleaved GQA layout, BF16 \"\n529\t                \"convolution cache, BF16 or FP32 recurrent state, and a \"\n530\t                \"GPU with compute capability 8.0+\"\n531\t            )\n532\t        if not hasattr(torch.ops._C, \"fused_gdn_decode_post_conv_mtp\"):\n533\t            return \"torch.ops._C.fused_gdn_decode_post_conv_mtp is not built\"\n534\t        return None\n535\t\n536\t    def create_qkvz_proj(\n537\t        self,\n538\t        hidden_size: int,\n539\t        key_dim: int,\n540\t        value_dim: int,\n541\t        quant_config: QuantizationConfig | None,\n542\t        prefix: str,\n543\t    ) -> MergedColumnParallelLinear:\n544\t        # When gqa_interleaved_layout=True (Qwen3-Next), qkvz weights are\n545\t        # stored as a single fused tensor with interleaved GQA layout, so we\n546\t        # use one output shard to preserve the interleaving across TP ranks.\n547\t        # When gqa_interleaved_layout=False (Qwen3.5), the checkpoint has\n548\t        # separate q, k, v, z weights, so we use 4 independent output sizes.\n549\t        output_sizes = (\n550\t            [sum((key_dim, key_dim, value_dim, value_dim))]\n551\t            if self.gqa_interleaved_layout\n552\t            else [key_dim, key_dim, value_dim, value_dim]\n553\t        )\n554\t        return MergedColumnParallelLinear(\n555\t            input_size=hidden_size,\n556\t            output_sizes=output_sizes,\n557\t            bias=False,\n558\t            quant_config=quant_config,\n559\t            prefix=prefix,\n560\t        )\n561\t\n562\t    def create_ba_proj(\n563\t        self,\n564\t        hidden_size: int,\n565\t        num_v_heads: int,\n566\t        quant_config: QuantizationConfig | None,\n567\t        prefix: str,\n568\t    ) -> MergedColumnParallelLinear:\n569\t        # When gqa_interleaved_layout=True (Qwen3-Next), in_proj_ba is stored\n570\t        # as a single fused weight [b_g0, a_g0, b_g1, a_g1, ...] interleaved\n571\t        # by key-head group; a single output shard preserves this across TP.\n572\t        # When gqa_interleaved_layout=False (Qwen3.5), in_proj_b and in_proj_a\n573\t        # are separate checkpoint weights, so we use 2 independent output sizes.\n574\t        output_sizes = (\n575\t            [num_v_heads * 2] if self.gqa_interleaved_layout else [num_v_heads] * 2\n576\t        )\n577\t        return MergedColumnParallelLinear(\n578\t            input_size=hidden_size,\n579\t            output_sizes=output_sizes,\n580\t            bias=False,\n581\t            quant_config=quant_config,\n582\t            prefix=prefix,\n583\t            disable_tp=self.maybe_disable_tp(quant_config),\n584\t        )\n585\t\n586\t    def maybe_disable_tp(self, quant_config: QuantizationConfig | None) -> bool:\n587\t        \"\"\"Whether to replicate ba_proj instead of TP-sharding it.\n588\t\n589\t        Marlin requires output_size_per_partition >= MIN_THREAD_N=64, which\n590\t        the Qwen3.5 non-interleaved [num_v_heads]*2 layout violates at TP>=2\n591\t        (e.g. num_v_heads=64, TP=4 -> 16). Replicating the projection keeps\n592\t        each rank above the Marlin threshold; forward() then slices b/a to\n593\t        the local TP partition. Qwen3-Next's interleaved [num_v_heads*2]\n594\t        layout is unaffected and stays TP-sharded.\n595\t\n596\t        See https://github.com/vllm-project/vllm/issues/35924\n597\t        \"\"\"\n598\t        return (\n599\t            current_platform.is_cuda()\n600\t            and not self.gqa_interleaved_layout\n601\t            and isinstance(quant_config, (AutoAWQConfig, AutoGPTQConfig, INCConfig))\n602\t        )\n603\t\n604\t    def split_ba(self, ba: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:\n605\t        b, a = ba.chunk(2, dim=-1)\n606\t        if self.disable_tp_for_ba_proj and self.tp_size > 1:\n607\t            # ba_proj is replicated for Marlin; slice b/a to local TP rank.\n608\t            ba_chunk = self.num_v_heads // self.tp_size\n609\t            ba_start = self.tp_rank * ba_chunk\n610\t            b = b[:, ba_start : ba_start + ba_chunk]\n611\t            a = a[:, ba_start : ba_start + ba_chunk]\n612\t        return b, a\n613\t\n614\t    def fix_query_key_value_ordering(\n615\t        self,\n616\t        mixed_qkvz: torch.Tensor,\n617\t        mixed_ba: torch.Tensor,\n618\t    ):\n619\t        \"\"\"\n620\t        Derives `query`, `key` and `value` tensors from `mixed_qkvzba`.\n621\t        \"\"\"\n622\t        new_tensor_shape_qkvz = mixed_qkvz.size()[:-1] + (\n623\t            self.num_k_heads // self.tp_size,\n624\t            (\n625\t                self.head_k_dim\n626\t                + self.head_k_dim\n627\t                + (self.head_v_dim + self.head_v_dim)\n628\t                * self.num_v_heads\n629\t                // self.num_k_heads\n630\t            ),\n631\t        )\n632\t        new_tensor_shape_ba = mixed_ba.size()[:-1] + (\n633\t            self.num_k_heads // self.tp_size,\n634\t            2 * self.num_v_heads // self.num_k_heads,\n635\t        )\n636\t\n637\t        mixed_qkvz = mixed_qkvz.view(*new_tensor_shape_qkvz)\n638\t        mixed_ba = mixed_ba.view(*new_tensor_shape_ba)\n639\t\n640\t        split_arg_list_qkvz = [\n641\t            self.head_k_dim,\n642\t            self.head_k_dim,\n643\t            (self.num_v_heads // self.num_k_heads * self.head_v_dim),\n644\t            (self.num_v_heads // self.num_k_heads * self.head_v_dim),\n645\t        ]\n646\t        split_arg_list_ba = [\n647\t            self.num_v_heads // self.num_k_heads,\n648\t            self.num_v_heads // self.num_k_heads,\n649\t        ]\n650\t\n651\t        # [b, sq, ng, (hn + hn + np/ng * hn + np/ng + np/ng)]\n652\t        # --> [b, sq, ng, hn], [b, sq, ng, hn], [b, sq, ng, np/ng * hn],\n653\t        #  [b, sq, ng, np/ng * hn], [b, sq, ng, np/ng], [b, sq, ng, np/ng]\n654\t        (query, key, value, z) = torch.split(mixed_qkvz, split_arg_list_qkvz, dim=2)\n655\t        (b, a) = torch.split(mixed_ba, split_arg_list_ba, dim=2)\n656\t\n657\t        # [b, sq, ng, np/ng * hn] -> [b, sq, np, hn]\n658\t        value = value.reshape(value.size(0), -1, self.head_v_dim)\n659\t        z = z.reshape(z.size(0), -1, self.head_v_dim)\n660\t        b = b.reshape(b.size(0), self.num_v_heads // self.tp_size)\n661\t        a = a.reshape(a.size(0), self.num_v_heads // self.tp_size)\n662\t\n663\t        return query, key, value, z, b, a\n664\t\n665\t    @torch.compile(fullgraph=True)\n666\t    def prepare_gdn_attention_core_inputs(\n667\t        self,\n668\t        mixed_qkvz: torch.Tensor,\n669\t        mixed_ba: torch.Tensor,\n670\t        num_tokens: int,\n671\t    ):\n672\t        \"\"\"\n673\t        Derives mixed_qkv, z, b, a from projected qkvz/ba for the GDN custom op.\n674\t\n675\t        For gqa_interleaved_layout (Qwen3-Next): unpack the interleaved\n676\t        [ng, (hk + hk + np/ng*hv + np/ng*hv)] layout into contiguous qkv.\n677\t        For non-interleaved layout (Qwen3.5): simple split along last dim.\n678\t        \"\"\"\n679\t        if not self.gqa_interleaved_layout:\n680\t            # Qwen3.5: weights are in [q, k, v, z] order\n681\t            assert num_tokens == mixed_qkvz.shape[0]\n682\t            qkv_size = (self.key_dim * 2 + self.value_dim) // self.tp_size\n683\t            z_size = self.value_dim // self.tp_size\n684\t            mixed_qkv, z_flat = mixed_qkvz.split([qkv_size, z_size], dim=-1)\n685\t            n = mixed_qkvz.shape[0]\n686\t            z_out = z_flat.reshape(n, -1, self.head_v_dim)\n687\t            b, a = mixed_ba.chunk(2, dim=-1)\n688\t            return mixed_qkv, z_out, b, a\n689\t\n690\t        # Qwen3-Next: interleaved GQA layout\n691\t        base_shape_qkvz = mixed_qkvz.size()[:-1]\n692\t        base_shape_ba = mixed_ba.size()[:-1]\n693\t        ng = self.num_k_heads // self.tp_size\n694\t\n695\t        new_tensor_shape_qkvz = base_shape_qkvz + (\n696\t            ng,\n697\t            (\n698\t                self.head_k_dim\n699\t                + self.head_k_dim"}]},"parent_tool_use_id":"call_a4861364bd941f5d","session_id":"4f5fa1a2-e349-4774-856c-cb06ca25bfcd","uuid":"333c7403-a8ad-4516-901a-a9a48f9d07d0","timestamp":"2026-09-15T12:21:28.542Z","subagent_type":"hyperloom-leaf","task_description":"Read GDN decode kernel paths"}
