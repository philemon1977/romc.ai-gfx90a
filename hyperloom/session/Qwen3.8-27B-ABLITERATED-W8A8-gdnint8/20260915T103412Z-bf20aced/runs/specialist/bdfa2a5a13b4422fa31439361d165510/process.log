{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_946ed5270b124b9f","type":"tool_result","content":"700\t                + (self.head_v_dim + self.head_v_dim)\n701\t                * self.num_v_heads\n702\t                // self.num_k_heads\n703\t            ),\n704\t        )\n705\t        new_tensor_shape_ba = base_shape_ba + (\n706\t            ng,\n707\t            2 * self.num_v_heads // self.num_k_heads,\n708\t        )\n709\t\n710\t        mixed_qkvz = mixed_qkvz.view(*new_tensor_shape_qkvz)\n711\t        mixed_ba = mixed_ba.view(*new_tensor_shape_ba)\n712\t\n713\t        split_arg_list_qkvz = [\n714\t            self.head_k_dim,\n715\t            self.head_k_dim,\n716\t            (self.num_v_heads // self.num_k_heads * self.head_v_dim),\n717\t            (self.num_v_heads // self.num_k_heads * self.head_v_dim),\n718\t        ]\n719\t        split_arg_list_ba = [\n720\t            self.num_v_heads // self.num_k_heads,\n721\t            self.num_v_heads // self.num_k_heads,\n722\t        ]\n723\t\n724\t        (query, key, value, z) = torch.split(mixed_qkvz, split_arg_list_qkvz, dim=-1)\n725\t        (b, a) = torch.split(mixed_ba, split_arg_list_ba, dim=-1)\n726\t\n727\t        mixed_qkv_logical = torch.cat(\n728\t            [\n729\t                query.reshape(num_tokens, -1),\n730\t                key.reshape(num_tokens, -1),\n731\t                value.reshape(num_tokens, -1),\n732\t            ],\n733\t            dim=-1,\n734\t        )\n735\t\n736\t        # The split above produces non-contiguous views into the interleaved\n737\t        # buffer.  Concatenating everything into a single flat tensor forces a\n738\t        # contiguous copy, then slicing back out gives contiguous q/k/v/z/b/a\n739\t        # tensors that downstream kernels require.  Doing this in one cat+slice\n740\t        # keeps torch.compile in a single Triton graph instead of emitting\n741\t        # separate copy kernels per tensor.  The original code used\n742\t        # rearrange(...).contiguous() on each tensor individually.\n743\t        fused = torch.cat(\n744\t            [\n745\t                mixed_qkv_logical.reshape(-1),\n746\t                z.reshape(-1),\n747\t                b.reshape(-1),\n748\t                a.reshape(-1),\n749\t            ],\n750\t            dim=0,\n751\t        )\n752\t\n753\t        curr = 0\n754\t        qkv_numel = mixed_qkv_logical.numel()\n755\t        z_numel = z.numel()\n756\t        b_numel = b.numel()\n757\t        a_numel = a.numel()\n758\t\n759\t        mixed_qkv_out = fused[curr : curr + qkv_numel].view(num_tokens, -1)\n760\t        curr += qkv_numel\n761\t\n762\t        z_out = fused[curr : curr + z_numel].view(\n763\t            num_tokens, self.num_v_heads // self.tp_size, self.head_v_dim\n764\t        )\n765\t        curr += z_numel\n766\t\n767\t        b_out = fused[curr : curr + b_numel].view(\n768\t            num_tokens, self.num_v_heads // self.tp_size\n769\t        )\n770\t        curr += b_numel\n771\t\n772\t        a_out = fused[curr : curr + a_numel].view(\n773\t            num_tokens, self.num_v_heads // self.tp_size\n774\t        )\n775\t\n776\t        return mixed_qkv_out, z_out, b_out, a_out\n777\t\n778\t    def rearrange_mixed_qkv(self, mixed_qkv):\n779\t        \"\"\"Split packed qkv into contiguous (1, seq, heads, dim) tensors.\n780\t\n781\t        The original code used ``rearrange(x, \"l (h d) -> 1 l h d\", d=...)``\n782\t        followed by ``.contiguous()`` on each tensor.  This version flattens\n783\t        all three splits into a single buffer via ``torch.cat`` so that\n784\t        torch.compile emits one Triton copy kernel instead of three separate\n785\t        contiguous() calls.\n786\t        \"\"\"\n787\t        if mixed_qkv is None:\n788\t            return None, None, None\n789\t\n790\t        seq_len = mixed_qkv.shape[0]\n791\t        q_dim = self.key_dim // self.tp_size\n792\t        k_dim = self.key_dim // self.tp_size\n793\t        v_dim = self.value_dim // self.tp_size\n794\t\n795\t        query, key, value = torch.split(mixed_qkv, [q_dim, k_dim, v_dim], dim=-1)\n796\t\n797\t        fused = torch.cat(\n798\t            [query.reshape(-1), key.reshape(-1), value.reshape(-1)], dim=0\n799\t        )\n800\t\n801\t        q_size = seq_len * q_dim\n802\t        k_size = seq_len * k_dim\n803\t\n804\t        q_contig = fused[0:q_size]\n805\t        k_contig = fused[q_size : q_size + k_size]\n806\t        v_contig = fused[q_size + k_size :]\n807\t\n808\t        query = q_contig.view(1, seq_len, -1, self.head_k_dim)\n809\t        key = k_contig.view(1, seq_len, -1, self.head_k_dim)\n810\t        value = v_contig.view(1, seq_len, -1, self.head_v_dim)\n811\t\n812\t        return query, key, value\n813\t\n814\t    def forward(\n815\t        self,\n816\t        hidden_states: torch.Tensor,\n817\t    ) -> torch.Tensor:\n818\t        return self._forward_method(hidden_states)\n819\t\n820\t    def _output_projection(\n821\t        self,\n822\t        core_attn_out: torch.Tensor,\n823\t        z: torch.Tensor,\n824\t    ) -> torch.Tensor:\n825\t        \"\"\"Part 3: RMSNormGated + output linear projection.\n826\t\n827\t        The RMSNormGated + quant sequence is eligible for fusion\n828\t        by the compilation pass when fuse_norm_quant is enabled.\n829\t        \"\"\"\n830\t        z_shape_og = z.shape\n831\t        core_attn_out = core_attn_out.reshape(-1, core_attn_out.shape[-1])\n832\t        z = z.reshape(-1, z.shape[-1])\n833\t        core_attn_out = self.norm(core_attn_out, z)\n834\t        core_attn_out = core_attn_out.reshape(z_shape_og)\n835\t        core_attn_out = core_attn_out.flatten(-2)  # ... h d -> ... (h d)\n836\t        output, _ = self.out_proj(core_attn_out)\n837\t        return output\n838\t\n839\t    def forward_hip(\n840\t        self,\n841\t        hidden_states: torch.Tensor,\n842\t    ) -> torch.Tensor:\n843\t        \"\"\"ROCm forward using AITER Triton fused projection+attention when\n844\t        available, otherwise falling back to the generic CUDA path.\"\"\"\n845\t        if GDN_AITER_TRITON_AVAILABLE:\n846\t            num_tokens = hidden_states.size(0)\n847\t            projected_states_qkvz, _ = self.in_proj_qkvz(hidden_states)\n848\t            projected_states_ba, _ = self.in_proj_ba(hidden_states)\n849\t            projected_states_qkvz = projected_states_qkvz.view(num_tokens, -1)\n850\t            projected_states_ba = projected_states_ba.view(num_tokens, -1)\n851\t            core_attn_out = torch.empty(\n852\t                (num_tokens, self.num_v_heads // self.tp_size, self.head_v_dim),\n853\t                dtype=hidden_states.dtype,\n854\t                device=hidden_states.device,\n855\t            )\n856\t            z = torch.empty(\n857\t                (num_tokens, self.num_v_heads // self.tp_size, self.head_v_dim),\n858\t                dtype=projected_states_qkvz.dtype,\n859\t                device=projected_states_qkvz.device,\n860\t            )\n861\t\n862\t            torch.ops.vllm.qwen_gdn_attention_core(\n863\t                projected_states_qkvz,\n864\t                projected_states_ba,\n865\t                z,\n866\t                core_attn_out,\n867\t                layer_name=_encode_layer_name(self.prefix),\n868\t                use_aiter=True,\n869\t            )\n870\t\n871\t            return self._output_projection(core_attn_out, z)\n872\t        else:\n873\t            return self.forward_cuda(hidden_states)\n874\t\n875\t    def forward_cuda(\n876\t        self,\n877\t        hidden_states: torch.Tensor,\n878\t    ) -> torch.Tensor:\n879\t        \"\"\"\n880\t        Forward pass with three parts:\n881\t        1. Input projection\n882\t        2. Core attention (custom op)\n883\t        3. Output projection\n884\t        \"\"\"\n885\t        num_tokens = hidden_states.size(0)\n886\t        # ============================================================\n887\t        # Part 1: Input Projection\n888\t        # ============================================================\n889\t        mixed_qkvz, _ = self.in_proj_qkvz(hidden_states)\n890\t        ba, _ = self.in_proj_ba(hidden_states)\n891\t\n892\t        use_fused_gdn_decode = (\n893\t            self.enable_fused_gdn_decode\n894\t            and hidden_states.dtype == torch.bfloat16\n895\t            and self.norm.weight.dtype in (torch.bfloat16, torch.float32)\n896\t        )\n897\t        if use_fused_gdn_decode:\n898\t            core_attn_out = torch.zeros(\n899\t                (num_tokens, self.num_v_heads // self.tp_size, self.head_v_dim),\n900\t                dtype=hidden_states.dtype,\n901\t                device=hidden_states.device,\n902\t            )\n903\t            torch.ops.vllm.qwen_gdn_attention_core_fused_norm_packed(\n904\t                mixed_qkvz,\n905\t                ba,\n906\t                core_attn_out,\n907\t                layer_name=_encode_layer_name(self.prefix),\n908\t            )\n909\t            output, _ = self.out_proj(core_attn_out.flatten(-2))\n910\t            return output\n911\t\n912\t        if self.gqa_interleaved_layout:\n913\t            # Qwen3-Next: unpack the interleaved GQA layout\n914\t            query, key, value, z, b, a = self.fix_query_key_value_ordering(\n915\t                mixed_qkvz, ba\n916\t            )\n917\t            query, key, value = map(\n918\t                lambda x: rearrange(x, \"l p d -> l (p d)\"), (query, key, value)\n919\t            )\n920\t            mixed_qkv = torch.cat((query, key, value), dim=-1)\n921\t        else:\n922\t            # Qwen3.5: weights are already in [q, k, v, z] and [b, a] order\n923\t            qkv_size = (self.key_dim * 2 + self.value_dim) // self.tp_size\n924\t            z_size = self.value_dim // self.tp_size\n925\t            mixed_qkv, z = mixed_qkvz.split([qkv_size, z_size], dim=-1)\n926\t            z = z.reshape(z.size(0), -1, self.head_v_dim)\n927\t            b, a = self.split_ba(ba)\n928\t\n929\t        # ============================================================\n930\t        # Part 2: Core Attention (Custom Op)\n931\t        # ============================================================\n932\t        # Note: we should not use torch.empty here like other attention backends,\n933\t        # see discussions in https://github.com/vllm-project/vllm/pull/28182\n934\t        core_attn_out = torch.zeros(\n935\t            (num_tokens, self.num_v_heads // self.tp_size, self.head_v_dim),\n936\t            dtype=hidden_states.dtype,\n937\t            device=hidden_states.device,\n938\t        )\n939\t\n940\t        torch.ops.vllm.qwen_gdn_attention_core(\n941\t            mixed_qkv,\n942\t            b.contiguous(),\n943\t            a.contiguous(),\n944\t            core_attn_out,\n945\t            layer_name=_encode_layer_name(self.prefix),\n946\t        )\n947\t\n948\t        # ============================================================\n949\t        # Part 3: Output Projection\n950\t        # ============================================================\n951\t        return self._output_projection(core_attn_out, z)\n952\t\n953\t    def forward_xpu(\n954\t        self,\n955\t        hidden_states: torch.Tensor,\n956\t    ) -> torch.Tensor:\n957\t        \"\"\"\n958\t        Forward pass with three parts:\n959\t        1. Input projection\n960\t        2. Core attention (custom op)\n961\t        3. Output projection\n962\t        \"\"\"\n963\t        num_tokens = hidden_states.size(0)\n964\t\n965\t        # ============================================================\n966\t        # Part 1: Input Projection\n967\t        # ============================================================\n968\t        projected_states_qkvz, _ = self.in_proj_qkvz(hidden_states)\n969\t        projected_states_ba, _ = self.in_proj_ba(hidden_states)\n970\t\n971\t        # ============================================================\n972\t        # Part 2: Core Attention\n973\t        # ============================================================\n974\t        core_attn_out = torch.zeros(\n975\t            (num_tokens, self.num_v_heads // self.tp_size, self.head_v_dim),\n976\t            dtype=hidden_states.dtype,\n977\t            device=hidden_states.device,\n978\t        )\n979\t        z = torch.empty_like(core_attn_out)\n980\t\n981\t        torch.ops.vllm.gdn_attention_core_xpu(\n982\t            core_attn_out,\n983\t            z,\n984\t            projected_states_qkvz,\n985\t            projected_states_ba,\n986\t            self.prefix,\n987\t        )\n988\t\n989\t        # ============================================================\n990\t        # Part 3: Output Projection\n991\t        # ============================================================\n992\t        z_shape_og = z.shape\n993\t        # Reshape input data into 2D tensor\n994\t        core_attn_out = core_attn_out.reshape(-1, core_attn_out.shape[-1])\n995\t        z = z.reshape(-1, z.shape[-1])\n996\t        core_attn_out = self.norm(core_attn_out, z)\n997\t        core_attn_out = core_attn_out.reshape(z_shape_og)\n998\t        core_attn_out = core_attn_out.flatten(-2)  # ... h d -> ... (h d)\n999\t        out, _ = self.out_proj(core_attn_out)\n1000\t        return out\n1001\t\n1002\t    def forward_cpu(\n1003\t        self,\n1004\t        hidden_states: torch.Tensor,\n1005\t    ) -> torch.Tensor:\n1006\t        assert not hasattr(self, \"in_proj_qkv\"), \"lora isn't supported on CPU.\"\n1007\t\n1008\t        mixed_qkvz, _ = self.in_proj_qkvz(hidden_states)\n1009\t        ba, _ = self.in_proj_ba(hidden_states)\n1010\t\n1011\t        if self.gqa_interleaved_layout:\n1012\t            # Qwen3-Next: unpack the interleaved GQA layout\n1013\t            query, key, value, z, b, a = self.fix_query_key_value_ordering(\n1014\t                mixed_qkvz, ba\n1015\t            )\n1016\t            query, key, value = map(\n1017\t                lambda x: rearrange(x, \"l p d -> l (p d)\"), (query, key, value)\n1018\t            )\n1019\t            mixed_qkv = torch.cat((query, key, value), dim=-1)\n1020\t        else:\n1021\t            # Qwen3.5: weights are already in [q, k, v, z] and [b, a] order\n1022\t            qkv_size = (self.key_dim * 2 + self.value_dim) // self.tp_size\n1023\t            z_size = self.value_dim // self.tp_size\n1024\t            mixed_qkv, z = mixed_qkvz.split([qkv_size, z_size], dim=-1)\n1025\t            z = z.reshape(z.size(0), -1, self.head_v_dim)\n1026\t            b, a = ba.chunk(2, dim=-1)\n1027\t\n1028\t        num_tokens = hidden_states.size(0)\n1029\t        core_attn_out = torch.zeros(\n1030\t            (num_tokens, self.num_v_heads // self.tp_size, self.head_v_dim),\n1031\t            dtype=hidden_states.dtype,\n1032\t            device=hidden_states.device,\n1033\t        )\n1034\t\n1035\t        torch.ops.vllm.cpu_gdn_attention_core(\n1036\t            mixed_qkv,\n1037\t            b,\n1038\t            a,\n1039\t            core_attn_out,\n1040\t            _encode_layer_name(self.prefix),\n1041\t        )\n1042\t\n1043\t        z_shape_og = z.shape\n1044\t        core_attn_out = core_attn_out.reshape(-1, core_attn_out.shape[-1])\n1045\t        z = z.reshape(-1, z.shape[-1])\n1046\t        core_attn_out = self.norm(core_attn_out, z)\n1047\t        core_attn_out = core_attn_out.reshape(z_shape_og)\n1048\t        core_attn_out = core_attn_out.flatten(-2)  # ... h d -> ... (h d)\n1049\t        out, _ = self.out_proj(core_attn_out)\n1050\t        return out\n1051\t\n1052\t    def _warmup_prefill_kernels(self, qkv_or_qkvz: torch.Tensor, v_dim: int) -> None:\n1053\t        \"\"\"Warm up GDN prefill kernels during V1 profiling.\n1054\t\n1055\t        During V1 profile runs, ``_forward_core`` returns early because\n1056\t        ``attn_metadata`` is ``None``, so the autotuned kernels used by\n1057\t        ``chunk_gated_delta_rule`` (e.g. ``solve_tril``,\n1058\t        ``chunk_scaled_dot_kkt``) are never invoked.  After profiling,\n1059\t        vLLM allocates KV cache using most of the remaining GPU memory.\n1060\t        When the first real inference triggers the autotuner it OOMs\n1061\t        because there is not enough memory left for benchmarking.\n1062\t\n1063\t        This method runs minimal forward passes through\n1064\t        ``chunk_gated_delta_rule`` with small dummy tensors to force\n1065\t        autotuning while GPU memory is still plentiful.  The autotuner\n1066\t        results are cached globally, so only the first layer incurs\n1067\t        actual benchmarking cost.\n1068\t\n1069\t        All kernels including ``chunk_fwd_kernel_o`` now use a fixed\n1070\t        ``BT = chunk_size`` (64).  A single warmup pass with T = 64\n1071\t        is sufficient to populate the autotuner cache.\n1072\t\n1073\t        The decode path uses ``gdn_aiter_fused_rearrange_sigmoid_gated_delta_rule``\n1074\t        which has fixed kernel parameters (no autotuning), so only the\n1075\t        prefill (chunked) path needs warming up.\n1076\t        \"\"\"\n1077\t        if self._prefill_kernels_warmed_up:\n1078\t            return\n1079\t        self._prefill_kernels_warmed_up = True\n1080\t\n1081\t        device = qkv_or_qkvz.device\n1082\t        dtype = qkv_or_qkvz.dtype\n1083\t        num_k_heads = self.num_k_heads // self.tp_size\n1084\t        num_v_heads = self.num_v_heads // self.tp_size\n1085\t        _, state_dtype = self.get_state_dtype()\n1086\t\n1087\t        # All kernels use BT = chunk_size, so a single pass with T = chunk_size\n1088\t        # is sufficient to populate every autotuner cache. Mirror the real\n1089\t        # prefill path here: build q/k/v/g/beta via fused_post_conv_prep and\n1090\t        # then run chunk_gated_delta_rule with in-kernel L2 norm disabled.\n1091\t        T = FLA_CHUNK_SIZE\n1092\t        dummy_mixed_qkv = torch.randn(\n1093\t            T, qkv_or_qkvz.shape[-1] - v_dim, device=device, dtype=dtype\n1094\t        )\n1095\t        dummy_a = torch.randn(T, num_v_heads, device=device, dtype=dtype)\n1096\t        dummy_b = torch.randn(T, num_v_heads, device=device, dtype=dtype)\n1097\t        q, k, v, g, beta = fused_post_conv_prep(\n1098\t            conv_output=dummy_mixed_qkv,\n1099\t            a=dummy_a,\n1100\t            b=dummy_b,\n1101\t            A_log=self.A_log,\n1102\t            dt_bias=self.dt_bias,\n1103\t            num_k_heads=num_k_heads,\n1104\t            head_k_dim=self.head_k_dim,\n1105\t            head_v_dim=self.head_v_dim,\n1106\t            apply_l2norm=True,\n1107\t            output_g_exp=False,\n1108\t        )\n1109\t        q = q.unsqueeze(0)\n1110\t        k = k.unsqueeze(0)\n1111\t        v = v.unsqueeze(0)\n1112\t        g = g.unsqueeze(0)\n1113\t        beta = beta.unsqueeze(0)\n1114\t        state = torch.zeros(\n1115\t            1,\n1116\t            num_v_heads,\n1117\t            self.head_v_dim,\n1118\t            self.head_k_dim,\n1119\t            device=device,\n1120\t            dtype=state_dtype,\n1121\t        )\n1122\t        cu_seqlens = torch.tensor([0, T], device=device, dtype=torch.int32)\n1123\t\n1124\t        # CuteDSL kernels require metadata\n1125\t        chunk_indices = None\n1126\t        chunk_offsets = None\n1127\t        if self.gdn_prefill_backend == \"cutedsl\":\n1128\t            from vllm.model_executor.layers.mamba.ops.gdn_chunk_cutedsl import (\n1129\t                prepare_metadata_cutedsl,\n1130\t            )\n1131\t\n1132\t            chunk_indices, chunk_offsets = prepare_metadata_cutedsl(cu_seqlens, T)\n1133\t\n1134\t        try:\n1135\t            self.chunk_gated_delta_rule(\n1136\t                q=q,\n1137\t                k=k,\n1138\t                v=v,\n1139\t                g=g,\n1140\t                beta=beta,\n1141\t                initial_state=state,\n1142\t                output_final_state=True,\n1143\t                cu_seqlens=cu_seqlens,\n1144\t                chunk_indices=chunk_indices,\n1145\t                chunk_offsets=chunk_offsets,\n1146\t                use_qk_l2norm_in_kernel=False,\n1147\t            )\n1148\t        except Exception:\n1149\t            logger.warning(\n1150\t                \"GDN prefill kernel warmup (T=%d) failed for \"\n1151\t                \"layer %s. First inference may OOM due to \"\n1152\t                \"autotuner.\",\n1153\t                T,\n1154\t                self.prefix,\n1155\t                exc_info=True,\n1156\t            )\n1157\t        else:\n1158\t            logger.debug(\n1159\t                \"GDN prefill kernel warmup (T=%d) completed for layer %s\",\n1160\t                T,\n1161\t                self.prefix,\n1162\t            )\n1163\t        finally:\n1164\t            del (\n1165\t                dummy_mixed_qkv,\n1166\t                q,\n1167\t                k,\n1168\t                v,\n1169\t                dummy_a,\n1170\t                dummy_b,\n1171\t                g,\n1172\t                beta,\n1173\t                state,\n1174\t                cu_seqlens,\n1175\t                chunk_indices,\n1176\t                chunk_offsets,\n1177\t            )\n1178\t\n1179\t        torch.accelerator.empty_cache()\n1180\t\n1181\t    def _forward_core_rocm(\n1182\t        self,\n1183\t        qkvz: torch.Tensor,\n1184\t        ba: torch.Tensor,\n1185\t        z_out: torch.Tensor,\n1186\t        core_attn_out: torch.Tensor,\n1187\t    ):\n1188\t        \"\"\"ROCm AITER fast path: conv1d + recurrent attention from packed\n1189\t        qkvz/ba layout.\n1190\t\n1191\t        For decode-only (no spec, no prefill) interleaved-GQA layouts,\n1192\t        dispatches directly to ``_forward_core_decode_aiter``. Otherwise unpacks\n1193\t        the packed layout and falls through to ``_forward_core``.\n1194\t\n1195\t        Args:\n1196\t            qkvz: packed [q, k, v, z] projection (num_tokens, qkvz_dim)\n1197\t            ba:   packed [b, a] gating vectors    (num_tokens, 2*num_heads)\n1198\t            z_out: **output** buffer for z        (num_tokens, num_heads,\n1199\t                   head_dim); mutated in-place.\n1200\t            core_attn_out: Pre-allocated output buffer for attention results.\n1201\t        \"\"\"\n1202\t        forward_context = get_forward_context()\n1203\t        attn_metadata_raw = forward_context.attn_metadata\n1204\t\n1205\t        if attn_metadata_raw is None:\n1206\t            v_dim = core_attn_out.shape[-1] * core_attn_out.shape[-2]\n1207\t            self._warmup_prefill_kernels(qkvz, v_dim)\n1208\t            return\n1209\t\n1210\t        assert isinstance(attn_metadata_raw, dict)\n1211\t        attn_metadata = attn_metadata_raw[self.prefix]  # type: ignore[index]\n1212\t        assert isinstance(attn_metadata, GDNAttentionMetadata)\n1213\t\n1214\t        # The AITER fused reshape/conv kernel expects Qwen3-Next's interleaved\n1215\t        # GQA layout. Qwen3.5 uses a non-interleaved q/k/v/z layout and must use\n1216\t        # the generic path below to split/rearrange inputs correctly.\n1217\t        if (\n1218\t            self.gqa_interleaved_layout\n1219\t            and attn_metadata.spec_sequence_masks is None\n1220\t            and attn_metadata.num_prefills == 0\n1221\t            and attn_metadata.num_decodes > 0\n1222\t        ):\n1223\t            return self._forward_core_decode_aiter(\n1224\t                qkvz=qkvz,\n1225\t                ba=ba,\n1226\t                z_out=z_out,\n1227\t                core_attn_out=core_attn_out,\n1228\t                attn_metadata=attn_metadata,\n1229\t            )\n1230\t\n1231\t        core_attn_out.zero_()\n1232\t        num_tokens_all = qkvz.shape[0]\n1233\t        mixed_qkv, z, b, a = self.prepare_gdn_attention_core_inputs(\n1234\t            qkvz, ba, num_tokens_all\n1235\t        )\n1236\t        z_out[:] = z\n1237\t        self._forward_core(\n1238\t            mixed_qkv=mixed_qkv,\n1239\t            b=b,\n1240\t            a=a,\n1241\t            core_attn_out=core_attn_out,\n1242\t        )\n1243\t\n1244\t    def _forward_core(\n1245\t        self,\n1246\t        mixed_qkv: torch.Tensor,\n1247\t        b: torch.Tensor,\n1248\t        a: torch.Tensor,\n1249\t        core_attn_out: torch.Tensor,\n1250\t    ):\n1251\t        \"\"\"Core conv1d + recurrent attention (standard path).\n1252\t\n1253\t        Args:\n1254\t            mixed_qkv: packed [q, k, v] projection (num_tokens, qkv_dim)\n1255\t            b: beta gating vector                   (num_tokens, num_heads)\n1256\t            a: alpha gating vector                  (num_tokens, num_heads)\n1257\t            core_attn_out: Pre-allocated output buffer for attention results.\n1258\t        \"\"\"\n1259\t        forward_context = get_forward_context()\n1260\t        attn_metadata_raw = forward_context.attn_metadata\n1261\t\n1262\t        if attn_metadata_raw is None:\n1263\t            self._warmup_prefill_kernels(mixed_qkv, 0)\n1264\t            return\n1265\t\n1266\t        assert isinstance(attn_metadata_raw, dict)\n1267\t        attn_metadata = attn_metadata_raw[self.prefix]  # type: ignore[index]\n1268\t        assert isinstance(attn_metadata, GDNAttentionMetadata)\n1269\t\n1270\t        if (\n1271\t            self.enable_packed_recurrent_decode\n1272\t            and attn_metadata.spec_sequence_masks is None\n1273\t            and attn_metadata.num_prefills == 0\n1274\t            and attn_metadata.num_decodes > 0\n1275\t        ):\n1276\t            return self._forward_core_decode_non_spec(\n1277\t                mixed_qkv=mixed_qkv,\n1278\t                b=b,\n1279\t                a=a,\n1280\t                core_attn_out=core_attn_out,\n1281\t                attn_metadata=attn_metadata,\n1282\t            )\n1283\t\n1284\t        has_initial_state = attn_metadata.has_initial_state\n1285\t        spec_query_start_loc = attn_metadata.spec_query_start_loc\n1286\t        non_spec_query_start_loc = attn_metadata.non_spec_query_start_loc\n1287\t        spec_sequence_masks = attn_metadata.spec_sequence_masks\n1288\t        spec_token_indx = attn_metadata.spec_token_indx\n1289\t        non_spec_token_indx = attn_metadata.non_spec_token_indx\n1290\t        spec_state_indices_tensor = attn_metadata.spec_state_indices_tensor  # noqa: E501\n1291\t        non_spec_state_indices_tensor = attn_metadata.non_spec_state_indices_tensor  # noqa: E501\n1292\t        self_kv_cache = self.kv_cache\n1293\t        # conv_state must be (..., dim, width-1) for the conv kernels.\n1294\t        # DS layout stores it that way directly; SD layout needs a transpose.\n1295\t        conv_state = (\n1296\t            self_kv_cache[0]\n1297\t            if is_conv_state_dim_first()\n1298\t            else self_kv_cache[0].transpose(-1, -2)\n1299\t        )\n1300\t        ssm_state = self_kv_cache[1]\n1301\t        num_actual_tokens = attn_metadata.num_actual_tokens\n1302\t        num_accepted_tokens = attn_metadata.num_accepted_tokens\n1303\t\n1304\t        mixed_qkv = mixed_qkv[:num_actual_tokens]\n1305\t        b = b[:num_actual_tokens]\n1306\t        a = a[:num_actual_tokens]\n1307\t\n1308\t        # 1. Convolution sequence transformation\n1309\t        conv_weights = self.conv1d.weight.view(\n1310\t            self.conv1d.weight.size(0), self.conv1d.weight.size(2)\n1311\t        )\n1312\t\n1313\t        if spec_sequence_masks is not None:\n1314\t            if attn_metadata.num_prefills == 0 and attn_metadata.num_decodes == 0:\n1315\t                mixed_qkv_spec = mixed_qkv\n1316\t                a_spec = a\n1317\t                b_spec = b\n1318\t                mixed_qkv_non_spec = None\n1319\t            else:\n1320\t                mixed_qkv_spec = mixed_qkv.index_select(0, spec_token_indx)\n1321\t                a_spec = a.index_select(0, spec_token_indx)\n1322\t                b_spec = b.index_select(0, spec_token_indx)\n1323\t                mixed_qkv_non_spec = mixed_qkv.index_select(0, non_spec_token_indx)\n1324\t        else:\n1325\t            mixed_qkv_spec = None\n1326\t            mixed_qkv_non_spec = mixed_qkv\n1327\t\n1328\t        # 1.1: Process the multi-query part\n1329\t        if spec_sequence_masks is not None:\n1330\t            # spec_state_indices_tensor is always set when spec_sequence_masks is set\n1331\t            assert spec_state_indices_tensor is not None\n1332\t            mixed_qkv_spec = causal_conv1d_update(\n1333\t                mixed_qkv_spec,\n1334\t                conv_state,\n1335\t                conv_weights,\n1336\t                self.conv1d.bias,\n1337\t                self.activation,\n1338\t                conv_state_indices=spec_state_indices_tensor[:, 0][  # type: ignore[index]\n1339\t                    : attn_metadata.num_spec_decodes  # type: ignore[attr-defined]\n1340\t                ],\n1341\t                num_accepted_tokens=num_accepted_tokens,\n1342\t                query_start_loc=spec_query_start_loc,\n1343\t                max_query_len=spec_state_indices_tensor.size(-1),\n1344\t                validate_data=False,\n1345\t            )\n1346\t\n1347\t        # 1.2: Process the remaining part\n1348\t        if attn_metadata.num_prefills > 0:\n1349\t            assert mixed_qkv_non_spec is not None\n1350\t            mixed_qkv_non_spec_T = mixed_qkv_non_spec.transpose(0, 1)\n1351\t            # - \"cache_indices\" updates the conv_state cache in positions\n1352\t            #   pointed to by \"state_indices_tensor\"\n1353\t            mixed_qkv_non_spec = causal_conv1d_fn(\n1354\t                mixed_qkv_non_spec_T,\n1355\t                conv_weights,\n1356\t                self.conv1d.bias,\n1357\t                activation=self.activation,\n1358\t                conv_states=conv_state,\n1359\t                has_initial_state=has_initial_state,\n1360\t                cache_indices=non_spec_state_indices_tensor,\n1361\t                query_start_loc=non_spec_query_start_loc,\n1362\t                metadata=attn_metadata,\n1363\t            ).transpose(0, 1)\n1364\t        elif attn_metadata.num_decodes > 0:\n1365\t            assert mixed_qkv_non_spec is not None\n1366\t            mixed_qkv_non_spec = causal_conv1d_update(\n1367\t                mixed_qkv_non_spec,\n1368\t                conv_state,\n1369\t                conv_weights,\n1370\t                self.conv1d.bias,\n1371\t                self.activation,\n1372\t                conv_state_indices=non_spec_state_indices_tensor[  # type: ignore[index]\n1373\t                    : attn_metadata.num_actual_tokens  # type: ignore[attr-defined]\n1374\t                ],\n1375\t                validate_data=True,\n1376\t            )\n1377\t        else:\n1378\t            mixed_qkv_non_spec = None\n1379\t\n1380\t        query_spec, key_spec, value_spec = self.rearrange_mixed_qkv(mixed_qkv_spec)\n1381\t\n1382\t        # Split mixed non-spec-decode+prefill to process independently\n1383\t        split_non_spec = (\n1384\t            spec_sequence_masks is None\n1385\t            and attn_metadata.num_prefills > 0\n1386\t            and attn_metadata.num_decodes > 0\n1387\t        )\n1388\t        num_decode_tokens = attn_metadata.num_decode_tokens\n1389\t\n1390\t        if attn_metadata.num_prefills > 0:\n1391\t            assert mixed_qkv_non_spec is not None, (\n1392\t                \"mixed_qkv_non_spec must be provided for prefill path\"\n1393\t            )\n1394\t            if spec_sequence_masks is not None:\n1395\t                a_non_spec = a.index_select(0, non_spec_token_indx)\n1396\t                b_non_spec = b.index_select(0, non_spec_token_indx)\n1397\t            else:\n1398\t                a_non_spec = a\n1399\t                b_non_spec = b"}]},"parent_tool_use_id":"call_a4861364bd941f5d","session_id":"4f5fa1a2-e349-4774-856c-cb06ca25bfcd","uuid":"f81faee1-f47a-4a81-9a1c-728a784cfec5","timestamp":"2026-09-15T12:21:34.375Z","subagent_type":"hyperloom-leaf","task_description":"Read GDN decode kernel paths"}
