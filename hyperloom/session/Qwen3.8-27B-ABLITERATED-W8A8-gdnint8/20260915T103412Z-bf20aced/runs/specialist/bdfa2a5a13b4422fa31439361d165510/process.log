pe: ignore[index]\n1782\t        assert isinstance(attn_metadata, GDNAttentionMetadata)\n1783\t        mixed_qkv, output_gate_flat = mixed_qkvz.split(\n1784\t            [qkv_size, self.value_dim // self.tp_size], dim=-1\n1785\t        )\n1786\t        output_gate = output_gate_flat.reshape(\n1787\t            output_gate_flat.size(0), -1, self.head_v_dim\n1788\t        )\n1789\t        b, a = self.split_ba(ba)\n1790\t        self._forward_core_fused_norm(\n1791\t            mixed_qkv=mixed_qkv,\n1792\t            b=b,\n1793\t            a=a,\n1794\t            output_gate=output_gate,\n1795\t            core_attn_out=core_attn_out,\n1796\t        )\n1797\t\n1798\t    def _can_use_fused_gdn_mtp_decode(\n1799\t        self, attn_metadata: GDNAttentionMetadata\n1800\t    ) -> bool:\n1801\t        state_indices = attn_metadata.spec_state_indices_tensor\n1802\t        return (\n1803\t            attn_metadata.spec_sequence_masks is not None\n1804\t            and attn_metadata.num_decodes == 0\n1805\t            and attn_metadata.num_spec_decodes > 0\n1806\t            and self.kv_cache[1].dtype in FUSED_GDN_STATE_DTYPES\n1807\t            and self.gdn_decode_kernel == \"cuda\"\n1808\t            and self.num_v_heads == 8 * self.num_k_heads\n1809\t            and state_indices is not None\n1810\t            and state_indices.size(1) <= MAX_FUSED_GDN_MTP_TOKENS\n1811\t            and hasattr(torch.ops._C, \"fused_gdn_decode_post_conv_mtp\")\n1812\t        )\n1813\t\n1814\t    def _rms_norm_gated_cuda(\n1815\t        self,\n1816\t        x: torch.Tensor,\n1817\t        output_gate: torch.Tensor,\n1818\t        out: torch.Tensor,\n1819\t    ) -> None:\n1820\t        from vllm.third_party.flash_linear_attention.ops.layernorm_guard import (\n1821\t            layer_norm_fwd,\n1822\t        )\n1823\t\n1824\t        x_shape = x.shape\n1825\t        assert output_gate.shape == x_shape\n1826\t        assert out.shape == x_shape\n1827\t        x_2d = x.reshape(-1, x_shape[-1])\n1828\t        output_gate_2d = output_gate.reshape(-1, x_shape[-1])\n1829\t        out_2d = out.reshape(-1, x_shape[-1])\n1830\t        assert x_2d.stride(-1) == 1\n1831\t        assert output_gate_2d.stride(-1) == 1\n1832\t        assert out_2d.stride(-1) == 1\n1833\t        layer_norm_fwd(\n1834\t            x_2d,\n1835\t            self.norm.weight.contiguous(),\n1836\t            self.norm.bias,\n1837\t            self.norm.eps,\n1838\t            z=output_gate_2d,\n1839\t            out=out_2d,\n1840\t            group_size=(\n1841\t                x_shape[-1] if self.norm.group_size is None else self.norm.group_size\n1842\t            ),\n1843\t            norm_before_gate=self.norm.norm_before_gate,\n1844\t            is_rms_norm=True,\n1845\t            activation=self.norm.activation,\n1846\t        )\n1847\t\n1848\t    def _forward_core_fused_norm(\n1849\t        self,\n1850\t        mixed_qkv: torch.Tensor,\n1851\t        b: torch.Tensor,\n1852\t        a: torch.Tensor,\n1853\t        output_gate: torch.Tensor,\n1854\t        core_attn_out: torch.Tensor,\n1855\t    ) -> None:\n1856\t        forward_context = get_forward_context()\n1857\t        attn_metadata_raw = forward_context.attn_metadata\n1858\t        if attn_metadata_raw is None:\n1859\t            self._warmup_prefill_kernels(mixed_qkv, 0)\n1860\t            return\n1861\t\n1862\t        assert isinstance(attn_metadata_raw, dict)\n1863\t        attn_metadata = attn_metadata_raw[self.prefix]  # type: ignore[index]\n1864\t        assert isinstance(attn_metadata, GDNAttentionMetadata)\n1865\t        if (\n1866\t            self._can_use_fused_gdn_mtp_decode(attn_metadata)\n1867\t            and attn_metadata.num_prefills == 0\n1868\t        ):\n1869\t            self._forward_core_decode_spec_fused_norm(\n1870\t                mixed_qkv=mixed_qkv,\n1871\t                b=b,\n1872\t                a=a,\n1873\t                output_gate=output_gate,\n1874\t                core_attn_out=core_attn_out,\n1875\t                attn_metadata=attn_metadata,\n1876\t            )\n1877\t            return\n1878\t        self._forward_core(\n1879\t            mixed_qkv=mixed_qkv,\n1880\t            b=b.contiguous(),\n1881\t            a=a.contiguous(),\n1882\t            core_attn_out=core_attn_out,\n1883\t        )\n1884\t        num_actual_tokens = attn_metadata.num_actual_tokens\n1885\t        self._rms_norm_gated_cuda(\n1886\t            core_attn_out[:num_actual_tokens],\n1887\t            output_gate[:num_actual_tokens],\n1888\t            core_attn_out[:num_actual_tokens],\n1889\t        )\n1890\t\n1891\t\n1892\tdef qwen_gdn_attention_core(\n1893\t    qkv_or_qkvz: torch.Tensor,\n1894\t    b_or_ba: torch.Tensor,\n1895\t    a_or_z_out: torch.Tensor,\n1896\t    core_attn_out: torch.Tensor,\n1897\t    layer_name: LayerNameType,\n1898\t    use_aiter: bool = False,\n1899\t) -> None:\n1900\t    \"\"\"Custom op dispatching to _forward_core or _forward_core_rocm.\n1901\t\n1902\t    Handles conv1d + recurrent attention only; input/output projections\n1903\t    are performed by the caller.\n1904\t\n1905\t    When ``use_aiter=False`` (standard path):\n1906\t        qkv_or_qkvz is [q, k, v], b_or_ba is b, a_or_z_out is a (read-only).\n1907\t    When ``use_aiter=True`` (AITER Triton path, ROCm only):\n1908\t        qkv_or_qkvz is [q, k, v, z], b_or_ba is [b, a], a_or_z_out is the\n1909\t        z output buffer (mutated in-place).\n1910\t\n1911\t    ``core_attn_out`` is always mutated in-place.\n1912\t    \"\"\"\n1913\t    layer_name = _resolve_layer_name(layer_name)\n1914\t    forward_context: ForwardContext = get_forward_context()\n1915\t    self = forward_context.no_compile_layers[layer_name]\n1916\t    if use_aiter:\n1917\t        self._forward_core_rocm(\n1918\t            qkvz=qkv_or_qkvz,\n1919\t            ba=b_or_ba,\n1920\t            z_out=a_or_z_out,\n1921\t            core_attn_out=core_attn_out,\n1922\t        )\n1923\t    else:\n1924\t        self._forward_core(\