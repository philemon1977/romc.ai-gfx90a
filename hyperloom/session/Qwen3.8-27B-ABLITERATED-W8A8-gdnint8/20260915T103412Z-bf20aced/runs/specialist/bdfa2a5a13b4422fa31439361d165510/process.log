{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_aa8f7dc7dfc7e575","type":"tool_result","content":"1\t# SPDX-License-Identifier: Apache-2.0\n2\t# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3\t# SPDX-FileCopyrightText: Songlin Yang, Yu Zhang\n4\t#\n5\t# This file contains code copied from the flash-linear-attention project.\n6\t# The original source code was licensed under the MIT license and included\n7\t# the following copyright notice:\n8\t# Copyright (c) 2023-2025, Songlin Yang, Yu Zhang\n9\t# ruff: noqa: E501\n10\t\n11\timport torch\n12\t\n13\tfrom vllm.triton_utils import tl, triton\n14\t\n15\tfrom .op import exp, log\n16\t\n17\t\n18\t@triton.heuristics(\n19\t    {\n20\t        \"USE_INITIAL_STATE\": lambda args: args[\"h0\"] is not None,\n21\t        \"IS_VARLEN\": lambda args: args[\"cu_seqlens\"] is not None,\n22\t        \"IS_CONTINUOUS_BATCHING\": lambda args: args[\"ssm_state_indices\"] is not None,\n23\t        \"IS_SPEC_DECODING\": lambda args: args[\"num_accepted_tokens\"] is not None,\n24\t    }\n25\t)\n26\t@triton.jit(do_not_specialize=[\"N\", \"T\"])\n27\tdef fused_recurrent_gated_delta_rule_fwd_kernel(\n28\t    q,\n29\t    k,\n30\t    v,\n31\t    g,\n32\t    beta,\n33\t    o,\n34\t    h0,\n35\t    ht,\n36\t    cu_seqlens,\n37\t    ssm_state_indices,\n38\t    num_accepted_tokens,\n39\t    scale,\n40\t    N: tl.int64,  # num of sequences\n41\t    T: tl.int64,  # num of tokens\n42\t    B: tl.constexpr,\n43\t    H: tl.constexpr,\n44\t    HV: tl.constexpr,\n45\t    K: tl.constexpr,\n46\t    V: tl.constexpr,\n47\t    BK: tl.constexpr,\n48\t    BV: tl.constexpr,\n49\t    stride_init_state_token: [REDACTED],\n50\t    stride_final_state_token: [REDACTED],\n51\t    stride_indices_seq: tl.constexpr,\n52\t    stride_indices_tok: tl.constexpr,\n53\t    USE_INITIAL_STATE: tl.constexpr,  # whether to use initial state\n54\t    INPLACE_FINAL_STATE: tl.constexpr,  # whether to store final state inplace\n55\t    IS_BETA_HEADWISE: tl.constexpr,  # whether beta is headwise vector or scalar,\n56\t    USE_QK_L2NORM_IN_KERNEL: tl.constexpr,\n57\t    IS_VARLEN: tl.constexpr,\n58\t    IS_CONTINUOUS_BATCHING: tl.constexpr,\n59\t    IS_SPEC_DECODING: tl.constexpr,\n60\t    IS_KDA: tl.constexpr,\n61\t):\n62\t    i_k, i_v, i_nh = tl.program_id(0), tl.program_id(1), tl.program_id(2)\n63\t    i_n, i_hv = i_nh // HV, i_nh % HV\n64\t    i_h = i_hv // (HV // H)\n65\t    if IS_VARLEN:\n66\t        bos, eos = (\n67\t            tl.load(cu_seqlens + i_n).to(tl.int64),\n68\t            tl.load(cu_seqlens + i_n + 1).to(tl.int64),\n69\t        )\n70\t        all = T\n71\t        T = eos - bos\n72\t    else:\n73\t        bos, eos = i_n * T, i_n * T + T\n74\t        all = B * T\n75\t\n76\t    if T == 0:\n77\t        # no tokens to process for this sequence\n78\t        return\n79\t\n80\t    o_k = i_k * BK + tl.arange(0, BK)\n81\t    o_v = i_v * BV + tl.arange(0, BV)\n82\t\n83\t    p_q = q + (bos * H + i_h) * K + o_k\n84\t    p_k = k + (bos * H + i_h) * K + o_k\n85\t    p_v = v + (bos * HV + i_hv) * V + o_v\n86\t    if IS_BETA_HEADWISE:\n87\t        p_beta = beta + (bos * HV + i_hv) * V + o_v\n88\t    else:\n89\t        p_beta = beta + bos * HV + i_hv\n90\t\n91\t    if not IS_KDA:\n92\t        p_g = g + bos * HV + i_hv\n93\t    else:\n94\t        p_gk = g + (bos * HV + i_hv) * K + o_k\n95\t\n96\t    p_o = o + ((i_k * all + bos) * HV + i_hv) * V + o_v\n97\t\n98\t    mask_k = o_k < K\n99\t    mask_v = o_v < V\n100\t    mask_h = mask_v[:, None] & mask_k[None, :]\n101\t\n102\t    b_h = tl.zeros([BV, BK], dtype=tl.float32)\n103\t    if USE_INITIAL_STATE:\n104\t        if IS_CONTINUOUS_BATCHING:\n105\t            if IS_SPEC_DECODING:\n106\t                i_t = tl.load(num_accepted_tokens + i_n).to(tl.int64) - 1\n107\t            else:\n108\t                i_t = 0\n109\t            # Load state index and check for invalid entries\n110\t            state_idx = tl.load(ssm_state_indices + i_n * stride_indices_seq + i_t).to(\n111\t                tl.int64\n112\t            )\n113\t            # Skip if state index is invalid (NULL_BLOCK_ID=0)\n114\t            if state_idx <= 0:\n115\t                return\n116\t            p_h0 = h0 + state_idx * stride_init_state_token\n117\t        else:\n118\t            p_h0 = h0 + bos * HV * V * K\n119\t        p_h0 = p_h0 + i_hv * V * K + o_v[:, None] * K + o_k[None, :]\n120\t        b_h += tl.load(p_h0, mask=mask_h, other=0).to(tl.float32)\n121\t\n122\t    for i_t in range(0, T):\n123\t        b_q = tl.load(p_q, mask=mask_k, other=0).to(tl.float32)\n124\t        b_k = tl.load(p_k, mask=mask_k, other=0).to(tl.float32)\n125\t        b_v = tl.load(p_v, mask=mask_v, other=0).to(tl.float32)\n126\t\n127\t        if USE_QK_L2NORM_IN_KERNEL:\n128\t            b_q = b_q / tl.sqrt(tl.sum(b_q * b_q) + 1e-6)\n129\t            b_k = b_k / tl.sqrt(tl.sum(b_k * b_k) + 1e-6)\n130\t        b_q = b_q * scale\n131\t        # [BV, BK]\n132\t        if not IS_KDA:\n133\t            b_g = tl.load(p_g).to(tl.float32)\n134\t            b_h *= exp(b_g)\n135\t        else:\n136\t            b_gk = tl.load(p_gk).to(tl.float32)\n137\t            b_h *= exp(b_gk[None, :])\n138\t        # [BV]\n139\t        b_v -= tl.sum(b_h * b_k[None, :], 1)\n140\t        if IS_BETA_HEADWISE:\n141\t            b_beta = tl.load(p_beta, mask=mask_v, other=0).to(tl.float32)\n142\t        else:\n143\t            b_beta = tl.load(p_beta).to(tl.float32)\n144\t        b_v *= b_beta\n145\t        # [BV, BK]\n146\t        b_h += b_v[:, None] * b_k[None, :]\n147\t        # [BV]\n148\t        b_o = tl.sum(b_h * b_q[None, :], 1)\n149\t        tl.store(p_o, b_o.to(p_o.dtype.element_ty), mask=mask_v)\n150\t\n151\t        # keep the states for multi-query tokens\n152\t        if INPLACE_FINAL_STATE:\n153\t            # Load state index and check for invalid entries\n154\t            final_state_idx = tl.load(\n155\t                ssm_state_indices + i_n * stride_indices_seq + i_t\n156\t            ).to(tl.int64)\n157\t            # Only store if state index is valid (not NULL_BLOCK_ID=0)\n158\t            if final_state_idx > 0:\n159\t                p_ht = ht + final_state_idx * stride_final_state_token\n160\t                p_ht = p_ht + i_hv * V * K + o_v[:, None] * K + o_k[None, :]\n161\t                tl.store(p_ht, b_h.to(p_ht.dtype.element_ty), mask=mask_h)\n162\t        else:\n163\t            p_ht = ht + (bos + i_t) * stride_final_state_token\n164\t            p_ht = p_ht + i_hv * V * K + o_v[:, None] * K + o_k[None, :]\n165\t            tl.store(p_ht, b_h.to(p_ht.dtype.element_ty), mask=mask_h)\n166\t\n167\t        p_q += H * K\n168\t        p_k += H * K\n169\t        p_o += HV * V\n170\t        p_v += HV * V\n171\t        if not IS_KDA:\n172\t            p_g += HV\n173\t        else:\n174\t            p_gk += HV * K\n175\t        p_beta += HV * (V if IS_BETA_HEADWISE else 1)\n176\t\n177\t\n178\tdef fused_recurrent_gated_delta_rule_fwd(\n179\t    q: torch.Tensor,\n180\t    k: torch.Tensor,\n181\t    v: torch.Tensor,\n182\t    g: torch.Tensor,\n183\t    beta: torch.Tensor,\n184\t    scale: float,\n185\t    initial_state: torch.Tensor,\n186\t    inplace_final_state: bool = True,\n187\t    cu_seqlens: torch.Tensor | None = None,\n188\t    ssm_state_indices: torch.Tensor | None = None,\n189\t    num_accepted_tokens: torch.Tensor | None = None,\n190\t    use_qk_l2norm_in_kernel: bool = False,\n191\t) -> tuple[torch.Tensor, torch.Tensor]:\n192\t    B, T, H, K, V = *k.shape, v.shape[-1]\n193\t    HV = v.shape[2]\n194\t    N = B if cu_seqlens is None else len(cu_seqlens) - 1\n195\t    BK, BV = triton.next_power_of_2(K), min(triton.next_power_of_2(V), 32)\n196\t    NK, NV = triton.cdiv(K, BK), triton.cdiv(V, BV)\n197\t    assert NK == 1, \"NK > 1 is not supported yet\"\n198\t    num_stages = 3\n199\t    num_warps = 1\n200\t\n201\t    o = q.new_empty(NK, *v.shape)\n202\t    if inplace_final_state:\n203\t        final_state = initial_state\n204\t    else:\n205\t        final_state = q.new_empty(T, HV, V, K, dtype=initial_state.dtype)\n206\t\n207\t    stride_init_state_token = [REDACTED]    stride_final_state_token = [REDACTED]    if ssm_state_indices is None:\n211\t        stride_indices_seq, stride_indices_tok = 1, 1\n212\t    elif ssm_state_indices.ndim == 1:\n213\t        stride_indices_seq, stride_indices_tok = ssm_state_indices.stride(0), 1\n214\t    else:\n215\t        stride_indices_seq, stride_indices_tok = ssm_state_indices.stride()\n216\t\n217\t    grid = (NK, NV, N * HV)\n218\t    fused_recurrent_gated_delta_rule_fwd_kernel[grid](\n219\t        q=q,\n220\t        k=k,\n221\t        v=v,\n222\t        g=g,\n223\t        beta=beta,\n224\t        o=o,\n225\t        h0=initial_state,\n226\t        ht=final_state,\n227\t        cu_seqlens=cu_seqlens,\n228\t        ssm_state_indices=ssm_state_indices,\n229\t        num_accepted_tokens=num_accepted_tokens,\n230\t        scale=scale,\n231\t        N=N,\n232\t        T=T,\n233\t        B=B,\n234\t        H=H,\n235\t        HV=HV,\n236\t        K=K,\n237\t        V=V,\n238\t        BK=BK,\n239\t        BV=BV,\n240\t        stride_init_state_token=[REDACTED],\n241\t        stride_final_state_token=[REDACTED],\n242\t        stride_indices_seq=stride_indices_seq,\n243\t        stride_indices_tok=stride_indices_tok,\n244\t        IS_BETA_HEADWISE=beta.ndim == v.ndim,\n245\t        USE_QK_L2NORM_IN_KERNEL=use_qk_l2norm_in_kernel,\n246\t        INPLACE_FINAL_STATE=inplace_final_state,\n247\t        IS_KDA=False,\n248\t        num_warps=num_warps,\n249\t        num_stages=num_stages,\n250\t    )\n251\t    o = o.squeeze(0)\n252\t    return o, final_state\n253\t\n254\t\n255\t@triton.jit\n256\tdef fused_recurrent_gated_delta_rule_packed_decode_kernel(\n257\t    mixed_qkv,\n258\t    a,\n259\t    b,\n260\t    A_log,\n261\t    dt_bias,\n262\t    o,\n263\t    h0,\n264\t    ht,\n265\t    ssm_state_indices,\n266\t    scale,\n267\t    stride_mixed_qkv_tok: tl.constexpr,\n268\t    stride_a_tok: tl.constexpr,\n269\t    stride_b_tok: tl.constexpr,\n270\t    stride_init_state_token: [REDACTED],\n271\t    stride_final_state_token: [REDACTED],\n272\t    stride_indices_seq: tl.constexpr,\n273\t    H: tl.constexpr,\n274\t    HV: tl.constexpr,\n275\t    K: tl.constexpr,\n276\t    V: tl.constexpr,\n277\t    BK: tl.constexpr,\n278\t    BV: tl.constexpr,\n279\t    SOFTPLUS_THRESHOLD: tl.constexpr,\n280\t    USE_QK_L2NORM_IN_KERNEL: tl.constexpr,\n281\t    SPLIT_BATCH_HEAD_GRID: tl.constexpr,\n282\t):\n283\t    if SPLIT_BATCH_HEAD_GRID:\n284\t        i_v, i_hv, i_n = tl.program_id(0), tl.program_id(1), tl.program_id(2)\n285\t    else:\n286\t        i_v, i_nh = tl.program_id(0), tl.program_id(1)\n287\t        i_n, i_hv = i_nh // HV, i_nh % HV\n288\t    i_h = i_hv // (HV // H)\n289\t\n290\t    o_k = tl.arange(0, BK)\n291\t    o_v = i_v * BV + tl.arange(0, BV)\n292\t    mask_k = o_k < K\n293\t    mask_v = o_v < V\n294\t    mask_h = mask_v[:, None] & mask_k[None, :]\n295\t\n296\t    state_idx = tl.load(ssm_state_indices + i_n * stride_indices_seq).to(tl.int64)\n297\t    p_o = o + (i_n * HV + i_hv) * V + o_v\n298\t\n299\t    # Skip if state index is invalid (NULL_BLOCK_ID=0)\n300\t    if state_idx <= 0:\n301\t        zero = tl.zeros([BV], dtype=tl.float32).to(p_o.dtype.element_ty)\n302\t        tl.store(p_o, zero, mask=mask_v)\n303\t        return\n304\t\n305\t    p_h0 = h0 + state_idx * stride_init_state_token\n306\t    p_h0 = p_h0 + i_hv * V * K + o_v[:, None] * K + o_k[None, :]\n307\t    b_h = tl.load(p_h0, mask=mask_h, other=0).to(tl.float32)\n308\t\n309\t    p_mixed = mixed_qkv + i_n * stride_mixed_qkv_tok\n310\t    q_off = i_h * K + o_k\n311\t    k_off = (H * K) + i_h * K + o_k\n312\t    v_off = (2 * H * K) + i_hv * V + o_v\n313\t    b_q = tl.load(p_mixed + q_off, mask=mask_k, other=0).to(tl.float32)\n314\t    b_k = tl.load(p_mixed + k_off, mask=mask_k, other=0).to(tl.float32)\n315\t    b_v = tl.load(p_mixed + v_off, mask=mask_v, other=0).to(tl.float32)\n316\t\n317\t    if USE_QK_L2NORM_IN_KERNEL:\n318\t        b_q = b_q / tl.sqrt(tl.sum(b_q * b_q) + 1e-6)\n319\t        b_k = b_k / tl.sqrt(tl.sum(b_k * b_k) + 1e-6)\n320\t    b_q = b_q * scale\n321\t\n322\t    a_val = tl.load(a + i_n * stride_a_tok + i_hv).to(tl.float32)\n323\t    b_val = tl.load(b + i_n * stride_b_tok + i_hv).to(tl.float32)\n324\t    A_log_val = tl.load(A_log + i_hv).to(tl.float32)\n325\t    dt_bias_val = tl.load(dt_bias + i_hv).to(tl.float32)\n326\t    x = a_val + dt_bias_val\n327\t    softplus_x = tl.where(x <= SOFTPLUS_THRESHOLD, tl.log(1.0 + tl.exp(x)), x)\n328\t    g_val = -tl.exp(A_log_val) * softplus_x\n329\t    beta_val = tl.sigmoid(b_val).to(b.dtype.element_ty).to(tl.float32)\n330\t\n331\t    b_h *= exp(g_val)\n332\t    b_v -= tl.sum(b_h * b_k[None, :], 1)\n333\t    b_v *= beta_val\n334\t    b_h += b_v[:, None] * b_k[None, :]\n335\t    b_o = tl.sum(b_h * b_q[None, :], 1)\n336\t    tl.store(p_o, b_o.to(p_o.dtype.element_ty), mask=mask_v)\n337\t\n338\t    p_ht = ht + state_idx * stride_final_state_token\n339\t    p_ht = p_ht + i_hv * V * K + o_v[:, None] * K + o_k[None, :]\n340\t    tl.store(p_ht, b_h.to(p_ht.dtype.element_ty), mask=mask_h)\n341\t\n342\t\n343\tdef fused_recurrent_gated_delta_rule_packed_decode(\n344\t    mixed_qkv: torch.Tensor,\n345\t    a: torch.Tensor,\n346\t    b: torch.Tensor,\n347\t    A_log: torch.Tensor,\n348\t    dt_bias: torch.Tensor,\n349\t    scale: float,\n350\t    initial_state: torch.Tensor,\n351\t    out: torch.Tensor,\n352\t    ssm_state_indices: torch.Tensor,\n353\t    use_qk_l2norm_in_kernel: bool = False,\n354\t) -> tuple[torch.Tensor, torch.Tensor]:\n355\t    if mixed_qkv.ndim != 2:\n356\t        raise ValueError(\n357\t            f\"`mixed_qkv` must be a 2D tensor (got ndim={mixed_qkv.ndim}).\"\n358\t        )\n359\t    if mixed_qkv.stride(-1) != 1:\n360\t        raise ValueError(\"`mixed_qkv` must be contiguous in the last dim.\")\n361\t    if a.ndim != 2 or b.ndim != 2:\n362\t        raise ValueError(\n363\t            f\"`a` and `b` must be 2D tensors (got a.ndim={a.ndim}, b.ndim={b.ndim}).\"\n364\t        )\n365\t    if a.stride(-1) != 1 or b.stride(-1) != 1:\n366\t        raise ValueError(\"`a`/`b` must be contiguous in the last dim.\")\n367\t    if A_log.ndim != 1 or dt_bias.ndim != 1:\n368\t        raise ValueError(\"`A_log`/`dt_bias` must be 1D tensors.\")\n369\t    if A_log.stride(0) != 1 or dt_bias.stride(0) != 1:\n370\t        raise ValueError(\"`A_log`/`dt_bias` must be contiguous.\")\n371\t    if ssm_state_indices.ndim != 1:\n372\t        raise ValueError(\n373\t            f\"`ssm_state_indices` must be 1D for packed decode (got ndim={ssm_state_indices.ndim}).\"\n374\t        )\n375\t    if not out.is_contiguous():\n376\t        raise ValueError(\"`out` must be contiguous.\")\n377\t\n378\t    dev = mixed_qkv.device\n379\t    if (\n380\t        a.device != dev\n381\t        or b.device != dev\n382\t        or A_log.device != dev\n383\t        or dt_bias.device != dev\n384\t        or initial_state.device != dev\n385\t        or out.device != dev\n386\t        or ssm_state_indices.device != dev\n387\t    ):\n388\t        raise ValueError(\"All inputs must be on the same device.\")\n389\t\n390\t    B = mixed_qkv.shape[0]\n391\t    if a.shape[0] != B or b.shape[0] != B:\n392\t        raise ValueError(\n393\t            \"Mismatched batch sizes: \"\n394\t            f\"mixed_qkv.shape[0]={B}, a.shape[0]={a.shape[0]}, b.shape[0]={b.shape[0]}.\"\n395\t        )\n396\t    if ssm_state_indices.shape[0] != B:\n397\t        raise ValueError(\n398\t            f\"`ssm_state_indices` must have shape [B] (got {tuple(ssm_state_indices.shape)}; expected ({B},)).\"\n399\t        )\n400\t\n401\t    if initial_state.ndim != 4:\n402\t        raise ValueError(\n403\t            f\"`initial_state` must be a 4D tensor (got ndim={initial_state.ndim}).\"\n404\t        )\n405\t    if initial_state.stride(-1) != 1:\n406\t        raise ValueError(\"`initial_state` must be contiguous in the last dim.\")\n407\t    HV, V, K = initial_state.shape[-3:]\n408\t    if a.shape[1] != HV or b.shape[1] != HV:\n409\t        raise ValueError(\n410\t            f\"`a`/`b` must have shape [B, HV] with HV={HV} (got a.shape={tuple(a.shape)}, b.shape={tuple(b.shape)}).\"\n411\t        )\n412\t    if A_log.numel() != HV or dt_bias.numel() != HV:\n413\t        raise ValueError(\n414\t            f\"`A_log` and `dt_bias` must have {HV} elements (got A_log.numel()={A_log.numel()}, dt_bias.numel()={dt_bias.numel()}).\"\n415\t        )\n416\t    if out.shape != (B, 1, HV, V):\n417\t        raise ValueError(\n418\t            f\"`out` must have shape {(B, 1, HV, V)} (got out.shape={tuple(out.shape)}).\"\n419\t        )\n420\t\n421\t    qkv_dim = mixed_qkv.shape[1]\n422\t    qk_dim = qkv_dim - HV * V\n423\t    if qk_dim <= 0 or qk_dim % 2 != 0:\n424\t        raise ValueError(\n425\t            f\"Invalid packed `mixed_qkv` last dim={qkv_dim} for HV={HV}, V={V}.\"\n426\t        )\n427\t    q_dim = qk_dim // 2\n428\t    if q_dim % K != 0:\n429\t        raise ValueError(f\"Invalid packed Q size {q_dim}: must be divisible by K={K}.\")\n430\t    H = q_dim // K\n431\t    if H <= 0 or HV % H != 0:\n432\t        raise ValueError(\n433\t            f\"Invalid head config inferred from mixed_qkv: H={H}, HV={HV}.\"\n434\t        )\n435\t\n436\t    BK = triton.next_power_of_2(K)\n437\t    if triton.cdiv(K, BK) != 1:\n438\t        raise ValueError(\n439\t            f\"Packed decode kernel only supports NK=1 (got K={K}, BK={BK}).\"\n440\t        )\n441\t    BV = min(triton.next_power_of_2(V), 32)\n442\t    num_stages = 3\n443\t    num_warps = 1\n444\t\n445\t    stride_mixed_qkv_tok = mixed_qkv.stride(0)\n446\t    stride_a_tok = a.stride(0)\n447\t    stride_b_tok = b.stride(0)\n448\t    stride_init_state_token = [REDACTED]    stride_final_state_token = [REDACTED]    stride_indices_seq = ssm_state_indices.stride(0)\n451\t\n452\t    NV = triton.cdiv(V, BV)\n453\t    # CUDA limits grid Y/Z dimensions to 65535.\n454\t    split_batch_head_grid = B * HV > 65535\n455\t    grid = (NV, HV, B) if split_batch_head_grid else (NV, B * HV)\n456\t    fused_recurrent_gated_delta_rule_packed_decode_kernel[grid](\n457\t        mixed_qkv=mixed_qkv,\n458\t        a=a,\n459\t        b=b,\n460\t        A_log=A_log,\n461\t        dt_bias=dt_bias,\n462\t        o=out,\n463\t        h0=initial_state,\n464\t        ht=initial_state,\n465\t        ssm_state_indices=ssm_state_indices,\n466\t        scale=scale,\n467\t        stride_mixed_qkv_tok=stride_mixed_qkv_tok,\n468\t        stride_a_tok=stride_a_tok,\n469\t        stride_b_tok=stride_b_tok,\n470\t        stride_init_state_token=[REDACTED],\n471\t        stride_final_state_token=[REDACTED],\n472\t        stride_indices_seq=stride_indices_seq,\n473\t        H=H,\n474\t        HV=HV,\n475\t        K=K,\n476\t        V=V,\n477\t        BK=BK,\n478\t        BV=BV,\n479\t        SOFTPLUS_THRESHOLD=20.0,\n480\t        USE_QK_L2NORM_IN_KERNEL=use_qk_l2norm_in_kernel,\n481\t        SPLIT_BATCH_HEAD_GRID=split_batch_head_grid,\n482\t        num_warps=num_warps,\n483\t        num_stages=num_stages,\n484\t    )\n485\t    return out, initial_state\n486\t\n487\t\n488\tclass FusedRecurrentFunction(torch.autograd.Function):\n489\t    @staticmethod\n490\t    def forward(\n491\t        ctx,\n492\t        q: torch.Tensor,\n493\t        k: torch.Tensor,\n494\t        v: torch.Tensor,\n495\t        g: torch.Tensor,\n496\t        beta: torch.Tensor,\n497\t        scale: float,\n498\t        initial_state: torch.Tensor,\n499\t        inplace_final_state: bool = True,\n500\t        cu_seqlens: torch.Tensor | None = None,\n501\t        ssm_state_indices: torch.Tensor | None = None,\n502\t        num_accepted_tokens: torch.Tensor | None = None,\n503\t        use_qk_l2norm_in_kernel: bool = False,\n504\t    ):\n505\t        o, final_state = fused_recurrent_gated_delta_rule_fwd(\n506\t            q=q.contiguous(),\n507\t            k=k.contiguous(),\n508\t            v=v.contiguous(),\n509\t            g=g.contiguous(),\n510\t            beta=beta.contiguous(),\n511\t            scale=scale,\n512\t            initial_state=initial_state,\n513\t            inplace_final_state=inplace_final_state,\n514\t            cu_seqlens=cu_seqlens,\n515\t            ssm_state_indices=ssm_state_indices,\n516\t            num_accepted_tokens=num_accepted_tokens,\n517\t            use_qk_l2norm_in_kernel=use_qk_l2norm_in_kernel,\n518\t        )\n519\t\n520\t        return o, final_state\n521\t\n522\t\n523\tdef fused_recurrent_gated_delta_rule(\n524\t    q: torch.Tensor,\n525\t    k: torch.Tensor,\n526\t    v: torch.Tensor,\n527\t    g: torch.Tensor,\n528\t    beta: torch.Tensor = None,\n529\t    scale: float = None,\n530\t    initial_state: torch.Tensor = None,\n531\t    inplace_final_state: bool = True,\n532\t    cu_seqlens: torch.Tensor | None = None,\n533\t    ssm_state_indices: torch.Tensor | None = None,\n534\t    num_accepted_tokens: torch.Tensor | None = None,\n535\t    use_qk_l2norm_in_kernel: bool = False,\n536\t) -> tuple[torch.Tensor, torch.Tensor]:\n537\t    r\"\"\"\n538\t    Args:\n539\t        q (torch.Tensor):\n540\t            queries of shape `[B, T, H, K]`.\n541\t        k (torch.Tensor):\n542\t            keys of shape `[B, T, H, K]`.\n543\t        v (torch.Tensor):\n544\t            values of shape `[B, T, HV, V]`.\n545\t            GVA is applied if `HV > H`.\n546\t        g (torch.Tensor):\n547\t            g (decays) of shape `[B, T, HV]`.\n548\t        beta (torch.Tensor):\n549\t            betas of shape `[B, T, HV]`.\n550\t        scale (Optional[int]):\n551\t            Scale factor for the RetNet attention scores.\n552\t            If not provided, it will default to `1 / sqrt(K)`. Default: `None`.\n553\t        initial_state (Optional[torch.Tensor]):\n554\t            Initial state of shape `[N, HV, V, K]` for `N` input sequences.\n555\t            For equal-length input sequences, `N` equals the batch size `B`.\n556\t            Default: `None`.\n557\t        inplace_final_state: bool:\n558\t            Whether to store the final state in-place to save memory.\n559\t            Default: `True`.\n560\t        cu_seqlens (torch.Tensor):\n561\t            Cumulative sequence lengths of shape `[N+1]` used for variable-length training,\n562\t            consistent with the FlashAttention API.\n563\t        ssm_state_indices (Optional[torch.Tensor]):\n564\t            Indices to map the input sequences to the initial/final states.\n565\t        num_accepted_tokens (Optional[torch.Tensor]):\n566\t            Number of accepted tokens for each sequence during decoding.\n567\t\n568\t    Returns:\n569\t        o (torch.Tensor):\n570\t            Outputs of shape `[B, T, HV, V]`.\n571\t        final_state (torch.Tensor):\n572\t            Final state of shape `[N, HV, V, K]`.\n573\t\n574\t    Examples::\n575\t        >>> import torch\n576\t        >>> import torch.nn.functional as F\n577\t        >>> from einops import rearrange\n578\t        >>> from fla.ops.gated_delta_rule import fused_recurrent_gated_delta_rule\n579\t        # inputs with equal lengths\n580\t        >>> B, T, H, HV, K, V = 4, 2048, 4, 8, 512, 512\n581\t        >>> q = torch.randn(B, T, H, K, device='cuda')\n582\t        >>> k = F.normalize(torch.randn(B, T, H, K, device='cuda'), p=2, dim=-1)\n583\t        >>> v = torch.randn(B, T, HV, V, device='cuda')\n584\t        >>> g = F.logsigmoid(torch.rand(B, T, HV, device='cuda'))\n585\t        >>> beta = torch.rand(B, T, HV, device='cuda').sigmoid()\n586\t        >>> h0 = torch.randn(B, HV, V, K, device='cuda')\n587\t        >>> o, ht = fused_gated_recurrent_delta_rule(\n588\t            q, k, v, g, beta,\n589\t            initial_state=h0,\n590\t        )\n591\t        # for variable-length inputs, the batch size `B` is expected to be 1 and `cu_seqlens` is required\n592\t        >>> q, k, v, g, beta = map(lambda x: rearrange(x, 'b t ... -> 1 (b t) ...'), (q, k, v, g, beta))\n593\t        # for a batch with 4 sequences, `cu_seqlens` with 5 start/end positions are expected\n594\t        >>> cu_seqlens = q.new_tensor([0, 2048, 4096, 6144, 8192], dtype=torch.int32)\n595\t        >>> o_var, ht_var = fused_gated_recurrent_delta_rule(\n596\t            q, k, v, g, beta,\n597\t            initial_state=h0,\n598\t            cu_seqlens=cu_seqlens\n599\t        )\n600\t    \"\"\"\n601\t    if cu_seqlens is not None and q.shape[0] != 1:\n602\t        raise ValueError(\n603\t            f\"The batch size is expected to be 1 rather than {q.shape[0]} when using `cu_seqlens`.\"\n604\t            f\"Please flatten variable-length inputs before processing.\"\n605\t        )\n606\t    if scale is None:\n607\t        scale = k.shape[-1] ** -0.5\n608\t    else:\n609\t        assert scale > 0, \"scale must be positive\"\n610\t    if beta is None:\n611\t        beta = torch.ones_like(q[..., 0])\n612\t    o, final_state = FusedRecurrentFunction.apply(\n613\t        q,\n614\t        k,\n615\t        v,\n616\t        g,\n617\t        beta,\n618\t        scale,\n619\t        initial_state,\n620\t        inplace_final_state,\n621\t        cu_seqlens,\n622\t        ssm_state_indices,\n623\t        num_accepted_tokens,\n624\t        use_qk_l2norm_in_kernel,\n625\t    )\n626\t    return o, final_state\n627\t"}]},"parent_tool_use_id":"call_a4861364bd941f5d","session_id":"4f5fa1a2-e349-4774-856c-cb06ca25bfcd","uuid":"8205536a-d3bc-4057-afc9-8b27e35fe074","timestamp":"2026-09-15T12:21:42.601Z","subagent_type":"hyperloom-leaf","task_description":"Read GDN decode kernel paths"}
