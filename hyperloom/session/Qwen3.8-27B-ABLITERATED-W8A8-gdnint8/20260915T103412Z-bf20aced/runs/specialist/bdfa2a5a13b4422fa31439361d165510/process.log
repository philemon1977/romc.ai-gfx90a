{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b094d0e874eedfcd","type":"tool_result","content":"1\t# SPDX-License-Identifier: Apache-2.0\n2\t# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3\t# SPDX-FileCopyrightText: Songlin Yang, Yu Zhang\n4\t#\n5\t# This file contains code copied from the flash-linear-attention project.\n6\t# The original source code was licensed under the MIT license and included\n7\t# the following copyright notice:\n8\t# Copyright (c) 2023-2025, Songlin Yang, Yu Zhang\n9\t\n10\timport torch\n11\t\n12\tfrom vllm.triton_utils import tl, triton\n13\t\n14\t\n15\t@triton.heuristics(\n16\t    {\n17\t        \"USE_INITIAL_STATE\": lambda args: args[\"h0\"] is not None,\n18\t        \"IS_VARLEN\": lambda args: args[\"cu_seqlens\"] is not None,\n19\t        \"IS_CONTINUOUS_BATCHING\": lambda args: args[\"ssm_state_indices\"] is not None,\n20\t        \"IS_SPEC_DECODING\": lambda args: args[\"num_accepted_tokens\"] is not None,\n21\t    }\n22\t)\n23\t@triton.jit(do_not_specialize=[\"N\", \"T\"])\n24\tdef fused_sigmoid_gating_delta_rule_update_kernel(\n25\t    A_log,\n26\t    a,\n27\t    b,\n28\t    dt_bias,\n29\t    beta,\n30\t    threshold,\n31\t    q,\n32\t    k,\n33\t    v,\n34\t    o,\n35\t    h0,\n36\t    ht,\n37\t    cu_seqlens,\n38\t    ssm_state_indices,\n39\t    num_accepted_tokens,\n40\t    scale,\n41\t    N: tl.int64,  # num of sequences\n42\t    T: tl.int64,  # num of tokens\n43\t    B: tl.constexpr,\n44\t    H: tl.constexpr,\n45\t    HV: tl.constexpr,\n46\t    K: tl.constexpr,\n47\t    V: tl.constexpr,\n48\t    BK: tl.constexpr,\n49\t    BV: tl.constexpr,\n50\t    stride_init_state_token: [REDACTED],\n51\t    stride_final_state_token: [REDACTED],\n52\t    stride_indices_seq: tl.constexpr,\n53\t    stride_indices_tok: tl.constexpr,\n54\t    USE_INITIAL_STATE: tl.constexpr,  # whether to use initial state\n55\t    INPLACE_FINAL_STATE: tl.constexpr,  # whether to store final state inplace\n56\t    USE_QK_L2NORM_IN_KERNEL: tl.constexpr,\n57\t    IS_VARLEN: tl.constexpr,\n58\t    IS_CONTINUOUS_BATCHING: tl.constexpr,\n59\t    IS_SPEC_DECODING: tl.constexpr,\n60\t    IS_KDA: tl.constexpr,\n61\t):\n62\t    i_k, i_v, i_nh = tl.program_id(0), tl.program_id(1), tl.program_id(2)\n63\t    i_n, i_hv = i_nh // HV, i_nh % HV\n64\t    i_h = i_hv // (HV // H)\n65\t    if IS_VARLEN:\n66\t        bos, eos = (\n67\t            tl.load(cu_seqlens + i_n).to(tl.int64),\n68\t            tl.load(cu_seqlens + i_n + 1).to(tl.int64),\n69\t        )\n70\t        all = T\n71\t        T = eos - bos\n72\t    else:\n73\t        bos, eos = i_n * T, i_n * T + T\n74\t        all = B * T\n75\t\n76\t    if T == 0:\n77\t        # no tokens to process for this sequence\n78\t        return\n79\t\n80\t    o_k = i_k * BK + tl.arange(0, BK)\n81\t    o_v = i_v * BV + tl.arange(0, BV)\n82\t\n83\t    p_q = q + (bos * H + i_h) * K + o_k\n84\t    p_k = k + (bos * H + i_h) * K + o_k\n85\t    p_v = v + (bos * HV + i_hv) * V + o_v\n86\t\n87\t    p_A_log = A_log + i_hv\n88\t    if not IS_KDA:\n89\t        p_a = a + bos * HV + i_hv\n90\t        p_dt_bias = dt_bias + i_hv\n91\t    else:\n92\t        p_a = a + (bos * HV + i_hv) * K + o_k\n93\t        p_dt_bias = dt_bias + i_hv * K + o_k\n94\t\n95\t    p_b = b + bos * HV + i_hv\n96\t    p_o = o + ((i_k * all + bos) * HV + i_hv) * V + o_v\n97\t\n98\t    mask_k = o_k < K\n99\t    mask_v = o_v < V\n100\t    mask_h = mask_v[:, None] & mask_k[None, :]\n101\t\n102\t    b_h = tl.zeros([BV, BK], dtype=tl.float32)\n103\t    if USE_INITIAL_STATE:\n104\t        if IS_CONTINUOUS_BATCHING:\n105\t            if IS_SPEC_DECODING:\n106\t                i_t = tl.load(num_accepted_tokens + i_n).to(tl.int64) - 1\n107\t            else:\n108\t                i_t = 0\n109\t            # Load state index and check for invalid entries\n110\t            state_idx = tl.load(ssm_state_indices + i_n * stride_indices_seq + i_t).to(\n111\t                tl.int64\n112\t            )\n113\t            # Skip if state index is invalid (NULL_BLOCK_ID=0)\n114\t            if state_idx <= 0:\n115\t                return\n116\t            p_h0 = h0 + state_idx * stride_init_state_token\n117\t        else:\n118\t            p_h0 = h0 + bos * HV * V * K\n119\t        p_h0 = p_h0 + i_hv * V * K + o_v[:, None] * K + o_k[None, :]\n120\t        b_h += tl.load(p_h0, mask=mask_h, other=0).to(tl.float32)\n121\t\n122\t    for i_t in range(0, T):\n123\t        b_q = tl.load(p_q, mask=mask_k, other=0).to(tl.float32)\n124\t        b_k = tl.load(p_k, mask=mask_k, other=0).to(tl.float32)\n125\t        b_v = tl.load(p_v, mask=mask_v, other=0).to(tl.float32)\n126\t        b_b = tl.load(p_b).to(tl.float32)\n127\t\n128\t        # If the model is loaded in fp16, without the .float() here, A might be -inf\n129\t        x = tl.load(p_a).to(tl.float32) + tl.load(p_dt_bias).to(tl.float32)\n130\t        softplus_x = tl.where(\n131\t            beta * x <= threshold, (1 / beta) * tl.log(1 + tl.exp(beta * x)), x\n132\t        )\n133\t        b_g = -tl.exp(tl.load(p_A_log).to(tl.float32)) * softplus_x\n134\t\n135\t        # compute beta_output = sigmoid(b)\n136\t        b_beta = tl.sigmoid(b_b.to(tl.float32))\n137\t\n138\t        if USE_QK_L2NORM_IN_KERNEL:\n139\t            b_q = b_q * (tl.rsqrt(tl.sum(b_q * b_q) + 1e-6))\n140\t            b_k = b_k * (tl.rsqrt(tl.sum(b_k * b_k) + 1e-6))\n141\t        b_q = b_q * scale\n142\t        # [BV, BK]\n143\t        if not IS_KDA:\n144\t            b_h *= tl.exp(b_g)\n145\t        else:\n146\t            b_h *= tl.exp(b_g[None, :])\n147\t        # [BV]\n148\t        b_v -= tl.sum(b_h * b_k[None, :], 1)\n149\t        b_v *= b_beta\n150\t        # [BV, BK]\n151\t        b_h += b_v[:, None] * b_k[None, :]\n152\t        # [BV]\n153\t        b_o = tl.sum(b_h * b_q[None, :], 1)\n154\t        tl.store(p_o, b_o.to(p_o.dtype.element_ty), mask=mask_v)\n155\t\n156\t        # keep the states for multi-query tokens\n157\t        if INPLACE_FINAL_STATE:\n158\t            # Load state index and check for invalid entries\n159\t            final_state_idx = tl.load(\n160\t                ssm_state_indices + i_n * stride_indices_seq + i_t\n161\t            ).to(tl.int64)\n162\t            # Only store if state index is valid (not NULL_BLOCK_ID=0)\n163\t            if final_state_idx > 0:\n164\t                p_ht = ht + final_state_idx * stride_final_state_token\n165\t                p_ht = p_ht + i_hv * V * K + o_v[:, None] * K + o_k[None, :]\n166\t                tl.store(p_ht, b_h.to(p_ht.dtype.element_ty), mask=mask_h)\n167\t        else:\n168\t            p_ht = ht + (bos + i_t) * stride_final_state_token\n169\t            p_ht = p_ht + i_hv * V * K + o_v[:, None] * K + o_k[None, :]\n170\t            tl.store(p_ht, b_h.to(p_ht.dtype.element_ty), mask=mask_h)\n171\t\n172\t        # Update pointers for next timestep\n173\t        p_q += H * K\n174\t        p_k += H * K\n175\t        p_o += HV * V\n176\t        p_v += HV * V\n177\t        p_b += HV\n178\t        p_a += HV\n179\t\n180\t\n181\tdef fused_sigmoid_gating_delta_rule_update(\n182\t    A_log: torch.Tensor,\n183\t    a: torch.Tensor,\n184\t    b: torch.Tensor,\n185\t    dt_bias: torch.Tensor,\n186\t    q: torch.Tensor,\n187\t    k: torch.Tensor,\n188\t    v: torch.Tensor,\n189\t    beta: float = 1.0,\n190\t    threshold: float = 20.0,\n191\t    scale: float = None,\n192\t    initial_state: torch.Tensor = None,\n193\t    inplace_final_state: bool = True,\n194\t    cu_seqlens: torch.Tensor | None = None,\n195\t    ssm_state_indices: torch.Tensor | None = None,\n196\t    num_accepted_tokens: torch.Tensor | None = None,\n197\t    use_qk_l2norm_in_kernel: bool = False,\n198\t    is_kda: bool = False,\n199\t):\n200\t    \"\"\"\n201\t    Fused triton implementation of sigmoid gating delta rule update.\n202\t    This function uses a single fused kernel that combines both sigmoid gating\n203\t    computation and the recurrent delta rule update for better performance.\n204\t    \"\"\"\n205\t    B, T, H, K, V = *k.shape, v.shape[-1]\n206\t    HV = v.shape[2]\n207\t    N = B if cu_seqlens is None else len(cu_seqlens) - 1\n208\t    BK, BV = triton.next_power_of_2(K), min(triton.next_power_of_2(V), 32)\n209\t    NK, NV = triton.cdiv(K, BK), triton.cdiv(V, BV)\n210\t    assert NK == 1, \"NK > 1 is not supported yet\"\n211\t    num_stages = 3\n212\t    num_warps = 4\n213\t\n214\t    if cu_seqlens is not None and q.shape[0] != 1:\n215\t        raise ValueError(\n216\t            f\"The batch size is expected to be 1 rather than {q.shape[0]}\"\n217\t            f\" when using `cu_seqlens`. Please flatten variable-length\"\n218\t            f\" inputs before processing.\"\n219\t        )\n220\t    if scale is None:\n221\t        scale = k.shape[-1] ** -0.5\n222\t    else:\n223\t        assert scale > 0, \"scale must be positive\"\n224\t\n225\t    o = q.new_empty(NK, *v.shape)\n226\t    if inplace_final_state:\n227\t        final_state = initial_state\n228\t    else:\n229\t        final_state = q.new_empty(T, HV, V, K, dtype=initial_state.dtype)\n230\t\n231\t    stride_init_state_token = [REDACTED]    stride_final_state_token = [REDACTED]    if ssm_state_indices is None:\n235\t        stride_indices_seq, stride_indices_tok = 1, 1\n236\t    elif ssm_state_indices.ndim == 1:\n237\t        stride_indices_seq, stride_indices_tok = ssm_state_indices.stride(0), 1\n238\t    else:\n239\t        stride_indices_seq, stride_indices_tok = ssm_state_indices.stride()\n240\t\n241\t    grid = (NK, NV, N * HV)\n242\t    fused_sigmoid_gating_delta_rule_update_kernel[grid](\n243\t        A_log=A_log,\n244\t        a=a.contiguous(),\n245\t        b=b.contiguous(),\n246\t        dt_bias=dt_bias,\n247\t        beta=beta,\n248\t        threshold=threshold,\n249\t        q=q.contiguous(),\n250\t        k=k.contiguous(),\n251\t        v=v.contiguous(),\n252\t        o=o,\n253\t        h0=initial_state,\n254\t        ht=final_state,\n255\t        cu_seqlens=cu_seqlens,\n256\t        ssm_state_indices=ssm_state_indices,\n257\t        num_accepted_tokens=num_accepted_tokens,\n258\t        scale=scale,\n259\t        N=N,\n260\t        T=T,\n261\t        B=B,\n262\t        H=H,\n263\t        HV=HV,\n264\t        K=K,\n265\t        V=V,\n266\t        BK=BK,\n267\t        BV=BV,\n268\t        stride_init_state_token=[REDACTED],\n269\t        stride_final_state_token=[REDACTED],\n270\t        stride_indices_seq=stride_indices_seq,\n271\t        stride_indices_tok=stride_indices_tok,\n272\t        INPLACE_FINAL_STATE=inplace_final_state,\n273\t        USE_QK_L2NORM_IN_KERNEL=use_qk_l2norm_in_kernel,\n274\t        IS_KDA=is_kda,\n275\t        num_warps=num_warps,\n276\t        num_stages=num_stages,\n277\t    )\n278\t    o = o.squeeze(0)\n279\t    return o, final_state\n280\t"}]},"parent_tool_use_id":"call_a4861364bd941f5d","session_id":"4f5fa1a2-e349-4774-856c-cb06ca25bfcd","uuid":"023882b6-2664-4aad-a2ed-0058a4b8df0a","timestamp":"2026-09-15T12:21:45.156Z","subagent_type":"hyperloom-leaf","task_description":"Read GDN decode kernel paths"}
