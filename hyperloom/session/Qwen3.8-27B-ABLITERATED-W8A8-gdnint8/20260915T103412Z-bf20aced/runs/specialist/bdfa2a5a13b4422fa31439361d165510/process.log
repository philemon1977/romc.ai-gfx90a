l(\n1987\t    g,\n1988\t    beta_output,\n1989\t    A_log,\n1990\t    a,\n1991\t    b,\n1992\t    dt_bias,\n1993\t    seq_len,\n1994\t    NUM_HEADS: tl.constexpr,\n1995\t    beta: tl.constexpr,\n1996\t    threshold: tl.constexpr,\n1997\t    BLK_HEADS: tl.constexpr,\n1998\t):\n1999\t    i_b, i_s, i_d = tl.program_id(0), tl.program_id(1), tl.program_id(2)\n2000\t    head_off = i_d * BLK_HEADS + tl.arange(0, BLK_HEADS)\n2001\t    off = i_b * seq_len * NUM_HEADS + i_s * NUM_HEADS + head_off\n2002\t    mask = head_off < NUM_HEADS\n2003\t    blk_A_log = tl.load(A_log + head_off, mask=mask)\n2004\t    blk_a = tl.load(a + off, mask=mask)\n2005\t    blk_b = tl.load(b + off, mask=mask)\n2006\t    blk_bias = tl.load(dt_bias + head_off, mask=mask)\n2007\t    # If the model is loaded in fp16, without the .float() here, A might be -inf\n2008\t    x = blk_a.to(tl.float32) + blk_bias.to(tl.float32)\n2009\t    softplus_x = tl.where(\n2010\t        beta * x <= threshold, (1 / beta) * tl.log(1 + tl.exp(beta * x)), x\n2011\t    )\n2012\t    blk_g = -tl.exp(blk_A_log.to(tl.float32)) * softplus_x\n2013\t    tl.store(g + off, blk_g.to(g.dtype.element_ty), mask=mask)\n2014\t    # compute beta_output = sigmoid(b)\n2015\t    blk_beta_output = tl.sigmoid(blk_b.to(tl.float32))\n2016\t    tl.store(\n2017\t        beta_output + off, blk_beta_output.to(beta_output.dtype.element_ty), mask=mask\n2018\t    )\n2019\t\n2020\t\n2021\tdef fused_gdn_gating(\n2022\t    A_log: torch.Tensor,\n2023\t    a: torch.Tensor,\n2024\t    b: torch.Tensor,\n2025\t    dt_bias: torch.Tensor,\n2026\t    beta: float = 1.0,\n2027\t    threshold: float = 20.0,\n2028\t) -> tuple[torch.Tensor, torch.Tensor]:\n2029\t    \"\"\"\n2030\t    Fused computation of g and beta for Gated Delta Net.\n2031\t    g = -self.A_log.float().exp() * F.softplus(a.float() + self.dt_bias)\n2032\t    beta_output = b.sigmoid()\n2033\t    TODO maybe use torch.compile to replace this triton kernel\n2034\t    \"\"\"\n2035\t    batch, num_heads = a.sha