{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_9c18c5ea7ad7b43d","type":"tool_result","content":"########## config/scheduler.py ##########\n1:# SPDX-License-Identifier: Apache-2.0\n2:# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3:\n4:from collections.abc import Callable\n5:from dataclasses import InitVar\n6:from typing import TYPE_CHECKING, Any, ClassVar, Literal, cast\n7:\n8:from pydantic import Field, field_validator\n9:from typing_extensions import Self\n10:\n11:from vllm.config.utils import config\n12:from vllm.logger import init_logger\n13:from vllm.utils.hashing import safe_hash\n14:from vllm.utils.import_utils import resolve_obj_by_qualname\n15:\n16:if TYPE_CHECKING:\n17:    from vllm.v1.core.sched.interface import SchedulerInterface\n18:\n19:logger = init_logger(__name__)\n20:\n21:RunnerType = Literal[\"generate\", \"pooling\", \"draft\"]\n22:SchedulerPolicy = Literal[\"fcfs\", \"priority\"]\n23:\n24:\n25:@config\n26:class SchedulerConfig:\n27:    \"\"\"Scheduler configuration.\"\"\"\n28:\n29:    max_model_len: InitVar[int]\n30:    \"\"\"Maximum length of a sequence (including prompt and generated text).\n31:\n32:    Note: This is stored in the ModelConfig, and is used only here to\n33:    provide fallbacks and validate other attributes.\"\"\"\n34:\n35:    is_encoder_decoder: InitVar[bool]\n36:    \"\"\"True if the model is an encoder-decoder model.\n37:\n38:    Note: This is stored in the ModelConfig, and is used only here to\n39:    disable chunked prefill and prefix caching for encoder-decoder models.\n40:    \"\"\"\n41:\n42:    DEFAULT_MAX_NUM_BATCHED_TOKENS: ClassVar[int] = 2048\n43:    DEFAULT_MAX_NUM_BATCHED_TOKENS_FOR_BATCHED_DP: ClassVar[int] = 256\n44:    DEFAULT_MAX_NUM_SEQS: ClassVar[int] = 128\n45:\n46:    runner_type: RunnerType = \"generate\"\n47:    \"\"\"The runner type to launch for the model.\"\"\"\n48:\n49:    max_num_batched_tokens: int = Field(default=DEFAULT_MAX_NUM_BATCHED_TOKENS, ge=1)\n50:    \"\"\"Maximum number of tokens that can be processed in a single iteration.\n51:\n52:    The default value here is mainly for convenience when testing.\n53:    In real usage, this should be set in `EngineArgs.create_engine_config`.\n54:    \"\"\"\n55:\n56:    max_num_scheduled_tokens: int | None = Field(default=None, ge=0)\n57:    \"\"\"Maximum number of tokens that the scheduler may issue in a single iteration.\n58:    \n59:    This is usually equal to max_num_batched_tokens, but can be smaller in cases\n60:    when the model might append tokens into the batch (such as speculative decoding).\n61:    Defaults to max_num_batched_tokens.\"\"\"\n62:\n63:    max_num_seqs: int = Field(default=DEFAULT_MAX_NUM_SEQS, ge=1)\n64:    \"\"\"Maximum number of sequences to be processed in a single iteration.\n65:\n66:    The default value here is mainly for convenience when testing.\n67:    In real usage, this should be set in `EngineArgs.create_engine_config`.\n68:    \"\"\"\n69:\n70:    long_prefill_token_threshold: int = Field(default=0, ge=0)\n71:    \"\"\"For chunked prefill, a request is considered long if the prompt is\n72:    longer than this number of tokens. 0 disables the cap (default).\"\"\"\n73:\n74:    enable_chunked_prefill: bool = True\n75:    \"\"\"If True, prefill requests can be chunked based\n76:    on the remaining `max_num_batched_tokens`.\n77:\n78:    The default value here is mainly for convenience when testing.\n79:    In real usage, this should be set in `EngineArgs.create_engine_config`.\n80:    \"\"\"\n81:\n82:    is_multimodal_model: bool = False\n83:    \"\"\"True if the model is multimodal.\"\"\"\n84:\n85:    # TODO (ywang96): Make this configurable.\n86:    max_num_encoder_input_tokens: int = Field(init=False)\n87:    \"\"\"Multimodal encoder compute budget, only used in V1.\n88:\n89:    NOTE: This is not currently configurable. It will be overridden by\n90:    max_num_batched_tokens in case max multimodal embedding size is larger.\"\"\"\n91:\n92:    # TODO (ywang96): Make this configurable.\n93:    encoder_cache_size: int = Field(init=False)\n94:    \"\"\"Multimodal encoder cache size, only used in V1.\n95:\n96:    NOTE: This is not currently configurable. It will be overridden by\n97:    max_num_batched_tokens in case max multimodal embedding size is larger.\"\"\"\n98:\n99:    policy: SchedulerPolicy = \"fcfs\"\n100:    \"\"\"The scheduling policy to use:\n101:\n102:    - \"fcfs\" means first come first served, i.e. requests are handled in order \n103:      of arrival.\n104:    - \"priority\" means requests are handled based on given priority (lower\n105:      value means earlier handling) and time of arrival deciding any ties).\"\"\"\n106:\n107:    disable_chunked_mm_input: bool = False\n108:    \"\"\"If set to true and chunked prefill is enabled, we do not want to\n109:    partially schedule a multimodal item. Only used in V1\n110:    This ensures that if a request has a mixed prompt\n111:    (like text tokens TTTT followed by image tokens IIIIIIIIII) where only\n112:    some image tokens can be scheduled (like TTTTIIIII, leaving IIIII),\n113:    it will be scheduled as TTTT in one step and IIIIIIIIII in the next.\"\"\"\n114:\n115:    # scheduler class or path. \"vllm.v1.core.sched.scheduler.Scheduler\"\n116:    # (default) or \"mod.custom_class\".\n117:    scheduler_cls: str | type[object] | None = None\n118:    \"\"\"The scheduler class to use. \"vllm.v1.core.sched.scheduler.Scheduler\" is\n119:    the default scheduler. Can be a class directly or the path to a class of\n120:    form \"mod.custom_class\".\"\"\"\n121:\n122:    disable_hybrid_kv_cache_manager: bool | None = None\n123:    \"\"\"If set to True, KV cache manager will allocate the same size of KV cache\n124:    for all attention layers even if there are multiple type of attention layers\n125:    like full attention and sliding window attention.\n126:    If set to None, the default value will be determined based on the environment\n127:    and starting configuration.\n128:    \"\"\"\n129:\n130:    scheduler_reserve_full_isl: bool = True\n131:    \"\"\"If True, the scheduler checks whether the full input sequence length\n132:    fits in the KV cache before admitting a new request, rather than only\n133:    checking the first chunk. Prevents over-admission and KV cache thrashing\n134:    with chunked prefill.\"\"\"\n135:\n136:    watermark: float = Field(default=0.0, ge=0.0, lt=1.0)\n137:    \"\"\"Fraction of total KV cache blocks to keep free (the watermark) when\n138:    admitting waiting or preempted requests into the running queue. This headroom\n139:    helps avoid frequent KV cache eviction and the resulting repeated preemption\n140:    of requests when GPU memory is scarce. Must be in the range [0.0, 1.0); 0.0","is_error":false}]},"parent_tool_use_id":null,"session_id":"e6c54dfe-6b99-4de2-b00f-8fb62245d858","uuid":"d931ba35-1fc1-4ceb-9020-c4eca3e10810","timestamp":"2026-09-15T12:03:35.466Z","tool_use_result":{"stdout":"########## config/scheduler.py ##########\n1:# SPDX-License-Identifier: Apache-2.0\n2:# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\n3:\n4:from collections.abc import Callable\n5:from dataclasses import InitVar\n6:from typing import TYPE_CHECKING, Any, ClassVar, Literal, cast\n7:\n8:from pydantic import Field, field_validator\n9:from typing_extensions import Self\n10:\n11:from vllm.config.utils import config\n12:from vllm.logger import init_logger\n13:from vllm.utils.hashing import safe_hash\n14:from vllm.utils.import_utils import resolve_obj_by_qualname\n15:\n16:if TYPE_CHECKING:\n17:    from vllm.v1.core.sched.interface import SchedulerInterface\n18:\n19:logger = init_logger(__name__)\n20:\n21:RunnerType = Literal[\"generate\", \"pooling\", \"draft\"]\n22:SchedulerPolicy = Literal[\"fcfs\", \"priority\"]\n23:\n24:\n25:@config\n26:class SchedulerConfig:\n27:    \"\"\"Scheduler configuration.\"\"\"\n28:\n29:    max_model_len: InitVar[int]\n30:    \"\"\