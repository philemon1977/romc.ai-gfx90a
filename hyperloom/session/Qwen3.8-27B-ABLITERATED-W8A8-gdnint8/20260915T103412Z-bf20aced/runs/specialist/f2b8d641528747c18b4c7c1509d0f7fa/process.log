{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_857f4f6d522388ad","type":"tool_result","content":"### cache.py 120-175\n118:    \"\"\" Optional override for mamba page size; used by hybrid mamba/attention\n119:    models to ensure exact alignment with attention page size.\"\"\"\n120:    skip_page_size_padded: int | None = None\n121:    \"\"\"Optional override for the page size of layers skipped from KV cache\n122:    quantization (``--kv-cache-dtype-skip-layers``); set during block-size\n123:    alignment so unquantized skip layers pad up to the quantized primary's\n124:    page.\"\"\"\n125:    mamba_block_size: int | None = Field(default=None, gt=0)\n126:    \"\"\"Size of a contiguous cache block in number of tokens for mamba cache.\n127:    Can be set only when prefix caching is enabled.\n128:    Value must be a multiple of 8 to align with causal_conv1d kernel.\"\"\"\n129:    mamba_cache_dtype: MambaDType = \"auto\"\n130:    \"\"\"The data type to use for the Mamba cache (both the conv as well as the\n131:    ssm state). If set to 'auto', the data type will be inferred from the model\n132:    config.\"\"\"\n133:    mamba_ssm_cache_dtype: MambaDType = \"auto\"\n134:    \"\"\"The data type to use for the Mamba cache (ssm state only, conv state will\n135:    still be controlled by mamba_cache_dtype). If set to 'auto', the data type\n136:    for the ssm state will be determined by mamba_cache_dtype.\"\"\"\n137:    mamba_cache_mode: MambaCacheMode = \"none\"\n138:    \"\"\"The cache strategy for Mamba layers:\n139:\n140:    - \"none\": set when prefix caching is disabled.\n141:    - \"all\": cache the mamba state of all tokens at position i * block_size.\n142:    - \"align\": only cache the mamba state of the last token of each scheduler step and\n143:      when the token is at position i * block_size. This is the default when prefix\n144:      caching is enabled.\n145:    \"\"\"\n146:    replayssm_buffer_len: int = Field(default=16, gt=0)\n147:    \"\"\"ReplaySSM history buffer length B: with use_replayssm, standard decode\n148:    caches recent SSM inputs in a size-B ring buffer and flushes the checkpoint\n149:    state to HBM every B steps. Default 16.\"\"\"\n150:    use_replayssm: bool = False\n151:    \"\"\"Use the ReplaySSM Mamba2 decode kernel: cache recent SSM inputs and skip\n152:    the per-step full-state store, writing the checkpoint back only on flush.\n153:    Requires mamba_cache_mode 'none' or 'align' (prefix caching) and the Triton\n154:    mamba backend; standard (non-speculative) decode only. In align mode flushes\n155:    are most efficient when mamba_block_size is a multiple of replayssm_buffer_len,\n156:    but this is not required.\"\"\"\n157:\n158:    # Will be set after profiling.\n159:    num_gpu_blocks: int | None = field(default=None, init=False)\n160:    \"\"\"The number of blocks to allocate for GPU memory.\"\"\"\n161:    num_cpu_blocks: int | None = field(default=None, init=False)\n162:    \"\"\"The number of blocks to allocate for CPU memory.\"\"\"\n163:\n164:    # Set after KV cache initialization.\n165:    kv_cache_size_tokens: int | None = field(default=None, init=False)\n166:    \"\"\"Per-DP-engine KV cache capacity in tokens (group-aware). Uses\n167:    group-aware capacity since num_gpu_blocks * block_size can be wrong\n168:    for hybrid models where requests occupy multiple KV cache groups.\"\"\"\n169:    kv_cache_max_concurrency: float | None = field(default=None, init=False)\n170:    \"\"\"Per-DP-engine maximum concurrency at max_model_len tokens.\"\"\"\n171:\n172:    kv_sharing_fast_prefill: bool = False\n173:    \"\"\"In some KV sharing setups, e.g. YOCO (https://arxiv.org/abs/2405.05254),\n174:    some layers can skip tokens corresponding to prefill. This flag enables\n175:    attention metadata for eligible layers to be overridden with metadata\n### vllm.py 2500-2590\n2505:                )\n2506:                logger.warning_once(\n2507:                    \"cp_kv_cache_interleave_size is overridden by dcp_kv_cache\"\n2508:                    \"_interleave_size. And dcp-kv-cache-interleave-size will be \"\n2509:                    \"deprecated when PCP is fully supported.\"\n2510:                )\n2511:            assert (\n2512:                self.parallel_config.cp_kv_cache_interleave_size <= block_size\n2513:                and block_size % self.parallel_config.cp_kv_cache_interleave_size == 0\n2514:            ), (\n2515:                f\"Block_size({block_size}) should be greater \"\n2516:                \"than or equal to and divisible by cp_kv_cache_interleave_size \"\n2517:                f\"({self.parallel_config.cp_kv_cache_interleave_size}).\"\n2518:            )\n2519:\n2520:        # Mamba cache align-mode constraints\n2521:        if self.cache_config.mamba_cache_mode == \"align\":\n2522:            assert not self.scheduler_config.disable_chunked_mm_input, (\n2523:                \"Chunked MM input is required because we need the flexibility \"\n2524:                \"to schedule a multiple of block_size tokens even if they are \"\n2525:                \"in the middle of a mm input\"\n2526:            )\n2527:\n2528:    @model_validator(mode=\"after\")\n2529:    def validate_nvfp4_kv_cache_with_mla(self) -> \"VllmConfig\":\n2530:        if self.model_config is None:\n2531:            return self\n2532:        if (\n2533:            self.cache_config.cache_dtype.startswith(\"nvfp4\")\n2534:            and self.model_config.use_mla\n2535:        ):\n2536:            raise ValueError(\n2537:                \"nvfp4 KV cache is not supported with MLA (Multi-head Latent \"\n2538:                \"Attention) backends. Please use a different --kv-cache-dtype \"\n2539:                \"(e.g., 'fp8' or 'auto') for MLA models such as DeepSeek.\"\n2540:            )\n2541:        return self\n2542:\n2543:    @model_validator(mode=\"after\")\n2544:    def validate_mamba_block_size(self) -> \"VllmConfig\":\n2545:        if self.model_config is None:\n2546:            return self\n2547:        mamba_block_size_is_set = (\n2548:            self.cache_config.mamba_block_size is not None\n2549:            and self.cache_config.mamba_block_size != self.model_config.max_model_len\n2550:        )\n2551:        if mamba_block_size_is_set and not self.cache_config.enable_prefix_caching:\n2552:            raise ValueError(\n2553:                \"--mamba-block-size can only be set with --enable-prefix-caching\"\n2554:            )\n2555:        return self\n2556:\n2557:    @model_validator(mode=\"after\")\n2558:    def validate_mamba_cached_kernel(self) -> \"VllmConfig\":\n2559:        if not self.cache_config.use_replayssm:\n2560:            return self\n2561:        # ReplaySSM adds a 3-tensor ring to the mamba state; only models that\n2562:        # opt in (supports_replayssm) build a consistent shape on both the layer\n2563:        # and config paths. Reject others so the mamba page size cannot desync.\n2564:        if self.model_config is not None and not self.model_config.supports_replayssm:\n2565:            raise ValueError(\n2566:                \"--use-replayssm is only supported for Nemotron-H models \"\n2567:                f\"(got architecture {self.model_config.architecture!r})\"\n2568:            )\n2569:        if self.cache_config.mamba_cache_mode == \"all\":\n2570:            raise ValueError(\n2571:                \"--use-replayssm supports prefix caching only in align mode; \"\n2572:                \"pass --mamba-cache-mode align\"\n2573:            )\n2574:        if self.num_speculative_tokens > 0:\n2575:            raise ValueError(\"--use-replayssm does not support speculative decoding\")\n2576:        if self.mamba_config.backend != MambaBackendEnum.TRITON:\n2577:            raise ValueError(\"--use-replayssm requires --mamba-backend triton\")\n2578:        if (\n2579:            self.kv_transfer_config is not None\n2580:            and self.kv_transfer_config.is_kv_transfer_instance\n2581:        ):\n2582:            raise ValueError(\n2583:                \"--use-replayssm is incompatible with KV connectors \"\n2584:                \"(P/D disaggregation, KV cache offload)\"\n2585:            )","is_error":false}]},"parent_tool_use_id":null,"session_id":"e6c54dfe-6b99-4de2-b00f-8fb62245d858","uuid":"c419770a-a116-48ef-8883-cee38e4791b3","timestamp":"2026-09-15T12:05:38.363Z","tool_use_result":{"stdout":"### cache.py 120-175\n118:    \"\"\" Optional override for mamba page size; used by hybrid mamba/attention\n119:    models to ensure exact alignment with attention page size.\"\"\"\n120:    skip_page_size_padded: int | None = None\n121:    \"\"\"Optional override for the page size of layers skipped from KV cache\n122:    quantization (``--kv-cache-dtype-skip-layers``); set during block-size\n123:    alignment so unquantized skip layers pad up to the quantized primary's\n124:    page.\"\"\"\n125:    mamba_block_size: int | None = Field(default=None, gt=0)\n126:    \"\"\"Size of a contiguous cache block in number of tokens for mamba cache.\n127:    Can be set only when prefix caching is enabled.\n128:    Value must be a multiple of 8 to align with causal_conv1d kernel.\"\"\"\n129:    mamba_cache_dtype: MambaDType = \"auto\"\n130:    \"\"\"The data type to use for the Mamba cache (both the conv as well as the\n131:    ssm state). If set to 'auto', the data type will be inferred from the model\n132:    config.\"\"\"\n133:    mamba_ssm_cache_dtype: MambaDType = \"auto\"\n134:    \"\"\"The data type to use for the Mamba cache (ssm state only, conv state will\n135:    still be controlled by mamba_cache_dtype). If set to 'auto', the data type\n136:    for the ssm state will be determined by mamba_cache_dtype.\"\"\"\n137:    mamba_cache_mode: MambaCacheMode = \"none\"\n138:    \"\"\"The cache strategy for Mamba layers:\n139:\n140:    - \"none\": set when prefix caching is disabled.\n141:    - \"all\": cache the mamba state of all tokens at position i * block_size.\n142:    - \"align\": only cache the mamba state of the last token of each scheduler step and\n143:      when the token is at position i * block_size. This is the default when prefix\n144:      caching is enabled.\n145:    \"\"\"\n146:    replayssm_buffer_len: int = Field(default=16, gt=0)\n147:    \"\"\"ReplaySSM history buffer length B: with use_replayssm, standard decode\n148:    caches recent SSM inputs in a size-B ring buffer and flushes the checkpoint\n149:    state to HBM every B steps. Default 16.\"\"\"\n150:    use_replayssm: bool = False\n151:    \"\"\"Use the ReplaySSM Mamba2 decode kernel: cache recent SSM inputs and skip\n152:    the per-step full-state store, writing the checkpoint back only on flush.\n153:    Requires mamba_cache_mode 'none' or 'align' (prefix caching) and the Triton\n154:    mamba backend; standard (non-speculative) decode only. In align mode flushes\n155:    are most efficient when mamba_block_size is a multiple of replayssm_buffer_len,\n156:    but this is not required.\"\"\"\n157:\n158:    # Will be set after profiling.\n159:    num_gpu_blocks: int | None = field(default=None, init=False)\n160:    \"\"\"The number of blocks to allocate for GPU memory.\"\"\"\n161:    num_cpu_blocks: int | None = field(default=None, init=False)\n162:    \"\"\"The number of blocks to allocate for CPU memory.\"\"\"\n163:\n164:    # Set after KV cache initialization.\n165:    kv_cache_size_tokens: int | None = field(default=None, init=False)\n166:    \"\"\"Per-DP-engine KV cache capacity in tokens (group-aware). Uses\n167:    group-aware capacity since num_gpu_blocks * block_size can be wrong\n168:    for hybrid models where requests occupy multiple KV cache groups.\"\"\"\n169:    kv_cache_max_concurrency: float | None = field(default=None, init=False)\n170:    \"\"\"Per-DP-engine maximum concurrency at max_model_len tokens.\"\"\"\n171:\n172:    kv_sharing_fast_prefill: bool = False\n173:    \"\"\"In some KV sharing se