prevents uniform decode optimizations.\n543:                req_index += 1\n544:                continue\n545:\n546:            if self.current_step < request.next_decode_eligible_step:\n547:                # V2+PP+async: enforce `pp_size` steps between same-req decodes\n548:                # to match worker-side sampled-tokens broadcast slot ring cadence.\n549:                req_index += 1\n550:                continue\n551:\n552:            if defer_prefills and request.is_prefill_chunk:\n553:                # DP prefill balancing: defer this in-progress prefill chunk to a\n554:                # cadence-aligned step; decodes still run to fill this step.\n555:                req_index += 1\n556:                continue\n557:\n558:            num_new_tokens = (\n559:                request.num_tokens_with_spec\n560:                + request.num_output_placeholders\n561:                - request.num_computed_tokens\n562:            )\n563:            if 0 < self.scheduler_config.long_prefill_token_threshold < num_new_tokens:\n564:                num_new_tokens = self.scheduler_config.long_prefill_token_threshold\n565:            num_new_tokens = min(\n566:                num_new_tokens, token_budget, input_budget - draft_slots\n567:            )\n568:\n569:            # Make sure the input position does not exceed the max model len.\n570:            # This is necessary when using spec decoding.\n571:            num_new_tokens = min(\n572:                num_new_tokens,\n573:                self.max_model_len\n574:                - request.num_computed_tokens\n575:                - self.num_sampled_tokens_per_step,\n576:            )\n577:\n578:            # Apply Mamba alignment before encoder caps.\n579:            if self.need_mamba_block_aligned_split:\n580:                num_new_tokens = self._mamba_block_aligned_split(\n581:                    request, num_new_tokens\n582:                )\n583:\n584:            # Schedule encoder inputs.\n585:            enco