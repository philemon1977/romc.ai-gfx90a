{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_b7bc0a62b008c18e","type":"tool_result","content":"# SPDX-License-Identifier: Apache-2.0\n# SPDX-FileCopyrightText: Copyright contributors to the vLLM project\nimport torch\nfrom transformers import PretrainedConfig\n\nfrom vllm.config import (\n    VllmConfig,\n)\nfrom vllm.distributed import (\n    get_tensor_model_parallel_rank,\n    get_tensor_model_parallel_world_size,\n)\nfrom vllm.model_executor.custom_op import PluggableLayer\nfrom vllm.model_executor.layers.mamba.abstract import MambaBase\nfrom vllm.model_executor.layers.mamba.mamba_utils import (\n    MambaStateDtypeCalculator,\n)\nfrom vllm.model_executor.models.utils import extract_layer_index\nfrom vllm.v1.attention.backends.registry import MambaAttentionBackendEnum\n\n\nclass GatedDeltaNetAttention(PluggableLayer, MambaBase):\n    \"\"\"Base class for GatedDeltaNet attention layer.\"\"\"\n\n    def __init__(\n        self,\n        config: PretrainedConfig,\n        vllm_config: VllmConfig,\n        prefix: str = \"\",\n    ) -> None:\n        super().__init__()\n        self.prefix = prefix\n        self.tp_size = get_tensor_model_parallel_world_size()\n        self.tp_rank = get_tensor_model_parallel_rank()\n        self.layer_idx = extract_layer_index(prefix)\n        self.hidden_size = config.hidden_size\n        self.activation = config.hidden_act\n        self.layer_norm_epsilon = config.rms_norm_eps\n        self.model_config = vllm_config.model_config\n        self.cache_config = vllm_config.cache_config\n        self.quant_config = vllm_config.quant_config\n        self.speculative_config = vllm_config.speculative_config\n        self.num_spec = (\n            self.speculative_config.num_speculative_tokens\n            if self.speculative_config\n            else 0\n        )\n\n    @property\n    def mamba_type(self) -> MambaAttentionBackendEnum:\n        return MambaAttentionBackendEnum.GDN_ATTN\n\n    def get_state_dtype(self) -> tuple[torch.dtype, ...]:\n        return MambaStateDtypeCalculator.gated_delta_net_state_dtype(\n            self.model_config.dtype,\n            self.cache_config.mamba_cache_dtype,\n            self.cache_config.mamba_ssm_cache_dtype,\n        )\n=== get_kv_cache_torch_dtype ===\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py:404:def get_kv_cache_torch_dtype(\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-405-    cache_dtype: str | torch.dtype | None,\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-406-    model_dtype: str | torch.dtype | None = None,\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-407-) -> torch.dtype:\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-408-    if isinstance(cache_dtype, str):\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-409-        if cache_dtype == \"auto\":\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-410-            if isinstance(model_dtype, str) and model_dtype in STR_DTYPE_TO_TORCH_DTYPE:\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-411-                torch_dtype = STR_DTYPE_TO_TORCH_DTYPE[model_dtype]\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-412-            elif isinstance(model_dtype, torch.dtype):\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-413-                torch_dtype = model_dtype\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-414-            else:\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-415-                raise ValueError(f\"Invalid model dtype: {model_dtype}\")\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-416-        elif cache_dtype in STR_DTYPE_TO_TORCH_DTYPE:\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-417-            torch_dtype = STR_DTYPE_TO_TORCH_DTYPE[cache_dtype]\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-418-        else:\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-419-            raise ValueError(f\"Invalid kv cache dtype: {cache_dtype}\")\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-420-    elif isinstance(cache_dtype, torch.dtype):\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-421-        torch_dtype = cache_dtype\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-422-    else:\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-423-        raise ValueError(f\"Invalid kv cache dtype: {cache_dtype}\")\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-424-    return torch_dtype\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-425-\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-426-\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-427-def get_kv_cache_quant_algo_string(quant_cfg: dict[str, Any]) -> str | None:\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-428-    \"\"\"Get the KV cache quantization algorithm string from the quantization config.\n/opt/envs/vllm/lib/python3.12/site-packages/vllm/utils/torch_utils.py-429-","is_error":false}]},"parent_tool_use_id":"call_bd243dea0185eec4","session_id":"ed4108fe-4997-42ac-9b66-e7a9797e8c58","uuid":"6741fdb4-00c5-4a02-81f0-d1c67b975597","timestamp":"2026-09-15T11:44:46.963Z","subagent_type":"hyperloom-leaf","task_description":"Survey GDN decode kernel knobs"}
