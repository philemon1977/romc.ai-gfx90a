_metadata.num_actual_tokens\n1733:    def _forward_core_decode_spec_post_conv_fused_norm(\n1742:        state_indices = attn_metadata.spec_state_indices_tensor\n1743:        cu_seqlens = attn_metadata.spec_query_start_loc\n1744:        num_accepted_tokens = attn_metadata.num_accepted_tokens\n1749:        num_requests = attn_metadata.num_spec_decodes\n1767:    def _forward_core_fused_norm_packed(\n1801:        state_indices = attn_metadata.spec_state_indices_tensor\n1803:            attn_metadata.spec_sequence_masks is not None\n1804:            and attn_metadata.num_decodes == 0\n1805:            and attn_metadata.num_spec_decodes > 0\n1848:    def _forward_core_fused_norm(\n1867:            and attn_metadata.num_prefills == 0\n1884:        num_actual_tokens = attn_metadata.num_actual_tokens","is_error":false}]},"parent_tool_use_id":"call_bd243dea0185eec4","session_id":"ed4108fe-4997-42ac-9b66-e7a9797e8c58","uuid":"8a29bea4-2564-4229-be08-928bc5de000d","timestamp":"2026-09-15T11:44:52.463Z","subagent_type":"hyperloom-leaf","task_description":"Survey GDN decode kernel knobs"}
