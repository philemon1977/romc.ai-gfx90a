{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_ab3786668e57a49d","type":"tool_result","content":"    ⚠️ 这里原来直接写 `ENV_STATS` 那一个固定路径 ⇒ TP4 的 4 个 worker 进程**共写同一文件**，\n    每次 dump 都是 `open(w)` 整体覆盖 ⇒ 读到的值是\"最后写的那个 worker\"的，跨快照比大小\n    会出现 `12000 → 2000` 这种**单调计数器居然变小**的荒谬现象（本会话 14:33 实测抓到）。\n    混合批占比是本轮最重要的数，仪器本身在说谎就必须先修仪器，而不是先去解释那个数。\n    现在：文件名带 pid + 原子替换（temp + os.replace），读侧永远拿到某个进程的完整快照；\n    要全场合计就把各 pid 文件相加（同一步每层都会被调 ⇒ 每进程计数近似相等，\n    用**任一进程**算占比即可，不必求和）。\n    \"\"\"\n    path = os.environ.get(ENV_STATS, \"\")\n    if not path:\n        return\n    try:\n        base, ext = os.path.splitext(path)\n        pid_path = f\"{base}.pid{os.getpid()}{ext or ''}\"\n        tmp = pid_path + \".tmp\"\n        d = stats()\n        d[\"pid\"] = os.getpid()\n        with open(tmp, \"w\", encoding=\"utf-8\") as f:\n            f.write(repr(d) + \"\\n\")\n            f.flush()\n            os.fsync(f.fileno())\n        os.replace(tmp, pid_path)          # 原子 ⇒ 读侧不会看到半截文件\n    except OSError:\n        pass\n\n\ndef try_paged_decode(*, query, output, key_cache, value_cache, block_table,\n                     query_start_loc, seq_lens, max_seq_len, max_query_len,\n                     kv_cache_dtype, sliding_window, alibi_slopes, sinks, sm_scale,\n                     is_block_table_ptr=False, output_scale=None) -> bool:\n    \"\"\"满足全部接管条件就发射 split-KV 两发内核并返回 True；否则返回 False（原路径不动）。\"\"\"\n    if not enabled():\n        return _reject(f\"{ENV_ENABLE} 未开\")\n    if max_query_len != 1:\n        return _reject(f\"max_query_len={max_query_len}!=1\")\n    if (sliding_window or 0) != 0:\n        return _reject(f\"sliding_window={sliding_window}\")\n    if sinks is not None:\n        return _reject(\"sinks is not None\")\n    if alibi_slopes is not None:\n        return _reject(\"alibi_slopes is not None\")\n    if kv_cache_dtype != \"auto\":\n        return _reject(f\"kv_cache_dtype={kv_cache_dtype!r}\")\n    if output_scale is not None:\n        return _reject(\"output_scale is not None\")\n    if is_block_table_ptr:\n        return _reject(\"is_block_table_ptr\")\n    if query.dtype not in (torch.bfloat16, torch.float16):\n        return _reject(f\"query.dtype={query.dtype}\")\n    if key_cache.dim() != 5:\n        return _reject(f\"key_cache.dim()={key_cache.dim()}\")\n    if key_cache.shape[4] * key_cache.element_size() != 16:\n        return _reject(\"key_cache 非 16B 打包布局\")\n    if int(key_cache.shape[3]) != int(value_cache.shape[3]):\n        return _reject(\"K/V 物理 block 不一致\")\n\n    num_seqs = int(len(seq_lens))\n    num_query_heads = int(query.shape[1])\n    num_kv_heads = int(key_cache.shape[1])\n    head_size = int(query.shape[2])\n    if num_kv_heads == 0 or num_query_heads % num_kv_heads != 0:\n        return _reject(\"q 头数不能被 kv 头数整除\")\n    # **原型只验到 batch=1**（§7.1），本会话离线裁判验到 b=16 ⇒ 默认只在基线 program 数\n    # ≤16 时接管：batch 自己就能把 104 个 CU 铺得差不多时，再切 partition 只剩额外一发。\n    # 阈值是**可调门**而不是常量：测拐点时显式设 64，默认 16（=本会话离线裁判验过的范围）。\n    # 默认 64（**2026-09-08 任务 A 实测定的**，原来是写死的 16）。依据见\n    # docs/research-notes/splitkv-拐点与税收-2026-09-08.md §1.6：\n    #   ctx=4096  speedup ×1.91(b=1) → 1.30(16) → 1.23(32) → 1.09(64)   ← 衰减但始终 >1.05\n    #   ctx=30720 speedup ×7.36(b=1) → 3.01(16) → 2.24(32)              ← 长上下文根本没过拐点\n    #   且两臂 scratch超预算=0、grid基数>上限=0 ⇒ 不是预算/门造的假拐点\n    # 正确性侧：golden 已验到 b=64（含长度不齐、含 1-token 行），见 §1.2 的 72/0。\n    max_base = _env_int(ENV_MAX_SEQS, _env_int(ENV_MAX_BASE, DEFAULT_MAX_SEQS))\n    if num_seqs * num_kv_heads > max_base:\n        return _reject(f\"grid 基数 {num_seqs}x{num_kv_heads} > 上限 {max_base}\")\n    if head_size > 512:\n        return _reject(f\"head_size={head_size}\")\n\n    physical_block = int(value_cache.shape[3])\n    ctx = int(max_seq_len or 0)\n    if ctx <= 0:\n        return _reject(\"max_seq_len<=0\")\n\n    fixed = _env_int(ENV_PART, 0)\n    adapt = 0 if fixed else 1\n    part_min = fixed if fixed else PART_MIN_DEFAULT\n    if part_min & (part_min - 1) or part_min < 64 or part_min > PART_MAX:\n        return _reject(f\"PART={part_min} 非法（须 64/128/256/512）\")\n\n    # ── grid 的 z 维必须按**静态上界**开，不能按本次 max_seq_len ──────────────\n    # 实测（本会话，2026-09-07 12:33 起服日志）：CUDA graph capture 传进来的 `max_seq_len`\n    # 是 **1**（`build_for_cudagraph_capture` 之后 `seq_lens.fill_(1)`，metadata 的\n    # max_seq_len 也跟着是 1），而 replay 时真实 seq_len 会长到 3 万。若按 capture 时的\n    # max_seq_len 开 grid ⇒ grid=(1,1,1)、PART=64 ⇒ **只attend 前 64 个 token**，输出全错。\n    # 静态上界取 `block_table 的列数 × 物理 block`：block_table 是持久缓冲\n    # `[max_num_reqs, max_num_blocks_per_req]`（v1/worker/block_table.py:105），\n    # 列数恒 = ceil(max_model_len/物理block) ⇒ 这个上界与 batch/步数无关，capture 与\n    # replay 同解，且必然 ≥ 任何真实 seq_len。\n    if block_table.dim() != 2:\n        return _reject(f\"block_table.dim()={block_table.dim()}\")\n    capacity = int(block_table.shape[1]) * physical_block\n    bound = max(capacity, ctx)          # 防御：万一哪天 block_table 被切窄，也不能漏 token\n\n    hd_pad = triton.next_power_of_2(head_size)\n    # grid 的 z 维 = **上界**（capture 时烤平，之后不再变）。\n    # 任务 B：默认用**紧上界**（只开真正会被用到的 partition 数）；\n    # `VLLM_ROCM_SPLITKV_PA_TIGHT_GRID=0` 退回旧口径 `ceil(bound/PART_MIN)`，\n    # ⇒ 同一份二进制、同一次起服流程下做 before/after 对照，不靠\"上次那个数\"。\n    tight = _env_int(ENV_TIGHT, 1)\n    max_parts = (grid_upper_bound(bound, part_min) if tight\n                 else (bound + part_min - 1) // part_min)\n    # 覆盖性自检：紧上界必须真的盖住 bound。**盖不住就拒绝接管，绝不静默少读。**\n    if grid_upper_bound(bound, part_min) > max_parts:\n        return _reject(\"grid 覆盖不了 bound\")\n    # scratch 预算：partition 数超预算 ⇒ 抬高 PART_MIN（device 侧 floor 跟着抬，仍自洽）。\n    # 单流 32k + 紧上界 ⇒ 195×4×256×4B ≈ 0.8 MB，不触发。\n    max_scratch = max(_env_int(ENV_MAX_SCRATCH_MIB, 32), 1) * 1048576\n    while (max_parts * num_seqs * num_query_heads * hd_pad * 4 > max_scratch\n           and part_min < PART_MAX):\n        part_min *= 2\n        max_parts = (grid_upper_bound(bound, part_min) if tight\n                     else (bound + part_min - 1) // part_min)\n    if max_parts * num_seqs * num_query_heads * hd_pad * 4 > max_scratch:\n        return _reject(f\"scratch {max_parts * num_seqs * num_query_heads * hd_pad * 4} 超预算\")\n\n    device = query.device\n    try:\n        capturing = bool(torch.cuda.is_current_stream_capturing())\n    except Exception:\n        capturing = False\n    buf = _get_scratch(num_seqs, num_query_heads, max_parts, hd_pad, device,\n                       creating_ok=(not capturing))\n    if buf is None:\n        return _reject(\"capture 中缺 scratch\")\n    tmp, es, ml = buf\n\n    bt = block_table if block_table.dtype == torch.int32 else block_table.to(torch.int32)\n    scale = float(sm_scale) if sm_scale is not None else 1.0 / math.sqrt(head_size)\n    nqp = num_query_heads // num_kv_heads\n    nqp_pad = max(triton.next_power_of_2(nqp), 16)\n    x = int(key_cache.shape[4])\n\n    kernel_paged_attention_splitkv[(num_seqs, num_kv_heads, max_parts)](\n        tmp_out_ptr=tmp, exp_sums_ptr=es, max_logits_ptr=ml,\n        query_ptr=query, key_cache_ptr=key_cache, value_cache_ptr=value_cache,\n        block_tables_ptr=bt, seq_lens_ptr=seq_lens, query_start_len_ptr=query_start_loc,\n        max_ctx=bound,\n        scale=scale,\n        num_query_heads=num_query_heads, num_queries_per_kv=nqp,\n        num_queries_per_kv_padded=nqp_pad,\n        block_table_stride=bt.stride(0),\n        query_stride_0=query.stride(0), query_stride_1=query.stride(1),\n        tmp_stride_0=tmp.stride(0), tmp_stride_1=tmp.stride(1), tmp_stride_2=tmp.stride(2),\n        es_stride_0=es.stride(0), es_stride_1=es.stride(1),\n        PART_MIN=part_min, MAX_PARTS=int(max_parts), ADAPT=adapt, BLOCK_N=BLOCK_N,\n        PHYSICAL_BLOCK_SIZE=physical_block,\n        HEAD_SIZE=head_size, HEAD_SIZE_PADDED=hd_pad, x=x,\n        stride_k_cache_0=key_cache.stride(0), stride_k_cache_1=key_cache.stride(1),\n        stride_k_cache_2=key_cache.stride(2), stride_k_cache_3=key_cache.stride(3),\n        stride_k_cache_4=key_cache.stride(4),\n        stride_v_cache_0=value_cache.stride(0), stride_v_cache_1=value_cache.stride(1),\n        stride_v_cache_2=value_cache.stride(2), stride_v_cache_3=value_cache.stride(3),\n        EVICT=EVICT, num_warps=NUM_WARPS, num_stages=NUM_STAGES,\n    )\n\n    block_d = min(REDUCE_BLOCK_D, hd_pad)\n    kernel_paged_attention_splitkv_reduce[(num_seqs, num_query_heads, hd_pad // block_d)](\n        output_ptr=output, tmp_out_ptr=tmp, exp_sums_ptr=es, max_logits_ptr=ml,\n        seq_lens_ptr=seq_lens, query_start_len_ptr=query_start_loc,\n        max_ctx=bound,\n        output_stride_0=output.stride(0), output_stride_1=output.stride(1),\n        tmp_stride_0=tmp.stride(0), tmp_stride_1=tmp.stride(1), tmp_stride_2=tmp.stride(2),\n        es_stride_0=es.stride(0), es_stride_1=es.stride(1),\n        PART_MIN=part_min, MAX_PARTS=int(max_parts), ADAPT=adapt,\n        BLOCK_P=min(max(triton.next_power_of_2(max_parts), 1), REDUCE_BLOCK_P),\n        BLOCK_D=block_d, HEAD_SIZE=head_size, HEAD_SIZE_PADDED=hd_pad,\n        num_warps=REDUCE_NUM_WARPS, num_stages=1,\n    )\n\n    _stats[\"takeover\"] += 1\n    _maybe_dump()\n    _stats[\"last_launch\"] = dict(num_seqs=num_seqs, num_kv_heads=num_kv_heads,\n                                 max_parts=max_parts, part_min=part_min, adapt=adapt,\n                                 num_query_heads=num_query_heads, head_size=head_size,\n                                 physical_block=physical_block, ctx=ctx, bound=bound,\n                                 tight_grid=tight, capturing=capturing)\n    every = _env_int(ENV_LOG_EVERY, 0)\n    log_key = (num_seqs, num_kv_heads, max_parts, part_min, adapt)\n    if log_key not in _LOGGED_KEYS:\n        _LOGGED_KEYS.add(log_key)\n        logger.info(\n            \"MI250X split-KV paged-decode **已接管**：grid=(seqs=%d, kv_heads=%d, parts=%d) \"\n            \"PART_MIN=%d ADAPT=%d BLOCK_N=%d warps=%d stages=%d tmp=f32 \"\n            \"| heads/rank=%d hd=%d 物理block=%d max_seq_len=%d static_bound=%d \"\n            \"TIGHT_GRID=%d | 门 %s=1\",\n            num_seqs, num_kv_heads, max_parts, part_min, adapt, BLOCK_N, NUM_WARPS,\n            NUM_STAGES, num_query_heads, head_size, physical_block, ctx, bound, tight,\n            ENV_ENABLE)\n    elif every and _stats[\"takeover\"] % every == 0:\n        logger.info(\"MI250X split-KV 累计接管 %d 次（reject=%d）\",\n                    _stats[\"takeover\"], _stats[\"reject\"])\n        _dump_stats()\n    return True","is_error":false}]},"parent_tool_use_id":null,"session_id":"ef0f2ec4-e661-4d41-a22b-ae2c33bf2ef7","uuid":"f48910ab-200e-4580-a84d-5b72c9d5bfc7","timestamp":"2026-09-15T12:59:12.560Z","tool_use_result":{"stdout":"    ⚠️ 这里原来直接写 `ENV_STATS` 那一个固定路径 ⇒ TP4 的 4 个 worker 进程**共写同一文件**，\n    每次 dump 都是 `open(w)` 整体覆盖 ⇒ 读到的值是\"最后写的那个 worker\"的，跨快照比大小\n    会出现 `12000 → 2000` 这种**单调计数器居然变小**的荒谬现象（本会话 14:33 实测抓到）。\n    混合批占比是本轮最重要的数，仪器本身在说谎就必须先修仪器，而不是先去解释那个数。\n    现在：文件名带 pid + 原子替换（temp + os.replace），读侧永远拿到某个进程的完整快照；\n    要全场合计就把各 pid 文件相加（同一步每层都会被调 ⇒ 每进程计数近似相等，\n    用**任一进程**算占比即可，不必求和）。\n    \"\"\"\n    path = os.environ.get(ENV_STATS, \"\")\n    if not path:\n        return\n    try:\n        base, ext = os.path.splitext(path)\n        pid_path = f\"{base}.pid{os.getpid()}{ext or ''}\"\n        tmp = pid_path + \".tmp\"\n        d = stats()\n        d[\"pid\"] = os.getpid()\n        with open(tmp, \"w\", encoding=\"utf-8\") as f:\n            f.write(repr(d) + \"\\n\")\n            f.flush()\n            os.fsync(f.fileno())\n        os.replace(tmp, pid_path)          # 原子 ⇒ 读侧不会看到半截文件\n    except OSError:\n        pass\n\n\ndef try_paged_decode(*, query, output, key_cache, value_cache, block_table,\n                     query_start_loc, seq_lens, max_seq_len, max_query_len,\n                     kv_cache_dtype, sliding_window, alibi_slopes, sinks, sm_scale,\n                     is_block_table_ptr=False, output_scale=None) -> bool:\n    \"\"\"满足全部接管条件就发射 split-KV 两发内核并返回 True；否则返回 False（原路径不动）。\"\"\"\n    if not enabled():\n        return _reject(f\"{ENV_ENABLE} 未开\")\n    if max_query_len != 1:\n        return _reject(f\"max_query_len={max_query_len}!=1\")\n    if (sliding_window or 0) != 0:\n        return _reject(f\"sliding_window={sliding_window}\")\n    if sinks is not None:\n        return _reject(\"sinks is not None\")\n    if alibi_slopes is not None:\n        return _reject(\"alibi_slopes is not None\")\n    if kv_cache_dtype != \"auto\":\n        return _reject(f\"kv_cache_dtype={kv_cache_dtype!r}\")\n    if output_scale is not None:\n        return _reject(\"output_scale is not None\")\n    if is_block_table_ptr:\n        return _reject(\"is_block_table_ptr\")\n    if query.dtype not in (torch.bfloat16, torch.float16):\n        return _reject(f\"query.dtype={query.dtype}\")\n    if key_cache.dim() != 5:\n        return _reject(f\"key_cache.dim()={key_cache.dim()}\")\n    if key_cache.shape[4] * key_cache.element_size() != 16:\n        return _reject(\"key_cache 非 16B 打包布局\")\n    if int(key_cache.shape[3]) != int(value_cache.shape[3]):\n        return _reject(\"K/V 物理 block 不一致\")\n\n    num_seqs = int(len(seq_lens))\n    num_query_heads = int(query.shape[1])\n    num_kv_heads = int(key_cache.shape[1])\n    head_size = int(query.shape[2])\n    if num_kv_heads == 0 or num_query_heads % num_kv_heads != 0:\n        return _reject(\"q 头数不能被 kv 头数整除\")\n    # **原型只验到 batch=1**（§7.1），本会话离线裁判验到 b=16 ⇒ 默认只在基线 program 数\n    # ≤16 时接管：batch 自己就能把 104 个 CU 铺得差不多时，再切 partition 只剩额外一发。\n    # 阈值是**可调门**而不是常量：测拐点时显式设 64，默认 16（=本会话离线裁判验过的范围）。\n    # 默认 64（**2026-09-08 任务 A 实测定的**，原来是写死的 16）。依据见\n    # docs/research-notes/splitkv-拐点与税收-2026-09-08.md §1.6：\n    #   ctx=4096  speedup ×1.91(b=1) → 1.30(16) → 1.23(32) → 1.09(64)   ← 衰减但始终 >1.05\n    #   ctx=30720 speedup ×7.36(b=1) → 3.01(16) → 2.24(32)              ← 长上下文根本没过拐点\n    #   且两臂 scratch超预算=0、grid基数>上限=0 ⇒ 不是预算/门造的假拐点\n    # 正确性侧：golden 已验到 b=64（含长度不齐、含 1-token 行），见 §1.2 的 72/0。\n    max_base = _env_int(ENV_MAX_SEQS, _env_int(ENV_MAX_BASE, DEFAULT_MAX_SEQS))\n    if num_seqs * num_kv_heads > max_base:\n        return _reject(f\"grid 基数 {num_seqs}x{num_kv_heads} > 上限 {max_base}\")\n    if head_size > 512:\n        return _reject(f\"head_size={head_size}\")\n\n    physical_block = int(value_cache.shape[3])\n    ctx = int(max_seq_len or 0)\n    if ctx <= 0:\n        return _reject(\"max_seq_len<=0\")\n\n    fixed = _env_int(ENV_PART, 0)\n    adapt = 0 if fixed else 1\n    part_min = fixed if fixed else PART_MIN_DEFAULT\n    if part_min & (part_min - 1) or part_min < 64 or part_min > PART_MAX:\n        return _reject(f\"PART={part_min} 非法（须 64/128/256/512）\")\n\n    # ── grid 的 z 维必须按**静态上界**开，不能按本次 max_seq_len ──────────────\n    # 实测（本会话，2026-09-07 12:33 起服日志）：CUDA graph capture 传进来的 `max_seq_len`\n    # 是 **1**（`build_for_cudagraph_capture` 之后 `seq_lens.fill_(1)`，metadata 的\n    # max_seq_len 也跟着是 1），而 replay 时真实 seq_len 会长到 3 万。若按 capture 时的\n    # max_seq_len 开 grid ⇒ grid=(1,1,1)、PART=64 ⇒ **只attend 前 64 个 token**，输出全错。\n    # 静态上界取 `block_table 的列数 × 物理 block`：block_table 是持久缓冲\n    # `[max_num_reqs, max_num_blocks_per_req]`（v1/worker/block_table.py:105），\n    # 列数恒 = ceil(max_model_len/物理block) ⇒ 这个上界与 batch/步数无关，capture 与\n    # replay 同解，且必然 ≥ 任何真实 seq_len。\n    if block_table.dim() != 2:\n        return _reject(f\"block_table.dim()={block_table.dim()}\")\n    capacity = int(block_table.shape[1]) * physical_block\n    bound = max(capacity, ctx)          # 防御：万一哪天 block_table 被切窄，也不能漏 token\n\n    hd_pad = triton.next_power_of_2(head_size)\n    # grid 的 z 维 = **上界**（capture 时烤平，之后不再变）。\n    # 任务 B：默认用**紧上界**（只开真正会被用到的 partition 数）；\n    # `VLLM_ROCM_SPLITKV_PA_TIGHT_GRID=0` 退回旧口径 `ceil(bound/PART_MIN)`，\n    # ⇒ 同一份二进制、同一次起服流程下做 before/after 对照，不靠\"上次那个数\"。\n    tight = _env_int(ENV_TIGHT, 1)\n    max_parts = (grid_upper_bound(bound, part_min) if tight\n                 else (bound + part_min - 1) // part_min)\n    # 覆盖性自检：紧上界必须真的盖住 bound。**盖不住就拒绝接管，绝不静默少读。**\n    if grid_upper_bound(bound, part_min) > max_parts:\n        return _reject(\"grid 覆盖不了 bound\")\n    # scratch 预算：partition 数超预算 ⇒ 抬高 PART_MIN（device 侧 floor 跟着抬，仍自洽）。\n    # 单流 32k + 紧上界 ⇒ 195×4×256×4B ≈ 0.8 MB，不触发。\n    max_scratch = max(_env_int(ENV_MAX_SCRATCH_MIB, 32), 1) * 1048576\n    while (max_parts * num_seqs * num_query_heads * hd_pad * 4 > max_scratch\n           and part_min < PART_MAX):\n        part_min *= 2\n        max_parts = (grid_upper_bound(bound, part_min) if tight\n                     else (bound + part_min - 1) // part_min)\n    if max_parts * num_seqs * num_query_heads * hd_pad * 4 > max_scratch:\n        return _reject(f\"scratch {max_parts * num_seqs * num_query_heads * hd_pad * 4} 超预算\")\n\n    device = query.device\n    try:\n        capturing = bool(torch.cuda.is_current_stream_capturing())\n    except Exception:\n        capturing = False\n    buf = _get_scratch(num_seqs, num_query_heads, max_parts, hd_pad, device,\n                       creating_ok=(not capturing))\n    if buf is None:\n        return _reject(\"capture 中缺 scratch\")\n    tmp, es, ml = buf\n\n    bt = block_table if block_table.dtype == torch.int32 else block_table.to(torch.int32)\n    scale = float(sm_scale) if sm_scale is not None else 1.0 / math.sqrt(head_size)\n    nqp = num_query_heads // num_kv_heads\n    nqp_pad = max(triton.next_power_of_2(nqp), 16)\n    x = int(key_cache.shape[4])\n\n    kernel_paged_attention_splitkv[(num_seqs, num_kv_heads, max_parts)](\n        tmp_out_ptr=tmp, exp_sums_ptr=es, max_logits_ptr=ml,\n        query_ptr=query, key_cache_ptr=key_cache, value_cache_ptr=value_cache,\n        block_tables_ptr=bt, seq_lens_ptr=seq_lens, query_start_len_ptr=query_start_loc,\n        max_ctx=bound,\n        scale=scale,\n        num_query_heads=num_query_heads, num_queries_per_kv=nqp,\n        num_queries_per_kv_padded=nqp_pad,\n        block_table_stride=bt.stride(0),\n        query_stride_0=query.stride(0), query_stride_1=query.stride(1),\n        tmp_stride_0=tmp.stride(0), tmp_stride_1=tmp.stride(1), tmp_stride_2=tmp.stride(2),\n        es_stride_0=es.stride(0), es_stride_1=es.stride(1),\n        PART_MIN=part_min, MAX_PARTS=int(max_parts), ADAPT=adapt, BLOCK_N=BLOCK_N,\n        PHYSICAL_BLOCK_SIZE=physical_block,\n        HEAD_SIZE=head_size, HEAD_SIZE_PADDED=hd_pad, x=x,\n        stride_k_cache_0=key_cache.stride(0), stride_k_cache_1=key_cache.stride(1),\n        stride_k_cache_2=key_cache.stride(2), stride_k_cache_3=key_cache.stride(3),\n        stride_k_cache_4=key_cache.stride(4),\n        stride_v_cache_0=value_cache.stride(0), stride_v_cache_1=value_cache.stride(1),\n        stride_v_cache_2=value_cache.stride(2), stride_v_cache_3=value_cache.stride(3),\n        EVICT=EVICT, num_warps=NUM_WARPS, num_stages=NUM_STAGES,\n    )\n\n    block_d = min(REDUCE_BLOCK_D, hd_pad)\n    kernel_paged_attention_splitkv_reduce[(num_seqs, num_query_heads, hd_pad // block_d)](\n        output_ptr=output, tmp_out_ptr=tmp, exp_sums_ptr=es, max_logits_ptr=ml,\n        seq_lens_ptr=seq_lens, query_start_len_ptr=query_start_loc,\n        max_ctx=bound,\n        output_stride_0=output.stride(0), output_stride_1=output.stride(1),\n        tmp_stride_0=tmp.stride(0), tmp_stride_1=tmp.stride(1), tmp_stride_2=tmp.stride(2),\n        es_stride_0=es.stride(0), es_stride_1=es.stride(1),\n        PART_MIN=part_min, MAX_PARTS=int(max_parts), ADAPT=adapt,\n        BLOCK_P=min(max(triton.next_power_of_2(max_parts), 1), REDUCE_BLOCK_P),\n        BLOCK_D=block_d, HEAD_SIZE=head_size, HEAD_SIZE_PADDED=hd_pad,\n        num_warps=REDUCE_NUM_WARPS, num_stages=1,\n    )\n\n    _stats[\"takeover\"] += 1\n    _maybe_dump()\n    _stats[\"last_launch\"] = dict(num_seqs=num_seqs, num_kv_heads=num_kv_heads,\n                                 max_parts=max_parts, part_min=part_min, adapt=adapt,\n                                 num_query_heads=num_query_heads, head_size=head_size,\n                                 physical_block=physical_block, ctx=ctx, bound=bound,\n                           