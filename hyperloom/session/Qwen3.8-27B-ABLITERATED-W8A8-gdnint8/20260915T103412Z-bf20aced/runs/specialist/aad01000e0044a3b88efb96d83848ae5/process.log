ions are: {valid}\"\n75-            )\n76-        if self.backend != MambaBackendEnum.FLASHINFER:\n77-            raise ValueError(\n78-                \"Mamba SSU algorithm selection is only supported with the \"\n79-                \"FlashInfer backend. Please set `--mamba-backend flashinfer`, \"\n80-                \"or omit `--mamba-ssu-algorithm`.\"\n81-            )\n82-\n83-    def __post_init__(self):\n84-        self.validate_ssu_algorithm()\n85-        if self.enable_stochastic_rounding:\n86-            from vllm.platforms import current_platform\n87-\n88-            if not current_platform.is_cuda():\n89-                raise ValueError(\n90-                    \"Stochastic rounding for Mamba cache is only supported \"\n91-                    \"on NVIDIA CUDA platforms. Please do not specify  \"\n92-                    \"`--enable-mamba-cache-stochastic-rounding`.\"\n93-                )\n94-            if (\n95-                self.backend == MambaBackendEnum.TRITON\n96-                and not current_platform.is_device_capability_family(100)\n97-            ):\n98-                raise ValueError(\n99-                    \"Stochastic rounding for Mamba cache with triton backend requires \"\n100-                    \"compute capability 10.0 (data center Blackwell). The `cvt.rs` \"\n101-                    \"PTX instruction is not supported on your GPU. Please do not \"\n102-                    \"specify `--enable-mamba-cache-stochastic-rounding`, \"\n103-                    \"or set `--mamba-backend flashinfer`.\"\n104-                )","is_error":false}]},"parent_tool_use_id":null,"session_id":"19d81106-3fca-485b-8bda-77a1b07f3024","uuid":"f359c4db-a1ad-4b24-a81d-5c3a2f80cb79","timestamp":"2026-09-15T11:51:58.594Z","tool_use_result":{"stdout":"=== MambaConfig ===\nfiles: config/mamba.py\n### config/mamba.py\n37:class MambaConfig:\n38-    \"\"\"Configuration for Mamba SSM backends.\"\"\"\n39-\n40-    backend: MambaBackendEnum = MambaBackendEnum.TRITON\n