= str(q_dtype_w)]\n        return set(zip(df[\"N\"].astype(int), df[\"K\"].astype(int), df[\"M\"].astype(int)))\n    except Exception:\n        return set()\n\n\ndef _check_kernel_tuned(N: int, K: int, q_dtype_w: torch.dtype, csv_path: str) -> bool:\n    configs = _load_gemm_tuned_configs(q_dtype_w, csv_path)\n    l_m = (\n        [1, 2, 4]\n        + list(range(8, 513, 8))\n        + [1024, 1536]\n        + [2**i for i in range(11, 19)]\n    )\n    return any((N, K, M) in configs for M in l_m)\n\n\ndef if_aiter_supported(func: Callable) -> Callable:\n    \"\"\"Decorator that only executes the function if\n    ROCm AITER package is supported and enabled on gfx9 archs.\n    \"\"\"\n\n    @functools.wraps(func)\n=== is_linear_enabled live ===\n1833:    def is_linear_enabled(cls) -> bool:\n1834-        # gfx90a carve-out: stock @if_aiter_supported is CDNA3-only.\n1835-        if not is_aiter_attention_supported():\n1836-            return False\n1837-        return cls._AITER_ENABLED and cls._LINEAR_ENABLED\n1838-\n1839-    @classmethod\n1840-    @if_aiter_supported\n1841-    def is_linear_fp8_enabled(cls) -> bool:\n=== live w8a8_gemm ===\n2359:    def w8a8_gemm(\n2360-        A: torch.Tensor,\n2361-        B: torch.Tensor,\n2362-        As: torch.Tensor,\n2363-        Bs: torch.Tensor,\n2364-        bias: torch.Tensor | None = None,\n2365-        output_dtype: torch.dtype = torch.float16,\n2366-    ) -> torch.Tensor:\n2367-        return torch.ops.vllm.rocm_aiter_w8a8_gemm(A, B, As, Bs, bias, output_dtype)\n2368-\n2369-    @staticmethod\n2370-    def preshuffled_per_token_w8a8_gemm(\n2371-        A: torch.Tensor,\n2372-        B: torch.Tensor,\n2373-        As: torch.Tensor,\n2374-        Bs: torch.Tensor,\n2375-        bias: torch.Tensor | None = None,\n2376-        output_dtype: torch.dtype = torch.float16,\n2377-    ) -> torch.Tensor:\n2378-        return torch.ops.vllm._rocm_aiter_preshuffled_per_token_w8a8_gemm(\n2379-            A, B, As, Bs, bias, output_dtype\