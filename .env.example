# ROCm.AI Docker 环境矩阵 —— 针对 8x AMD Instinct MI250 (gfx90a / MI200) 选型
# 主机: Ubuntu 24.04, amdgpu 驱动 6.16.13, Docker 29 (走国内镜像加速)

PYTORCH_IMAGE=rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.9.1
TF_IMAGE=rocm/tensorflow:rocm7.14.1-ubuntu24.04-py3.12-tf2.20
JAX_IMAGE=rocm/jax:rocm7.2.4-jax0.8.2-py3.12
# vLLM: 本地构建（docker/Dockerfile.vllm-local），复用已有 conda 环境，
# 免去拉取 20GB 官方 rocm/vllm 镜像，且版本更新（0.28.0 vs 0.10.1）
VLLM_IMAGE=rocm-ai/vllm:0.28.0-rocm7.2.4
# 官方镜像（可选，不拉取）: rocm/vllm:rocm6.4.1_vllm_0.10.1_20250909

# gfx90a 若在新镜像中不可用的回退版本:
# PYTORCH_FALLBACK_IMAGE=rocm/pytorch:rocm6.4.4_ubuntu24.04_py3.12_pytorch_release_2.7.1
# TF_FALLBACK_IMAGE=rocm/tensorflow:rocm6.4.3_ubuntu20.04_py3.9_tf_release_2.17.0
