# 本地构建 vLLM 镜像 —— 复用已下载的 rocm/pytorch:7.2.4 基础镜像 + 本机现成 conda 环境
# 免去拉取 ~20GB 官方 rocm/vllm:rocm6.4.1_* 镜像（该线基于 ROCm 6.4.1，反而更旧）
#
# 资产来源:
#   - 基础镜像: rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.9.1 (本机已有, ROCm 7.2.4)
#   - 环境副本: envs/vllm-0.28.0-rocm7.2.4 (复制自 /home/qiba/ai/envs/vllm_0.28.0_rocm72,
#              vLLM 0.28.0 + torch 2.12.0+rocm7.2, 已补装 tqdm/gguf/filelock, shebang 已改到 /opt/envs/vllm)
#
# 构建: docker build -f docker/Dockerfile.vllm-local -t rocm-ai/vllm:0.28.0-rocm7.2.4 .
# 运行: docker run --device /dev/kfd --device /dev/dri --group-add 993 --group-add 44 \
#         --security-opt seccomp=unconfined --ipc=host -v $PWD/models:/models:ro \
#         -p 8000:8000 rocm-ai/vllm:0.28.0-rocm7.2.4 serve /models
FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.9.1

COPY envs/vllm-0.28.0-rocm7.2.4 /opt/envs/vllm

ENV PATH=/opt/envs/vllm/bin:$PATH \
    VLLM_LOGGING_LEVEL=INFO \
    PYTHONUNBUFFERED=1

# 构建期自检（导入不需要 GPU）
RUN python -c "import vllm, torch; print('vllm', vllm.__version__, '| torch', torch.__version__)"

EXPOSE 8000
# 用法（vllm CLI 已在 PATH）:
#   交互: docker run -it ... rocm-ai/vllm:0.28.0-rocm7.2.4
#   服务: docker run -p 8000:8000 ... rocm-ai/vllm:0.28.0-rocm7.2.4 \
#           vllm serve /models --served-model-name tiny-qwen --gpu-memory-utilization 0.5 --max-model-len 4096
CMD ["bash"]
