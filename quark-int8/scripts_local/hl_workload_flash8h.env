# Hyperloom Phase 2 落库：GLM-5.3-Flash Quark-INT8 / 8×MI250X / 8 并发 / 8 小时
# 权威副本在 quark-int8/scripts_local/hl_workload_flash8h.env（入库），
# 由 hl_session_flash8h.sh 以 root 拷到 $RUN_DIR/workload.env（该目录 root 属主）。
#
# 规模为什么这么定（口径必须写下来，否则下次又要重新推）：
#   Magpie 默认 NUM_PROMPTS = CONC × factor(seq_cost)，ISL+OSL<=1024 时 factor=10
#   => 默认 80 条 × 512 输出 = 4.1 万 token，按本机聚合 ~13 tok/s 要 52 min/候选。
#   钉到 16 条（= 8 并发两个整波）=> 8192 输出 token ≈ 11 min，加装载 6-12 min，
#   8 小时能跑到 ~10 个候选。decode 速率与上下文长度无关（实测 ISL 64→16384
#   decode 恒 3.18-3.33 tok/s，index_topk=2048 每层只读 2048 key），所以短上下文
#   不损失代表性。
export MODEL_PATH=/mnt/stripe-3mix-3t2/models/ZhipuAI/GLM-5.3-Flash-Quark-Int8
export FRAMEWORK=vllm
export TP=8
export EP=1
export CONC=8
export ISL=512
export OSL=512
export PRECISION=int8
export MAX_HOURS=8
export TARGET_GAIN=40
export KNOWLEDGE_LOCAL_ROOT=/home/qiba/ROCm.AI/hyperloom/kb
# 8h 档：配置车道 0.45 + 内核车道 0.35（本机首次真正启用内核车道）。
# 不传 --no-enable-roofline（默认 on，mi250x 的 CU/带宽/峰值已进 HW_SPECS）。
# OPT_FLAGS 只放"值里不含空格"的 flag（hl_launch.sh 用无引号数组展开）。
# --no-eval 的原因（09-21 两条实测，缺一不可记）：
#   (1) lm_eval 在 baseline 末尾炸：ConnectionError Couldn't reach 'openai/gsm8k' on the Hub
#       (OfflineModeIsEnabled)。数据集**其实在容器里**（/root/.cache/huggingface/datasets/
#       openai___gsm8k，直接 load_dataset 离线可通：train 7473 / test 1319）——真因是 eval 跑在
#       Ray worker 里，HOME/HF_HOME 与 /root/.cache 不是同一个。可以用 --extra-env
#       HF_HOME=/root/.cache/huggingface 修好，**但我故意不修**，理由见 (2)。
#   (2) 开着的代价是小时级/候选：gsm8k test=1319 × max_gen_toks≈256 = 33.8 万输出 token，
#       按本机实测 8 并发聚合 24 tok/s => 单 eval ≈ 3.9 h；还没算 5-shot 带来的 ~4 M token prefill。
#       8 小时会全部烧在精度门上。
#   => 代价必须写清：--no-eval 的官方语义是"每个候选只按吞吐打分，本 run 未被精度验证"。
#      补验收放在会话结束后用本仓自己的尺子做（分钟级）：scripts_local/taskcheck.py
#      （与 8121 的 glm53_verify32k 同题同判据）+ tools/probe_nll.py 的 NLL 量级硬门。
export OPT_FLAGS="--gpu-type mi250x --max-model-len 8192 --no-eval --max-minutes-framework-pct 0.45 --max-minutes-kernel-pct 0.35 --max-minutes-sweep-pct 0.01 --no-enable-conc-sweep --extra-env NUM_PROMPTS=16 --extra-env VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256"
# 与现役 8128 臂的已知可跑集一致；两处刻意的差异：
#   1) 不给 --gpu-memory-utilization（runner 从 GPU_MEMORY_UTILIZATION 读，默认就是 0.95，
#      写两遍会让 dedup 变成"最后一个赢"，白增一个变量）
#   2) --enforce-eager 必须留：本模型默认 cudagraph 报 "piecewise CUDA graphs … not
#      torch-compiled"，只加 VLLM_USE_BREAKABLE_CUDAGRAPH=1 会在第一个请求 segfault
#      （见 knobs/glm5next-quark-int8-launch-set.md §2 实测表）；FULL_DECODE_ONLY 档仍未试。
#   3) 【09-21 新测，已撤掉 --safetensors-load-strategy eager】eager 的"必给"判词来自
#      8114 / 0.28 wheel 树；在 0918 nightly（vllm 0.3.1.dev85）上单变量对照（同镜像、
#      同 --max-model-len 8192、同 TP8、同 blk128）：
#          eager : engine init -> 装载完成 14m27s；宿主 RSS 峰 90.4 GiB；MemAvailable 低 14.1 GiB
#          默认lazy: Loading weights took 444.47s，7m57s 装完；RSS 峰 37.5 GiB；avail 最低 71.3 GiB
#      ⇒ 默认路径快 6.5 min/候选，且把 MemAvailable 从"离 Ray 误杀线 1.5 GiB"挪到 71 GiB。
#      数值侧同尺子验过：NLL 第 1/3 条 1.811/0.481 vs eager 那跑 1.815/0.472（同量级同位次），
#      中文那条 1.514/0.607/1.514 属**同一台服务器**的 run-to-run 抖动（batch/paged-KV 组成），
#      不是装载差异。注意"不给 flag"= vLLM 默认 lazy（default_loader.py），
#      **不是** --load-format fastsafetensors —— 后者是第三个未测变量，留给后续单变量臂。
export SERVER_ARGS="--dtype bfloat16 --max-num-seqs 8 --block-size 128 --kv-cache-dtype bfloat16 --language-model-only --max-num-batched-tokens 2048 --enforce-eager"
