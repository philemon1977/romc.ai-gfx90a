# ============================================================================
# ROCm.AI @ 8x MI250 (gfx90a) — 仓库范围策略
#
# 本仓库提交：文档 / 配置 / 脚本 / 测试 / 补丁源码 / 知识库 / 报告与实测数据。
# 本仓库不提交（可由 scripts/bootstrap.sh 与 scripts/build_*.sh 重建，或体积无意义）：
#   - Python 虚拟环境      envs/, hyperloom/envs/          (~26 GB)
#   - 模型权重             models/                         (~1 GB, 第三方资产)
#   - 第三方代码副本       amd-skills/, hyperloom/hyperloom/, kernelforge/,
#                          hyperloom/bin/, *.dist-info/     (见 DEPENDENCIES.md)
#   - optimizer 重放环境   hyperloom/session/**/{wt*,worktree,scratch,vcache,aot,
#                          site-packages,__pycache__}  (~28.9 GB of the 29 GB session)
#     —— session 里的 run 状态与结果（manifest/state/critic 判决/逐候选基准记录）
#        是入库的，只剔掉每个候选一棵 vLLM worktree 与编译缓存。
#   - 临时与缓存           .tmp/, hyperloom/.tmp/, hyperloom/.cache/  (~33 GB)
#   - 重复的库存二进制     hyperloom/patches/*/vllm/**      (与上游 wheel 逐字节相同)
# 需要保留的二进制（aiter 修复产物、profiler trace）走 Git LFS，见 .gitattributes。
# ============================================================================

# --- 本地工具链（git-lfs 等，由 bootstrap 安装到此） -------------------------
/.tools/

# --- 环境与依赖 --------------------------------------------------------------
/envs/
/hyperloom/envs/
/venv/
/.venv/
*.egg-info/
build/
dist/

# --- 模型权重与数据集（第三方资产，用 scripts/fetch_models.sh 拉取） ----------
/models/
*.safetensors
*.gguf
*.ckpt
*.pth
*.pt

# --- 第三方代码：见 DEPENDENCIES.md + scripts/bootstrap.sh --------------------
/amd-skills/
/hyperloom/hyperloom/
/hyperloom/kernelforge/
/hyperloom/bin/
/hyperloom/*.dist-info/
/hyperloom/.agents/
/hyperloom/.claude/
/hyperloom/.cursor/
/hyperloom/.cache/

# --- 临时与工具现场 ----------------------------------------------------------
/hyperloom/logs/
/.tmp/
/hyperloom/.tmp/
torch_compile_cache/
.cache/
**/wt/
**/wt2/
**/worktree/
**/scratch/
**/pristine/
**/verify/
*.hsaco
*.ttir
*.ttgir
*.llir
*.amdgcn
*.best_config
kernel_perf/

# --- Hyperloom optimizer 运行现场：入库「状态与结果」，剔除「重放环境」 -------
# 保留：manifest/state/session_breakdown、runs 下每个候选的 request|emit|review|
#       judge_bundle|specialist_done、benchmark_report 与 samples_gsm8k 逐样本记录、
#       agent 转录与 process.log、prompt 快照、integrate_patch 的 *.bak（改动前原文件）。
# 剔除：每个候选一棵 vLLM worktree 及其 site-packages、AOT/inductor/triton 编译缓存
#       （占 session 29 GB 里的 28.9 GB），以及半一致状态的 sqlite 事件库。
#
# 【安全】runtime/ 一律不入库，且这条不是可选的整洁性规则：
#   hyperloom/session/runtime/kernel-agent.env.sh 是 0644 全局可读的运维 env 脚本，
#   里面有 `export ANTHROPIC_API_KEY=<48 字符真实密钥>` 与 ANTHROPIC_BASE_URL。
#   本仓库是 public，任何 `git add hyperloom/session` 的整目录写法都会把它推上去。
#   其余 runtime/ 内容（optimizer.lock、*.audit.jsonl、事件总线 spool、KB 预热缓存）
#   是工具的活动状态而非产出，其文本形态已在 */emit.json、state.json 里。
/hyperloom/session/**/runtime/
/hyperloom/session/**/wt3/
/hyperloom/session/**/vcache/
/hyperloom/session/**/boot/
/hyperloom/session/**/aot/
/hyperloom/session/**/site-packages/
/hyperloom/session/**/triton_cache/
/hyperloom/session/**/usersite-shim/
/hyperloom/session/**/*.so
/hyperloom/session/**/*.so.*
/hyperloom/session/**/*.safetensors
# sqlite 事件库与其 wal/shm 一起排除：只提交 .db 会漏掉未 checkpoint 的 wal，
# 得到半一致快照。同一批事件的文本形态见 storage/../emit.json 与 state.json。
# 需要时在本机导出：python3 -c "import sqlite3;print('\n'.join(
#   sqlite3.connect('file:storage/coordinator.db?mode=ro&uri=True').iterdump()))"
/hyperloom/session/**/*.db
/hyperloom/session/**/*.db-wal
/hyperloom/session/**/*.db-shm

# --- Python 运行垃圾 ---------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- 工具运行期标记（0 字节锁 / 就绪时间戳，非产出） -------------------------
.lock
!.gitignore.lock
server_ready_at
*.pid
heartbeat.json

# --- 机密与本机配置（提交 .env.example，实际 .env 不入库） --------------------
.env
.env.*
!.env.example
*.pem
*.key
*_token
*credentials*

# --- 编辑器等 ----------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# --- 补丁目录：只保留补丁源码与启动器，丢弃整棵已构建 overlay ----------------
# hyperloom/patches/<name>/vllm/** 是从 site-packages 拷来的完整 vLLM 树，
# 其中的 .so 经 sha256 校验与上游 wheel 逐字节相同，Python 侧改动全部在 .patch 里。
/hyperloom/patches/**
!/hyperloom/patches/*/
!/hyperloom/patches/*/*.patch
!/hyperloom/patches/*/README.md
!/hyperloom/patches/*/bin/
!/hyperloom/patches/*/bin/*

# --- quark-int8 实验产物（按本仓策略不入库：模型权重 / 构建产物 / 缓存 / 日志）----
# 可重建：aiter JIT 的 .so（555M）、triton 缓存（77M）、CK 例程编译产物
# 体积无意义：tiny_* 是 4 个 273–282M 的临时测试 checkpoint
/quark-int8/tiny_*/
/quark-int8/aiter_jit_build/
/quark-int8/triton_cache/
/quark-int8/.triton/
/quark-int8/logs/
/quark-int8/ck_int4/*.gfx90a
